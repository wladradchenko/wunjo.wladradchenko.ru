msgstr "Capcineig"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_transform_360.xml
#: rc.cpp:2796 rc.cpp:3086
#, kde-format
msgid ""
"The amount to rotate the image<br>\n"
"    \t(nose up or down)."
msgstr ""
"La quantitat a girar la imatge<br>\n"
"    \t(la cara es mou amunt o avall)."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_stereo.xml
#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_transform_360.xml
#: rc.cpp:2798 rc.cpp:2822 rc.cpp:3088
#, kde-format
msgid "Roll"
msgstr "Balanceig"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_transform_360.xml
#: rc.cpp:2800 rc.cpp:3090
#, kde-format
msgid ""
"The amount to rotate the image<br>\n"
"    \t(clockwise or anticlockwise rotation along the axis of movement)."
msgstr ""
"La quantitat a girar la imatge<br>\n"
"    \t(gir en sentit horari o antihorari al llarg de l'eix de moviment)."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_stereo.xml
#: rc.cpp:2802 rc.cpp:2824
#, kde-format
msgid "FOV"
msgstr "CDV"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#: rc.cpp:2804
#, kde-format
msgid ""
"The horizontal field of view, in degrees, of the resulting frame.<br>\n"
"    \tAny value over 179 results in a fisheye projection."
msgstr ""
"El camp de visió horitzontal, en graus, del fotograma resultant.<br>\n"
"    \tQualsevol valor superior a 179 ocasiona una projecció d'ull de peix."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#: rc.cpp:2806
#, kde-format
msgid "Fisheye"
msgstr "Ull de peix"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#: rc.cpp:2808
#, kde-format
msgid ""
"The amount of fisheye to mix in.<br>\n"
"    \t100 means that you get a 100% fisheye lens."
msgstr ""
"La quantitat d'ull de peix a barrejar.<br>\n"
"    \t100 vol dir que obteniu una lent d'ull de peix al 100%."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_stereo.xml
#: rc.cpp:2814
#, kde-format
msgid "VR360 Equirectangular to Stereo"
msgstr "VR360 equirectangular a estèreo"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_stereo.xml
#: rc.cpp:2816
#, kde-format
msgid ""
"Projects a stereographic image from an equirectangular. Use this to create "
"the little planet effect from a VR360 footage."
msgstr ""
"Projecta una imatge estereogràfica a partir d'una equirectangular. Useu això "
"per a crear l'efecte «Planeta petit» a partir del metratge VR360."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_stereo.xml
#. i18n: file: data/effects/frei0r/frei0r_defish0r.xml
#. i18n: file: data/effects/frei0r/frei0r_iirblur.xml
#. i18n: file: data/effects/frei0r/frei0r_sharpness.xml
#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:2826 rc.cpp:3384 rc.cpp:3690 rc.cpp:4600 rc.cpp:6106
#, kde-format
msgid "Amount"
msgstr "Quantitat"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_stereo.xml
#: rc.cpp:2830
#, kde-format
msgid "Nearest-neighbor,Bilinear"
msgstr "Veí més pròxim,Bilineal"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_wrap.xml
#: rc.cpp:2832
#, kde-format
msgid "VR360 Wrap"
msgstr "Ajust VR360"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_wrap.xml
#: rc.cpp:2834
#, kde-format
msgid ""
"Stretches a section of the equirectangular panorama to cover the entire VR "
"sphere"
msgstr ""
"Estira una secció del panorama equirectangular per a cobrir tota l'esfera VR"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_wrap.xml
#: rc.cpp:2838
#, kde-format
msgid "Determines the sampling method"
msgstr "Determina el mètode de mostreig"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_wrap.xml
#: rc.cpp:2844 rc.cpp:2848 rc.cpp:2852 rc.cpp:2856
#, kde-format
msgid "Degrees from the center of the image to keep unchanged"
msgstr "Graus des del centre de la imatge a mantenir sense canvis"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_wrap.xml
#: rc.cpp:2858
#, kde-format
msgid "Blur start"
msgstr "Inici del difuminat"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_wrap.xml
#: rc.cpp:2860
#, kde-format
msgid ""
"Horizontal fraction of the unchanged area to blur over in the equator band"
msgstr ""
"Fracció horitzontal de l'àrea sense canvis a difuminar a la banda equatorial"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_wrap.xml
#: rc.cpp:2862
#, kde-format
msgid "Blur end"
msgstr "Final del difuminat"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_wrap.xml
#: rc.cpp:2864
#, kde-format
msgid "Horizontal fraction of the unchanged area to blur over at the poles"
msgstr "Fracció horitzontal de l'àrea sense canvis a difuminar als pols"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2866
#, kde-format
msgid "VR360 Hemispherical to Equirectangular"
msgstr "VR360 hemisfèric a equirectangular"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2868
#, kde-format
msgid ""
"Converts a video frame with two hemispherical images to a single "
"equirectangular frame. The plugin assumes that both hemispheres are in the "
"frame"
msgstr ""
"Converteix un fotograma de vídeo amb dues imatges hemisfèriques a un "
"fotograma equirectangular únic. El connector assumeix que els dos hemisferis "
"estan en el fotograma"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2870
#, kde-format
msgid "Alignment yaw"
msgstr "Alineació de guinyada"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2872 rc.cpp:2876 rc.cpp:2880
#, kde-format
msgid ""
"The two fisheye cameras of a 360 camera are rarely perfectly 180 degrees "
"apart.<br>\n"
"    \tThese parameters adds a rotation to both lenses to correct for this."
msgstr ""
"Les dues càmeres d'ulls de peix d'una càmera de 360 poques vegades es troben "
"exactament a 180 graus de distància.<br>\n"
"    \tAquests paràmetres afegeixen un gir a les dues lents per a corregir-ho."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2874
#, kde-format
msgid "Alignment pitch"
msgstr "Alineació de capcineig"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2878
#, kde-format
msgid "Alignment roll"
msgstr "Alineació de balanceig"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2882
#, kde-format
msgid "Projection"
msgstr "Projecció"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2884
#, kde-format
msgid ""
"The fisheye projection type. Currently only equidistant fisheyes, like the "
"Ricoh Theta and Garmin Virb360 are supported."
msgstr ""
"El tipus de projecció d'ull de peix. Actualment només es permeten els ulls "
"de peix equidistants, com el Ricoh Theta i el Garmin Virb360."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2886
#, kde-format
msgid "Equidistant Fisheye"
msgstr "Ull de peix equidistant"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2888
#, kde-format
msgid "Lens FOV"
msgstr "CDV de la lent"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2890
#, kde-format
msgid ""
"The field of view of a single hemisphere in degrees, expressed as a fraction "
"of the frame width."
msgstr ""
"El camp de visió d'un únic hemisferi en graus, expressat com una fracció de "
"l'amplada del fotograma."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2892
#, kde-format
msgid "Lens radius"
msgstr "Radi de la lent"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2894
#, kde-format
msgid ""
"The radius of the image circle, expressed as a fraction of the frame width."
msgstr ""
"El radi del cercle de la imatge, expressat com una fracció de l'amplada del "
"fotograma."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2896
#, kde-format
msgid "Front X"
msgstr "Frontal X"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2898
#, kde-format
msgid ""
"The image center and image orientation for the front-facing camera.<br>\n"
"    \tThe X parameter is a fraction of the image width."
msgstr ""
"El centre de la imatge i l'orientació de la imatge per a la càmera frontal."
"<br>\n"
"    \tEl paràmetre X és una fracció de l'amplada de la imatge."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2900
#, kde-format
msgid "Front Y"
msgstr "Frontal Y"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2902
#, kde-format
msgid ""
"The image center and image orientation for the front-facing camera.<br>\n"
"    \tThe Y parameter a fraction of the image height."
msgstr ""
"El centre de la imatge i l'orientació de la imatge per a la càmera frontal."
"<br>\n"
"    \tEl paràmetre Y és una fracció de l'alçada de la imatge."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2904
#, kde-format
msgid "Front Up"
msgstr "Frontal amunt"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2906
#, kde-format
msgid ""
"The image center and image orientation for the front-facing camera.<br>\n"
"    \tUp is the \"up\" direction in the image, in degrees clockwise from a "
"direction towards the frame top edge."
msgstr ""
"El centre de la imatge i l'orientació de la imatge per a la càmera frontal."
"<br>\n"
"    \tAmunt es la direcció «amunt» de la imatge, en graus en el sentit "
"horari des d'una direcció cap a la vora superior del fotograma."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2908
#, kde-format
msgid "Back X"
msgstr "Posterior X"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2910
#, kde-format
msgid ""
"The image center and image orientation for the back-facing camera.<br>\n"
"    \tThe X parameter is a fraction of the image width.."
msgstr ""
"El centre de la imatge i l'orientació de la imatge per a la càmera dorsal."
"<br>\n"
"    \tEl paràmetre X és una fracció de l'amplada de la imatge."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2912
#, kde-format
msgid "Back Y"
msgstr "Posterior Y"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2914
#, kde-format
msgid ""
"The image center and image orientation for the back-facing camera.<br>\n"
"    \tThe Y parameter a fraction of the image height."
msgstr ""
"El centre de la imatge i l'orientació de la imatge per a la càmera dorsal."
"<br>\n"
"    \tEl paràmetre Y és una fracció de l'alçada de la imatge."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2916
#, kde-format
msgid "Back Up"
msgstr "Posterior amunt"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2918
#, kde-format
msgid ""
"The image center and image orientation for the back-facing camera.<br>\n"
"    \tUp is the \"up\" direction in the image, in degrees clockwise from a "
"direction towards the frame top edge."
msgstr ""
"El centre de la imatge i l'orientació de la imatge per a la càmera dorsal."
"<br>\n"
"    \tAmunt es la direcció «amunt» de la imatge, en graus en el sentit "
"horari des d'una direcció cap a la vora superior del fotograma."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2920
#, kde-format
msgid "Nadir radius"
msgstr "Radi del nadir"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2922 rc.cpp:2926
#, kde-format
msgid ""
"360 cameras like the Theta have a problem with the nadir direction where, no "
"matter what, you will have a little of the camera in the image.<br>\n"
"    \tThis parameter \"stretches\" the image near nadir to cover up the "
"missing parts."
msgstr ""
"Les càmeres de 360 com la Theta tenen un problema amb la direcció nadir on, "
"no importa el que, tindrà una mica de la càmera a la imatge.<br>\n"
"    \tAquest paràmetre «estira» la imatge a prop del nadir per a cobrir les "
"parts que falten."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2924
#, kde-format
msgid "Nadir start"
msgstr "Inici del nadir"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2928
#, kde-format
msgid "Lens distortion A"
msgstr "Distorsió de la lent A"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2930 rc.cpp:2934 rc.cpp:2938
#, kde-format
msgid ""
"Lens distortion correction parameters.<br>\n"
"    \tThe first three parameters are the same as in Hugin."
msgstr ""
"Paràmetres de correcció de la distorsió de la lent.<br>\n"
"    \tEls tres primers paràmetres són els mateixos que a Hugin."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2932
#, kde-format
msgid "Lens distortion B"
msgstr "Distorsió de la lent B"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2936
#, kde-format
msgid "Lens distortion C"
msgstr "Distorsió de la lent C"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2940
#, kde-format
msgid "Lens distortion radius"
msgstr "Radi de distorsió de la lent"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2942
#, kde-format
msgid ""
"Lens distortion correction parameters.<br>\n"
"    \tIf you use Hugin parameters, the Radius should be set to the value of "
"(0.5 * min(image width, image height) / image width). For a 2:1 aspect dual "
"hemispherical image, that would be 0.25."
msgstr ""
"Paràmetres de correcció de la distorsió de la lent.<br>\n"
"    \tSi utilitzeu paràmetres Hugin, el radi s'ha d'establir al valor (0,5 * "
"min(amplada de la imatge, alçada de la imatge) / amplada de la imatge). Per "
"a una imatge semiesfèrica d'aspecte dual 2:1, això seria 0,25."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2944
#, kde-format
msgid "Lens vignetting A"
msgstr "Vinyetatge de la lent A"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2946 rc.cpp:2950 rc.cpp:2954 rc.cpp:2958
#, kde-format
msgid ""
"Lens vignetting correction parameters.<br>\n"
"    \tThe first four parameters are the same as in Hugin, corresponding to "
"the Va, Vb, Vc and Vd image parameters."
msgstr ""
"Paràmetres de correcció del vinyetatge de la lent.<br>\n"
"    \tEls primers quatre paràmetres són els mateixos que a Hugin, "
"corresponents als paràmetres d'imatge Va, Vb, Vc i Vd."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2948
#, kde-format
msgid "Lens vignetting B"
msgstr "Vinyetatge de la lent B"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2952
#, kde-format
msgid "Lens vignetting C"
msgstr "Vinyetatge de la lent C"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2956
#, kde-format
msgid "Lens vignetting D"
msgstr "Vinyetatge de la lent D"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2960
#, kde-format
msgid "Lens vignetting radius"
msgstr "Radi de vinyetatge de la lent"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2962
#, kde-format
msgid ""
"If you use Hugin parameters, the radius should be set to the value of (0.5 * "
"image diagonal / image width).<br>\n"
"    \tFor a 2:1 aspect dual hemispherical image, that would be 0.5590. Use "
"the A parameter to scale the effect and avoid overexposing highlights"
msgstr ""
"Si utilitzeu paràmetres Hugin, el radi s'ha d'establir al valor (0,5 * "
"diagonal de la imatge / amplada de la imatge).<br>\n"
"    \tPer a una imatge semiesfèrica d'aspecte dual 2:1, això seria 0,5590. "
"Utilitzeu el paràmetre A per a canviar l'escala de l'efecte i evitar la "
"sobreexposició de llums intenses"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2964
#, kde-format
msgid "Use sensor response parameters"
msgstr "Utilitza els paràmetres de resposta del sensor"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2966
#, kde-format
msgid "Switch on to use sensor response parameters (EMoR h(x))"
msgstr ""
"Activa per a utilitzar els paràmetres de resposta del sensor (EMoR h(x))"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2968
#, kde-format
msgid "EMoR h(1)"
msgstr "EMoR h(1)"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2970 rc.cpp:2974 rc.cpp:2978 rc.cpp:2982 rc.cpp:2986
#, kde-format
msgid ""
"Sensor response parameters.<br>\n"
"    \tThe EMoR h(x) parameters are the same as Hugin's Ra - Re in the lens "
"parameters. If you use Hugin-derived values for vignetting correction, you "
"should also use these parameters, as Hugin's vignetting correction assumes "
"that the sensor response has been corrected."
msgstr ""
"Paràmetres de resposta del sensor.<br>\n"
"    \tEls paràmetres EMoR h(x) són els mateixos  Ra - Re de Hugin en els "
"paràmetres de la lent. Si utilitzeu valors derivats de Hugin per a la "
"correcció del vinyetatge també haureu d'utilitzar aquests paràmetres, ja que "
"la correcció del vinyetatge de Hugin assumeix que la resposta del sensor "
"s'ha corregit."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2972
#, kde-format
msgid "EMoR h(2)"
msgstr "EMoR h(2)"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2976
#, kde-format
msgid "EMoR h(3)"
msgstr "EMoR h(3)"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2980
#, kde-format
msgid "EMoR h(4)"
msgstr "EMoR h(4)"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2984
#, kde-format
msgid "EMoR h(5)"
msgstr "EMoR h(5)"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_rect_to_eq.xml
#: rc.cpp:2992
#, kde-format
msgid "VR360 Rectilinear to Equirectangular"
msgstr "VR360 rectilini a equirectangular"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_rect_to_eq.xml
#: rc.cpp:2994
#, kde-format
msgid ""
"Converts a rectilinear (a normal-looking) image to an equirectangular image. "
"Use this together with Transform 360 to place \"normal\" footage in a 360 "
"movie."
msgstr ""
"Converteix una imatge rectilínia (d'aspecte normal) en una imatge "
"equirectangular. Useu-lo juntament amb Transforma 360 per a col·locar "
"metratge «normal» en una pel·lícula de 360."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:3004
#, kde-format
msgid "VR360 Stabilize"
msgstr "Estabilització VR360"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:3006
#, kde-format
msgid ""
"Stabilizes 360 footage.<br>\n"
"    The plugin works in two phases - analysis and stabilization. When "
"analyzing footage, it detects frame-to-frame rotation, and when stabilizing "
"it tries to correct high-frequency motion (shake)."
msgstr ""
"Estabilitza el metratge de 360.<br>\n"
"    El connector funcionarà en dues fases: anàlisi i estabilització. En "
"analitzar el metratge, detectarà el gir fotograma a fotograma i, en "
"estabilitzar, intentarà corregir el moviment d'alta freqüència (sacseig)."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:3008
#, kde-format
msgid "Analyze"
msgstr "Analitza"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:3010
#, kde-format
msgid "Switch on for analysis phase; switch off for stabilization phase."
msgstr ""
"Activat per a la fase d'anàlisi; desactivat per a la fase d'estabilització."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:3012
#, kde-format
msgid "Motion analysis file"
msgstr "Fitxer d'anàlisi de moviments"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:3014
#, kde-format
msgid "Select the file to store stabilization data in"
msgstr "Selecciona el fitxer on emmagatzemar les dades d'estabilització"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:3016
#, kde-format
msgid "Start offset"
msgstr "Desplaçament inicial"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:3018
#, kde-format
msgid ""
"The offset into the stabilization file that corresponds to the start of this "
"clip.<br>\n"
"    \tFor example, if you have a 30 second clip, analyze it all, and then "
"split it into three clips of 10 seconds each, then the start offsets should "
"be 0s, 10s, and 20s."
msgstr ""
"El desplaçament en el fitxer d'estabilització que correspon a l'inici "
"d'aquest clip.<br>\n"
"    \tPer exemple, si teniu un clip de 30 segons, analitzeu-lo tot i després "
"dividiu-lo en tres clips de 10 segons cadascun, llavors els desplaçaments "
"d'inici haurien de ser 0s, 10s i 20s."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:3020
#, kde-format
msgid "Analysis sample radius"
msgstr "Radi de mostra de l'anàlisi"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:3022
#, kde-format
msgid "The radius of the square that the stabilizer will sample"
msgstr "El radi del quadrat que l'estabilitzador agafarà com a mostra"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:3024
#, kde-format
msgid "Analysis search radius"
msgstr "Radi de cerca de l'anàlisi"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:3026
#, kde-format
msgid "The maximum amount of motion the stabilizer will detect"
msgstr "La quantitat màxima de moviment que detectarà l'estabilitzador"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:3028
#, kde-format
msgid "Analysis offset"
msgstr "Decalatge de l'anàlisi"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:3030
#, kde-format
msgid "The distance between the track points"
msgstr "La distància entre els punts de seguiment"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:3032
#, kde-format
msgid "Use backwards-facing track points"
msgstr "Utilitza els punts de seguiment cap enrere"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:3034
#, kde-format
msgid ""
"If set, six backwards-facing track points will also be used to detect pitch "
"and yaw motion.<br>\n"
"    \tDisable if, for example, you show up holding the camera there"
msgstr ""
"Si s'estableix, també s'utilitzaran sis punts de seguiment orientats cap "
"enrere per a detectar el moviment de capcineig i guinyada.<br>\n"
"    \tDesactiveu-ho si, per exemple, voleu mostrar-vos aguantant la càmera"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:3036
#, kde-format
msgid "Yaw amount"
msgstr "Quantitat de guinyada"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:3038 rc.cpp:3062
#, kde-format
msgid ""
"The amount of stabilization to apply.<br>\n"
"    \t100% means that the stabilizer will make the camera as steady as it "
"can. Smaller values reduce the amount of stabilization."
msgstr ""
"La quantitat d'estabilització a aplicar. <br>\n"
"    \t100% significa que l'estabilitzador farà la càmera tan estable com "
"pugui. Els valors més petits redueixen la quantitat d'estabilització."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:3040
#, kde-format
msgid "Yaw smoothing"
msgstr "Suavitzat de guinyada"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:3042
#, kde-format
msgid ""
"The number of frames to use to smooth out the shakes. The higher the value, "
"the slower the camera will follow any intended motion."
msgstr ""
"El nombre de fotogrames que s'han d'utilitzar per a suavitzar les "
"sacsejades. Com més alt sigui el valor, més lent seguirà la càmera qualsevol "
"moviment pretès."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:3044
#, kde-format
msgid "Yaw time bias"
msgstr "Biaix del temps de guinyada"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:3046 rc.cpp:3058 rc.cpp:3070
#, kde-format
msgid ""
"Shift the frames used to smooth out the shakes relative to the stabilized "
"frame.<br>\n"
"    \tA value less than zero will give more weight to past frames, and the "
"camera will seem to lag behind intended movement. A value greater than zero "
"will give more weight to future frames, and the camera will appear to move "
"ahead of the intended camera movement. A value of zero should make the "
"camera follow the intended path."
msgstr ""
"Desplaça els fotogrames utilitzats per a suavitzar les sacsejades relatives "
"al fotograma estabilitzat.<br>\n"
"    \tUn valor inferior a zero donarà més pes als fotogrames passats, i la "
"càmera semblarà estar per darrere del moviment previst. Un valor més gran "
"que zero donarà més pes als fotogrames futurs, i la càmera semblarà que "
"s'avança al moviment previst de la càmera. Un valor de zero hauria de fer "
"que la càmera segueixi el recorregut pretès."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:3048
#, kde-format
msgid "Pitch amount"
msgstr "Quantitat de capcineig"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:3050
#, kde-format
msgid ""
"The amount of stabilization to apply. 100% means that the stabilizer will "
"make the camera as steady as it can. Smaller values reduce the amount of "
"stabilization."
msgstr ""
"La quantitat d'estabilització a aplicar. 100% significa que l'estabilitzador "
"farà que la càmera sigui tan estable com pugui. Els valors més petits "
"redueixen la quantitat d'estabilització."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:3052
#, kde-format
msgid "Pitch smoothing"
msgstr "Suavitzat de capcineig"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:3054 rc.cpp:3066
#, kde-format
msgid ""
"The number of frames to use to smooth out the shakes.<br>\n"
"    \tThe higher the value, the slower the camera will follow any intended "
"motion."
msgstr ""
"El nombre de fotogrames a utilitzar per a suavitzar les sacsejades.<br>\n"
"    \tCom més alt sigui el valor, més lenta seguirà la càmera qualsevol "
"moviment pretès."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:3056
#, kde-format
msgid "Pitch time bias"
msgstr "Biaix del temps de capcineig"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:3060
#, kde-format
msgid "Roll amount"
msgstr "Quantitat de balanceig"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:3064
#, kde-format
msgid "Roll smoothing"
msgstr "Suavitzat de balanceig"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:3068
#, kde-format
msgid "Roll time bias"
msgstr "Biaix del temps de balanceig"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_transform_360.xml
#: rc.cpp:3076
#, kde-format
msgid "VR360 Transform"
msgstr "Transformació VR360"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_transform_360.xml
#: rc.cpp:3078
#, kde-format
msgid "Rotates a panoramic image"
msgstr "Gira una imatge panoràmica"

#. i18n: file: data/effects/frei0r/frei0r_bluescreen0r.xml
#: rc.cpp:3098
#, kde-format
msgid "Blue Screen (Color to Alpha)"
msgstr "Pantalla blava (Color a alfa)"

#. i18n: file: data/effects/frei0r/frei0r_bluescreen0r.xml
#: rc.cpp:3100
#, kde-format
msgid "Turns the selected color into alpha making it transparent."
msgstr "Converteix el color seleccionat en alfa fent-lo transparent."

#. i18n: file: data/effects/frei0r/frei0r_bluescreen0r.xml
#: rc.cpp:3106
#, kde-format
msgid "Distance to Color"
msgstr "Distància al color"

#. i18n: file: data/effects/frei0r/frei0r_brightness.xml
#: rc.cpp:3108
#, kde-format
msgctxt "Brightness Effect Name"
msgid "Brightness"
msgstr "Lluminositat"

#. i18n: file: data/effects/frei0r/frei0r_brightness.xml
#: rc.cpp:3110
#, kde-format
msgid "Adjusts the brightness of a source image"
msgstr "Ajusta la lluminositat de la imatge original"

#. i18n: file: data/effects/frei0r/frei0r_bw0r.xml
#: rc.cpp:3114
#, kde-format
