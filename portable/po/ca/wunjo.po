msgstr "Aplica un efecte de zoom i de panoràmica"

#. i18n: file: data/effects/avfilter/subtitles.xml
#: rc.cpp:7676
#, kde-format
msgid "Render subtitles onto the video"
msgstr "Renderitza subtítols en el vídeo"

#. i18n: file: data/effects/avfilter/subtitles.xml
#: rc.cpp:7678
#, kde-format
msgid "Subtitle file to apply"
msgstr "Fitxer de subtítols a aplicar"

#. i18n: file: data/effects/ladspa/ladspa_1185.xml
#: rc.cpp:7680
#, kde-format
msgid "Diode Processor"
msgstr "Processador de díodes"

#. i18n: file: data/effects/ladspa/ladspa_1185.xml
#: rc.cpp:7682
#, kde-format
msgid ""
"Diode Processor (LADSPA 1185)<br>\n"
"   Mangles the signal as if it had been passed through a diode rectifier "
"network. You should probably follow this with a <i>DC Offset Remover</i>, "
"unless you want the offset."
msgstr ""
"Processador de díodes (LADSPA 1185)<br>\n"
"   Comprimeix el senyal com si s'hagués passat a través d'una xarxa "
"rectificadora de díodes. Probablement això hauria de seguir amb un "
"<i>Supressor de desplaçament DC</i>, llevat que vulgueu el desplaçament."

#. i18n: file: data/effects/ladspa/ladspa_1185.xml
#: rc.cpp:7686
#, kde-format
msgid ""
"The <i>Mode</i> parameter is<br>\n"
"      continuously variable from thru to half-wave (1) rectification to full-"
"wave (2) to silence (0)"
msgstr ""
"El paràmetre <i>Mode</i> està<br>\n"
"      variant contínuament des de rectificació de mitja ona (1) a ona "
"completa (2) a silenci (0)"

