#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7910
#, kde-format
msgid "Crossover Distortion"
msgstr "Distorsió creuada («Crossover Distortion»)"

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7912
#, kde-format
msgid ""
"Crossover Distortion (LADSPA 1404)<br>\n"
"   This is a simulation of the distortion that happens in class B and AB "
"power amps when the signal crosses 0."
msgstr ""
"Distorsió creuada (LADSPA 1404)<br>\n"
"   Aquesta és una simulació de la distorsió que succeeix en els "
"amplificadors de potència de classe B i AB quan el senyal creua 0."

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7914
#, kde-format
msgid "Crossover Amplitude"
msgstr "Amplitud de l'encreuament"

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7916
#, kde-format
msgid "Controls the point at which the output signal becomes linear"
msgstr "Controla el punt en què el senyal de sortida es torna lineal"

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7920
#, kde-format
msgid "Controls degree of smoothing of the crossover point"
msgstr "Controla el grau de suavitzat del punt d'encreuament"

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7924
#, kde-format
msgid "Aliasing"
msgstr "Aliàsing"

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7926
#, kde-format
msgid ""
"Aliasing (LADSPA 1407)<br>\n"
"   Simulates aliasing using nyquist frequency modulation. Produces wacky "
"results if the blocks aren't even numbers of samples long."
msgstr ""
"Aliàsing (LADSPA 1407)<br>\n"
"   Simula l'aliàsing utilitzant la modulació de freqüència «nyquist». "
"Produeix resultats errònies si els blocs no són un nombre parell de ni tan "
"sols un nombre de mostres."

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7928
#, kde-format
msgid "Aliasing Level"
msgstr "Nivell d'aliàsing"

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7930
#, kde-format
msgid "Controls the amount of simulated aliasing in the output."
msgstr "Controla la quantitat d'aliàsing simulat a la sortida."

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7934
#, kde-format
msgid "Barry's Satan Maximiser"
msgstr "Maximitzador de Satanàs de Barry («Barry's Satan Maximiser»)"

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7936
#, kde-format
msgid ""
"Barry's Satan Maximiser (LADSPA 1408)<br>\n"
"   Compresses signals with a stupidly short attack and decay, infinite ratio "
"and hard knee. Not really as a compressor, but good harsh (non-musical) "
"distortion."
msgstr ""
"Maximitzador de Satanàs de Barry (LADSPA 1408)<br>\n"
"   Comprimeix els senyals amb un atac i un decaïment estúpidament curts, una "
"relació infinita i un amortidor dur. En realitat no com un compressor, sinó "
"una distorsió dura bona (no musical)."

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7938
#, kde-format
msgid "Decay Time (samples)"
msgstr "Temps de decaïment (mostres)"

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7940
#, kde-format
msgid "Controls the envelope decay time."
msgstr "Controla el temps de decaïment de l'envolupant."

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7942
#, kde-format
msgid "Knee Point"
msgstr "Punt d'amortiment"

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7944
#, kde-format
msgid ""
"Controls the knee roll-off point,<br>\n"
"      ie. the point above which the compression kicks in. 0 will have no "
"effect, -90 will remove virtually all dynamic range."
msgstr ""
"Controla el punt de sortida de l'amortiment,<br>\n"
"      és a dir, el punt per sobre el qual es produeix la compressió. 0 no "
"tindrà cap efecte, -90 eliminarà virtualment tot el marge dinàmic."

