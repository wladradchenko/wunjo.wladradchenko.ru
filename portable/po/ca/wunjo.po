#: src/monitor/view/MonitorGeometryScene.qml:337
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"<shortcut>Double click</shortcut> to add a keyframe, <shortcut>Shift drag</"
"shortcut> for proportional rescale, <shortcut>Ctrl drag</shortcut> for "
"center-based rescale, <shortcut>Hover right</shortcut> for toolbar, "
"<shortcut>Click</shortcut> on a center to seek to its keyframe"
msgstr ""
"Feu <shortcut>doble clic</shortcut> per a afegir un fotograma clau, "
"<shortcut>Maj + arrossegar</shortcut> per a convertir a una escala "
"proporcional, <shortcut>Ctrl + arrossegar</shortcut> per a convertir a una "
"escala basada en el centre, <shortcut>aneu a la dreta</shortcut> per a la "
"barra d'eines, feu <shortcut>clic</shortcut> sobre un centre per a cercar el "
"seu fotograma clau"

#: src/monitor/view/MonitorRotoScene.qml:63
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"<shortcut>Click</shortcut> to add points, <shortcut>Right click</shortcut> "
"to close shape."
msgstr ""
"Feu <shortcut>clic</shortcut> per a afegir punts, feu <shortcut>clic dret</"
"shortcut> per a tancar la forma."

#: src/monitor/view/MonitorRotoScene.qml:64
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"<shortcut>Double click</shortcut> on center to resize, <shortcut>Double "
"click</shortcut> on line segment to add new point, <shortcut>Double click</"
"shortcut> point to delete it, <shortcut>Double click</shortcut> background "
"to create new keyframe, <shortcut>Hover right</shortcut> for toolbar"
msgstr ""
"Feu <shortcut>doble clic</shortcut> sobre el centre per a canviar la mida, "
"feu <shortcut>doble clic</shortcut> sobre un segment de línia per a afegir "
"un punt nou, feu <shortcut>doble clic</shortcut> sobre un punt per a "
"suprimir-lo, feu <shortcut>doble clic</shortcut> sobre el fons per a crear "
"un fotograma clau nou, <shortcut>aneu a la dreta</shortcut> per a la barra "
"d'eines"

# skip-rule: k-Shift-1
#: src/monitor/view/MonitorRotoScene.qml:65
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid "<shortcut>Shift drag handle</shortcut> for center-based resize"
