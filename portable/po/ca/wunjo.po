#. i18n: file: data/effects/ladspa/ladspa_1430.xml
#: rc.cpp:8022
#, kde-format
msgid "Chebyshev Distortion"
msgstr "Distorsió de Txebixev («Chebyshev Distortion»)"

#. i18n: file: data/effects/ladspa/ladspa_1430.xml
#: rc.cpp:8024
#, kde-format
msgid ""
"Chebyshev Distortion (LADSPA 1430)<br>\n"
"   This effect is seeded from incoming signal envelope. As the level of the "
"signal rises more and more harmonics will for added to the output signal. "
"The distortion control sets the sensitivity of the input."
msgstr ""
"Distorsió de Txebixev (LADSPA 1430)<br>\n"
"   Aquest efecte se sembra a partir de l'envolupant del senyal entrant. A "
"mesura que el nivell del senyal augmenta cada vegada s'afegeixen més "
"harmònics al senyal de sortida. El control de distorsió estableix la "
"sensibilitat de l'entrada."

#. i18n: file: data/effects/ladspa/ladspa_1430.xml
#: rc.cpp:8026
#, kde-format
msgid "Distortion"
msgstr "Distorsió"

#. i18n: file: data/effects/ladspa/ladspa_1430.xml
#: rc.cpp:8028
#, kde-format
msgid "Sets the sensitivity of the input"
msgstr "Estableix la sensibilitat de l'entrada"

#. i18n: file: data/effects/ladspa/ladspa_1431.xml
#: rc.cpp:8032
#, kde-format
msgid "Bode Frequency Shifter"
msgstr "Desplaçador de freqüència Bode («Bode Frequency Shifter»)"

#. i18n: file: data/effects/ladspa/ladspa_1431.xml
#: rc.cpp:8034
#, kde-format
msgid ""
"<b>Bode Frequency Shifter</b> (LADSPA 1431)<br>\n"
"   A Bode/Moog Frequency Shifter is a popular analogue synth module that "
"works by shifting all the frequencies of an input signal up or down by a "
"specified frequency. This effect shifts in both directions at the same time "
"as it is almost no extra work and is often useful to have both directions. "
"In contrast to the analogue Bode/Moog, which use Dome filters as the core, "
"it uses a Hilbert Transformer, which is much simpler to implement in digital "
"systems."
msgstr ""
"<b>Desplaçador de freqüència Bode</b> (LADSPA 1431)<br>\n"
"   Un desplaçador de freqüència Bode/Moog és un mòdul de síntesi analògica "
"popular que funciona desplaçant totes les freqüències d'un senyal d'entrada "
"amunt o avall segons una freqüència especificada. Aquest efecte canvia en "
"ambdues direccions al mateix temps i que gairebé no és una feina extra i "
"sovint és útil per tenir ambdues direccions. En contrast amb l'analògic Bode/"
"Moog, que utilitza els filtres Dome com a nucli, utilitza un transformador "
"de Hilbert, que és molt més senzill d'implementar en sistemes digitals."

#. i18n: file: data/effects/ladspa/ladspa_1431.xml
#: rc.cpp:8036
#, kde-format
msgid "Frequency Shift"
msgstr "Desplaçament de freqüència"

#. i18n: file: data/effects/ladspa/ladspa_1431.xml
#. i18n: file: data/effects/ladspa/ladspa_1432.xml
#: rc.cpp:8038 rc.cpp:8056
#, kde-format
msgid "Controls the frequency shift applied to the input signal"
msgstr "Controla el desplaçament de la freqüència aplicada al senyal d'entrada"

#. i18n: file: data/effects/ladspa/ladspa_1432.xml
#: rc.cpp:8042
#, kde-format
msgid "Bode Frequency Shifter (CV)"
msgstr "Desplaçador de freqüència Bode (CV)"

#. i18n: file: data/effects/ladspa/ladspa_1432.xml
#: rc.cpp:8044
#, kde-format
msgid ""
"<b>Bode Frequency Shifter (CV)</b> (LADSPA 1432)<br>\n"
"   A Bode/Moog Frequency Shifter is a popular analogue synth module that "
"works by shifting all the frequencies of an input signal up or down by a "
"specified frequency. This effect shifts in both directions at the same time "
"as it is almost no extra work and is often useful to have both directions. "
"In contrast to the analogue Bode/Moog, which use Dome filters as the core, "
"it uses a Hilbert Transformer, which is much simpler to implement in digital "
"systems."
msgstr ""
"<b>Desplaçador de freqüència Bode (CV)</b> (LADSPA 1432)<br>\n"
"   Un desplaçador de freqüència Bode/Moog és un mòdul de síntesi analògica "
"popular que funciona desplaçant totes les freqüències d'un senyal d'entrada "
"amunt o avall segons una freqüència especificada. Aquest efecte canvia en "
"ambdues direccions al mateix temps i que gairebé no és una feina extra i "
"sovint és útil per tenir ambdues direccions. En contrast amb l'analògic Bode/"
"Moog, que utilitza els filtres Dome com a nucli, utilitza un transformador "
"de Hilbert, que és molt més senzill d'implementar en sistemes digitals."

#. i18n: file: data/effects/ladspa/ladspa_1432.xml
#: rc.cpp:8046
#, kde-format
msgid "Base Shift"
msgstr "Desplaçament de base"

