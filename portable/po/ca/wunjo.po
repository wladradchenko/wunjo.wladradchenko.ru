#. i18n: file: data/effects/ladspa/ladspa_1411.xml
#: rc.cpp:7988
#, kde-format
msgid "Comb Splitter"
msgstr "Divisor de pinta (Comb Splitter)"

#. i18n: file: data/effects/ladspa/ladspa_1411.xml
#: rc.cpp:7990
#, kde-format
msgid ""
"Comb Splitter (LADSPA 1411)<br>\n"
"   Divides the input up into two parts with frequency peaks at f Hz "
"intervals, skewed by f/2 Hz between the two outputs. Mixing the two outputs "
"will get you exactly the input signal."
msgstr ""
"Divisor de pinta (LADSPA 1411)<br>\n"
"   Divideix l'entrada en dues parts amb pics de freqüència a intervals de "
"«f» Hz, esbiaixats per f/2 Hz entre les dues sortides. Mesclant les dues "
"sortides obtindreu exactament el senyal d'entrada."

#. i18n: file: data/effects/ladspa/ladspa_1411.xml
#: rc.cpp:7994
#, kde-format
msgid "The distance between the frequency peaks"
msgstr "La distància entre els pics de freqüència"

