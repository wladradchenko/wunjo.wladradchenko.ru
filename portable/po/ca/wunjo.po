#. i18n: file: data/effects/ladspa/ladspa_phaser.xml
#: rc.cpp:7698 rc.cpp:7720 rc.cpp:7732 rc.cpp:7836 rc.cpp:7854 rc.cpp:8090
#: rc.cpp:8856
#, kde-format
msgid "Feedback"
msgstr "Retroalimentació"

#. i18n: file: data/effects/ladspa/ladspa_1190.xml
#: rc.cpp:7700
#, kde-format
msgid "Feedback level, increases the distinctive wooshy phaser sound."
msgstr ""
"Nivell de retroalimentació, augmenta el so de «wooshy phaser» distintiu."

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7706
#, kde-format
msgid ""
"Flanger (LADSPA 1191)<br>\n"
"   A digital flanger implementation. Uses a novel zero excursion, controlled "
"bandwidth modulation function, which should make the modulation less "
"repetitive and noticeable."
msgstr ""
"Flanger (LADSPA 1191)<br>\n"
"   Una implementació digital de «flanger». Fa servir una funció de modulació "
"d'amplada de banda controlada nova d'excursió zero, que hauria de fer la "
"modulació menys repetitiva i notòria."

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7708
#, kde-format
msgid "Delay Base"
msgstr "Base de retard"

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7710
#, kde-format
msgid ""
"This is the offset from<br>\n"
"      the input time that the detune delay moves around"
msgstr ""
"Aquest és el desplaçament des del<br>\n"
"      temps d'entrada des del qual es mou el retard de desintonització"

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7712
#, kde-format
msgid "Max Slowdown"
msgstr "Alentiment màxim"

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7714
#, kde-format
msgid ""
"This is the maximum<br>\n"
"      delay that will be applied to the delayed signal, relative to the dry "
"signal."
msgstr ""
"Aquest és el retard màxim<br>\n"
"      que s'aplicarà al senyal retardat, relatiu al senyal assecat."

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7716
#, kde-format
msgid "LFO Frequency"
msgstr "Freqüència LFO"

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7718
#, kde-format
msgid ""
"This is the core frequency<br>\n"
"      that the 'LFO' will move at. The LFO isn't actually an oscillator, but "
"it does vary periodically."
msgstr ""
"Aquesta és la freqüència central<br>\n"
"      a la qual es mourà la «LFO». Realment, la LFO no és un oscil·lador, "
"però varia periòdicament."

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7722
#, kde-format
msgid ""
"Feedback applied from the<br>\n"
"      output to the input, increases the depth of the effect, but makes it "
"sound less like a real flanger."
msgstr ""
"Retroalimentació aplicada des de la<br>\n"
"      sortida a l'entrada, augmenta la profunditat de l'efecte, però fa que "
"soni menys com un flanger real."

#. i18n: file: data/effects/ladspa/ladspa_1192.xml
#: rc.cpp:7726
#, kde-format
msgid "Fractionally Addressed Delay Line"
msgstr ""
"Línia de retard amb direcció fraccionada («Fractionally Addressed Delay "
"Line»)"

#. i18n: file: data/effects/ladspa/ladspa_1192.xml
#: rc.cpp:7728
#, kde-format
msgid ""
"Fractionally Addressed Delay Line (LADSPA 1192)<br>\n"
"   Automatically adapts to the number of channels and sampling rate of the "
"consumer."
msgstr ""
"Línia de retard amb direcció fraccionada (LADSPA 1192)<br>\n"
"   Adapta automàticament el nombre de canals i freqüència de mostreig del "
"consumidor."

#. i18n: file: data/effects/ladspa/ladspa_1195.xml
#. i18n: file: data/effects/ladspa/ladspa_declipper.xml
#: rc.cpp:7736 rc.cpp:8780
#, kde-format
msgid "Declipper"
msgstr "Eliminació de talls («Declipper»)"

#. i18n: file: data/effects/ladspa/ladspa_1195.xml
#: rc.cpp:7738
#, kde-format
msgid ""
"Declipper (LADSPA 1195)<br>\n"
"   Removes nasty clicks from input signals, not very kind to them though."
msgstr ""
"Eliminació de talls (LADSPA 1195)<br>\n"
"   Elimina els clics desagradables dels senyals d'entrada, però no és gaire "
"amable amb ells."

#. i18n: file: data/effects/ladspa/ladspa_1196.xml
#: rc.cpp:7742
#, kde-format
msgid "Fast Overdrive"
msgstr "Saturació ràpida («Fast Overdrive»)"

#. i18n: file: data/effects/ladspa/ladspa_1196.xml
#: rc.cpp:7744
#, kde-format
msgid ""
"Fast Overdrive (LADSPA 1196)<br>\n"
"   A simple overdrive. Compresses the extreme peaks to make a sound similar "
"to an overdriven amplifier."
msgstr ""
"Saturació ràpida (LADSPA 1196)<br>\n"
"   Una saturació senzilla. Comprimeix els pics extrems per a fer un so "
"similar a un amplificador amb saturació."

#. i18n: file: data/effects/ladspa/ladspa_1196.xml
#: rc.cpp:7746
#, kde-format
msgid "Drive Level"
msgstr "Nivell dinàmic"

#. i18n: file: data/effects/ladspa/ladspa_1196.xml
#: rc.cpp:7748
#, kde-format
msgid ""
"Controls the point at<br>\n"
"      which the signal starts to distort, and the degree of distortion."
msgstr ""
"Controla el punt al<br>\n"
"      qual el senyal comença a distorsionar, i el grau de distorsió."

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7752
#, kde-format
msgid "Decimator"
msgstr "Decimator"

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7754
#, kde-format
msgid ""
"Decimator (LADSPA 1202)<br>\n"
"   Decimates (reduces the effective sample rate), and reduces the bit depth "
"of the input signal, allows non integer values for smooth transitions "
"between clean and lo-fi signals."
msgstr ""
"Decimator (LADSPA 1202)<br>\n"
"   Trunca (redueix la freqüència de mostreig efectiva), i redueix la "
"profunditat de bits del senyal d'entrada, permet valors no enters per a "
"transicions suaus entre els senyals nets i baixa fidelitat."

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7756
#, kde-format
msgid "Bit Depth"
msgstr "Profunditat de bits"

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7758
#, kde-format
msgid "The bit depth that the signal will be reduced to"
msgstr "La profunditat de bits al qual es reduirà el senyal"

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7760
#, kde-format
msgid "Sample Rate"
msgstr "Freqüència de mostreig"

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7762
#, kde-format
msgid "The sample rate that the signal will be resampled at"
msgstr "La freqüència de mostreig al qual el senyal es tornarà a mostrejar"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7766
#, kde-format
msgid "Single Band Parametric"
msgstr "Paramètric de banda individual («Single Band Parametric»)"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7768
#, kde-format
msgid ""
"Single Band Parametric (LADSPA 1203)<br>\n"
"   A single band of a parametric filter."
msgstr ""
"Paramètric de banda individual (LADSPA 1203)<br>\n"
"   Una banda individual d'un filtre paramètric."

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7770
#, kde-format
msgid "Gain (dB)"
msgstr "Guany (dB)"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7772
#, kde-format
msgid "The attenuation/gain of the eq"
msgstr "L'atenuació/guany de l'equalitzador"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7774
#, kde-format
msgid "Frequency (Hz)"
msgstr "Freqüència (Hz)"

# skip-rule: tags-spaces-start
#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7776
#, kde-format
msgid ""
"The centre frequency (i.e. point of<br>\n"
"      most/least attenuation). Beware of high values for <i>Frequency</i> "
"and <i>Bandwidth</i>: if the high pitch (<i>Frequency</i> * 2^<i>Bandwidth</"
"i>) goes over half the sample rate, you will get aliasing."
msgstr ""
"La freqüència central (és a dir, el punt de<br>\n"
"      més/menys atenuació). Compte amb els valors alts de la <i>Freqüència</"
"i> i l'<i>Amplada de banda</i>: si el to alt (<i>Freqüència</i> * "
"2^<i>Amplada de banda</i>) supera la meitat de la freqüència de mostreig, "
"obtindreu aliàsing."

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7778
#, kde-format
msgid "Bandwidth (octaves)"
msgstr "Amplada de banda (octaves)"

# skip-rule: tags-spaces-start
#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7780
#, kde-format
msgid ""
"The pitch difference from the<br>\n"
"      centre before the attenuation has reached half the <i>Gain</i>."
msgstr ""
"La diferència de to des del<br>\n"
"      centre abans que l'atenuació arribi a la meitat del <i>Guany</i>."

#. i18n: file: data/effects/ladspa/ladspa_1207.xml
#: rc.cpp:7784
#, kde-format
msgid "DC Offset Remover"
msgstr "Supressor de desplaçament DC"

#. i18n: file: data/effects/ladspa/ladspa_1207.xml
#: rc.cpp:7786
#, kde-format
msgid ""
"DC Offset Remover (LADSPA 1207)<br>\n"
"   Simply removes the DC (0 Hz) component from an audio signal, uses a high "
"pass filter, so has some side effects, but they should be minimal."
msgstr ""
"Supressor de desplaçament DC (LADSPA 1207)<br>\n"
"   Simplement elimina el component DC (0 Hz) d'un senyal d'àudio, utilitza "
"un filtre passaalt, de manera que té alguns efectes secundaris, però haurien "
"de ser mínims."

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#: rc.cpp:7790
#, kde-format
msgid "Foldover Distortion"
msgstr "Foldover Distortion"

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#: rc.cpp:7792
#, kde-format
msgid ""
"Foldover Distortion (LADSPA 1213)<br>\n"
"   Uses a sine wave approximation to simulate valve style foldover "
"distortion. Probably should have a <i>DC Offset Remover</i> on the output, "
"but it's not always necessary."
msgstr ""
"Foldover Distortion (LADSPA 1213)<br>\n"
"   Utilitza una aproximació d'ona sinusoidal per simular una distorsió "
"«foldover» d'estil de vàlvula. Probablement caldria un <i>Supressor de "
"desplaçament DC</i> a la sortida, però no sempre és necessari."

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:7794 rc.cpp:8736
#, kde-format
msgid "Drive"
msgstr "Unitat"

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#: rc.cpp:7796
#, kde-format
msgid "Controls the degree of distortion"
msgstr "Controla el grau de distorsió"

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#: rc.cpp:7798
#, kde-format
msgid "Skew"
msgstr "Esbiaix"

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#: rc.cpp:7800
#, kde-format
msgid "Controls the asymmetry of the waveform"
msgstr "Control l'asimetria de la forma d'ona"

#. i18n: file: data/effects/ladspa/ladspa_1218.xml
#: rc.cpp:7804
#, kde-format
msgid "4x4 Pole Allpass"
msgstr "Passatot de pol 4x4"

#. i18n: file: data/effects/ladspa/ladspa_1218.xml
#: rc.cpp:7806
#, kde-format
msgid ""
"4x4 Pole Allpass (LADSPA 1218)<br>\n"
"   Automatically adapts to the number of channels and sampling rate of the "
"consumer."
msgstr ""
"Passatot de pol 4x4 (LADSPA 1218)<br>\n"
"   Adapta automàticament el nombre de canals i la freqüència de mostreig del "
"consumidor."

#. i18n: file: data/effects/ladspa/ladspa_1218.xml
#: rc.cpp:7808
#, kde-format
msgid "Frequency 1"
msgstr "Freqüència 1"

#. i18n: file: data/effects/ladspa/ladspa_1218.xml
#: rc.cpp:7810
#, kde-format
msgid "Feedback 1"
msgstr "Retroalimentació 1"

#. i18n: file: data/effects/ladspa/ladspa_1218.xml
#: rc.cpp:7812
#, kde-format
msgid "Frequency 2"
msgstr "Freqüència 2"

#. i18n: file: data/effects/ladspa/ladspa_1218.xml
#: rc.cpp:7814
#, kde-format
msgid "Feedback 2"
msgstr "Retroalimentació 2"

#. i18n: file: data/effects/ladspa/ladspa_1218.xml
#: rc.cpp:7816
#, kde-format
msgid "Frequency 3"
msgstr "Freqüència 3"

#. i18n: file: data/effects/ladspa/ladspa_1218.xml
#: rc.cpp:7818
#, kde-format
msgid "Feedback 3"
msgstr "Retroalimentació 3"

#. i18n: file: data/effects/ladspa/ladspa_1218.xml
#: rc.cpp:7820
#, kde-format
msgid "Frequency 4"
msgstr "Freqüència 4"

#. i18n: file: data/effects/ladspa/ladspa_1218.xml
#: rc.cpp:7822
#, kde-format
msgid "Feedback 4"
msgstr "Retroalimentació 4"

#. i18n: file: data/effects/ladspa/ladspa_1219.xml
#: rc.cpp:7826
#, kde-format
msgid "Auto Phaser"
msgstr "Auto Phaser"

#. i18n: file: data/effects/ladspa/ladspa_1219.xml
#: rc.cpp:7828
#, kde-format
