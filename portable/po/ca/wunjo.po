#. i18n: file: data/effects/ladspa/ladspa_1190.xml
#: rc.cpp:7690
#, kde-format
msgid "Comb Filter"
msgstr "Filtres de pinta («comb»)"

#. i18n: file: data/effects/ladspa/ladspa_1190.xml
#: rc.cpp:7692
#, kde-format
msgid "Comb Filter (LADSPA 1190)"
msgstr "Filtres de pinta (LADSPA 1190)"

#. i18n: file: data/effects/ladspa/ladspa_1190.xml
#. i18n: file: data/effects/ladspa/ladspa_1411.xml
#: rc.cpp:7694 rc.cpp:7992
#, kde-format
msgid "Band Separation"
msgstr "Separació de bandes"

#. i18n: file: data/effects/ladspa/ladspa_1190.xml
#: rc.cpp:7696
#, kde-format
msgid "Controls the distance between the filters peaks"
msgstr "Controla la distància entre els pics dels filtres"

#. i18n: file: data/effects/ladspa/ladspa_1190.xml
#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#. i18n: file: data/effects/ladspa/ladspa_1192.xml
#. i18n: file: data/effects/ladspa/ladspa_1219.xml
#. i18n: file: data/effects/ladspa/ladspa_1402.xml
