#: rc.cpp:1554
#, kde-format
msgid ""
"Designed to analyze and apply the normalization based on an entire audio "
"file or an entire track. Correct audio loudness as recommended by EBU R128"
msgstr ""
"Dissenyat per a analitzar i aplicar la normalització basada en un fitxer "
"d'àudio complet o una pista sencera. Corregeix la sonoritat de l'àudio tal "
"com recomana EBU R128"

#. i18n: file: data/effects/loudness.xml
#. i18n: file: data/effects/tracker.xml
