#. i18n: file: data/effects/ladspa/ladspa_2154.xml
#: rc.cpp:8658
#, kde-format
msgid "TAP Reflector"
msgstr "TAP Reflector"

#. i18n: file: data/effects/ladspa/ladspa_2154.xml
#: rc.cpp:8660
#, kde-format
msgid ""
"TAP Reflector (LADSPA 2154)<br>\n"
"    Creates a psychedelic reverse audio effect."
msgstr ""
"TAP Reflector (LADSPA 2154)<br>\n"
"    Crea un efecte d'àudio invers psicodèlic."

#. i18n: file: data/effects/ladspa/ladspa_2154.xml
#: rc.cpp:8662
#, kde-format
msgid "Fragment Length"
msgstr "Longitud dels fragments"

#. i18n: file: data/effects/ladspa/ladspa_2154.xml
#: rc.cpp:8664
#, kde-format
msgid ""
"It is best to set it to<br>\n"
"      approximately match the tempo of the track, so the Fragment Length is "
"equal to the time of one measure."
msgstr ""
"És millor definir a<br>\n"
"      aproximadament igual que el tempo de la pista, així que la longitud "
"del fragment sigui igual que el temps d'una mesura."

#. i18n: file: data/effects/ladspa/ladspa_2155.xml
#: rc.cpp:8672
#, kde-format
msgid "TAP Pink/Fractal Noise"
msgstr "Soroll rosa/fractal TAP"

#. i18n: file: data/effects/ladspa/ladspa_2155.xml
#: rc.cpp:8674
#, kde-format
msgid ""
"TAP Pink/Fractal Noise (LADSPA 2155)<br>\n"
"    Adds pink noise to the incoming signal using a one-dimensional random "
"fractal line generated by the Midpoint Displacement Method."
msgstr ""
"Soroll rosa/fractal TAP (LADSPA 2155)<br>\n"
"    Afegeix soroll rosa al senyal entrant utilitzant una línia fractal "
"aleatòria unidimensional generada pel mètode de desplaçament del punt mitjà."

#. i18n: file: data/effects/ladspa/ladspa_2155.xml
#: rc.cpp:8676
#, kde-format
msgid "Fractal Dimension"
msgstr "Dimensió fractal"

#. i18n: file: data/effects/ladspa/ladspa_2155.xml
#: rc.cpp:8678
#, kde-format
msgid "Signal Level"
msgstr "Nivell del senyal"

#. i18n: file: data/effects/ladspa/ladspa_2155.xml
#: rc.cpp:8680
#, kde-format
msgid "Noise Level"
msgstr "Nivell de soroll"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8684
#, kde-format
msgid "TAP Fractal Doubler"
msgstr "Doblador fractal TAP"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8686
#, kde-format
msgid ""
"TAP Fractal Doubler (LADSPA 2156)<br>\n"
"    Suitable for doubling tracks with vocals, acoustic/electric guitars, "
"bass and just about any other instrument on them."
msgstr ""
"Doblador fractal TAP (LADSPA 2156)<br>\n"
"    Adequat per a doblar pistes amb veus, guitarres acústiques/elèctriques, "
"baixos i qualsevol altre instrument a sobre d'ells."

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8688
#, kde-format
msgid "Time Tracking"
msgstr "Seguiment del temps"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8690 rc.cpp:8694
#, kde-format
msgid ""
"Determines how \"rough\" and how big<br>\n"
"      these changes are. When set to 0, changes are bigger and more chaotic "
"(\"bad backup singer\"). When set to 1, changes are smaller and smoother "
"(\"better tracking of the original\")."
msgstr ""
"Determina com són de «toscos» i de grans<br>\n"
"      són aquests canvis. Quan s'estableix a 0, els canvis són més grans i "
"caòtics («cantant suplent dolent»). Quan s'estableix a 1, els canvis són més "
"petits i suaus («seguiment millor de l'original»)."

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8692
#, kde-format
msgid "Pitch Tracking"
msgstr "Seguiment del to"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8698
#, kde-format
msgid "Dry Left Position"
msgstr "Posició esquerra assecada"

# skip-rule: kct-range
#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8700 rc.cpp:8704 rc.cpp:8710 rc.cpp:8714
#, kde-format
msgid ""
"These controls range between 0 and 1,<br>\n"
"      0 meaning hard left and 1 meaning hard right position."
msgstr ""
"Aquestes controls varien entre 0 i 1,<br>\n"
"      0 vol dir esquerra dura i 1 vol dur posició de dreta dura."

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8702
#, kde-format
msgid "Dry Right Position"
msgstr "Posició dreta assecada"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8708
#, kde-format
msgid "Wet Left Position"
msgstr "Posició esquerra humida"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8712
#, kde-format
msgid "Wet Right Position"
msgstr "Posició dreta humida"

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8718
#, kde-format
msgid "TAP Sigmoid Booster"
msgstr "Potenciador de sigmoides TAP"

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8720
#, kde-format
msgid ""
"TAP Sigmoid Booster (LADSPA 2157)<br>\n"
"   Applies a time-invariant nonlinear amplitude transfer function to the "
"signal."
msgstr ""
"Potenciador de sigmoides TAP (LADSPA 2157)<br>\n"
"   Aplica una funció de transferència d'amplitud no lineal invariant en el "
"temps al senyal."

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8722
#, kde-format
msgid "Pre Gain"
msgstr "Guany previ"

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8724
#, kde-format
msgid "Scales the input signal before the transfer function is applied to it."
msgstr ""
"Escala el senyal d'entrada abans d'aplicar-hi la funció de transferència."

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8726
#, kde-format
msgid "Post Gain"
msgstr "Guany posterior"

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8728
#, kde-format
msgid "Can be used to adjust the output gain of the effect."
msgstr "Es pot utilitzar per ajustar el guany de sortida de l'efecte."

#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:8732
#, kde-format
msgid "TAP TubeWarmth"
msgstr "TubeWarmth TAP"

#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:8734
#, kde-format
msgid ""
"TAP TubeWarmth (LADSPA 2158)<br>\n"
"   Adds the character of vacuum tube amplification by emulating the "
"sonically desirable nonlinear characteristics of triodes. It also supports "
"emulating analog tape saturation."
msgstr ""
"TubeWarmth TAP (LADSPA 2158)<br>\n"
"   Afegeix el caràcter de l'amplificació dels tubs de buit emulant les "
"característiques no lineals dels tríodes que són desitjables sonorament. "
"També permet emular la saturació de les cintes analògiques."

#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:8738
#, kde-format
msgid "Adjusts the amount of the effect"
msgstr "Ajusta la quantitat de l'efecte"

#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:8740
#, kde-format
msgid "Tape--Tube Blend"
msgstr "Barreja cinta-tub"

#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:8742
#, kde-format
msgid "Controls the color of the TubeWarmth sound"
msgstr "Controla el color del so de TubeWarmth"

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8746
#, kde-format
msgid "TAP Chorus/Flange"
msgstr "Chorus/Flange TAP"

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8748
#, kde-format
msgid ""
"TAP Chorus/Flange (LADSPA 2159)<br>\n"
"    Creates traditional Chorus and Flanger effects, spiced up a bit to make "
"use of stereo processing. It sounds best on guitar and synth tracks."
msgstr ""
"Chorus/Flange TAP (LADSPA 2159)<br>\n"
"    Crea els efectes tradicionals de cor i «flanger», amanits una mica per a "
"fer ús del processament estèreo. Sona millor a les pistes de guitarra i de "
"sintetitzador."

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8752
#, kde-format
msgid ""
"Determines the LFO frequency<br>\n"
"      with which the time-varying delay is modulated. The higher the "
"frequency, the more intense the effect will be."
msgstr ""
"Determina la freqüència LFO<br>\n"
"      amb la qual es modula el retard que varia amb el temps. Com més alta "
"sigui la freqüència, més intens serà l'efecte."

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8754
#, kde-format
msgid "L/R Phase Shift"
msgstr "Desplaçament de fase E/D"

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8756
#, kde-format
msgid ""
"Controls the phase shift between the two<br>\n"
"      LFOs. The higher this setting, the stronger the \"stereo-ness\" of the "
"effect will be. When set to 0, processing of the two channels will be in-"
"phase; when set to 180 degrees, the two LFO's are is counter-phase to create "
"the widest stereo effect."
msgstr ""
"Controla el desplaçament de fase entre les dues<br>\n"
"      LFO. Com més alta sigui aquesta opció, més forta serà l'estèreo de "
"l'efecte. Quan s'estableix a 0, el processament dels dos canals serà en "
"fase; quan s'estableix a 180 graus, les dues LFO són en contrafase per a "
"crear un efecte estèreo més ample."

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8760
#, kde-format
msgid ""
"Adjusts the modulation depth of the delay.<br>\n"
"      Increasing it will result in stronger modulation using the same LFO "
"frequency."
msgstr ""
"Ajusta la profunditat de modulació del retard.<br>\n"
"      L'augment d'aquest donarà com a resultat una modulació més forta "
"utilitzant la mateixa freqüència LFO."

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8764
#, kde-format
msgid ""
"Determines the fixed amount of time with<br>\n"
"      which the signal is delayed after the time-varying delay has been "
"applied. The setting of this control distinguishes between the Chorus and "
"Flanger effects. Delays smaller than 10 ms can be labeled Flanger, delays "
"above 20 ms yield Chorus, and delays in the range of 10-20 ms result in a "
"blend between Chorus and Flanger."
msgstr ""
"Determina la quantitat fixa de temps amb<br>\n"
"      que el senyal es retarda després que s'hagi aplicat un retard que "
"varia amb el temps. L'establiment d'aquest control distingeix entre els "
"efectes de cor i de «flanger». Els retards inferiors a 10 ms es poden "
"etiquetar com a «flanger», els retards per sobre de 20 ms com a cor, i els "
"retards en l'interval de 10-20 ms donen com a resultat una barreja entre cor "
"i «flanger»."

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8766
#, kde-format
msgid "Contour"
msgstr "Contorn"

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8768
#, kde-format
msgid ""
"The cutoff frequency of a high-pass<br>\n"
"      filter applied to the now twice-delayed signal."
msgstr ""
"La freqüència de tall d'un filtre passaalt<br>\n"
"      aplicat al senyal retardada ara dues vegades."

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8772 rc.cpp:8776
#, kde-format
msgid ""
"Allows for a final tuning of the sound.<br>\n"
"      The strongest effect is achieved if the two settings are about the "
"same. Decreasing one of them (preferably the Wet Level, to mitigate any "
"unwanted side effects) results in a subtler effect."
msgstr ""
"Permet un afinament final del so.<br>\n"
"      L'efecte més fort s'aconsegueix si les dues opcions són aproximadament "
"les mateixes. La disminució d'una d'elles (preferiblement el nivell humit, "
"per mitigar qualsevol efecte secundari no desitjat) resulta en un efecte més "
"subtil."

