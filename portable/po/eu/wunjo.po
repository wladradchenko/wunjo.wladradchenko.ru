#. i18n: file: data/effects/gpsgraphic.xml
#: rc.cpp:976
#, kde-format
msgid "Crop left"
msgstr "Moztu ezkerretik"

#. i18n: file: data/effects/gpsgraphic.xml
#: rc.cpp:978
#, fuzzy, kde-format
#| msgid ""
#| "<![CDATA[Crops data from the left side of the graph (effectively zooming "
#| "in). <br>\n"
#| "    \tThe value is interpreted either as a percentage of total or an "
#| "absolute value depending on crop_mode_h. In percentage mode, the values "
#| "are not restricted to 0-100 to allow for \"zoom out\" behaviour (ie: "
#| "cropping -50 left will add an extra half of the total horizontal "
#| "distance). Values over 100 (in % mode) will effectively not display "
#| "anything. If <em>Graph Type</em> is set to <b>Speedometer</b>, all crop "
#| "left/right values are ignored.]]>"
msgid ""
"Crops data from the left side of the graph (effectively zooming in). <br>\n"
"    \tThe value is interpreted either as a percentage of total or an "
"absolute value depending on crop_mode_h. In percentage mode, the values are "
"not restricted to 0-100 to allow for \"zoom out\" behaviour (ie: cropping "
"-50 left will add an extra half of the total horizontal distance). Values "
"over 100 (in % mode) will effectively not display anything. If <em>Graph "
"Type</em> is set to <b>Speedometer</b>, all crop left/right values are "
"ignored."
msgstr ""
"<![CDATA[Grafikoaren ezker aldeko datuak mozten ditu (zooma gerturatuz)."
"<br>\n"
"    \tBalioa, crop_mode_h arabera, osoaren ehuneko gisa edo balio absolutu "
"gisa interpretatzen da. Ehuneko moduan, \"Zooma urruntze\" jokabidea "
"baimentzeko, balioak ez dira 0-100 tartera mugatzen (adib: ezkerrerantz -50 "
"moztuta, distantzia horizontal osoaren erdi gehigarri bat gehituko du). "
"100etik gorako balioek (% moduan) ez dute ezer azaltzea eragingo. "
"<em>Grafiko mota</em> <b>abiadura-neurgailua</b> gisa ezarrita badago, "
"ezkerretik/eskuinetik mozteko balio guztiei ezikusi egingo zaie.]]>"

#. i18n: file: data/effects/gpsgraphic.xml
#: rc.cpp:980
#, kde-format
msgid "Crop right"
msgstr "Moztu eskuinetik"

#. i18n: file: data/effects/gpsgraphic.xml
#: rc.cpp:982
#, fuzzy, kde-format
#| msgid ""
#| "<![CDATA[Same as <em>Crop left</em> but for the right side, and "
#| "percentage type is interpreted as an inverse percentage (ie: 100 = do not "
#| "crop anything). Values under 0 will effectively not display anything.]]>"
msgid ""
"Same as <em>Crop left</em> but for the right side, and percentage type is "
"interpreted as an inverse percentage (ie: 100 = do not crop anything). "
"Values under 0 will effectively not display anything."
msgstr ""
"<![CDATA[<em>Moztu ezkerretik</em> bezala baina eskuin alderako, eta ehuneko "
"mota alderantzizko ehuneko gisa interpretatzen da (adib: 100 = ez moztu "
"ezer). 0 azpiko balioek ez dute ezer azaltzea eragingo.]]>"

#. i18n: file: data/effects/gpsgraphic.xml
#: rc.cpp:984
#, kde-format
msgid "Crop mode vertical"
msgstr "Moztuko modua bertikala"

#. i18n: file: data/effects/gpsgraphic.xml
#: rc.cpp:986
#, fuzzy, kde-format
#| msgid ""
#| "<![CDATA[Decides how to interpret the <em>Crop bottom</em> and <em>Crop "
#| "top</em> values.<br/>\n"
#| "    \tWith an absolute value, it can zoom in to between 100 and 150m of "
#| "altitude to show\n"
#| "small changes in altitude between those 2 values better.<br/>\n"
#| "Note: for the vertical type, absolute values are latitude degrees (for "
#| "the location\n"
#| "source type) and altitude, heart rate, speed for the others interpreted "
#| "as the <em>Legend unit</em>\n"
#| "type where applicable (ie: a value of 10 for altitude will be considered "
#| "meters by default\n"
#| "but if changing <em>Legend unit</em> to feet it will mean 10 feet).]]>"
msgid ""
"Decides how to interpret the <em>Crop bottom</em> and <em>Crop top</em> "
"values.<br/>\n"
"    \tWith an absolute value, it can zoom in to between 100 and 150m of "
"altitude to show\n"
"small changes in altitude between those 2 values better.<br/>\n"
"Note: for the vertical type, absolute values are latitude degrees (for the "
"location\n"
"source type) and altitude, heart rate, speed for the others interpreted as "
"the <em>Legend unit</em>\n"
"type where applicable (ie: a value of 10 for altitude will be considered "
"meters by default\n"
"but if changing <em>Legend unit</em> to feet it will mean 10 feet)."
msgstr ""
"<![CDATA[<em>Moztu behetik</em> eta <em>Moztu goitik</em> balioak nola "
"interpretatu erabakitzen du.<br/>\n"
"    \tBalio absolutu batekin, zooma garaieran 100 eta 150m artean gerturatu "
"dezake,\n"
"2 balio horien arteko garaiera aldaketa txikiak hobeto erakusteko.<br/>\n"
"Oharra: Mota bertikalerako, balio absolutuak latitude graduak (kokaleku "
"sorburu\n"
"motarako) eta garaiera dira, bihotz-maiztasuna, abiadura, besteetarako, "
"aplikagarria denean,\n"
"<em>Legendaren unitatea</em> bezala interpretatua (adib: 10 balioa "
"garaieran, era lehenetsian\n"
"metro gisa hartuko dira, baina <em>Legendaren unitatea</em> oinetara aldatuz "
"gero 10 oin adieraziko du).]]>"

#. i18n: file: data/effects/gpsgraphic.xml
