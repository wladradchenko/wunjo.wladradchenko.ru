#. i18n: file: data/effects/ladspa/ladspa_1430.xml
#: rc.cpp:7802
#, kde-format
msgid "Chebyshev Distortion"
msgstr "Distorção Chebyshev"

#. i18n: file: data/effects/ladspa/ladspa_1430.xml
#: rc.cpp:7804
#, kde-format
msgid ""
"Chebyshev Distortion (LADSPA 1430)<br>\n"
"   This effect is seeded from incoming signal envelope. As the level of the "
"signal rises more and more harmonics will for added to the output signal. "
"The distortion control sets the sensitivity of the input."
msgstr ""
"Distorção Chebyshev (LADSPA 1430)<br>\n"
"   Este efeito baseia-se no envelope do sinal de entrada. À medida que o "
"nível do sinal aumenta, mais harmônicos são adicionados ao sinal de saída. O "
"controle de distorção define a sensibilidade da entrada."

#. i18n: file: data/effects/ladspa/ladspa_1430.xml
#: rc.cpp:7806
#, kde-format
msgid "Distortion"
msgstr "Distorção"

#. i18n: file: data/effects/ladspa/ladspa_1430.xml
#: rc.cpp:7808
#, kde-format
msgid "Sets the sensitivity of the input"
msgstr "Define a sensibilidade da entrada"

#. i18n: file: data/effects/ladspa/ladspa_1431.xml
#: rc.cpp:7812
#, kde-format
msgid "Bode Frequency Shifter"
msgstr "Deslocador de frequência de Bode"

#. i18n: file: data/effects/ladspa/ladspa_1431.xml
#: rc.cpp:7814
#, kde-format
msgid ""
"<b>Bode Frequency Shifter</b> (LADSPA 1431)<br>\n"
"   A Bode/Moog Frequency Shifter is a popular analogue synth module that "
"works by shifting all the frequencies of an input signal up or down by a "
"specified frequency. This effect shifts in both directions at the same time "
"as it is almost no extra work and is often useful to have both directions. "
"In contrast to the analogue Bode/Moog, which use Dome filters as the core, "
"it uses a Hilbert Transformer, which is much simpler to implement in digital "
"systems."
msgstr ""
"<b>Deslocador de frequência de Bode</b> (LADSPA 1431)<br>\n"
"O deslocador de frequência de Bode/Moog é um módulo de sintetizador "
"analógico popular que funciona deslocando todas as frequências de um sinal "
"de entrada para cima ou para baixo em um valor de frequência especificado. "
"Esse efeito realiza o deslocamento em ambas as direções simultaneamente, "
"visto que isso praticamente não exige processamento adicional e é "
"frequentemente útil dispor de ambas as direções. Ao contrário do Bode/Moog "
"analógico, que utiliza filtros Dome como núcleo, este utiliza um "
"Transformador de Hilbert, que é muito mais simples de implementar em "
"sistemas digitais."

#. i18n: file: data/effects/ladspa/ladspa_1431.xml
#: rc.cpp:7816
#, kde-format
msgid "Frequency Shift"
msgstr "Deslocamento de frequência"

#. i18n: file: data/effects/ladspa/ladspa_1431.xml
#. i18n: file: data/effects/ladspa/ladspa_1432.xml
#: rc.cpp:7818 rc.cpp:7836
#, kde-format
msgid "Controls the frequency shift applied to the input signal"
msgstr "Controla o deslocamento de frequência aplicado ao sinal de entrada"

#. i18n: file: data/effects/ladspa/ladspa_1432.xml
#: rc.cpp:7822
#, kde-format
msgid "Bode Frequency Shifter (CV)"
msgstr "Deslocador de frequência de Bode (CV)"

#. i18n: file: data/effects/ladspa/ladspa_1432.xml
#: rc.cpp:7824
#, kde-format
msgid ""
"<b>Bode Frequency Shifter (CV)</b> (LADSPA 1432)<br>\n"
"   A Bode/Moog Frequency Shifter is a popular analogue synth module that "
"works by shifting all the frequencies of an input signal up or down by a "
"specified frequency. This effect shifts in both directions at the same time "
"as it is almost no extra work and is often useful to have both directions. "
"In contrast to the analogue Bode/Moog, which use Dome filters as the core, "
"it uses a Hilbert Transformer, which is much simpler to implement in digital "
"systems."
msgstr ""
"<b>Deslocador de frequência de Bode (CV)</b>(LADSPA 1432)<br>\n"
"O deslocador de frequência de Bode/Moog é um módulo de sintetizador "
"analógico popular que funciona deslocando todas as frequências de um sinal "
"de entrada para cima ou para baixo em um valor de frequência especificado. "
"Esse efeito realiza o deslocamento em ambas as direções simultaneamente, "
"visto que isso praticamente não exige processamento adicional e é "
"frequentemente útil dispor de ambas as direções. Ao contrário do Bode/Moog "
"analógico, que utiliza filtros Dome como núcleo, este utiliza um "
"Transformador de Hilbert, que é muito mais simples de implementar em "
"sistemas digitais."

#. i18n: file: data/effects/ladspa/ladspa_1432.xml
#: rc.cpp:7826
#, kde-format
msgid "Base Shift"
msgstr "Deslocamento da base"

#. i18n: file: data/effects/ladspa/ladspa_1432.xml
#: rc.cpp:7830
#, kde-format
msgid "Down,Both,Up"
msgstr "Abaixo,Ambos,Acima"

