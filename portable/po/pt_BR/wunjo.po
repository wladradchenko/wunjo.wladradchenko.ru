msgstr "O momento do primeiro atraso"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7646
#, kde-format
msgid "Delay Range"
msgstr "Intervalo do atraso"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7648
#, kde-format
msgid "The time difference between the first and last delay"
msgstr "A diferença de tempo entre o primeiro e o último atraso"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7650
#, kde-format
msgid "Delay Change"
msgstr "Alteração de atraso"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7652
#, kde-format
msgid "The scaling factor between one delay and the next"
msgstr "O fator de escala entre um atraso e o próximo"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7654
#, kde-format
msgid "Delay Random"
msgstr "Aleatorização do atraso"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7656
#, kde-format
msgid "The random factor applied to the delay"
msgstr "O fator aleatório aplicado ao atraso"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7658
#, kde-format
