#: src/monitor/view/MonitorGeometryScene.qml:337
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"<shortcut>Double click</shortcut> to add a keyframe, <shortcut>Shift drag</"
"shortcut> for proportional rescale, <shortcut>Ctrl drag</shortcut> for "
"center-based rescale, <shortcut>Hover right</shortcut> for toolbar, "
"<shortcut>Click</shortcut> on a center to seek to its keyframe"
msgstr ""
"<shortcut>Clique duplo</shortcut> para adicionar um quadro-chave, "
"<shortcut>arraste pressionando Shift</shortcut> para redimensionamento "
"proporcional, <shortcut>arraste pressionando Ctrl</shortcut> para "
"redimensionamento baseado no centro, <shortcut>passe o mouse à direita</"
"shortcut> para a barra de ferramentas, <shortcut>clique</shortcut> em um "
"centro para buscar o seu quadro-chave"

#: src/monitor/view/MonitorRotoScene.qml:63
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"<shortcut>Click</shortcut> to add points, <shortcut>Right click</shortcut> "
"to close shape."
msgstr ""
"<shortcut>Clique</shortcut> para adicionar pontos, <shortcut>botão direito "
"do mouse</shortcut> para fechar forma."

#: src/monitor/view/MonitorRotoScene.qml:64
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"<shortcut>Double click</shortcut> on center to resize, <shortcut>Double "
"click</shortcut> on line segment to add new point, <shortcut>Double click</"
"shortcut> point to delete it, <shortcut>Double click</shortcut> background "
"to create new keyframe, <shortcut>Hover right</shortcut> for toolbar"
msgstr ""
"<shortcut>Clique duplo</shortcut> no centro para redimensionar, "
"<shortcut>clique duplo</shortcut> no segmento de reta para adicionar um novo "
"ponto, <shortcut>clique duplo</shortcut> em um ponto para excluí-lo, "
"<shortcut>clique duplo</shortcut> no plano de fundo para criar um novo "
"quadro-chave, <shortcut>passe o mouse à direita</shortcut> para a barra de "
"ferramentas"

#: src/monitor/view/MonitorRotoScene.qml:65
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid "<shortcut>Shift drag handle</shortcut> for center-based resize"
msgstr ""
"<shortcut>Arraste o separador pressionando Shift</shortcut> para "
"redimensionamento baseado no centro"

