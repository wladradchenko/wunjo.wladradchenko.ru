msgstr "Nenhum,Instantâneo,Pico,Pico+Instantâneo"

#. i18n: file: data/effects/avfilter/avfilter_vectorscope.xml
#. i18n: file: data/effects/avfilter/avfilter_waveform.xml
#: rc.cpp:7258 rc.cpp:7364
#, kde-format
msgid "Graticule"
msgstr "Gratícula"

#. i18n: file: data/effects/avfilter/avfilter_vectorscope.xml
#: rc.cpp:7260
#, kde-format
