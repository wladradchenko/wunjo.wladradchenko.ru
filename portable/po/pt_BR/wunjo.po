msgstr "Hertz,Q-Factor,Octave,Slope,kHz"

#. i18n: file: data/effects/avfilter/avfilter_equalizer.xml
#: rc.cpp:5820
#, kde-format
msgid "Band Width"
msgstr "Largura de banda"

#. i18n: file: data/effects/avfilter/avfilter_erosion.xml
#: rc.cpp:5836
#, kde-format
msgid "Erosion"
msgstr "Erosão"

#. i18n: file: data/effects/avfilter/avfilter_erosion.xml
#: rc.cpp:5838
#, kde-format
msgid ""
"Apply erosion effect.<br>\n"
"    Simulates image erosion, an effect which will enlarge the darkest pixels "
"in the image by replacing the pixel by the local (3x3) minimum."
msgstr ""
"Aplicar efeito de erosão.<br>\n"
"    Simula a erosão da imagem, um efeito que ampliará os pixels mais escuros "
"da imagem, substituindo o pixel pelo mínimo local (3x3)."

