#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7714
#, kde-format
msgid "Barry's Satan Maximiser"
msgstr "Maximizador Satan de Barry"

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7716
#, kde-format
msgid ""
"Barry's Satan Maximiser (LADSPA 1408)<br>\n"
"   Compresses signals with a stupidly short attack and decay, infinite ratio "
"and hard knee. Not really as a compressor, but good harsh (non-musical) "
"distortion."
msgstr ""
"Maximizador Barry's Satan (LADSPA 1408)<br>\n"
"   Comprime sinais com tempos de ataque e decaimento absurdamente curtos, "
"razão infinita e 'hard knee'. Não funciona exatamente como um compressor, "
"mas gera uma distorção agressiva (e não musical) de boa qualidade."

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7718
#, kde-format
msgid "Decay Time (samples)"
msgstr "Tempo de decaimento (amostras)"

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7720
#, kde-format
msgid "Controls the envelope decay time."
msgstr "Controla o tempo de decaimento do envelope."

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7722
#, kde-format
msgid "Knee Point"
msgstr "Ponto de transição"

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7724
#, kde-format
msgid ""
"Controls the knee roll-off point,<br>\n"
"      ie. the point above which the compression kicks in. 0 will have no "
"effect, -90 will remove virtually all dynamic range."
msgstr ""
"Controla o ponto de transição ('joelho') da compressão,<br>\n"
"      ou seja, o ponto acima do qual a compressão entra em ação. O valor 0 "
"não terá efeito; -90 eliminará praticamente toda a faixa dinâmica."

