#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6936
#, kde-format
msgid "Smartblur"
msgstr "Desfoque inteligente"

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6938
#, kde-format
msgid "Blur the input video without impacting the outlines."
msgstr "Desfoca o vídeo de entrada sem afetar os contornos."

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6940
#, kde-format
msgid "Luma radius"
msgstr "Raio da luma"

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6942
#, kde-format
msgid ""
"Set the luma radius.<br>\n"
"            The value specifies the variance of the gaussian filter used to "
"blur the image (slower if larger)."
msgstr ""
"Define o raio de luminância.<br>\n"
"            O valor especifica a variância do filtro gaussiano usado para "
"desfocar a imagem (mais lento se for maior)."

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:6944 rc.cpp:7186
#, kde-format
msgid "Luma strength"
msgstr "Potência da luma"

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6946
#, kde-format
msgid ""
"Set the luma strength.<br>\n"
"            The value configures the blurring. A positive value will blur "
"the image, whereas a negative value will sharpen the image."
msgstr ""
"Define a intensidade da luminância.<br>\n"
"            O valor configura o desfoque. Um valor positivo desfocará a "
"imagem, enquanto um valor negativo a tornará mais nítida."

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6948
#, kde-format
msgid "Luma threshold"
msgstr "Limiar da luma"

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6950
#, kde-format
msgid ""
"Set the luma threshold used as a coefficient<br>\n"
"            to determine whether a pixel should be blurred or not. A value "
"of 0 will filter all the image, positive values will filter flat areas, "
"negative values will filter edges."
msgstr ""
"Define o limite de luma usado como coeficiente<br>\n"
"            para determinar se um pixel deve ser desfocado ou não. Um valor "
"de 0 filtrará toda a imagem, valores positivos filtrarão áreas planas, "
"valores negativos filtrarão bordas."

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6952
#, kde-format
msgid "Chroma radius"
msgstr "Raio do croma"

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6954
#, kde-format
msgid ""
"Set the chroma radius.<br>\n"
"            The value specifies the variance of the gaussian filter used to "
"blur the image (slower if larger). If not specified, it defaults to the "
"value set for <em>Luma radius</em>"
msgstr ""
"Define o raio de croma.<br>\n"
"            O valor especifica a variância do filtro gaussiano usado para "
"desfocar a imagem (mais lento se for maior). Se não for especificado, o "
"padrão é o valor definido para <em>Raio de Luma</em>"

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:6956 rc.cpp:7198
#, kde-format
msgid "Chroma strength"
msgstr "Potência do croma"

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6958
#, kde-format
msgid ""
"Set the chroma strength.<br>\n"
"            The value configures the blurring. A positive value will blur "
"the image, whereas a negative value will sharpen the image. If not "
"specified, it defaults to the value set for <em>Luma strength</em>."
msgstr ""
"Ajuste a intensidade do croma.<br>\n"
"            O valor configura o desfoque. Um valor positivo irá desfocar a "
"imagem, enquanto um valor negativo irá aprimorá-la. Se não for especificado, "
"o valor padrão será o definido para <em>Intensidade de Luma</em>."

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6960
#, kde-format
msgid "Chroma threshold"
msgstr "Limiar do croma"

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6962
#, kde-format
msgid ""
"Set the chroma threshold used as a coefficient<br>\n"
"            to determine whether a pixel should be blurred or not. A value "
"of 0 will filter all the image, positive values will filter flat areas, "
"negative values will filter edges. If not specified, it defaults to the "
"value set for <em>Luma threshold</em>"
msgstr ""
"Define o limite de croma usado como coeficiente<br>\n"
"            para determinar se um pixel deve ser desfocado ou não. Um valor "
"de 0 filtrará toda a imagem, valores positivos filtrarão áreas planas e "
"valores negativos filtrarão bordas. Se não for especificado, o padrão será o "
"valor definido para <em>Limite de Luma</em>"

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6964
#, kde-format
msgid "Alpha radius"
msgstr "Raio do alfa"

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6966
#, kde-format
msgid ""
"Set the alpha radius.<br>\n"
"            The value specifies the variance of the gaussian filter used to "
"blur the image (slower if larger). If not specified, it defaults to the "
"value set for <em>Luma radius</em>"
msgstr ""
"Define o raio alfa.<br>\n"
"             O valor especifica a variância do filtro gaussiano usado para "
"desfocar a imagem (mais lento se for maior). Se não for especificado, o "
"padrão é o valor definido para <em>Raio de Luma</em>"

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:6968 rc.cpp:7210
#, kde-format
msgid "Alpha strength"
msgstr "Potência do alfa"

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6970
#, kde-format
msgid ""
"Set the alpha strength.<br>\n"
"            The value configures the blurring. A positive value will blur "
"the image, whereas a negative value will sharpen the image. If not "
"specified, it defaults to the value set for <em>Luma strength</em>."
msgstr ""
"Ajuste a intensidade do alfa.<br>\n"
"            O valor configura o desfoque. Um valor positivo irá desfocar a "
"imagem, enquanto um valor negativo irá aprimorá-la. Se não for especificado, "
"o valor padrão será o definido para <em>Intensidade de Luma</em>."

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6974
#, kde-format
msgid ""
"Set the alpha threshold used as a coefficient<br>\n"
"            to determine whether a pixel should be blurred or not. A value "
"of 0 will filter all the image, positive values will filter flat areas, "
"negative values will filter edges. If not specified, it defaults to the "
"value set for <em>Luma threshold</em>"
msgstr ""
"Define o limite alfa usado como coeficiente<br>\n"
"            para determinar se um pixel deve ser desfocado ou não. Um valor "
"de 0 filtrará toda a imagem, valores positivos filtrarão áreas planas e "
"valores negativos filtrarão bordas. Se não for especificado, o padrão será o "
"valor definido para <em>Limite de Luma</em>"

