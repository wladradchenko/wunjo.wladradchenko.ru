msgstr ""
"Flanger DJ (LADSPA 1438)<br>\n"
"   Este é um efeito de 'flanger' mais ou menos típico de mesas de mixagem "
"para DJs"

#. i18n: file: data/effects/ladspa/ladspa_1438.xml
#: rc.cpp:7858
#, kde-format
msgid "LFO sync"
msgstr "Sincronizar LFO"

#. i18n: file: data/effects/ladspa/ladspa_1438.xml
#: rc.cpp:7860
#, kde-format
msgid ""
"When turned from off to on<br>\n"
"      it resets the phase of the LFO back to the start of the cycle. Used to "
"sync the LFO to the track."
msgstr ""
"Ao ser ativado (mudando de \"off\" para \"on\"),<br>\n"
"      ele redefine a fase do LFO para o início do ciclo. Utilizado para "
"sincronizar o LFO com a faixa."

#. i18n: file: data/effects/ladspa/ladspa_1438.xml
#: rc.cpp:7862
#, kde-format
