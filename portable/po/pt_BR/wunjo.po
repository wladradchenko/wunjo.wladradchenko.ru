#: rc.cpp:7480
#, kde-format
msgid "Feedback level, increases the distinctive wooshy phaser sound."
msgstr ""
"Nível de feedback; aumenta o som característico do faseador com efeito de "
"varredura ('wooshy')."

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7486
#, kde-format
msgid ""
"Flanger (LADSPA 1191)<br>\n"
"   A digital flanger implementation. Uses a novel zero excursion, controlled "
"bandwidth modulation function, which should make the modulation less "
"repetitive and noticeable."
msgstr ""
"Flanger (LADSPA 1191)<br>\n"
"   Uma implementação digital de flanger. Utiliza uma função de modulação "
"inovadora de excursão zero e largura de banda controlada, o que deve tornar "
"a modulação menos repetitiva e menos perceptível."

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7488
#, kde-format
msgid "Delay Base"
msgstr "Base de Atraso"

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7490
#, kde-format
msgid ""
"This is the offset from<br>\n"
"      the input time that the detune delay moves around"
msgstr ""
"Este é o deslocamento em relação<br>\n"
"      ao tempo de entrada em torno do qual o atraso de 'detune' oscila."

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7492
#, kde-format
msgid "Max Slowdown"
msgstr "Desaceleração máxima"

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7494
#, kde-format
msgid ""
"This is the maximum<br>\n"
"      delay that will be applied to the delayed signal, relative to the dry "
"signal."
msgstr ""
"Este é o atraso máximo<br>\n"
"      que será aplicado ao sinal atrasado, em relação ao sinal original "
"(dry)."

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7496
#, kde-format
msgid "LFO Frequency"
msgstr "Frequência LFO"

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7498
#, kde-format
msgid ""
"This is the core frequency<br>\n"
"      that the 'LFO' will move at. The LFO isn't actually an oscillator, but "
"it does vary periodically."
msgstr ""
"Esta é a frequência fundamental<br>\n"
"      na qual o 'LFO' irá operar. O LFO não é, na verdade, um oscilador, mas "
"varia periodicamente."

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7502
#, kde-format
msgid ""
"Feedback applied from the<br>\n"
"      output to the input, increases the depth of the effect, but makes it "
"sound less like a real flanger."
msgstr ""
"A aplicação de realimentação da<br>\n"
"      saída para a entrada aumenta a intensidade do efeito, mas faz com que "
"ele soe menos como um 'flanger' real."

#. i18n: file: data/effects/ladspa/ladspa_1192.xml
#: rc.cpp:7506
#, kde-format
msgid "Fractionally Addressed Delay Line"
msgstr "Linha de atraso com endereçamento fracionário"

#. i18n: file: data/effects/ladspa/ladspa_1192.xml
#: rc.cpp:7508
#, kde-format
msgid ""
"Fractionally Addressed Delay Line (LADSPA 1192)<br>\n"
"   Automatically adapts to the number of channels and sampling rate of the "
"consumer."
msgstr ""
"Linha de atraso com endereçamento fracionário (LADSPA 1192)<br>\n"
"   Adapta-se automaticamente ao número de canais e à taxa de amostragem do "
"consumidor."

#. i18n: file: data/effects/ladspa/ladspa_1195.xml
#. i18n: file: data/effects/ladspa/ladspa_declipper.xml
#: rc.cpp:7516 rc.cpp:8560
#, kde-format
msgid "Declipper"
msgstr "Remoção de clipe"

#. i18n: file: data/effects/ladspa/ladspa_1195.xml
#: rc.cpp:7518
#, kde-format
msgid ""
"Declipper (LADSPA 1195)<br>\n"
"   Removes nasty clicks from input signals, not very kind to them though."
msgstr ""
"Remoção de clipe (LADSPA 1195)<br>\n"
"   Remove estalos desagradáveis ​​dos sinais de entrada, embora não seja muito "
"gentil com eles."

#. i18n: file: data/effects/ladspa/ladspa_1196.xml
#: rc.cpp:7522
#, kde-format
msgid "Fast Overdrive"
msgstr "Ampliação rápida"

#. i18n: file: data/effects/ladspa/ladspa_1196.xml
#: rc.cpp:7524
#, kde-format
msgid ""
"Fast Overdrive (LADSPA 1196)<br>\n"
"   A simple overdrive. Compresses the extreme peaks to make a sound similar "
"to an overdriven amplifier."
msgstr ""
"Ampliação rápida (LADSPA 1196)<br>\n"
"   Uma ampliação simples. Comprime os picos extremos para produzir um som "
"semelhante ao de um amplificador saturado."

#. i18n: file: data/effects/ladspa/ladspa_1196.xml
#: rc.cpp:7526
#, kde-format
msgid "Drive Level"
msgstr "Nível de drive"

#. i18n: file: data/effects/ladspa/ladspa_1196.xml
#: rc.cpp:7528
#, kde-format
msgid ""
"Controls the point at<br>\n"
"      which the signal starts to distort, and the degree of distortion."
msgstr ""
"Controla o ponto em que<br>\n"
"      o sinal começa a distorcer, e o grau de distorção."

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7532
#, kde-format
msgid "Decimator"
msgstr "Decimator"

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7534
#, kde-format
msgid ""
"Decimator (LADSPA 1202)<br>\n"
"   Decimates (reduces the effective sample rate), and reduces the bit depth "
"of the input signal, allows non integer values for smooth transitions "
"between clean and lo-fi signals."
msgstr ""
"Decimator (LADSPA 1202)<br>\n"
"   Realiza a decimação (reduz a taxa de amostragem efetiva) e reduz a "
"profundidade de bits do sinal de entrada; permite valores não inteiros para "
"transições suaves entre sinais limpos e 'lo-fi'."

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7536
#, kde-format
msgid "Bit Depth"
msgstr "Profundidade de bits"

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7538
#, kde-format
msgid "The bit depth that the signal will be reduced to"
msgstr "A profundidade de bits à qual o sinal será reduzido"

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7540
#, kde-format
msgid "Sample Rate"
msgstr "Taxa de amostragem"

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7542
#, kde-format
msgid "The sample rate that the signal will be resampled at"
msgstr "A taxa de amostragem na qual o sinal será reamostrado"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7546
#, kde-format
msgid "Single Band Parametric"
msgstr "Paramétrico de banda única"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7548
#, kde-format
msgid ""
"Single Band Parametric (LADSPA 1203)<br>\n"
"   A single band of a parametric filter."
msgstr ""
"Paramétrico de banda única (LADSPA 1203)<br>\n"
"   Uma única banda de um filtro paramétrico."

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7550
#, kde-format
msgid "Gain (dB)"
msgstr "Ganho (dB)"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7552
#, kde-format
msgid "The attenuation/gain of the eq"
msgstr "A atenuação/ganho do eq"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7554
#, kde-format
msgid "Frequency (Hz)"
msgstr "Frequência (Hz)"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7556
#, kde-format
msgid ""
"The centre frequency (i.e. point of<br>\n"
"      most/least attenuation). Beware of high values for <i>Frequency</i> "
"and <i>Bandwidth</i>: if the high pitch (<i>Frequency</i> * 2^<i>Bandwidth</"
"i>) goes over half the sample rate, you will get aliasing."
msgstr ""
"A frequência central (ou seja, ponto de<br>\n"
"       maior/menos atenuação). Cuidado com valores altos para <i>Frequência</"
"i> e <i>Largura de banda</i>: se o tom alto (<i>Frequência</i> * "
"2^<i>Largura de banda</i>) ultrapassar a metade da taxa de amostragem, você "
"obterá alias."

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7558
#, kde-format
msgid "Bandwidth (octaves)"
msgstr "Largura de banda (oitavas)"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7560
#, kde-format
msgid ""
"The pitch difference from the<br>\n"
"      centre before the attenuation has reached half the <i>Gain</i>."
msgstr ""
"A diferença de tom em relação ao<br>\n"
"      centro antes que a atenuação atinja metade do <i>Ganho</i>."

#. i18n: file: data/effects/ladspa/ladspa_1207.xml
#: rc.cpp:7564
#, kde-format
msgid "DC Offset Remover"
msgstr "Removedor de deslocamento CC"

#. i18n: file: data/effects/ladspa/ladspa_1207.xml
#: rc.cpp:7566
#, kde-format
msgid ""
"DC Offset Remover (LADSPA 1207)<br>\n"
"   Simply removes the DC (0 Hz) component from an audio signal, uses a high "
"pass filter, so has some side effects, but they should be minimal."
msgstr ""
"Removedor de deslocamento CC (LADSPA 1207)<br>\n"
"   Remove simplesmente a componente CC (0 Hz) de um sinal de áudio; utiliza "
"um filtro passa-alta, portanto apresenta alguns efeitos colaterais, mas "
"estes devem ser mínimos."

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#: rc.cpp:7570
#, kde-format
msgid "Foldover Distortion"
msgstr "Distorção de dobra"

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#: rc.cpp:7572
#, kde-format
msgid ""
"Foldover Distortion (LADSPA 1213)<br>\n"
"   Uses a sine wave approximation to simulate valve style foldover "
"distortion. Probably should have a <i>DC Offset Remover</i> on the output, "
"but it's not always necessary."
msgstr ""
"Distorção de dobra (LADSPA 1213)<br>\n"
"   Utiliza uma aproximação de onda senoidal para simular a distorção de "
"dobra ('foldover') característica de válvulas. Provavelmente deveria incluir "
"um <i>Removedor de deslocamento CC</i> na saída, mas isso nem sempre é "
"necessário."

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:7574 rc.cpp:8516
#, kde-format
msgid "Drive"
msgstr "Drive"

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#: rc.cpp:7576
#, kde-format
msgid "Controls the degree of distortion"
msgstr "Controla o grau de distorção"

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#: rc.cpp:7578
#, kde-format
msgid "Skew"
msgstr "Inclinar"

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#: rc.cpp:7580
#, kde-format
msgid "Controls the asymmetry of the waveform"
msgstr "Controla a assimetria da forma de onda"

