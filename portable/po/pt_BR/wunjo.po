#. i18n: file: data/effects/ladspa/ladspa_1185.xml
#: rc.cpp:7460
#, kde-format
msgid "Diode Processor"
msgstr "Processador de diodo"

#. i18n: file: data/effects/ladspa/ladspa_1185.xml
#: rc.cpp:7462
#, kde-format
msgid ""
"Diode Processor (LADSPA 1185)<br>\n"
"   Mangles the signal as if it had been passed through a diode rectifier "
"network. You should probably follow this with a <i>DC Offset Remover</i>, "
"unless you want the offset."
msgstr ""
"Processador de Diodo (LADSPA 1185)<br>\n"
"Distorce o sinal como se ele tivesse passado por uma rede retificadora de "
"diodos. Provavelmente, você deve aplicar um <i>Removedor de Offset DC</i> em "
"seguida, a menos que deseje manter o offset."

#. i18n: file: data/effects/ladspa/ladspa_1185.xml
#: rc.cpp:7466
#, kde-format
msgid ""
"The <i>Mode</i> parameter is<br>\n"
"      continuously variable from thru to half-wave (1) rectification to full-"
"wave (2) to silence (0)"
msgstr ""
"O parâmetro <i>Mode</i> é<br>\n"
"      continuamente variável, indo da retificação de meia-onda (1) para a de "
"onda completa (2) e até o silêncio (0)"

