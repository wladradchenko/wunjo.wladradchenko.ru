#. i18n: file: data/effects/ladspa/ladspa_1411.xml
#: rc.cpp:7768
#, kde-format
msgid "Comb Splitter"
msgstr "Divisor combinado"

#. i18n: file: data/effects/ladspa/ladspa_1411.xml
#: rc.cpp:7770
#, kde-format
msgid ""
"Comb Splitter (LADSPA 1411)<br>\n"
"   Divides the input up into two parts with frequency peaks at f Hz "
"intervals, skewed by f/2 Hz between the two outputs. Mixing the two outputs "
"will get you exactly the input signal."
msgstr ""
"Divisor combinado (LADSPA 1411)<br>\n"
"   Divide o sinal de entrada em duas partes com picos de frequência em "
"intervalos de f Hz, defasados ​​em f/2 Hz entre as duas saídas. A combinação "
"das duas saídas resulta exatamente no sinal de entrada original."

#. i18n: file: data/effects/ladspa/ladspa_1411.xml
#: rc.cpp:7774
#, kde-format
msgid "The distance between the frequency peaks"
msgstr "A distância entre os picos de frequência"

