#: rc.cpp:5862
#, kde-format
msgid "Adjust exposure of the video stream."
msgstr "Ajusta a exposição de transmissão do vídeo."

#. i18n: file: data/effects/avfilter/avfilter_extrastereo.xml
#: rc.cpp:5868
#, kde-format
msgid "Extrastereo"
msgstr "Extra-estéreo"

#. i18n: file: data/effects/avfilter/avfilter_extrastereo.xml
#: rc.cpp:5870
#, kde-format
msgid ""
"Linearly increases the difference between left and right channels which adds "
"some sort of \"live\" effect to playback."
msgstr ""
"Aumenta linearmente a diferença entre os canais esquerdo e direito, o que "
"adiciona algum tipo de efeito \"ao vivo\" à reprodução."

#. i18n: file: data/effects/avfilter/avfilter_extrastereo.xml
#: rc.cpp:5874
#, kde-format
msgid ""
"Sets the difference coefficient (default: 2.5).\n"
"0.0 means mono sound (average of both channels),\n"
"with 1.0 sound will be unchanged, with -1.0 left and right channels will be "
"swapped."
msgstr ""
"Define o coeficiente de diferença (padrão: 2,5).\n"
"0,0 significa som mono (média de ambos os canais),\n"
"com 1,0 o som permanecerá inalterado, com -1,0 os canais esquerdo e direito "
"serão trocados."

#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:5878
#, kde-format
