#. i18n: file: data/effects/avfilter/avfilter_compensationdelay.xml
#: rc.cpp:5406
#, kde-format
msgid "Dry amount"
msgstr "Quantidade seca"

#. i18n: file: data/effects/avfilter/avfilter_compensationdelay.xml
#: rc.cpp:5408
#, kde-format
