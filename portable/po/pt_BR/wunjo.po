msgstr "Alteração de amplitude"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7660
#, kde-format
msgid "The scaling factor between one amplitude and the next"
msgstr "O fator de escala entre uma amplitude e a seguinte"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7662
#, kde-format
msgid "Amplitude Random"
msgstr "Aleatorização da amplitude"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7664
#, kde-format
msgid "The random factor applied to the amplitude"
msgstr "O fator aleatório aplicado à amplitude"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7666
#, kde-format
msgid "Dry/Wet Mix"
msgstr "Mistura de Seco/Molhado"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7668
#, kde-format
msgid "The level of delayed sound mixed into the output"
msgstr "O nível de som atrasado misturado à saída"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#: rc.cpp:7672
#, kde-format
msgid "Dyson Compressor"
msgstr "Compressor Dyson"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#: rc.cpp:7674
#, kde-format
msgid "Dyson Compressor (LADSPA 1403)"
msgstr "Compressor Dyson (LADSPA 1403)"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#: rc.cpp:7676
#, kde-format
msgid "Peak Limit"
msgstr "Limite de pico"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#: rc.cpp:7678
#, kde-format
msgid ""
"Controls the desired limit<br>\n"
"      of the output signal"
msgstr ""
"Controla o limite desejado<br>\n"
"      do sinal de saída"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#. i18n: file: data/effects/ladspa/ladspa_1913.xml
#: rc.cpp:7680 rc.cpp:8138
#, kde-format
msgid "Release Time"
msgstr "Tempo de lançamento"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#: rc.cpp:7682
#, kde-format
msgid ""
"Controls the time taken for<br>\n"
"      the compressor to relax its gain control over the input signal"
msgstr ""
"Controla o tempo que o compressor leva para<br>\n"
"      relaxar o controle de ganho sobre o sinal de entrada"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#: rc.cpp:7684
#, kde-format
msgid "Fast Compression Ratio"
msgstr "Taxa de compactação rápida"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#: rc.cpp:7686
#, kde-format
msgid "Compression Ratio"
msgstr "Taxa de compactação"

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7690
#, kde-format
msgid "Crossover Distortion"
msgstr "Distorção de cruzamento"

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7692
#, kde-format
msgid ""
"Crossover Distortion (LADSPA 1404)<br>\n"
"   This is a simulation of the distortion that happens in class B and AB "
"power amps when the signal crosses 0."
msgstr ""
"Distorção de cruzamento (LADSPA 1404)<br>\n"
"   Esta é uma simulação da distorção que ocorre em amplificadores de "
"potência classe B e AB quando o sinal cruza o 0."

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7694
#, kde-format
msgid "Crossover Amplitude"
msgstr "Amplitude da cruzamento"

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7696
#, kde-format
msgid "Controls the point at which the output signal becomes linear"
msgstr "Controla o ponto em que o sinal de saída se torna linear"

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7700
#, kde-format
msgid "Controls degree of smoothing of the crossover point"
msgstr "Controla o grau de suavização do ponto de cruzamento"

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7704
#, kde-format
msgid "Aliasing"
msgstr "Suavização"

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7706
#, kde-format
msgid ""
"Aliasing (LADSPA 1407)<br>\n"
"   Simulates aliasing using nyquist frequency modulation. Produces wacky "
"results if the blocks aren't even numbers of samples long."
msgstr ""
"Suavização (LADSPA 1407)<br>\n"
"   Simula suavização usando modulação de frequência de Nyquist. Produz "
"resultados inusitados se os blocos não tiverem um número par de amostras."

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7708
#, kde-format
msgid "Aliasing Level"
msgstr "Nível de suavização"

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7710
