#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8212
#, kde-format
msgid "TAP Stereo Echo"
msgstr "Eco estéreo TAP"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8214
#, kde-format
msgid ""
"TAP Stereo Echo (LADSPA 2143)<br>\n"
"   Supports conventional mono and stereo delays, ping-pong delays and the "
"Haas effect (also known as Cross Delay Stereo)."
msgstr ""
"Eco estéreo TAP (LADSPA 2143)<br>\n"
"   Suporta atrasos mono e estéreo convencionais, delays ping-pong e o efeito "
"Haas (também conhecido como atraso estéreo cruzado)."

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8216
#, kde-format
msgid "Cross Mode"
msgstr "Modo cruzado"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8218
#, kde-format
msgid "Haas Effect"
msgstr "Efeito Haas"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8220
#, kde-format
msgid "Swap Outputs"
msgstr "Trocar saídas"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8222
#, kde-format
msgid "L Delay"
msgstr "Atraso E"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8224
#, kde-format
msgid "L Feedback"
msgstr "Feedback E"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8226
#, kde-format
msgid "R/Haas Delay"
msgstr "Atraso D/Haas"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8228
#, kde-format
msgid "R/Haas Feedback"
msgstr "Feedback D/Haas"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8230
#, kde-format
msgid "L Echo Level"
msgstr "Nível de eco E"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8232
#, kde-format
msgid "R Echo Level"
msgstr "Nível de eco D"

#. i18n: file: data/effects/ladspa/ladspa_2144.xml
#: rc.cpp:8238
#, kde-format
msgid "TAP Tremolo"
msgstr "Trêmulo TAP"

#. i18n: file: data/effects/ladspa/ladspa_2144.xml
#: rc.cpp:8240
#, kde-format
msgid ""
"TAP Tremolo (LADSPA 2144)<br>\n"
"   Sounds good mainly on acoustic or electric guitar tracks."
msgstr ""
"Trêmulo TAP (LADSPA 2144)<br>\n"
"   Soa bem principalmente em faixas de guitarra acústica ou elétrica."

#. i18n: file: data/effects/ladspa/ladspa_2145.xml
#: rc.cpp:8250
#, kde-format
msgid "TAP Scaling Limiter"
msgstr "Limitador de escala TAP"

#. i18n: file: data/effects/ladspa/ladspa_2145.xml
#: rc.cpp:8252
#, kde-format
msgid ""
"TAP Scaling Limiter (LADSPA 2145)<br>\n"
"   Achieves signal level limiting without audible artifacts."
msgstr ""
"Limitador de escala TAP (LADSPA 2145)<br>\n"
"   Consegue limitar o nível do sinal sem artefatos audíveis."

#. i18n: file: data/effects/ladspa/ladspa_2145.xml
#: rc.cpp:8254
#, kde-format
msgid "Limit Level"
msgstr "Nível limite"

#. i18n: file: data/effects/ladspa/ladspa_2145.xml
#: rc.cpp:8256
#, kde-format
msgid "Output Volume"
msgstr "Volume de saída"

#. i18n: file: data/effects/ladspa/ladspa_2146.xml
#: rc.cpp:8260
#, kde-format
msgid "TAP AutoPanner"
msgstr "AutoPanner TAP"

#. i18n: file: data/effects/ladspa/ladspa_2146.xml
#: rc.cpp:8262
#, kde-format
msgid ""
"TAP AutoPanner (LADSPA 2146)<br>\n"
"   Main use is to liven up synth tracks in the mix"
msgstr ""
"AutoPanner TAP (LADSPA 2146)<br>\n"
"   O principal uso é para dar mais vida às faixas de sintetizador na mixagem"

#. i18n: file: data/effects/ladspa/ladspa_2146.xml
#: rc.cpp:8268
#, kde-format
msgid ""
"Sets the wideness of panning.<br>\n"
"      A setting of 100% means that mono input signal is panned between the "
"extreme left and right positions"
msgstr ""
"Define a amplitude do panorama.<br>\n"
"      Uma configuração de 100% significa que o sinal de entrada mono é "
"panoramizado entre as posições extremas esquerda e direita"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8274
#, kde-format
msgid "TAP DeEsser"
msgstr "De-Esser TAP"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8276
#, kde-format
msgid ""
"TAP DeEsser (LADSPA 2147)<br>\n"
"   Used for attenuating higher pitched frequencies in vocals such as those "
"found in 'ess', 'shh' and 'chh' sounds."
msgstr ""
"De-Esser TAP (LADSPA 2147)<br>\n"
"   Usado para atenuar frequências mais altas em vocais, como aquelas "
"encontradas em sons como 'ess', 'shh' e 'chh'."

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8278
#, kde-format
msgid "Threshold Level"
msgstr "Nível limite"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8282
#, kde-format
msgid "Sidechain Filter"
msgstr "Filtro de cadeia lateral"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8284
#, kde-format
msgid ""
"The chosen filter's frequency<br>\n"
"      is set by the <b>Frequency</b> parameter"
msgstr ""
"A frequência do filtro escolhido<br>\n"
"      é definida pelo parâmetro <b>Frequência</b>"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8286
#, kde-format
msgid "Highpass,Bandpass"
msgstr "Passa-alta,Passa-banda"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8288
#, kde-format
msgid "Monitor On"
msgstr "Monitor ligado"

#. i18n: file: data/effects/ladspa/ladspa_2148.xml
#: rc.cpp:8292
#, kde-format
msgid "TAP Vibrato"
msgstr "Vibrato TAP"

#. i18n: file: data/effects/ladspa/ladspa_2148.xml
#: rc.cpp:8294
#, kde-format
msgid ""
"TAP Vibrato (LADSPA 2148)<br>\n"
"   Modulates the pitch of its input signal with a low-frequency sinusoidal "
"signal. It is useful for guitar and synth tracks, and it can also come handy "
"if a strange effect is needed."
msgstr ""
"Vibrato TAP (LADSPA 2148)<br>\n"
"   Modula a altura do sinal de entrada com um sinal sinusoidal de baixa "
"frequência. É útil para faixas de guitarra e sintetizador, e também pode ser "
"útil se for necessário um efeito inusitado."

#. i18n: file: data/effects/ladspa/ladspa_2148.xml
#: rc.cpp:8298
#, kde-format
msgid "Determines how fast the pitch is modulated up-down"
msgstr "Determina a velocidade com que o tom é modulado para cima e para baixo"

#. i18n: file: data/effects/ladspa/ladspa_2148.xml
#: rc.cpp:8302
#, kde-format
msgid "Sets the amount of pitch modulation"
msgstr "Define a quantidade de modulação de tom"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8310
#, kde-format
msgid "TAP Rotary Speaker"
msgstr "Alto-falante rotativo TAP"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8312
#, kde-format
msgid ""
"TAP Rotary Speaker (LADSPA 2149)<br>\n"
"   Simulates the sound of rotating speakers."
msgstr ""
"Alto-falante rotativo TAP (LADSPA 2149)<br>\n"
"   Simula o som de alto-falantes rotativos."

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8314
#, kde-format
msgid "Rotor Frequency"
msgstr "Frequência de rotação"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8316
#, kde-format
msgid "Horn Frequency"
msgstr "Frequência da buzina"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8318
#, kde-format
msgid "Mic Distance"
msgstr "Distância de gravação"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8320
#, kde-format
msgid "Rotor/Horn Mix"
msgstr "Mistura de rotação/buzina"

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8324
#, kde-format
msgid "TAP Pitch Shifter"
msgstr "Desvio de tom TAP"

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8326
#, kde-format
msgid ""
"TAP Pitch Shifter (LADSPA 2150)<br>\n"
"   Change the pitch in the range of plus/minus one octave."
msgstr ""
"Desvio de tom TAP (LADSPA 2150)<br>\n"
"   Altera a afinação em uma faixa de mais ou menos uma oitava."

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8328
#, kde-format
msgid "Semitone Shift"
msgstr "Desvio de semi-tom"

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8330
#, kde-format
msgid ""
"Does the same thing as <b>Rate Shift</b></br>\n"
"      but allows to set musically sensible pitch shift rates."
msgstr ""
"Faz o mesmo que <b>Desvio de afinação</b></br>\n"
"      mas permite definir taxas de transposição de afinação musicalmente "
"adequadas."

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8332
#, kde-format
msgid "Rate Shift"
msgstr "Desvio de afinação"

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8334
#, kde-format
msgid ""
"Does the same thing as <b>Semitone Shift</b><br>\n"
"      but in percentage of the original pitch, so that is closer to a "
"\"physical\", non-musical approach"
msgstr ""
"Faz a mesma coisa que <b>Desvio de semi-tom</b><br>\n"
"      mas em porcentagem da altura original, o que é mais próximo de uma "
"abordagem \"física\", não musical"

#. i18n: file: data/effects/ladspa/ladspa_2151.xml
#: rc.cpp:8342
#, kde-format
msgid "TAP Equalizer/BW"
msgstr "Equalizador/BW TAP"

#. i18n: file: data/effects/ladspa/ladspa_2151.xml
#: rc.cpp:8344
#, kde-format
msgid ""
"TAP Equalizer (LADSPA (2151)<br>\n"
"    8-band equalizer with adjustable band center frequencies and bandwidth."
msgstr ""
"Equalizador TAP (LADSPA (2151)<br>\n"
"    Equalizador de 8 bandas com frequências centrais de banda e largura de "
"banda ajustáveis."

#. i18n: file: data/effects/ladspa/ladspa_2151.xml
#: rc.cpp:8350 rc.cpp:8356 rc.cpp:8362 rc.cpp:8368 rc.cpp:8374 rc.cpp:8380
#: rc.cpp:8386 rc.cpp:8392
#, kde-format
msgid "BW"
msgstr "BW"

#. i18n: file: data/effects/ladspa/ladspa_2151.xml
#: rc.cpp:8360
#, kde-format
msgid "<Gain"
msgstr "<Ganho"

#. i18n: file: data/effects/ladspa/ladspa_2152.xml
#: rc.cpp:8396
#, kde-format
msgid "TAP Dynamics (M)"
msgstr "Dinâmica TAP (M)"

#. i18n: file: data/effects/ladspa/ladspa_2152.xml
#: rc.cpp:8398
#, kde-format
msgid ""
"TAP Dynamics Mono (LADSPA 2152)<br>\n"
"   Allows changing the dynamic content of the audio stream"
msgstr ""
"Dinâmica TAP Mono (LADSPA 2152)<br>\n"
"   Permite alterar o conteúdo dinâmico do fluxo de áudio"

#. i18n: file: data/effects/ladspa/ladspa_2152.xml
#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8404 rc.cpp:8422
#, kde-format
msgid "Offset Gain"
msgstr "Deslocamento de ganho"

#. i18n: file: data/effects/ladspa/ladspa_2152.xml
#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8406 rc.cpp:8424
#, kde-format
msgid "Makeup Gain"
msgstr "Aumentar ganho"

#. i18n: file: data/effects/ladspa/ladspa_2152.xml
#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8408 rc.cpp:8432
#, kde-format
msgid "Dynamics Transfer Function"
msgstr "Função de transferência de dinâmica"

#. i18n: file: data/effects/ladspa/ladspa_2152.xml
#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8410 rc.cpp:8434
#, kde-format
msgid ""
"2:1 comp at -6dB,2:1 comp at -9dB,2:1 comp at -12dB,2:1 comp at -18dB,2.5 "
"comp at -18dB,3:1 comp at -12dB,3:1 comp at -15dB,Compressor/Gate,Expander,"
"Hard limiter at -6dB;Hard limiter at -12dB;Hard gate at -35dB;Soft limiter;"
"Soft knee comp/gate;Softgate below -36dB"
msgstr ""
"2:1 comp at -6dB,2:1 comp at -9dB,2:1 comp at -12dB,2:1 comp at -18dB,2.5 "
"comp at -18dB,3:1 comp at -12dB,3:1 comp at -15dB,Compressor/Gate,Expander,"
"Hard limiter at -6dB;Hard limiter at -12dB;Hard gate at -35dB;Soft limiter;"
"Soft knee comp/gate;Softgate below -36dB"

#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8414
#, kde-format
msgid "TAP Dynamics (St)"
msgstr "Dinâmica TAP (St)"

#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8416
#, kde-format
msgid ""
"TAP Dynamics Stereo (LADSPA 2153)<br>\n"
"   Allows changing the dynamic content of the audio stream"
msgstr ""
"Dinâmica TAP Estéreo (LADSPA 2153)<br>\n"
"   Permite alterar o conteúdo dinâmico do fluxo de áudio"

#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8428
#, kde-format
msgid ""
"Controls how the envelope levels<br>\n"
"      are used to determine the needed gain adjustment"
msgstr ""
"Controla como os níveis de envelope<br>\n"
"      são usados ​​para determinar o ajuste de ganho necessário"

#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8430
#, kde-format
msgid "Independent,Average,Peak"
msgstr "Independência,Média,Pico"

#. i18n: file: data/effects/ladspa/ladspa_2154.xml
#: rc.cpp:8438
#, kde-format
msgid "TAP Reflector"
msgstr "Refletor TAP"

#. i18n: file: data/effects/ladspa/ladspa_2154.xml
#: rc.cpp:8440
#, kde-format
msgid ""
"TAP Reflector (LADSPA 2154)<br>\n"
"    Creates a psychedelic reverse audio effect."
msgstr ""
"Refletor TAP (LADSPA 2154)<br>\n"
"    Cria um efeito de áudio reverso psicodélico."

#. i18n: file: data/effects/ladspa/ladspa_2154.xml
#: rc.cpp:8442
#, kde-format
msgid "Fragment Length"
msgstr "Comprimento do fragmento"

#. i18n: file: data/effects/ladspa/ladspa_2154.xml
#: rc.cpp:8444
#, kde-format
msgid ""
"It is best to set it to<br>\n"
"      approximately match the tempo of the track, so the Fragment Length is "
"equal to the time of one measure."
msgstr ""
"O ideal é definir para<br>\n"
"      corresponder aproximadamente ao andamento da faixa, de modo que o "
"comprimento do fragmento seja igual ao tempo de um compasso."

#. i18n: file: data/effects/ladspa/ladspa_2155.xml
#: rc.cpp:8452
#, kde-format
msgid "TAP Pink/Fractal Noise"
msgstr "Ruído rosa/fractal TAP"

#. i18n: file: data/effects/ladspa/ladspa_2155.xml
#: rc.cpp:8454
#, kde-format
msgid ""
"TAP Pink/Fractal Noise (LADSPA 2155)<br>\n"
"    Adds pink noise to the incoming signal using a one-dimensional random "
"fractal line generated by the Midpoint Displacement Method."
msgstr ""
"Ruído rosa/fractal TAP (LADSPA 2155)<br>\n"
"    Adiciona ruído rosa ao sinal de entrada usando uma linha fractal "
"aleatória unidimensional gerada pelo método de deslocamento do ponto médio."

#. i18n: file: data/effects/ladspa/ladspa_2155.xml
#: rc.cpp:8456
#, kde-format
msgid "Fractal Dimension"
msgstr "Dimensão fractal"

#. i18n: file: data/effects/ladspa/ladspa_2155.xml
#: rc.cpp:8458
#, kde-format
msgid "Signal Level"
msgstr "Nível de sinal"

#. i18n: file: data/effects/ladspa/ladspa_2155.xml
#: rc.cpp:8460
#, kde-format
msgid "Noise Level"
msgstr "Nível de ruído"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8464
#, kde-format
msgid "TAP Fractal Doubler"
msgstr "Duplicador fractal TAP"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8466
#, kde-format
msgid ""
"TAP Fractal Doubler (LADSPA 2156)<br>\n"
"    Suitable for doubling tracks with vocals, acoustic/electric guitars, "
"bass and just about any other instrument on them."
msgstr ""
"Duplicador fractal TAP (LADSPA 2156)<br>\n"
"    Adequado para duplicar faixas com vocais, guitarras acústicas/elétricas, "
"baixo e praticamente qualquer outro instrumento."

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8468
#, kde-format
msgid "Time Tracking"
msgstr "Rastreamento de tempo"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8470 rc.cpp:8474
#, kde-format
msgid ""
"Determines how \"rough\" and how big<br>\n"
"      these changes are. When set to 0, changes are bigger and more chaotic "
"(\"bad backup singer\"). When set to 1, changes are smaller and smoother "
"(\"better tracking of the original\")."
msgstr ""
"Determina o quão \"bruscas\" e o quão grandes<br>\n"
"      essas alterações são. Quando definido como 0, as alterações são "
"maiores e mais caóticas (\"cantor de apoio ruim\"). Quando definido como 1, "
"as alterações são menores e mais suaves (\"melhor acompanhamento do "
"original\")."

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8472
#, kde-format
msgid "Pitch Tracking"
msgstr "Rastreamento de tom"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8478
#, kde-format
msgid "Dry Left Position"
msgstr "Posição esquerda seca"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8480 rc.cpp:8484 rc.cpp:8490 rc.cpp:8494
#, kde-format
msgid ""
"These controls range between 0 and 1,<br>\n"
"      0 meaning hard left and 1 meaning hard right position."
msgstr ""
"Esses controles variam entre 0 e 1,<br>\n"
"      0 significa posição totalmente à esquerda e 1 significa posição "
"totalmente à direita."

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8482
#, kde-format
msgid "Dry Right Position"
msgstr "Posição direita seca"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8488
#, kde-format
msgid "Wet Left Position"
msgstr "Posição esquerda molhada"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8492
#, kde-format
msgid "Wet Right Position"
msgstr "Posição direita molhada"

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8498
#, kde-format
msgid "TAP Sigmoid Booster"
msgstr "Reforço sigmóide TAP"

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8500
#, kde-format
msgid ""
"TAP Sigmoid Booster (LADSPA 2157)<br>\n"
"   Applies a time-invariant nonlinear amplitude transfer function to the "
"signal."
msgstr ""
"Reforço sigmóide TAP (LADSPA 2157)<br>\n"
"   Aplica uma função de transferência de amplitude não linear invariante no "
"tempo ao sinal."

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
