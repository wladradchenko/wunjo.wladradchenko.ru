#: src/dialogs/clipjobmanager.cpp:49
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"The output file name will be the same as the source bin clip filename, with "
"the modified extension. It will be appended at the end of the arguments or "
"inserted in place of <b>{output}</b> if found. If output filename already "
"exists, a -0001 pattern will be appended."
msgstr ""
"O nome do arquivo de saída será o mesmo que o nome do arquivo do clipe nos "
"arquivos de projeto, com a extensão modificada. Ele será adicionado ao final "
"dos argumentos ou inserido no lugar de <b>{output}</b> se encontrado. Se o "
"nome do arquivo de saída já existir, um padrão -0001 será anexado."

