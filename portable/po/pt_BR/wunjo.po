#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7050
#, kde-format
msgid "Stereo tools"
msgstr "Ferramentas estéreo"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7052
#, kde-format
msgid ""
"This filter has some handy utilities to manage stereo signals, for "
"converting M/S stereo recordings to L/R signal while having control over the "
"parameters or spreading the stereo image of master track."
msgstr ""
"Este filtro possui alguns utilitários úteis para gerenciar sinais estéreo, "
"para converter gravações estéreo M/S em sinais L/R, mantendo o controle "
"sobre os parâmetros ou espalhando a imagem estéreo da trilha master."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7054
#, kde-format
msgid "Level IN"
msgstr "Nível de entrada"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7056 rc.cpp:7060
#, kde-format
msgid ""
"Set input level before filtering for both channels.\n"
"Allowed range is from 0.015625 to 64."
msgstr ""
"Define o nível de entrada antes de filtrar para ambos os canais.\n"
"O intervalo permitido é de 0,015625 a 64."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7058
#, kde-format
msgid "Level OUT"
msgstr "Nível de saída"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7062 rc.cpp:7120
#, kde-format
msgid "Balance IN"
msgstr "Balanço de entrada"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7064 rc.cpp:7068
#, kde-format
msgid ""
"Set input balance between both channels. Default is 0. Allowed range is from "
"-1 to 1."
msgstr ""
"Define o equilíbrio de entrada entre ambos os canais. O padrão é 0. O "
"intervalo permitido é de -1 a 1."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7066 rc.cpp:7126
#, kde-format
msgid "Balance OUT"
msgstr "Balanço de saída"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7070
#, kde-format
msgid "Softclip"
msgstr "Suavização de clipping"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7072
#, kde-format
msgid ""
"Enable softclipping. Results in analog distortion instead of harsh digital "
"0dB clipping."
msgstr ""
"Ativa a suavização de clipping. Resulta em distorção analógica em vez de "
"corte digital severo de 0 dB."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7074
#, kde-format
msgid "Mute Left"
msgstr "Silenciar a esquerda"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7076
#, kde-format
msgid "Mute Right"
msgstr "Silenciar a direita"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7078
#, kde-format
msgid "Phase Left"
msgstr "Fase à esquerda"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7080
#, kde-format
msgid "Change the phase of the left channel."
msgstr "Muda a fase do canal esquerdo."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7082
#, kde-format
msgid "Phase Right"
msgstr "Fase à direita"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7084
#, kde-format
msgid "Change the phase of the right channel."
msgstr "Muda a fase do canal direito."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:7086 rc.cpp:8426
#, kde-format
msgid "Stereo Mode"
msgstr "Modo estéreo"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7088
#, kde-format
msgid ""
"Left/Right to Left/Right,Left/Right to Mid/Side,Mid/Side to Left/Right,Left/"
"Right to Left/Left,Left/Right to Right/Right,Left/Right to Left + Right,Left/"
"Right to Right/Left,Mid/Side to Left/Left,Mid/Side to Right/Right,Mid/Side "
"to Right/Left,Left/Right to Left - Right"
msgstr ""
"Esquerda/Direita para Esquerda/Direita,Esquerda/Direita para Meio/Lateral,"
"Meio/Lateral para Esquerda/Direita,Esquerda/Direita para Esquerda/Esquerda,"
"Esquerda/Direita para Direita/Direita,Esquerda/Direita para Esquerda + "
"Direita,Esquerda/Direita para Direita/Esquerda,Meio/Lateral para Esquerda/"
"Esquerda,Meio/Lateral para Direita/Direita,Meio/Lateral para Direita/"
"Esquerda,Esquerda/Direita para Esquerda - Direita"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7090
#, kde-format
msgid "Side Level"
msgstr "Nível lateral"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7092
#, kde-format
msgid ""
"Set level of side signal. Default is 1. Allowed range is from 0.015625 to 64."
msgstr ""
"Define o nível do sinal lateral. O padrão é 1. O intervalo permitido é de "
"0,015625 a 64."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7094
#, kde-format
msgid "Side Balance"
msgstr "Balanço lateral"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7096
#, kde-format
msgid ""
"Set balance of side signal. Default is 0. Allowed range is from -1 to 1."
msgstr ""
"Define o equilíbrio do sinal lateral. O padrão é 0. O intervalo permitido é "
"de -1 a 1."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7098
#, kde-format
msgid "Mid Level"
msgstr "Nível médio"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7100
#, kde-format
msgid ""
"Set level of the middle signal. Default is 1. Allowed range is from 0.015625 "
"to 64."
msgstr ""
"Define o nível do sinal médio. O padrão é 1. O intervalo permitido é de "
"0,015625 a 64."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7102
#, kde-format
msgid "Mid Pan"
msgstr "Panorâmica média"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7104
#, kde-format
msgid "Set middle signal pan. Default is 0. Allowed range is from -1 to 1."
msgstr ""
"Define a panorâmica do sinal média. O padrão é 0. O intervalo permitido é de "
"-1 a 1."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7106
#, kde-format
msgid "Stereo base"
msgstr "Base estéreo"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7108
#, kde-format
msgid ""
"Set stereo base between mono and inverted channels. Default is 0. Allowed "
"range is from -1 to 1."
msgstr ""
"Define a base estéreo entre os canais mono e invertido. O padrão é 0. A "
"faixa permitida é de -1 a 1."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7112
#, kde-format
msgid ""
"Set delay in milliseconds how much to delay left from right channel and vice "
"versa. Default is 0. Allowed range is from -20 to 20."
msgstr ""
"Define o atraso em milissegundos para o canal esquerdo do canal direito e "
"vice-versa. O padrão é 0. O intervalo permitido é de -20 a 20."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7114
#, kde-format
msgid "S/C level"
msgstr "Nível S/C"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7116
#, kde-format
msgid "Stereo phase"
msgstr "Fase do estéreo"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7118
#, kde-format
msgid "Set the stereo phase in degrees."
msgstr "Defina a fase estéreo em graus."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7122 rc.cpp:7128
#, kde-format
msgid ""
"‘balance’\n"
"Classic balance mode. Attenuate one channel at a time. Gain is raised up to "
"1.\n"
"‘amplitude’\n"
"Similar to classic mode above but gain is raised up to 2.\n"
"‘power’\n"
"Equal power distribution, from -6dB to +6dB range."
msgstr ""
"‘balanço’\n"
"Modo de balanceamento clássico. Atenua um canal por vez. O ganho é aumentado "
"para 1.\n"
"‘amplitude’\n"
"Semelhante ao modo clássico acima, mas o ganho é aumentado para até 2.\n"
"‘potência’\n"
"Distribuição de potência uniforme, na faixa de -6 dB a +6 dB."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7124 rc.cpp:7130
#, kde-format
msgid "balance,amplitude,power"
msgstr "balanço,amplitude,potência"

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7132
#, kde-format
msgid "Stereo widener"
msgstr "Ampliador estéreo"

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7134
#, kde-format
msgid ""
"This filter enhance the stereo effect by suppressing signal common to both "
"channels and by delaying the signal of left into right and vice versa, "
"thereby widening the stereo effect."
msgstr ""
"Este filtro aprimora o efeito estéreo suprimindo o sinal comum a ambos os "
"canais e atrasando o sinal do canal esquerdo para o canal direito e vice-"
"versa, ampliando assim o efeito estéreo."

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7138
#, kde-format
msgid ""
"Time in milliseconds of the delay of left signal into right and vice versa."
msgstr ""
"Tempo em milissegundos do atraso do sinal esquerdo para o direito e vice-"
"versa."

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7140
#, kde-format
msgid "Feedback Gain"
msgstr "Ganho de realimentação"

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7142
#, kde-format
msgid ""
"Amount of gain in delayed signal into right and vice versa.\n"
"Gives a delay effect of left signal in right output and vice versa which "
"gives widening effect."
msgstr ""
"Quantidade de ganho no sinal atrasado na saída direita e vice-versa.\n"
"Proporciona um efeito de atraso no sinal esquerdo na saída direita e vice-"
"versa, o que proporciona um efeito de ampliação."

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7144
#, kde-format
msgid "Cross feed"
msgstr "Alimentação cruzada"

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7146
#, kde-format
msgid ""
"Cross feed of left into right with inverted phase. This helps in suppressing "
"the mono.\n"
"If the value is 1 it will cancel all the signal common to both channels."
msgstr ""
"Alimentação cruzada da esquerda para a direita com fase invertida. Isso "
"ajuda a suprimir o mono.\n"
"Se o valor for 1, cancelará todo o sinal comum a ambos os canais."

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7148
#, kde-format
msgid "Drymix"
msgstr "Drymix"

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7150
#, kde-format
msgid "Set level of input signal of original channel."
msgstr "Define o nível do sinal de entrada do canal original."

#. i18n: file: data/effects/avfilter/avfilter_swapuv.xml
#: rc.cpp:7152
#, kde-format
msgid "Swap UV"
msgstr "Trocar UV"

#. i18n: file: data/effects/avfilter/avfilter_swapuv.xml
#: rc.cpp:7154
#, kde-format
msgid "Swap U and V components"
msgstr "Troca os componentes U e V"

#. i18n: file: data/effects/avfilter/avfilter_tmix.xml
#: rc.cpp:7156
#, kde-format
msgid "Temporal frames Mixer"
msgstr "Misturador de quadros temporal"

#. i18n: file: data/effects/avfilter/avfilter_tmix.xml
#: rc.cpp:7158
#, kde-format
msgid "Mix successive video frames"
msgstr "Mistura sucessivos quadros de vídeo"

#. i18n: file: data/effects/avfilter/avfilter_tmix.xml
#: rc.cpp:7160
#, kde-format
msgid "Frames to mix"
msgstr "Quadros a serem misturados"

#. i18n: file: data/effects/avfilter/avfilter_transpose.xml
#: rc.cpp:7162
#, kde-format
msgid "Transpose"
msgstr "Transposição"

#. i18n: file: data/effects/avfilter/avfilter_transpose.xml
#: rc.cpp:7164
#, kde-format
msgid "Transpose rows with columns in the input video and optionally flip it"
msgstr ""
"Transpõe linhas com colunas no vídeo de entrada e, opcionalmente, invertê-lo"

#. i18n: file: data/effects/avfilter/avfilter_transpose.xml
#: rc.cpp:7168
#, kde-format
msgid "Clock,Clock flip,Counter clock,Counter clock flip"
msgstr "Horário,Horário invertido,Anti horário,Anti horário invertido"

#. i18n: file: data/effects/avfilter/avfilter_transpose.xml
#: rc.cpp:7170
#, kde-format
msgid "Override if"
msgstr "Sobrescrever se"

#. i18n: file: data/effects/avfilter/avfilter_transpose.xml
#: rc.cpp:7172
#, kde-format
msgid "None,Portrait,Landscape"
msgstr "Nenhum,Retrato,Paisagem"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7174
#, kde-format
msgid "Sharp/Unsharp"
msgstr "Nítido/Desfocado"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7176
#, kde-format
msgid "Sharpen or unsharpen/blur your video"
msgstr "Aumenta ou diminui a nitidez/desfoque do seu vídeo"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7178
#, kde-format
msgid "Luma horizontal matrix"
msgstr "Matriz luma horizontal"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7180
#, kde-format
msgid "Set the luma matrix horizontal size"
msgstr "Define o tamanho horizontal da matriz de luma"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7182
#, kde-format
msgid "Luma vertical matrix"
msgstr "Matriz luma vertical"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7184
#, kde-format
msgid "Set the luma matrix vertical size"
msgstr "Define o tamanho vertical da matriz de luma"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7188
#, kde-format
msgid ""
"Set the luma effect strength.<br>\n"
"            Reasonable values are between -1.5 and 1.5. Negative values will "
"blur the input video, while positive values will sharpen it, a value of 0 "
"will disable the effect."
msgstr ""
"Define a intensidade do efeito luma.<br>\n"
"            Valores razoáveis estão entre -1,5 e 1,5. Valores negativos "
"desfocarão o vídeo de entrada, enquanto valores positivos o tornarão mais "
"nítido. Um valor de 0 desativará o efeito."

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7190
#, kde-format
msgid "Chroma horizontal matrix"
msgstr "Matriz croma horizontal"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7192
#, kde-format
msgid "Set the chroma matrix horizontal size"
msgstr "Define o tamanho horizontal da matriz croma"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7194
#, kde-format
msgid "Chroma vertical matrix"
msgstr "Matriz vertical do croma"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7196
#, kde-format
msgid "Set the chroma matrix vertical size"
msgstr "Define o tamanho vertical da matriz croma"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7200
#, kde-format
msgid ""
"Set the chroma effect strength.<br>\n"
"            Reasonable values are between -1.5 and 1.5. Negative values will "
"blur the input video, while positive values will sharpen it, a value of zero "
"will disable the effect."
msgstr ""
"Define a intensidade do efeito de croma.<br>\n"
"            Valores razoáveis estão entre -1,5 e 1,5. Valores negativos "
"desfocarão o vídeo de entrada, enquanto valores positivos o tornarão mais "
"nítido. Um valor igual a zero desativará o efeito."

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7202
#, kde-format
msgid "Alpha horizontal matrix"
msgstr "Matriz alfa horizontal"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7204
#, kde-format
msgid "Set the alpha matrix horizontal size"
msgstr "Define o tamanho horizontal da matriz alfa"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7206
#, kde-format
msgid "Alpha vertical matrix"
msgstr "Matriz alfa vertical"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7208
#, kde-format
msgid "Set the alpha matrix vertical size"
msgstr "Define o tamanho vertical da matriz alfa"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7212
#, kde-format
msgid ""
"Set the alpha effect strength.<br>\n"
"            Reasonable values are between -1.5 and 1.5. Negative values will "
"blur the input video, while positive values will sharpen it, a value of zero "
"will disable the effect."
msgstr ""
"Define a intensidade do efeito alfa.<br>\n"
"            Valores razoáveis estão entre -1,5 e 1,5. Valores negativos "
"desfocarão o vídeo de entrada, enquanto valores positivos o tornarão mais "
"nítido. Um valor igual a zero desativará o efeito."

#. i18n: file: data/effects/avfilter/avfilter_vaguedenoiser.xml
#: rc.cpp:7214
#, kde-format
msgid "Wavelet Denoiser"
msgstr "Redução do ruído Wavelet"

#. i18n: file: data/effects/avfilter/avfilter_vaguedenoiser.xml
#: rc.cpp:7216
#, kde-format
msgid ""
"Wavelet based denoiser.<br>\n"
"    It transforms each frame from the video input into the wavelet domain, "
"using Cohen-Daubechies-Feauveau 9/7."
msgstr ""
"Redutor de ruído baseado em wavelet.<br>\n"
"    Ele transforma cada quadro da entrada de vídeo para o domínio wavelet, "
"usando Cohen-Daubechies-Feauveau 9/7."

#. i18n: file: data/effects/avfilter/avfilter_vaguedenoiser.xml
#: rc.cpp:7220
#, kde-format
msgid "Hard,Soft,Garrote"
msgstr "Duro,Suave,Garrote"

#. i18n: file: data/effects/avfilter/avfilter_vaguedenoiser.xml
#: rc.cpp:7222
#, kde-format
msgid "Threshold Type"
msgstr "Tipo de limiar"

#. i18n: file: data/effects/avfilter/avfilter_vaguedenoiser.xml
#: rc.cpp:7224
#, kde-format
msgid "Universal,Bayes"
msgstr "Universal,Bayes"

#. i18n: file: data/effects/avfilter/avfilter_vectorscope.xml
#: rc.cpp:7236
#, kde-format
