#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7624
#, kde-format
msgid "Delayorama (LADSPA 1402)"
msgstr "Delayorama (LADSPA 1402)"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7628
#, kde-format
msgid ""
"Controls the random numbers that<br>\n"
"      will be used to stagger the delays and amplitudes if random is turned "
"up on them. Changing this forces the random values to be recalculated."
msgstr ""
"Controla os números aleatórios que<br>\n"
"      serão usados ​​para escalonar os atrasos e as amplitudes, caso a "
"aleatoriedade esteja ativada para eles. Alterar essa configuração força o "
"recálculo dos valores aleatórios."

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7632
#, kde-format
msgid "Controls the gain of the input signal"
msgstr "Controla o ganho do sinal de entrada"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7636
#, kde-format
msgid "Controls the amount of output signal fed back into the input"
msgstr "Controla a quantidade de sinal de saída realimentado para a entrada"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7638
#, kde-format
msgid "Number of Taps"
msgstr "Número de repetições"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7640
#, kde-format
msgid "Controls the number of taps in the delay"
msgstr "Controla o número de repetições no atraso"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7642
#, kde-format
