#. i18n: file: data/effects/frei0r/frei0r_levels.xml
#: rc.cpp:3624 rc.cpp:3648 rc.cpp:3672 rc.cpp:3706
#, kde-format
msgid "Adjust levels"
msgstr "დონეების მორგება"

#. i18n: file: data/effects/frei0r/frei0r_levels.xml
#: rc.cpp:3630 rc.cpp:3654 rc.cpp:3684 rc.cpp:3718
