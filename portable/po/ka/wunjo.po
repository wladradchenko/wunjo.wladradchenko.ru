#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6958
#, kde-format
msgid "Luma radius"
msgstr "განათებულობის რადიუსი"

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6960
#, kde-format
msgid ""
"Set the luma radius.<br>\n"
"            The value specifies the variance of the gaussian filter used to "
"blur the image (slower if larger)."
msgstr ""
"განათებულობის რადიუსის დაყენება.<br>\n"
"                მნიშვნელობები უთითებს გაუსის ფილტრის დისპერსიას, რომელიც "
"გამოსახულების დასაბინდად გამოიყენება (რაც დიდია, მით ნელია)."

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:6962 rc.cpp:7204
#, kde-format
msgid "Luma strength"
msgstr "ლუმას სიძლიერე"

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6964
#, kde-format
msgid ""
"Set the luma strength.<br>\n"
"            The value configures the blurring. A positive value will blur "
"the image, whereas a negative value will sharpen the image."
msgstr ""
"განათებულობის სიძლიერის დაყენება.<br>\n"
"                მნიშვნელობა აყენებს დაბინდვას. დადებითი მნიშვნელობა "
"დაბინდავს გამოსახულებას, უარყოფითი კი გაამკვეთრებს."

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6966
#, kde-format
msgid "Luma threshold"
msgstr "ლუმას ზღვარი"

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6968
#, kde-format
msgid ""
"Set the luma threshold used as a coefficient<br>\n"
"            to determine whether a pixel should be blurred or not. A value "
"of 0 will filter all the image, positive values will filter flat areas, "
"negative values will filter edges."
msgstr ""
"განათებულობის ზღვრის დაყენება, რომელიც კოეფიციენტად გამოიყენება<br>\n"
"           დასადგენად, იქნება პიქსელი ბუნდოვანი, თუ არა. მნიშვნელობა 0 მთელ "
"გამოსახულებას გაფილტრავს, დადებითი მნიშვნელობა ბრტყელ ადგილებს, უარყოფითი - "
"წიბოებს."

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6970
#, kde-format
msgid "Chroma radius"
msgstr "ბუნდოვნების რადიუსი"

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6972
#, kde-format
msgid ""
"Set the chroma radius.<br>\n"
"            The value specifies the variance of the gaussian filter used to "
"blur the image (slower if larger). If not specified, it defaults to the "
"value set for <em>Luma radius</em>"
msgstr ""
"ინტენსივობის რადიუსის დაყენება.<br>\n"
"             მნიშვნელობა უთითებს გაუსის ფილტრის დისპერსიას, რომელიც "
"გამოსახულების დასაბინდად გამოიყენება (რაც მეტია, მით ნელია). თუ მითითებული "
"არაა, მისი მნიშვნელობა ნაგულისხმევად <em>ინტენსივობის რადიუსს</em> უდრის"

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:6974 rc.cpp:7216
#, kde-format
msgid "Chroma strength"
msgstr "ბუნდოვნების ძალა"

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6976
#, kde-format
msgid ""
"Set the chroma strength.<br>\n"
"            The value configures the blurring. A positive value will blur "
"the image, whereas a negative value will sharpen the image. If not "
"specified, it defaults to the value set for <em>Luma strength</em>."
msgstr ""
"ფერის ინტენსივობის სიძლიერის დაყენება.<br>\n"
"                მნიშვნელობა აყენებს დაბინდვას. დადებითი მნიშვნელობა "
"დაბინდავს გამოსახულებას, უარყოფითი კი გაამკვეთრებს. თუ მითითებული არაა, მისი "
"ნაგულისხმევი მნიშვნელობა <em>განათებულობის სიძლიერეს</em>."

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6978
#, kde-format
msgid "Chroma threshold"
msgstr "ბუნდოვნების ზღვარი"

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6980
#, kde-format
msgid ""
"Set the chroma threshold used as a coefficient<br>\n"
"            to determine whether a pixel should be blurred or not. A value "
"of 0 will filter all the image, positive values will filter flat areas, "
"negative values will filter edges. If not specified, it defaults to the "
"value set for <em>Luma threshold</em>"
msgstr ""
"ფერის ინტენსივობის დაყენება, რომელიც კოეფიციენტად გამოიყენება<br>\n"
"           დასადგენად, იქნება პიქსელი ბუნდოვანი, თუ არა. მნიშვნელობა 0 მთელ "
"გამოსახულებას გაფილტრავს, დადებითი მნიშვნელობა ბრტყელ ადგილებს, უარყოფითი - "
"წიბოებს. თუ მითითებული არაა, ნაგულისხმევად ის <em>განათებულობის ზღვარს</em> "
"უდრის"

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6982
#, kde-format
msgid "Alpha radius"
msgstr "ალფას რადიუსი"

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6984
