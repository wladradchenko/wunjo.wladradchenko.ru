#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8214
#, kde-format
msgid ""
"TAP Stereo Echo (LADSPA 2143)<br>\n"
"   Supports conventional mono and stereo delays, ping-pong delays and the "
"Haas effect (also known as Cross Delay Stereo)."
msgstr ""
"TAP Écho Stéréo (LADSPA 2143)<br>\n"
"   Prend en charge les retards mono et stéréo conventionnels, les retards en "
"ping-pong et l'effet Haas (Également connu sous le nom de stéréo à retard "
"croisé)."

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8216
#, kde-format
msgid "Cross Mode"
msgstr "Mode croisé"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8218
#, kde-format
msgid "Haas Effect"
