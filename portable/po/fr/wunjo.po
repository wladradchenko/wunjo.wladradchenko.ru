msgstr "Fraction horizontale de la zone non modifiée à flouter aux pôles"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2646
#, kde-format
msgid "VR360 Hemispherical to Equirectangular"
msgstr "Hémisphérique « VR360 » vers Équirectangulaire"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2648
#, kde-format
msgid ""
"Converts a video frame with two hemispherical images to a single "
"equirectangular frame. The plugin assumes that both hemispheres are in the "
"frame"
msgstr ""
"Convertit une trame vidéo avec deux images hémisphériques en une unique "
"trame équirectangulaire. Le module externe suppose que les deux hémisphères "
"sont dans la trame."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2650
#, kde-format
msgid "Alignment yaw"
msgstr "Lacet pour alignement"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2652 rc.cpp:2656 rc.cpp:2660
#, kde-format
msgid ""
"The two fisheye cameras of a 360 camera are rarely perfectly 180 degrees "
"apart.<br>\n"
"    \tThese parameters adds a rotation to both lenses to correct for this."
msgstr ""
"Les deux caméras à grand angle d'une caméra à 360 ° sont rarement "
"parfaitement à 180 degrés l'une de l'autre.<br>\n"
"        Ces paramètres ajoutent une rotation aux deux lentilles pour "
"corriger cela."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2654
#, kde-format
msgid "Alignment pitch"
msgstr "Hauteur d'alignement"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2658
#, kde-format
msgid "Alignment roll"
msgstr "Roulis pour alignement"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2662
#, kde-format
msgid "Projection"
msgstr "Projection"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2664
#, kde-format
msgid ""
"The fisheye projection type. Currently only equidistant fisheyes, like the "
"Ricoh Theta and Garmin Virb360 are supported."
msgstr ""
"Le type de projection grand angle. Actuellement, seules les projections "
"grand angle équidistants sont prises en charge pour les appareils « Ricoh "
"Theta » et « Garmin Virb360 »."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2666
#, kde-format
msgid "Equidistant Fisheye"
msgstr "Très grand angle équidistant"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2668
#, kde-format
msgid "Lens FOV"
msgstr "Champ de vision de la lentille"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2670
#, kde-format
msgid ""
