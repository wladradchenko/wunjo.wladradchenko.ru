#: rc.cpp:7478 rc.cpp:7500 rc.cpp:7512 rc.cpp:7616 rc.cpp:7634 rc.cpp:7870
#: rc.cpp:8636
#, kde-format
msgid "Feedback"
msgstr "Retour"

#. i18n: file: data/effects/ladspa/ladspa_1190.xml
#: rc.cpp:7480
#, kde-format
msgid "Feedback level, increases the distinctive wooshy phaser sound."
msgstr ""
"Niveau de rétroaction, accentue le son caractéristique de « souffle » du "
"phaser."

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7486
#, kde-format
msgid ""
"Flanger (LADSPA 1191)<br>\n"
"   A digital flanger implementation. Uses a novel zero excursion, controlled "
"bandwidth modulation function, which should make the modulation less "
"repetitive and noticeable."
msgstr ""
"Flanger (LADSPA 1191)<br>\n"
"   Une implémentation numérique de flanger. Utilise une nouvelle fonction de "
"modulation à excursion nulle et bande passante contrôlée, qui devrait rendre "
"la modulation moins répétitive et moins perceptible."

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7488
#, kde-format
msgid "Delay Base"
msgstr "Retard de base"

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7490
#, kde-format
msgid ""
"This is the offset from<br>\n"
"      the input time that the detune delay moves around"
msgstr ""
"C'est le décalage par rapport<br>\n"
"      au temps d'entrée autour duquel se déplace le retard de désaccord"

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7492
#, kde-format
msgid "Max Slowdown"
msgstr "Ralentissement maximal"

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7494
#, kde-format
msgid ""
"This is the maximum<br>\n"
"      delay that will be applied to the delayed signal, relative to the dry "
"signal."
msgstr ""
"C'est le retard<br>\n"
"      maximal qui sera appliqué au signal retardé, par rapport au signal sec."

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7496
#, kde-format
msgid "LFO Frequency"
msgstr "Fréquence du LFO"

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7498
#, kde-format
msgid ""
"This is the core frequency<br>\n"
"      that the 'LFO' will move at. The LFO isn't actually an oscillator, but "
"it does vary periodically."
msgstr ""
"C'est la fréquence de base<br>\n"
"      à laquelle le « LFO » se déplacera. Le LFO n'est pas réellement un "
"oscillateur, mais il varie de façon périodique."

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7502
#, kde-format
msgid ""
"Feedback applied from the<br>\n"
"      output to the input, increases the depth of the effect, but makes it "
"sound less like a real flanger."
msgstr ""
"Rétroaction appliquée de la<br>\n"
"      sortie vers l'entrée, augmente la profondeur de l'effet, mais le rend "
"moins semblable à un vrai flanger."

#. i18n: file: data/effects/ladspa/ladspa_1192.xml
#: rc.cpp:7506
#, kde-format
msgid "Fractionally Addressed Delay Line"
msgstr "Ligne de retard à adressage fractionnaire"

#. i18n: file: data/effects/ladspa/ladspa_1192.xml
#: rc.cpp:7508
#, kde-format
msgid ""
"Fractionally Addressed Delay Line (LADSPA 1192)<br>\n"
"   Automatically adapts to the number of channels and sampling rate of the "
"consumer."
msgstr ""
"Ligne de retard à adressage fractionnaire (LADSPA 1192)<br>\n"
"   S'adapte automatiquement au nombre de canaux et à la fréquence "
"d'échantillonnage du consommateur."

#. i18n: file: data/effects/ladspa/ladspa_1195.xml
#. i18n: file: data/effects/ladspa/ladspa_declipper.xml
#: rc.cpp:7516 rc.cpp:8560
#, kde-format
msgid "Declipper"
msgstr "Élimination des surcharges"

#. i18n: file: data/effects/ladspa/ladspa_1195.xml
#: rc.cpp:7518
#, kde-format
msgid ""
"Declipper (LADSPA 1195)<br>\n"
"   Removes nasty clicks from input signals, not very kind to them though."
msgstr ""
"Déclippeur (LADSPA 1195)<br>\n"
"   Supprime les clics gênants des signaux d'entrée, sans trop de ménagement "
"toutefois."

#. i18n: file: data/effects/ladspa/ladspa_1196.xml
#: rc.cpp:7522
#, kde-format
msgid "Fast Overdrive"
msgstr "Saturation rapide"

#. i18n: file: data/effects/ladspa/ladspa_1196.xml
#: rc.cpp:7524
#, kde-format
msgid ""
"Fast Overdrive (LADSPA 1196)<br>\n"
"   A simple overdrive. Compresses the extreme peaks to make a sound similar "
"to an overdriven amplifier."
msgstr ""
"Saturation rapide (LADSPA 1196)<br>\n"
"   Une saturation simple. Compresse les crêtes extrêmes pour obtenir un son "
"semblable à celui d'un amplificateur saturé."

#. i18n: file: data/effects/ladspa/ladspa_1196.xml
#: rc.cpp:7526
#, kde-format
msgid "Drive Level"
msgstr "Niveau de saturation"

#. i18n: file: data/effects/ladspa/ladspa_1196.xml
#: rc.cpp:7528
#, kde-format
msgid ""
"Controls the point at<br>\n"
"      which the signal starts to distort, and the degree of distortion."
msgstr ""
"Contrôle le point à partir<br>\n"
"      duquel le signal commence à se distordre, ainsi que le degré de "
"distorsion."

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7532
#, kde-format
msgid "Decimator"
msgstr "Décimateur"

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7534
#, kde-format
msgid ""
"Decimator (LADSPA 1202)<br>\n"
"   Decimates (reduces the effective sample rate), and reduces the bit depth "
"of the input signal, allows non integer values for smooth transitions "
"between clean and lo-fi signals."
msgstr ""
"Décimateur (LADSPA 1202)<br>\n"
"   Décime (réduit la fréquence d'échantillonnage effective) et réduit la "
"profondeur de bits du signal d'entrée. Accepte des valeurs non entières pour "
"des transitions douces entre des signaux propres et lo-fi."

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7536
#, kde-format
msgid "Bit Depth"
msgstr "Profondeur de bits"

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7538
#, kde-format
msgid "The bit depth that the signal will be reduced to"
msgstr "La profondeur de bits à laquelle le signal sera réduit"

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7540
#, kde-format
msgid "Sample Rate"
msgstr "Fréquence d'échantillonnage"

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7542
#, kde-format
msgid "The sample rate that the signal will be resampled at"
msgstr ""
"La fréquence d'échantillonnage à laquelle le signal sera rééchantillonné"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7546
#, kde-format
msgid "Single Band Parametric"
msgstr "Paramétrique à bande unique"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7548
#, kde-format
msgid ""
"Single Band Parametric (LADSPA 1203)<br>\n"
"   A single band of a parametric filter."
msgstr ""
"Paramétrique à bande unique (LADSPA 1203)<br>\n"
"   Une seule bande d'un filtre paramétrique."

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7550
#, kde-format
msgid "Gain (dB)"
msgstr "Gain (dB)"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7552
#, kde-format
msgid "The attenuation/gain of the eq"
msgstr "L'atténuation / le gain de l'égaliseur"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7554
#, kde-format
msgid "Frequency (Hz)"
msgstr "Fréquence (Hz)"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7556
#, kde-format
msgid ""
"The centre frequency (i.e. point of<br>\n"
"      most/least attenuation). Beware of high values for <i>Frequency</i> "
"and <i>Bandwidth</i>: if the high pitch (<i>Frequency</i> * 2^<i>Bandwidth</"
"i>) goes over half the sample rate, you will get aliasing."
msgstr ""
"La fréquence centrale (c'est-à-dire le point<br>\n"
"      d'atténuation maximale / minimale). Attention aux valeurs élevées pour "
"<i>Fréquence</i> et <i>Largeur de bande</i> : si la hauteur supérieure "
"(<i>Fréquence</i> * 2^<i>Largeur de bande</i>) dépasse la moitié de la "
"fréquence d'échantillonnage, vous obtiendrez du repliement."

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7558
#, kde-format
msgid "Bandwidth (octaves)"
msgstr "Largeur de bande (octaves)"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7560
#, kde-format
msgid ""
"The pitch difference from the<br>\n"
"      centre before the attenuation has reached half the <i>Gain</i>."
msgstr ""
"L'écart de hauteur par rapport au<br>\n"
"      centre avant que l'atténuation n'atteigne la moitié du <i>Gain</i>."

#. i18n: file: data/effects/ladspa/ladspa_1207.xml
#: rc.cpp:7564
#, kde-format
msgid "DC Offset Remover"
msgstr "Suppresseur de décalage CC"

#. i18n: file: data/effects/ladspa/ladspa_1207.xml
#: rc.cpp:7566
#, kde-format
msgid ""
"DC Offset Remover (LADSPA 1207)<br>\n"
"   Simply removes the DC (0 Hz) component from an audio signal, uses a high "
"pass filter, so has some side effects, but they should be minimal."
msgstr ""
"Suppresseur de décalage CC (LADSPA 1207)<br>\n"
"   Supprime simplement la composante continue (0 Hz) d'un signal audio. "
"Utilise un filtre passe-haut, ce qui entraîne quelques effets secondaires, "
"mais ils devraient être minimes."

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#: rc.cpp:7570
#, kde-format
msgid "Foldover Distortion"
msgstr "Distorsion par repliement"

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#: rc.cpp:7572
#, kde-format
msgid ""
"Foldover Distortion (LADSPA 1213)<br>\n"
"   Uses a sine wave approximation to simulate valve style foldover "
"distortion. Probably should have a <i>DC Offset Remover</i> on the output, "
"but it's not always necessary."
msgstr ""
"Distorsion par repliement (LADSPA 1213)<br>\n"
"   Utilise une approximation d'onde sinusoïdale pour simuler une distorsion "
"par repliement de type lampe. Il faudrait probablement un <i>Suppresseur de "
"décalage CC</i> en sortie, mais ce n'est pas toujours nécessaire."

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:7574 rc.cpp:8516
#, kde-format
msgid "Drive"
msgstr "Lecteur"

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#: rc.cpp:7576
#, kde-format
msgid "Controls the degree of distortion"
msgstr "Contrôle le degré de distorsion"

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#: rc.cpp:7578
#, kde-format
msgid "Skew"
msgstr "Asymétrie"

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#: rc.cpp:7580
#, kde-format
msgid "Controls the asymmetry of the waveform"
msgstr "Contrôle l'asymétrie de la forme d'onde"

#. i18n: file: data/effects/ladspa/ladspa_1218.xml
#: rc.cpp:7584
#, kde-format
