msgstr ""
"Étire une section du panorama équirectangulaire pour couvrir la totalité de "
"la sphère de réalité virtuelle"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_wrap.xml
#: rc.cpp:2618
#, kde-format
msgid "Determines the sampling method"
msgstr "Définit la méthode d'échantillonnage"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_wrap.xml
