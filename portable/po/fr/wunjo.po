msgstr "Degrés à partir du centre de l'image devant être conservé"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_wrap.xml
#: rc.cpp:2638
#, kde-format
msgid "Blur start"
msgstr "Début du floutage"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_wrap.xml
#: rc.cpp:2640
#, kde-format
msgid ""
"Horizontal fraction of the unchanged area to blur over in the equator band"
msgstr ""
"Fraction horizontale de la zone non modifiée à flouter dans la bande "
"équatoriale"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_wrap.xml
#: rc.cpp:2642
#, kde-format
