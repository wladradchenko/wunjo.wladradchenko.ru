#. i18n: file: data/effects/ladspa/ladspa_1890.xml
#: rc.cpp:7932
#, kde-format
msgid "GLAME Highpass"
msgstr "Passe-haut GLAME"

#. i18n: file: data/effects/ladspa/ladspa_1890.xml
#: rc.cpp:7934
#, kde-format
msgid ""
"GLAME Highpass Filter (LADSPA 1890)<br>\n"
"   IIR highpass filter based using Chebishev coefficients. The filter allows "
"you to tweak the number of stages used for filtering. Every stage adds two "
"more poles, which leads to a steeper dropoff."
msgstr ""
"Filtre passe-haut GLAME (LADSPA 1890)<br>\n"
"   Filtre passe-haut RII utilisant des coefficients de Tchebychev. Le filtre "
"permet d'ajuster le nombre d'étages utilisés pour le filtrage. Chaque étage "
"ajoute deux pôles supplémentaires, ce qui entraîne une atténuation plus "
"raide."

