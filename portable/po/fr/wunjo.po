msgstr "Retour R / Haas"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8230
#, kde-format
msgid "L Echo Level"
msgstr "Niveau d'écho à gauche"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8232
#, kde-format
