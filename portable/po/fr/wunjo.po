#, kde-format
msgid "Amount"
msgstr "Quantité"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_stereo.xml
#: rc.cpp:2610
#, kde-format
msgid "Nearest-neighbor,Bilinear"
msgstr "Voisin le plus proche voisin, bilinéaire"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_wrap.xml
#: rc.cpp:2612
#, kde-format
msgid "VR360 Wrap"
msgstr "Transformation « VR360 »"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_wrap.xml
#: rc.cpp:2614
#, kde-format
