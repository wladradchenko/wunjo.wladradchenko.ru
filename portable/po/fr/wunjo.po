#. i18n: file: data/effects/ladspa/ladspa_1913.xml
#: rc.cpp:7680 rc.cpp:8138
#, kde-format
msgid "Release Time"
msgstr "Temps de relâchement"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#: rc.cpp:7682
#, kde-format
msgid ""
"Controls the time taken for<br>\n"
"      the compressor to relax its gain control over the input signal"
msgstr ""
"Contrôle le temps nécessaire<br>\n"
"      au compresseur pour relâcher son contrôle de gain sur le signal "
"d'entrée"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#: rc.cpp:7684
#, kde-format
msgid "Fast Compression Ratio"
msgstr "Taux de compression rapide"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#: rc.cpp:7686
#, kde-format
msgid "Compression Ratio"
msgstr "Taux de compression"

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7690
#, kde-format
msgid "Crossover Distortion"
msgstr "Distorsion de croisement"

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7692
#, kde-format
msgid ""
"Crossover Distortion (LADSPA 1404)<br>\n"
"   This is a simulation of the distortion that happens in class B and AB "
"power amps when the signal crosses 0."
msgstr ""
"Distorsion de croisement (LADSPA 1404)<br>\n"
"   Ceci est une simulation de la distorsion qui se produit dans les "
"amplificateurs de puissance de classe B et AB lorsque le signal passe par 0."

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7694
#, kde-format
msgid "Crossover Amplitude"
msgstr "Amplitude de croisement"

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7696
#, kde-format
msgid "Controls the point at which the output signal becomes linear"
msgstr "Contrôle le point à partir duquel le signal de sortie devient linéaire"

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7700
#, kde-format
msgid "Controls degree of smoothing of the crossover point"
msgstr "Contrôle le degré de lissage du point de croisement"

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7704
#, kde-format
msgid "Aliasing"
msgstr "Repliement"

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7706
#, kde-format
msgid ""
"Aliasing (LADSPA 1407)<br>\n"
"   Simulates aliasing using nyquist frequency modulation. Produces wacky "
"results if the blocks aren't even numbers of samples long."
msgstr ""
"Repliement (LADSPA 1407)<br>\n"
"   Simule le repliement de spectre à l'aide d'une modulation de la fréquence "
"de Nyquist. Produit des résultats farfelus si les blocs ne comportent pas un "
"nombre pair d'échantillons."

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7708
#, kde-format
msgid "Aliasing Level"
msgstr "Niveau de repliement"

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7710
#, kde-format
msgid "Controls the amount of simulated aliasing in the output."
msgstr "Contrôle la quantité de repliement simulé dans la sortie."

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7714
#, kde-format
msgid "Barry's Satan Maximiser"
msgstr "Barry's Satan Maximiser"

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7716
#, kde-format
msgid ""
"Barry's Satan Maximiser (LADSPA 1408)<br>\n"
"   Compresses signals with a stupidly short attack and decay, infinite ratio "
"and hard knee. Not really as a compressor, but good harsh (non-musical) "
"distortion."
msgstr ""
"Barry's Satan Maximiser (LADSPA 1408)<br>\n"
"   Compresse les signaux avec une attaque et une décroissance ridiculement "
"courtes, un taux infini et un coude dur. Pas vraiment utile comme "
"compresseur, mais donne une bonne distorsion agressive (non musicale)."

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7718
#, kde-format
msgid "Decay Time (samples)"
msgstr "Temps de décroissance (échantillons)"

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7720
#, kde-format
msgid "Controls the envelope decay time."
msgstr "Contrôle le temps de décroissance de l'enveloppe."

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7722
#, kde-format
msgid "Knee Point"
msgstr "Point de coude"

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7724
#, kde-format
msgid ""
"Controls the knee roll-off point,<br>\n"
"      ie. the point above which the compression kicks in. 0 will have no "
"effect, -90 will remove virtually all dynamic range."
msgstr ""
"Contrôle le point de coude,<br>\n"
"      c'est-à-dire le point au-dessus duquel la compression intervient. 0 "
"n'aura aucun effet, -90 supprimera pratiquement toute la dynamique."

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7728
#, kde-format
msgid "Gate"
msgstr "Porte"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7730
#, kde-format
msgid "Gate (LADSPA 1410)"
msgstr "Porte (LADSPA 1410)"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7732
#, kde-format
msgid "LF Key Filter"
msgstr "Filtre de clé BF"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7734
#, kde-format
msgid ""
"Controls the cutoff of<br>\n"
"      the low frequency filter (highpass)"
msgstr ""
"Contrôle la coupure du<br>\n"
"      filtre basse fréquence (passe-haut)"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7736
#, kde-format
msgid "HF Key Filter"
msgstr "Filtre de clé HF"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7738
#, kde-format
msgid ""
"Controls the cutoff of<br>\n"
"      the high frequency filter (lowpass)"
msgstr ""
"Contrôle la coupure du<br>\n"
"      filtre haute fréquence (passe-bas)"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7742
#, kde-format
msgid ""
"Controls the level at<br>\n"
"      which the gate will open"
msgstr ""
"Contrôle le niveau à<br>\n"
"      partir duquel la porte s'ouvre"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7746
#, kde-format
msgid ""
"Controls the time the<br>\n"
"      gate will take to open fully"
msgstr ""
"Contrôle le temps nécessaire<br>\n"
"      à la porte pour s'ouvrir complètement"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7748
#, kde-format
msgid "Hold"
msgstr "Maintien"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7750
#, kde-format
msgid ""
"Controls the minimum<br>\n"
"      time the gate will stay open for"
msgstr ""
"Contrôle la durée<br>\n"
"      minimale pendant laquelle la porte reste ouverte"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7754
#, kde-format
msgid ""
"Controls the time the<br>\n"
"      gate will take to close fully"
msgstr ""
"Contrôle le temps nécessaire<br>\n"
"      à la porte pour se fermer complètement"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7758
#, kde-format
msgid ""
"Controls the difference<br>\n"
"      between the gate's open and closed state"
msgstr ""
"Contrôle la différence<br>\n"
"      entre l'état ouvert et l'état fermé de la porte"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7760
#, kde-format
msgid "Output Monitor"
msgstr "Moniteur de sortie"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7762
#, kde-format
msgid "Controls output monitor"
msgstr "Contrôle le moniteur de sortie"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7764
#, kde-format
msgid "Key (listen),Gate (normal output),Bypass"
msgstr "Clé (écoute),Porte (sortie normale),Contournement"

#. i18n: file: data/effects/ladspa/ladspa_1411.xml
#: rc.cpp:7768
#, kde-format
msgid "Comb Splitter"
msgstr "Séparateur en peigne"

#. i18n: file: data/effects/ladspa/ladspa_1411.xml
#: rc.cpp:7770
#, kde-format
msgid ""
"Comb Splitter (LADSPA 1411)<br>\n"
"   Divides the input up into two parts with frequency peaks at f Hz "
"intervals, skewed by f/2 Hz between the two outputs. Mixing the two outputs "
"will get you exactly the input signal."
msgstr ""
"Séparateur en peigne (LADSPA 1411)<br>\n"
"   Divise l'entrée en deux parties avec des crêtes de fréquence à "
"intervalles de f Hz, décalées de f/2 Hz entre les deux sorties. Mixer les "
"deux sorties restitue exactement le signal d'entrée."

#. i18n: file: data/effects/ladspa/ladspa_1411.xml
#: rc.cpp:7774
#, kde-format
msgid "The distance between the frequency peaks"
msgstr "La distance entre les crêtes de fréquence"

#. i18n: file: data/effects/ladspa/ladspa_1415.xml
#: rc.cpp:7778
#, kde-format
msgid "FM Oscillator"
msgstr "Oscillateur FM"

#. i18n: file: data/effects/ladspa/ladspa_1415.xml
#: rc.cpp:7780
#, kde-format
msgid "FM Oscillator (LADSPA 1415)"
msgstr "Oscillateur FM (LADSPA 1415)"

#. i18n: file: data/effects/ladspa/ladspa_1415.xml
#: rc.cpp:7784
#, kde-format
msgid "The shape of the waveform"
msgstr "La forme de l'onde"

#. i18n: file: data/effects/ladspa/ladspa_1415.xml
#: rc.cpp:7786
#, kde-format
msgid "Sine,Triangle,Square,Saw"
msgstr "Sinus,Triangle,Carré,Dent de scie"

#. i18n: file: data/effects/ladspa/ladspa_1423.xml
#: rc.cpp:7790
#, kde-format
msgid "SWH Plate Reverb"
msgstr "Réverbération à plaque SWH"

#. i18n: file: data/effects/ladspa/ladspa_1423.xml
#: rc.cpp:7792
#, kde-format
msgid ""
"SWH Plate Reverb (LADSPA 1423)<br>\n"
"   Automatically adapts to the number of channels and sampling rate of the "
"audio stream"
msgstr ""
"Réverbération à plaque SWH (LADSPA 1423)<br>\n"
"   S'adapte automatiquement au nombre de canaux et à la fréquence "
"d'échantillonnage du flux audio"

#. i18n: file: data/effects/ladspa/ladspa_1423.xml
#: rc.cpp:7794
#, kde-format
msgid "Reverb Time"
msgstr "Durée de réverbération"

#. i18n: file: data/effects/ladspa/ladspa_1423.xml
#. i18n: file: data/effects/ladspa/ladspa_reverb.xml
#. i18n: file: data/effects/ladspa/ladspa_room_reverb.xml
#: rc.cpp:7796 rc.cpp:8664 rc.cpp:8674
#, kde-format
msgid "Damping"
msgstr "Amortissement"

#. i18n: file: data/effects/ladspa/ladspa_1423.xml
#: rc.cpp:7798
#, kde-format
msgid "Dry/wet mix"
msgstr "Mixage sec / traité"

#. i18n: file: data/effects/ladspa/ladspa_1430.xml
#: rc.cpp:7802
#, kde-format
msgid "Chebyshev Distortion"
msgstr "Distorsion de Tchebychev"

#. i18n: file: data/effects/ladspa/ladspa_1430.xml
#: rc.cpp:7804
#, kde-format
msgid ""
"Chebyshev Distortion (LADSPA 1430)<br>\n"
"   This effect is seeded from incoming signal envelope. As the level of the "
"signal rises more and more harmonics will for added to the output signal. "
"The distortion control sets the sensitivity of the input."
msgstr ""
"Distorsion de Tchebychev (LADSPA 1430)<br>\n"
"   Cet effet est alimenté par l'enveloppe du signal entrant. À mesure que le "
"niveau du signal augmente, de plus en plus d'harmoniques sont ajoutées au "
"signal de sortie. Le contrôle de distorsion définit la sensibilité de "
"l'entrée."

#. i18n: file: data/effects/ladspa/ladspa_1430.xml
#: rc.cpp:7806
#, kde-format
msgid "Distortion"
msgstr "Distorsion"

#. i18n: file: data/effects/ladspa/ladspa_1430.xml
#: rc.cpp:7808
#, kde-format
msgid "Sets the sensitivity of the input"
msgstr "Définit la sensibilité de l'entrée"

#. i18n: file: data/effects/ladspa/ladspa_1431.xml
#: rc.cpp:7812
#, kde-format
msgid "Bode Frequency Shifter"
msgstr "Décaleur de fréquence de Bode"

#. i18n: file: data/effects/ladspa/ladspa_1431.xml
#: rc.cpp:7814
#, kde-format
msgid ""
"<b>Bode Frequency Shifter</b> (LADSPA 1431)<br>\n"
"   A Bode/Moog Frequency Shifter is a popular analogue synth module that "
"works by shifting all the frequencies of an input signal up or down by a "
"specified frequency. This effect shifts in both directions at the same time "
"as it is almost no extra work and is often useful to have both directions. "
"In contrast to the analogue Bode/Moog, which use Dome filters as the core, "
"it uses a Hilbert Transformer, which is much simpler to implement in digital "
"systems."
msgstr ""
"<b>Décaleur de fréquence de Bode</b> (LADSPA 1431)<br>\n"
"   Un décaleur de fréquence Bode/Moog est un module de synthétiseur "
"analogique populaire qui fonctionne en décalant toutes les fréquences d'un "
"signal d'entrée vers le haut ou vers le bas d'une fréquence donnée. Cet "
"effet décale dans les deux sens en même temps, car cela ne demande presque "
"aucun travail supplémentaire et il est souvent utile de disposer des deux "
"sens. Contrairement au Bode/Moog analogique, qui utilise des filtres Dome "
"comme cœur, il utilise un transformateur de Hilbert, beaucoup plus simple à "
"mettre en œuvre dans les systèmes numériques."

#. i18n: file: data/effects/ladspa/ladspa_1431.xml
#: rc.cpp:7816
#, kde-format
msgid "Frequency Shift"
msgstr "Décalage de fréquence"

#. i18n: file: data/effects/ladspa/ladspa_1431.xml
#. i18n: file: data/effects/ladspa/ladspa_1432.xml
#: rc.cpp:7818 rc.cpp:7836
#, kde-format
msgid "Controls the frequency shift applied to the input signal"
msgstr "Contrôle le décalage de fréquence appliqué au signal d'entrée"

#. i18n: file: data/effects/ladspa/ladspa_1432.xml
#: rc.cpp:7822
#, kde-format
msgid "Bode Frequency Shifter (CV)"
msgstr "Décaleur de fréquence de Bode (CV)"

#. i18n: file: data/effects/ladspa/ladspa_1432.xml
#: rc.cpp:7824
#, kde-format
msgid ""
"<b>Bode Frequency Shifter (CV)</b> (LADSPA 1432)<br>\n"
"   A Bode/Moog Frequency Shifter is a popular analogue synth module that "
"works by shifting all the frequencies of an input signal up or down by a "
"specified frequency. This effect shifts in both directions at the same time "
"as it is almost no extra work and is often useful to have both directions. "
"In contrast to the analogue Bode/Moog, which use Dome filters as the core, "
"it uses a Hilbert Transformer, which is much simpler to implement in digital "
"systems."
msgstr ""
"<b>Décaleur de fréquence de Bode (CV)</b> (LADSPA 1432)<br>\n"
"   Un décaleur de fréquence Bode/Moog est un module de synthétiseur "
"analogique populaire qui fonctionne en décalant toutes les fréquences d'un "
"signal d'entrée vers le haut ou vers le bas d'une fréquence donnée. Cet "
"effet décale dans les deux sens en même temps, car cela ne demande presque "
"aucun travail supplémentaire et il est souvent utile de disposer des deux "
"sens. Contrairement au Bode/Moog analogique, qui utilise des filtres Dome "
"comme cœur, il utilise un transformateur de Hilbert, beaucoup plus simple à "
"mettre en œuvre dans les systèmes numériques."

#. i18n: file: data/effects/ladspa/ladspa_1432.xml
#: rc.cpp:7826
#, kde-format
msgid "Base Shift"
msgstr "Décalage de base"

#. i18n: file: data/effects/ladspa/ladspa_1432.xml
#: rc.cpp:7830
#, kde-format
msgid "Down,Both,Up"
msgstr "Vers le bas,Les deux,Vers le haut"

#. i18n: file: data/effects/ladspa/ladspa_1432.xml
#: rc.cpp:7832
#, kde-format
msgid "CV Attenuation"
msgstr "Atténuation CV"

#. i18n: file: data/effects/ladspa/ladspa_1432.xml
#: rc.cpp:7834
#, kde-format
msgid "Shift CV"
msgstr "Décalage CV"

#. i18n: file: data/effects/ladspa/ladspa_1433.xml
#: rc.cpp:7840
#, kde-format
msgid "AM Pitch Shifter"
msgstr "Décaleur de hauteur AM"

#. i18n: file: data/effects/ladspa/ladspa_1433.xml
#: rc.cpp:7842
#, kde-format
msgid ""
"AM Pitch Shifter (LADSPA 1433)<br>\n"
"   This effect works by running a single write pointer (monotonic) and two "
"read pointers (pitchscaled) over a ringbuffer. The output is faded between "
"the two readpointers according to the sine of the distance from the write "
"pointer."
msgstr ""
"Décaleur de hauteur AM (LADSPA 1433)<br>\n"
"   Cet effet fonctionne en faisant parcourir un tampon circulaire par un "
"pointeur d'écriture unique (monotone) et deux pointeurs de lecture (à "
"hauteur modifiée). La sortie passe en fondu entre les deux pointeurs de "
"lecture selon le sinus de la distance au pointeur d'écriture."

#. i18n: file: data/effects/ladspa/ladspa_1433.xml
#. i18n: file: data/effects/ladspa/ladspa_pitch.xml
#: rc.cpp:7844 rc.cpp:8640
#, kde-format
msgid "Pitch Shift"
msgstr "Modulation de hauteur"

#. i18n: file: data/effects/ladspa/ladspa_1433.xml
#: rc.cpp:7846
#, kde-format
msgid ""
"The multiple of the output pitch.<br>\n"
"      For example, 2.00 will increase the pitch by one octave."
msgstr ""
"Le multiple de la hauteur de sortie.<br>\n"
"      Par exemple, 2,00 augmentera la hauteur d'une octave."

#. i18n: file: data/effects/ladspa/ladspa_1433.xml
#: rc.cpp:7848
#, kde-format
msgid "Buffer Size"
msgstr "Taille du tampon"

#. i18n: file: data/effects/ladspa/ladspa_1433.xml
#: rc.cpp:7850
#, kde-format
msgid ""
"The order of magnitude of the buffer size.<br>\n"
"      Small buffers will sound fluttery, large buffers will have flangy "
"sounding echos."
msgstr ""
"L'ordre de grandeur de la taille du tampon.<br>\n"
"      Les petits tampons produiront un son vacillant, les grands tampons "
"produiront des échos au son de flanger."

#. i18n: file: data/effects/ladspa/ladspa_1438.xml
#: rc.cpp:7854
#, kde-format
msgid "DJ Flanger"
msgstr "Flanger DJ"

#. i18n: file: data/effects/ladspa/ladspa_1438.xml
#: rc.cpp:7856
#, kde-format
msgid ""
"DJ Flanger (LADSPA 1438)<br>\n"
"   This is a flanger which is more or less typical of DJ mixing desks"
msgstr ""
"Flanger DJ (LADSPA 1438)<br>\n"
"   Ceci est un flanger plus ou moins typique des tables de mixage de DJ"

#. i18n: file: data/effects/ladspa/ladspa_1438.xml
#: rc.cpp:7858
#, kde-format
msgid "LFO sync"
msgstr "Synchronisation du LFO"

#. i18n: file: data/effects/ladspa/ladspa_1438.xml
#: rc.cpp:7860
#, kde-format
msgid ""
"When turned from off to on<br>\n"
"      it resets the phase of the LFO back to the start of the cycle. Used to "
"sync the LFO to the track."
msgstr ""
"Lors du passage de désactivé à activé,<br>\n"
"      réinitialise la phase du LFO au début du cycle. Utilisé pour "
"synchroniser le LFO avec le morceau."

#. i18n: file: data/effects/ladspa/ladspa_1438.xml
#: rc.cpp:7862
#, kde-format
msgid "LFO period"
msgstr "Période du LFO"

#. i18n: file: data/effects/ladspa/ladspa_1438.xml
#: rc.cpp:7864
#, kde-format
msgid "The cycle period of the LFO in seconds"
msgstr "La période du cycle du LFO en secondes"

#. i18n: file: data/effects/ladspa/ladspa_1438.xml
#: rc.cpp:7868
#, kde-format
msgid "The maximum delay the LFO will use to flange in milliseconds"
msgstr "Le retard maximal utilisé par le LFO pour le flanger, en millisecondes"

#. i18n: file: data/effects/ladspa/ladspa_1438.xml
#: rc.cpp:7872
#, kde-format
msgid "The amount of the delays output that is mixed back into the delay"
msgstr "La quantité de sortie des retards réinjectée dans le retard"

#. i18n: file: data/effects/ladspa/ladspa_1886.xml
#: rc.cpp:7876
#, kde-format
msgid "Exponential Signal Decay"
msgstr "Décroissance exponentielle du signal"

#. i18n: file: data/effects/ladspa/ladspa_1886.xml
#: rc.cpp:7878
#, kde-format
msgid "Exponential Signal Decay (LADSPA 1886)"
msgstr "Décroissance exponentielle du signal (LADSPA 1886)"

#. i18n: file: data/effects/ladspa/ladspa_1887.xml
#: rc.cpp:7884
#, kde-format
msgid "Comb Delay Line (linear interpolation)"
msgstr "Ligne de retard en peigne (interpolation linéaire)"

#. i18n: file: data/effects/ladspa/ladspa_1887.xml
#: rc.cpp:7886
#, kde-format
msgid ""
"Comb Delay Line (linear interpolation) (LADSPA 1887)<br>\n"
"   Based on work by James McCartney in SuperCollider."
msgstr ""
"Ligne de retard en peigne (interpolation linéaire) (LADSPA 1887)<br>\n"
"   Basé sur le travail de James McCartney dans SuperCollider."

