#: rc.cpp:3528
#, kde-format
msgid ""
"If <em>Reflect Edges</em> is not checked, <br>\n"
"        this parameter defines the preferred corner."
msgstr ""
"Si l'option <em>Réfléchir les bords</em> est non sélectionnée, <br>\n"
"        ce paramètre définit le coin préféré."

