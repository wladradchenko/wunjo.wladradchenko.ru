#: rc.cpp:6022
#, kde-format
msgid "Apply Gaussian Blur filter"
msgstr "Appliquer le filtre de flou gaussien"

#. i18n: file: data/effects/avfilter/avfilter_gblur.xml
#: rc.cpp:6026
#, kde-format
msgid "Set number of steps for Gaussian approximation"
msgstr "Définir le nombre d'étapes pour l'approximation gaussienne"

#. i18n: file: data/effects/avfilter/avfilter_gblur.xml
#: rc.cpp:6028
#, kde-format
msgid "1,2,3,4,5,6"
msgstr "1, 2, 3, 4, 5, 6"

#. i18n: file: data/effects/avfilter/avfilter_gblur.xml
#: rc.cpp:6032
#, kde-format
msgid ""
"Set which planes to filter.<br>\n"
"        By default all planes are filtered (YUV)."
msgstr ""
"Définir les plans à filtrer. <br>\n"
"        Par défaut, tous les plans sont filtrés (YUV)."

#. i18n: file: data/effects/avfilter/avfilter_gblur.xml
#: rc.cpp:6038
#, kde-format
msgid ""
"Set sigma, the standard deviation of Gaussian blur.<br>\n"
"        Determines the strength of the horizontal blur. Default is 10."
msgstr ""
"Définir le sigma, l'écart type du flou gaussien. <br>\n"
"        Détermine la force du floutage horizontal. La valeur par défaut est "
