msgstr "Hauteur"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_transform_360.xml
#: rc.cpp:2576 rc.cpp:2866
#, kde-format
msgid ""
"The amount to rotate the image<br>\n"
"    \t(nose up or down)."
msgstr ""
"La quantité pour le pivotement de l'image<br>\n"
"        (Le nez vers le haut ou vers le bas)."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_stereo.xml
#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_transform_360.xml
#: rc.cpp:2578 rc.cpp:2602 rc.cpp:2868
#, kde-format
msgid "Roll"
msgstr "Roulis"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_transform_360.xml
#: rc.cpp:2580 rc.cpp:2870
#, kde-format
msgid ""
"The amount to rotate the image<br>\n"
"    \t(clockwise or anticlockwise rotation along the axis of movement)."
msgstr ""
"La quantité de pivotement de l'image<br>\n"
"        (Rotation dans le sens ou dans le sens inverse des aiguilles d'une "
"montre, le long de l'axe de mouvement)."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_stereo.xml
#: rc.cpp:2582 rc.cpp:2604
#, kde-format
msgid "FOV"
msgstr "Champ de vision (FOV)"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#: rc.cpp:2584
#, kde-format
msgid ""
"The horizontal field of view, in degrees, of the resulting frame.<br>\n"
"    \tAny value over 179 results in a fisheye projection."
msgstr ""
"Le champ de vision horizontal, en degrés, de la trame résultante.<br>\n"
"        Toute valeur supérieure à 179 entraîne une projection en grand-angle."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#: rc.cpp:2586
#, kde-format
msgid "Fisheye"
msgstr "Grand angle"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#: rc.cpp:2588
#, kde-format
msgid ""
"The amount of fisheye to mix in.<br>\n"
"    \t100 means that you get a 100% fisheye lens."
msgstr ""
"La quantité de grand angle à mélanger.<br>\n"
"        Une valeur de 100 signifie que vous obtenez une lentille à 100 % en "
"grand angle."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_stereo.xml
#: rc.cpp:2594
#, kde-format
msgid "VR360 Equirectangular to Stereo"
msgstr "Équirectangulaire « VR360 » vers Stéréo"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_stereo.xml
#: rc.cpp:2596
#, kde-format
msgid ""
"Projects a stereographic image from an equirectangular. Use this to create "
"the little planet effect from a VR360 footage."
msgstr ""
"Projette une image stéréographique à partir d'un équirectangulaire. Veuillez "
"utiliser ceci pour créer l'effet de petite planète à partir d'une séquence "
"« VR360 »."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_stereo.xml
#. i18n: file: data/effects/frei0r/frei0r_defish0r.xml
