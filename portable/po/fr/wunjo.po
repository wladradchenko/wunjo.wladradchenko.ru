#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8416
#, kde-format
msgid ""
"TAP Dynamics Stereo (LADSPA 2153)<br>\n"
"   Allows changing the dynamic content of the audio stream"
msgstr ""
"TAP Dynamics Stereo (LADSPA 2153)<br>\n"
"   Permet de modifier le contenu dynamique du flux audio"

#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8428
#, kde-format
msgid ""
"Controls how the envelope levels<br>\n"
"      are used to determine the needed gain adjustment"
msgstr ""
"Contrôle la façon dont les niveaux de l'enveloppe<br>\n"
"      sont utilisés pour déterminer l'ajustement nécessaire de gain"

#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8430
#, kde-format
msgid "Independent,Average,Peak"
msgstr "Indépendant, Moyenne, Pic"

#. i18n: file: data/effects/ladspa/ladspa_2154.xml
#: rc.cpp:8438
#, kde-format
msgid "TAP Reflector"
msgstr "Réflecteur TAP"

#. i18n: file: data/effects/ladspa/ladspa_2154.xml
#: rc.cpp:8440
#, kde-format
msgid ""
"TAP Reflector (LADSPA 2154)<br>\n"
"    Creates a psychedelic reverse audio effect."
msgstr ""
"Réflecteur TAP (LADSPA 2154)<br>\n"
"    Crée un effet audio psychédélique inversé."

#. i18n: file: data/effects/ladspa/ladspa_2154.xml
#: rc.cpp:8442
#, kde-format
msgid "Fragment Length"
msgstr "Longueur de fragment"

#. i18n: file: data/effects/ladspa/ladspa_2154.xml
#: rc.cpp:8444
#, kde-format
msgid ""
"It is best to set it to<br>\n"
"      approximately match the tempo of the track, so the Fragment Length is "
"equal to the time of one measure."
msgstr ""
"Il est préférable de la régler pour<br>\n"
"      correspondre approximativement au tempo de la piste, de sorte que la "
"longueur du fragment soit égale au temps d'une mesure."

#. i18n: file: data/effects/ladspa/ladspa_2155.xml
#: rc.cpp:8452
#, kde-format
msgid "TAP Pink/Fractal Noise"
msgstr "Bruit rose / fractal TAP"

#. i18n: file: data/effects/ladspa/ladspa_2155.xml
#: rc.cpp:8454
#, kde-format
msgid ""
"TAP Pink/Fractal Noise (LADSPA 2155)<br>\n"
"    Adds pink noise to the incoming signal using a one-dimensional random "
"fractal line generated by the Midpoint Displacement Method."
msgstr ""
"TAP Bruit Rose / Fractal (LADSPA 2155)<br>\n"
"    Ajoute du bruit rose au signal entrant à l'aide d'une ligne fractale "
"aléatoire unidimensionnelle générée par la méthode de déplacement du point "
"médian."

#. i18n: file: data/effects/ladspa/ladspa_2155.xml
#: rc.cpp:8456
#, kde-format
msgid "Fractal Dimension"
msgstr "Dimension fractale"

#. i18n: file: data/effects/ladspa/ladspa_2155.xml
#: rc.cpp:8458
#, kde-format
msgid "Signal Level"
msgstr "Niveau de signal"

#. i18n: file: data/effects/ladspa/ladspa_2155.xml
#: rc.cpp:8460
#, kde-format
msgid "Noise Level"
msgstr "Niveau de bruit"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8464
#, kde-format
msgid "TAP Fractal Doubler"
msgstr "Doubleur fractal TAP"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8466
#, kde-format
msgid ""
"TAP Fractal Doubler (LADSPA 2156)<br>\n"
"    Suitable for doubling tracks with vocals, acoustic/electric guitars, "
"bass and just about any other instrument on them."
msgstr ""
"Doubleur fractal TAP (LADSPA 2156)<br>\n"
"    Convient pour doubler des pistes avec des voix, des guitares "
"acoustiques / électriques, des basses et à peu près n'importe quel autre "
"instrument en plus de ceux-ci."

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8468
#, kde-format
msgid "Time Tracking"
msgstr "Suivi du temps"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8470 rc.cpp:8474
#, kde-format
msgid ""
"Determines how \"rough\" and how big<br>\n"
"      these changes are. When set to 0, changes are bigger and more chaotic "
"(\"bad backup singer\"). When set to 1, changes are smaller and smoother "
"(\"better tracking of the original\")."
msgstr ""
"Détermine le niveaux de « rugosité  »et de taille<br>\n"
"      pour ces modifications. Lorsqu'ils sont définis à la valeur 0, les "
"modifications sont plus importantes et chaotiques (« Mauvais chanteur de "
"seconde zone »). Lorsqu'ils sont réglés sur la valeur 1, les modifications "
"sont plus limitées et plus fluides (« Meilleur suivi de l'original »)."

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8472
#, kde-format
msgid "Pitch Tracking"
msgstr "Suivi en hauteur"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8478
#, kde-format
msgid "Dry Left Position"
msgstr "Position sèche à gauche"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8480 rc.cpp:8484 rc.cpp:8490 rc.cpp:8494
#, kde-format
msgid ""
"These controls range between 0 and 1,<br>\n"
"      0 meaning hard left and 1 meaning hard right position."
msgstr ""
"Ceux-ci contrôlent un intervalle allant de 0 à 1.<br>\n"
"      La valeur 0 signifie fort à gauche et la valeur 1 fort à droite."

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8482
#, kde-format
msgid "Dry Right Position"
msgstr "Position sèche à droite"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8488
#, kde-format
msgid "Wet Left Position"
msgstr "Position humide à gauche"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8492
#, kde-format
msgid "Wet Right Position"
msgstr "Position humide à droite"

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8498
#, kde-format
msgid "TAP Sigmoid Booster"
msgstr "TAP Sigmoid Booster"

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8500
#, kde-format
msgid ""
"TAP Sigmoid Booster (LADSPA 2157)<br>\n"
"   Applies a time-invariant nonlinear amplitude transfer function to the "
"signal."
msgstr ""
"TAP Sigmoid Booster (LADSPA 2157)<br>\n"
"   Applique une fonction de transfert d'amplitude non linéaire invariante "
"dans le temps au signal."

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8502
#, kde-format
msgid "Pre Gain"
msgstr "Pré gain"

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8504
#, kde-format
msgid "Scales the input signal before the transfer function is applied to it."
msgstr ""
"Met à l'échelle le signal d'entrée avant que la fonction de transfert ne lui "
"soit appliquée."

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8506
#, kde-format
msgid "Post Gain"
msgstr "Post-gain"

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8508
#, kde-format
msgid "Can be used to adjust the output gain of the effect."
msgstr "Peut être utilisé pour ajuster le gain de sortie de l'effet."

#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:8512
#, kde-format
msgid "TAP TubeWarmth"
msgstr "TAP TubeWarmth"

#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:8514
#, kde-format
msgid ""
"TAP TubeWarmth (LADSPA 2158)<br>\n"
"   Adds the character of vacuum tube amplification by emulating the "
"sonically desirable nonlinear characteristics of triodes. It also supports "
"emulating analog tape saturation."
msgstr ""
"TAP TubeWarmth (LADSPA 2158)<br>\n"
"   Ajoute la caractéristique de l'amplification avec un tube à vide en "
"émulant les caractéristiques non linéaires des triodes souhaitables sur le "
"plan sonore. Il prend également en charge l'émulation de la saturation de la "
"bande analogique."

#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:8518
#, kde-format
msgid "Adjusts the amount of the effect"
msgstr "Ajuste la quantité associée à l'effet"

#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:8520
#, kde-format
msgid "Tape--Tube Blend"
msgstr "Cassette - Mélange de tubes"

#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:8522
#, kde-format
msgid "Controls the color of the TubeWarmth sound"
msgstr "Contrôle la couleur du son TubeWarmth"

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8526
#, kde-format
msgid "TAP Chorus/Flange"
msgstr "TAP Chorus / Flange"

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8528
#, kde-format
msgid ""
"TAP Chorus/Flange (LADSPA 2159)<br>\n"
"    Creates traditional Chorus and Flanger effects, spiced up a bit to make "
"use of stereo processing. It sounds best on guitar and synth tracks."
msgstr ""
"TAP Chorus / Flange (LADSPA 2159)<br>\n"
"    Crée des effets traditionnels « Chorus » et « Flanger », un peu pimentés "
"pour utiliser le traitement stéréo. Cela sonne mieux sur les pistes de "
"guitare et de synthétiseur."

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8532
#, kde-format
msgid ""
"Determines the LFO frequency<br>\n"
"      with which the time-varying delay is modulated. The higher the "
"frequency, the more intense the effect will be."
msgstr ""
"Détermine la fréquence LFO<br>\n"
"      avec laquelle le retard variable dans le temps est modulé. Plus la "
"fréquence est élevée, plus l'effet sera intense."

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8534
#, kde-format
msgid "L/R Phase Shift"
msgstr "Décalage de phase en gauche / droite"

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8536
#, kde-format
msgid ""
"Controls the phase shift between the two<br>\n"
"      LFOs. The higher this setting, the stronger the \"stereo-ness\" of the "
"effect will be. When set to 0, processing of the two channels will be in-"
"phase; when set to 180 degrees, the two LFO's are is counter-phase to create "
"the widest stereo effect."
msgstr ""
"Contrôle le décalage de phase entre les deux<br>\n"
"      LFOs. Plus ce paramètre est élevé, plus la « stéréo-apparition » de "
"l'effet sera forte. Lorsqu'il est défini à la valeur 0, le traitement des "
"deux canaux sera fait en phase. Lorsqu'il est réglé sur la valeur de 180 "
"degrés, les deux LFO sont en phase opposée pour la création d'un effet "
"stéréo le plus large possible."

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8540
#, kde-format
msgid ""
"Adjusts the modulation depth of the delay.<br>\n"
"      Increasing it will result in stronger modulation using the same LFO "
"frequency."
msgstr ""
"Ajuste la profondeur de modulation du retard.<br>\n"
"     Son augmentation entraînera une modulation plus forte en utilisant la "
"même fréquence LFO."

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8544
#, kde-format
msgid ""
"Determines the fixed amount of time with<br>\n"
"      which the signal is delayed after the time-varying delay has been "
"applied. The setting of this control distinguishes between the Chorus and "
"Flanger effects. Delays smaller than 10 ms can be labeled Flanger, delays "
"above 20 ms yield Chorus, and delays in the range of 10-20 ms result in a "
"blend between Chorus and Flanger."
msgstr ""
"Détermine la durée fixe pendant laquelle<br>\n"
"      le signal est retardé après l'application du retard variable de temps. "
"Le paramétrage de ce contrôle distingue les effets « Chorus » et "
"« Flanger ». Les retards inférieurs à 10 ms peuvent être considérés comme un "
"effet « Flanger ». Les retards supérieurs à 20 ms produisent un effet "
"« Chorus ». Enfin, les retards de l'ordre de 10 à 20 ms entraînent un "
"mélange entre les deux effets."

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8546
#, kde-format
msgid "Contour"
msgstr "Contour"

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8548
#, kde-format
msgid ""
"The cutoff frequency of a high-pass<br>\n"
"      filter applied to the now twice-delayed signal."
msgstr ""
"La fréquence de coupure d'un filtre passe-haut<br>\n"
"      appliqué au signal courant deux fois retardé."

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8552 rc.cpp:8556
#, kde-format
msgid ""
"Allows for a final tuning of the sound.<br>\n"
"      The strongest effect is achieved if the two settings are about the "
"same. Decreasing one of them (preferably the Wet Level, to mitigate any "
"unwanted side effects) results in a subtler effect."
msgstr ""
"Permet un réglage final du son.<br>\n"
"      L'effet le plus fort est obtenu si les deux paramètres sont à peu près "
"identiques. La diminution de l'un d'entre eux (De préférence le niveau "
"humide, pour atténuer les effets secondaires indésirables) entraîne un effet "
"plus subtil."

