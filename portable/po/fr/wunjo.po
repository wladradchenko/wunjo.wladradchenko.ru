#, kde-format
msgid "Peak Limit"
msgstr "Limite de crête"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#: rc.cpp:7678
#, kde-format
msgid ""
"Controls the desired limit<br>\n"
"      of the output signal"
msgstr ""
"Contrôle la limite souhaitée<br>\n"
"      du signal de sortie"

