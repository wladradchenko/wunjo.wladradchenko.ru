msgstr "Contrôle le gain du signal d'entrée"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7636
#, kde-format
msgid "Controls the amount of output signal fed back into the input"
msgstr "Contrôle la quantité de signal de sortie réinjectée dans l'entrée"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7638
#, kde-format
