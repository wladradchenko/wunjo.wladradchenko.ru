#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7050
#, kde-format
msgid "Stereo tools"
msgstr "Outils pour la stéréo"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7052
#, kde-format
msgid ""
"This filter has some handy utilities to manage stereo signals, for "
"converting M/S stereo recordings to L/R signal while having control over the "
"parameters or spreading the stereo image of master track."
msgstr ""
"Ce filtre dispose de quelques outils pratiques pour gérer les signaux "
"stéréo, pour convertir des enregistrements stéréo M/S en signal G/D tout en "
"contrôlant les paramètres, ou pour élargir l'image stéréo de la piste "
"principale."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7054
#, kde-format
msgid "Level IN"
msgstr "Niveau d'entrée"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7056 rc.cpp:7060
#, kde-format
msgid ""
"Set input level before filtering for both channels.\n"
"Allowed range is from 0.015625 to 64."
msgstr ""
"Définissez le niveau d'entrée avant le filtrage des deux canaux.\n"
"L'intervalle autorisé est de 0,015625 à 64."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7058
#, kde-format
msgid "Level OUT"
msgstr "Niveau de sortie"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7062 rc.cpp:7120
#, kde-format
msgid "Balance IN"
msgstr "Balance en entrée"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7064 rc.cpp:7068
#, kde-format
msgid ""
"Set input balance between both channels. Default is 0. Allowed range is from "
"-1 to 1."
msgstr ""
"Définissez l'équilibre d'entrée entre les deux canaux. La valeur par défaut "
"est de 0. L'intervalle autorisé est de -1 à 1."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7066 rc.cpp:7126
#, kde-format
msgid "Balance OUT"
msgstr "Balance en sortie"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7070
#, kde-format
msgid "Softclip"
msgstr "Softclip"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7072
#, kde-format
msgid ""
"Enable softclipping. Results in analog distortion instead of harsh digital "
"0dB clipping."
msgstr ""
"Activez le découpage doux. Il en résulte une distorsion analogique au lieu "
"d'un écrêtage numérique sévère de 0 dB."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7074
#, kde-format
msgid "Mute Left"
msgstr "Mettre en pause à gauche"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7076
#, kde-format
msgid "Mute Right"
msgstr "Mettre en sourdine à droite"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7078
#, kde-format
msgid "Phase Left"
msgstr "Phase à gauche"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7080
#, kde-format
msgid "Change the phase of the left channel."
msgstr "Modifier la phase du canal gauche."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7082
#, kde-format
msgid "Phase Right"
msgstr "Phase à droite"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7084
#, kde-format
msgid "Change the phase of the right channel."
msgstr "Modifier la phase du canal droit."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:7086 rc.cpp:8426
#, kde-format
msgid "Stereo Mode"
msgstr "Mode stéréo"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7088
#, kde-format
msgid ""
"Left/Right to Left/Right,Left/Right to Mid/Side,Mid/Side to Left/Right,Left/"
"Right to Left/Left,Left/Right to Right/Right,Left/Right to Left + Right,Left/"
"Right to Right/Left,Mid/Side to Left/Left,Mid/Side to Right/Right,Mid/Side "
"to Right/Left,Left/Right to Left - Right"
msgstr ""
"Gauche / Droite à Gauche / Droite, Gauche / Droite à Central / Latéral, "
"Central / Latéral à Gauche / Droite, Gauche / Droite à Gauche + Droite, "
"Gauche / Droite à Droite / Gauche, Central / Latéral à Gauche / Gauche, "
"Central / Latéral à Droite / Droite, Central / Latéral à Droite / Gauche, "
"Gauche / Droite à Gauche - Droite"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7090
#, kde-format
msgid "Side Level"
msgstr "Niveau latéral"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7092
#, kde-format
msgid ""
"Set level of side signal. Default is 1. Allowed range is from 0.015625 to 64."
msgstr ""
"Définir le niveau du signal latéral. La valeur par défaut est 1. "
"L'intervalle autorisé est de 0,015625 à 64."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7094
#, kde-format
msgid "Side Balance"
msgstr "Balance latérale"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7096
#, kde-format
msgid ""
"Set balance of side signal. Default is 0. Allowed range is from -1 to 1."
msgstr ""
"Régler l'équilibre du signal latéral. La valeur par défaut est 0. "
"L'intervalle autorisé est de -1 à 1."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7098
#, kde-format
msgid "Mid Level"
msgstr "Niveau médian"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7100
#, kde-format
msgid ""
"Set level of the middle signal. Default is 1. Allowed range is from 0.015625 "
"to 64."
msgstr ""
"Définir le niveau du signal médian. La valeur par défaut est 1. L'intervalle "
"autorisé est de 0,015625 à 64."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7102
#, kde-format
msgid "Mid Pan"
msgstr "Panoramique moyen"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7104
#, kde-format
msgid "Set middle signal pan. Default is 0. Allowed range is from -1 to 1."
msgstr ""
"Régler le panoramique médian du signal. La valeur par défaut est 0. "
"L'interface autorisé est de -1 à 1."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7106
#, kde-format
msgid "Stereo base"
msgstr "Base de stéréo"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7108
#, kde-format
msgid ""
"Set stereo base between mono and inverted channels. Default is 0. Allowed "
"range is from -1 to 1."
msgstr ""
"Définissez la base stéréo entre les canaux mono et inversé. La valeur par "
"défaut est 0. L'intervalle autorisé est de -1 à 1."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7112
#, kde-format
msgid ""
"Set delay in milliseconds how much to delay left from right channel and vice "
"versa. Default is 0. Allowed range is from -20 to 20."
msgstr ""
"Définissez le retard en millisecondes de combien il faut retarder le canal "
"de gauche vis-à-vis du droit et inversement. La valeur par défaut est 0. "
"L'intervalle autorisé est de -20 à 20."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7114
#, kde-format
msgid "S/C level"
msgstr "Niveau S / C"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7116
#, kde-format
msgid "Stereo phase"
msgstr "Phase pour stéréo"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7118
#, kde-format
msgid "Set the stereo phase in degrees."
msgstr "Définir la phase stéréo en degrés."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7122 rc.cpp:7128
#, kde-format
msgid ""
"‘balance’\n"
"Classic balance mode. Attenuate one channel at a time. Gain is raised up to "
"1.\n"
"‘amplitude’\n"
"Similar to classic mode above but gain is raised up to 2.\n"
"‘power’\n"
"Equal power distribution, from -6dB to +6dB range."
msgstr ""
"« balance »\n"
"Mode d'équilibrage classique. Atténuez un canal à la fois. Le gain est "
"augmenté jusqu'à 1.\n"
"« amplitude »\n"
"Similaire au mode classique ci-dessus, mais le gain est augmenté jusqu'à 2.\n"
"« power »\n"
"Distribution de puissance égale, de -6 dB à +6 dB."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7124 rc.cpp:7130
#, kde-format
msgid "balance,amplitude,power"
msgstr "balance, amplitude, puissance"

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7132
#, kde-format
msgid "Stereo widener"
msgstr "Élargisseur stéréo"

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7134
#, kde-format
msgid ""
"This filter enhance the stereo effect by suppressing signal common to both "
"channels and by delaying the signal of left into right and vice versa, "
"thereby widening the stereo effect."
msgstr ""
"Ce filtre améliore l'effet stéréo par suppression du signal commun aux deux "
"canaux et en retardant le signal à gauche vers la droite et vice versa, "
"élargissant ainsi l'effet stéréo."

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7138
#, kde-format
msgid ""
"Time in milliseconds of the delay of left signal into right and vice versa."
msgstr ""
"Temps en millisecondes du retard du signal gauche par rapport à celui de "
"droite et inversement."

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7140
#, kde-format
msgid "Feedback Gain"
msgstr "Gain en retour"

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7142
#, kde-format
msgid ""
"Amount of gain in delayed signal into right and vice versa.\n"
"Gives a delay effect of left signal in right output and vice versa which "
"gives widening effect."
msgstr ""
"Montant du gain du signal retardé vers la droite et inversement.\n"
"Donne un effet de retard du signal gauche dans la sortie droite et "
"inversement ce qui donne un effet d'élargissement."

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7144
#, kde-format
msgid "Cross feed"
msgstr "Alimentation croisée"

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7146
#, kde-format
msgid ""
"Cross feed of left into right with inverted phase. This helps in suppressing "
"the mono.\n"
"If the value is 1 it will cancel all the signal common to both channels."
msgstr ""
"Alimentation croisée de la gauche vers la droite avec phase inversée. Cela "
"aide à supprimer le mono.\n"
"Si la valeur est 1, cela annulera tout le signal commun aux deux canaux."

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7148
#, kde-format
msgid "Drymix"
msgstr "Drymix"

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7150
#, kde-format
msgid "Set level of input signal of original channel."
msgstr "Définir le niveau du signal d'entrée du canal d'origine."

#. i18n: file: data/effects/avfilter/avfilter_swapuv.xml
#: rc.cpp:7152
#, kde-format
msgid "Swap UV"
msgstr "Échanger U et V"

#. i18n: file: data/effects/avfilter/avfilter_swapuv.xml
#: rc.cpp:7154
#, kde-format
msgid "Swap U and V components"
msgstr "Échanger les composants U et V"

#. i18n: file: data/effects/avfilter/avfilter_tmix.xml
#: rc.cpp:7156
#, kde-format
msgid "Temporal frames Mixer"
msgstr "Mélangeur temporel de trames"

#. i18n: file: data/effects/avfilter/avfilter_tmix.xml
#: rc.cpp:7158
#, kde-format
msgid "Mix successive video frames"
msgstr "Mélanger les trames vidéo successives"

#. i18n: file: data/effects/avfilter/avfilter_tmix.xml
#: rc.cpp:7160
#, kde-format
msgid "Frames to mix"
msgstr "Trames à mélanger"

#. i18n: file: data/effects/avfilter/avfilter_transpose.xml
#: rc.cpp:7162
#, kde-format
msgid "Transpose"
msgstr "Transposer"

#. i18n: file: data/effects/avfilter/avfilter_transpose.xml
#: rc.cpp:7164
#, kde-format
msgid "Transpose rows with columns in the input video and optionally flip it"
msgstr ""
"Transposer les lignes avec des colonnes dans la vidéo d'entrée et "
"éventuellement la faire pivoter"

#. i18n: file: data/effects/avfilter/avfilter_transpose.xml
#: rc.cpp:7168
#, kde-format
msgid "Clock,Clock flip,Counter clock,Counter clock flip"
msgstr ""
"Horloge, Inversion d'horloge, Horloge de compteur, Inversion d'horloge de "
"compteur"

#. i18n: file: data/effects/avfilter/avfilter_transpose.xml
#: rc.cpp:7170
#, kde-format
msgid "Override if"
msgstr "Écraser si"

#. i18n: file: data/effects/avfilter/avfilter_transpose.xml
#: rc.cpp:7172
#, kde-format
msgid "None,Portrait,Landscape"
msgstr "Aucun, Portrait, Paysage"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7174
#, kde-format
msgid "Sharp/Unsharp"
msgstr "Accentuer / Désaccentuer"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7176
#, kde-format
msgid "Sharpen or unsharpen/blur your video"
msgstr "Accentuer ou désaccentuer / flouter votre vidéo"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7178
#, kde-format
msgid "Luma horizontal matrix"
msgstr "Matrice horizontale de luminosité"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7180
#, kde-format
msgid "Set the luma matrix horizontal size"
msgstr "Définir la taille horizontale de la matrice de luminosité"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7182
#, kde-format
msgid "Luma vertical matrix"
msgstr "Matrice verticale de luminosité"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7184
#, kde-format
msgid "Set the luma matrix vertical size"
msgstr "Définir la taille verticale de la matrice de luminosité"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7188
#, kde-format
msgid ""
"Set the luma effect strength.<br>\n"
"            Reasonable values are between -1.5 and 1.5. Negative values will "
"blur the input video, while positive values will sharpen it, a value of 0 "
"will disable the effect."
msgstr ""
"Définir l'intensité de l'effet sur la luminance.<br>\n"
"            Les valeurs raisonnables sont comprises entre -1,5 et 1,5. Les "
"valeurs négatives flouteront la vidéo d'entrée, tandis que les valeurs "
"positives l'accentueront. Une valeur de 0 désactivera l'effet."

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7190
#, kde-format
msgid "Chroma horizontal matrix"
msgstr "Matrice horizontale de chrominance"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7192
#, kde-format
msgid "Set the chroma matrix horizontal size"
msgstr "Définir la taille horizontale de la matrice de chrominance"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7194
#, kde-format
msgid "Chroma vertical matrix"
msgstr "Matrice verticale de chrominance"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7196
#, kde-format
msgid "Set the chroma matrix vertical size"
msgstr "Définir la taille verticale de la matrice de chrominance"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7200
#, kde-format
msgid ""
"Set the chroma effect strength.<br>\n"
"            Reasonable values are between -1.5 and 1.5. Negative values will "
"blur the input video, while positive values will sharpen it, a value of zero "
"will disable the effect."
msgstr ""
"Définir l'intensité de l'effet sur la chrominance.<br>\n"
"            Les valeurs raisonnables sont comprises entre -1,5 et 1,5. Les "
"valeurs négatives flouteront la vidéo d'entrée, tandis que les valeurs "
"positives l'accentueront. Une valeur de zéro désactivera l'effet."

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7202
#, kde-format
msgid "Alpha horizontal matrix"
msgstr "Matrice horizontale de canal Alpha"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7204
#, kde-format
msgid "Set the alpha matrix horizontal size"
msgstr "Définir la taille horizontale de la matrice Alpha"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7206
#, kde-format
msgid "Alpha vertical matrix"
msgstr "Matrice verticale Alpha"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7208
#, kde-format
msgid "Set the alpha matrix vertical size"
msgstr "Définir la taille verticale de la matrice Alpha"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7212
#, kde-format
msgid ""
"Set the alpha effect strength.<br>\n"
"            Reasonable values are between -1.5 and 1.5. Negative values will "
"blur the input video, while positive values will sharpen it, a value of zero "
"will disable the effect."
msgstr ""
"Définir l'intensité de l'effet sur l'alpha.<br>\n"
"            Les valeurs raisonnables sont comprises entre -1,5 et 1,5. Les "
"valeurs négatives flouteront la vidéo d'entrée, tandis que les valeurs "
"positives l'accentueront. Une valeur de zéro désactivera l'effet."

#. i18n: file: data/effects/avfilter/avfilter_vaguedenoiser.xml
#: rc.cpp:7214
#, kde-format
msgid "Wavelet Denoiser"
msgstr "Suppresseur de bruit par ondelettes"

#. i18n: file: data/effects/avfilter/avfilter_vaguedenoiser.xml
#: rc.cpp:7216
#, kde-format
msgid ""
"Wavelet based denoiser.<br>\n"
"    It transforms each frame from the video input into the wavelet domain, "
"using Cohen-Daubechies-Feauveau 9/7."
msgstr ""
"Débruiteur reposant sur des ondelettes.<br>\n"
"    Il transforme chaque trame de l'entrée vidéo dans le domaine des "
"ondelettes, en utilisant la méthode de Cohen-Daubechies-Feauveau 9 / 7."

#. i18n: file: data/effects/avfilter/avfilter_vaguedenoiser.xml
#: rc.cpp:7220
#, kde-format
msgid "Hard,Soft,Garrote"
msgstr "Matériel, Logiciel, Garrot"

#. i18n: file: data/effects/avfilter/avfilter_vaguedenoiser.xml
#: rc.cpp:7222
#, kde-format
msgid "Threshold Type"
msgstr "Type de seuil"

#. i18n: file: data/effects/avfilter/avfilter_vaguedenoiser.xml
#: rc.cpp:7224
#, kde-format
msgid "Universal,Bayes"
msgstr "Universel, Bayes"

#. i18n: file: data/effects/avfilter/avfilter_vectorscope.xml
#: rc.cpp:7236
#, kde-format
