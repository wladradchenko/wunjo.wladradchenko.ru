msgstr "Niveau d'écho à droite"

#. i18n: file: data/effects/ladspa/ladspa_2144.xml
#: rc.cpp:8238
#, kde-format
msgid "TAP Tremolo"
msgstr "Tremolo TAP"

#. i18n: file: data/effects/ladspa/ladspa_2144.xml
#: rc.cpp:8240
#, kde-format
msgid ""
"TAP Tremolo (LADSPA 2144)<br>\n"
"   Sounds good mainly on acoustic or electric guitar tracks."
msgstr ""
"TAP Tremolo (LADSPA 2144)<br>\n"
"   Donne un bon rendu principalement sur les pistes de guitare acoustique ou "
"électrique."

#. i18n: file: data/effects/ladspa/ladspa_2145.xml
#: rc.cpp:8250
#, kde-format
msgid "TAP Scaling Limiter"
msgstr "Limiteur de mise à l'échelle TAP"

#. i18n: file: data/effects/ladspa/ladspa_2145.xml
#: rc.cpp:8252
#, kde-format
msgid ""
"TAP Scaling Limiter (LADSPA 2145)<br>\n"
"   Achieves signal level limiting without audible artifacts."
msgstr ""
"TAP Scaling Limiter (LADSPA 2145)<br>\n"
"   Atteint la limitation du niveau de signal sans artefact audible."

#. i18n: file: data/effects/ladspa/ladspa_2145.xml
#: rc.cpp:8254
#, kde-format
msgid "Limit Level"
msgstr "Niveau limite"

#. i18n: file: data/effects/ladspa/ladspa_2145.xml
#: rc.cpp:8256
#, kde-format
msgid "Output Volume"
msgstr "Volume de sortie"

#. i18n: file: data/effects/ladspa/ladspa_2146.xml
#: rc.cpp:8260
#, kde-format
msgid "TAP AutoPanner"
msgstr "TAP AutoPanner"

#. i18n: file: data/effects/ladspa/ladspa_2146.xml
#: rc.cpp:8262
#, kde-format
msgid ""
"TAP AutoPanner (LADSPA 2146)<br>\n"
"   Main use is to liven up synth tracks in the mix"
msgstr ""
"TAP AutoPanner (LADSPA 2146)<br>\n"
"   L'utilisation principale est de rendre plus vivantes les pistes de "
"synthétiseur dans le mixage"

#. i18n: file: data/effects/ladspa/ladspa_2146.xml
#: rc.cpp:8268
#, kde-format
msgid ""
"Sets the wideness of panning.<br>\n"
"      A setting of 100% means that mono input signal is panned between the "
"extreme left and right positions"
msgstr ""
"Définit la largeur du panoramique.<br>\n"
"      Un réglage à 100 % signifie que le signal d'entrée mono est étalé "
"entre les positions extrêmes à gauche et à droite"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8274
#, kde-format
msgid "TAP DeEsser"
msgstr "TAP DeEsser"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8276
#, kde-format
msgid ""
"TAP DeEsser (LADSPA 2147)<br>\n"
"   Used for attenuating higher pitched frequencies in vocals such as those "
"found in 'ess', 'shh' and 'chh' sounds."
msgstr ""
"TAP DeEsser (LADSPA 2147)<br>\n"
"   Utilisé pour l'atténuation des fréquences aiguës plus élevées dans les "
"voix telles que celles que l'on trouve dans les sons « ess », « shh » et "
"« chh »."

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8278
#, kde-format
msgid "Threshold Level"
msgstr "Valeur du seuil"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8282
#, kde-format
msgid "Sidechain Filter"
msgstr "Filtre de chaîne latérale"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8284
#, kde-format
msgid ""
"The chosen filter's frequency<br>\n"
"      is set by the <b>Frequency</b> parameter"
msgstr ""
"La fréquence du filtre choisi<br>\n"
"      est définie par le paramètre <b>Fréquence</b>"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8286
#, kde-format
msgid "Highpass,Bandpass"
msgstr "Passe bande haut, Passe bande basse"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8288
#, kde-format
msgid "Monitor On"
msgstr "Écran activé"

#. i18n: file: data/effects/ladspa/ladspa_2148.xml
#: rc.cpp:8292
#, kde-format
msgid "TAP Vibrato"
msgstr "Vibrato TAP"

#. i18n: file: data/effects/ladspa/ladspa_2148.xml
#: rc.cpp:8294
#, kde-format
msgid ""
"TAP Vibrato (LADSPA 2148)<br>\n"
"   Modulates the pitch of its input signal with a low-frequency sinusoidal "
"signal. It is useful for guitar and synth tracks, and it can also come handy "
"if a strange effect is needed."
msgstr ""
"TAP Vibrato (LADSPA 2148)<br>\n"
"   Module la hauteur de son signal d'entrée avec un signal sinusoïdal basse "
"fréquence. Il est utile pour les pistes de guitare et de synthétiseur. Il "
"peut également être utile si un effet étrange est recherché."

#. i18n: file: data/effects/ladspa/ladspa_2148.xml
#: rc.cpp:8298
#, kde-format
msgid "Determines how fast the pitch is modulated up-down"
msgstr "Détermine avec quelle vitesse la hauteur est modulée de haut en bas."

#. i18n: file: data/effects/ladspa/ladspa_2148.xml
#: rc.cpp:8302
#, kde-format
msgid "Sets the amount of pitch modulation"
msgstr "Définit la quantité de modulation en hauteur"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8310
#, kde-format
msgid "TAP Rotary Speaker"
msgstr "Enceinte rotative TAP"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8312
#, kde-format
msgid ""
"TAP Rotary Speaker (LADSPA 2149)<br>\n"
"   Simulates the sound of rotating speakers."
msgstr ""
"Haut-parleur rotatif TAP (LADSPA 2149)<br>\n"
"   Simule le son de haut-parleurs rotatifs."

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8314
#, kde-format
msgid "Rotor Frequency"
msgstr "Fréquence de rotation"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8316
#, kde-format
msgid "Horn Frequency"
msgstr "Fréquence du klaxon"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8318
#, kde-format
msgid "Mic Distance"
msgstr "Distance au micro"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8320
#, kde-format
msgid "Rotor/Horn Mix"
msgstr "Mélange Rotor / klaxon"

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8324
#, kde-format
msgid "TAP Pitch Shifter"
msgstr "Outil de décalage de hauteur TAP"

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8326
#, kde-format
msgid ""
"TAP Pitch Shifter (LADSPA 2150)<br>\n"
"   Change the pitch in the range of plus/minus one octave."
msgstr ""
"TAP Pitch Shifter (LADSPA 2150)<br>\n"
"   Modifiez la hauteur dans l'intervalle de plus / moins une octave."

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8328
#, kde-format
msgid "Semitone Shift"
msgstr "Décalage en demi-teinte"

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8330
#, kde-format
msgid ""
"Does the same thing as <b>Rate Shift</b></br>\n"
"      but allows to set musically sensible pitch shift rates."
msgstr ""
"Réalise la même chose que <b>Décalage de débit</b></br>\n"
"      mais permet de définir des taux de décalage de hauteur musicalement "
"raisonnables."

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8332
#, kde-format
msgid "Rate Shift"
msgstr "Décalage de débit"

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8334
#, kde-format
msgid ""
"Does the same thing as <b>Semitone Shift</b><br>\n"
"      but in percentage of the original pitch, so that is closer to a "
"\"physical\", non-musical approach"
msgstr ""
"Fait la même chose que <b>Décalage en demi-teinte</b><br>\n"
"      mais en pourcentage de la hauteur originale. Ainsi, ceci est plus "
"proche d'une approche « physique », non musicale"

#. i18n: file: data/effects/ladspa/ladspa_2151.xml
#: rc.cpp:8342
#, kde-format
msgid "TAP Equalizer/BW"
msgstr "Égaliseur TAP / BW"

#. i18n: file: data/effects/ladspa/ladspa_2151.xml
#: rc.cpp:8344
#, kde-format
msgid ""
"TAP Equalizer (LADSPA (2151)<br>\n"
"    8-band equalizer with adjustable band center frequencies and bandwidth."
msgstr ""
"Égaliseur TAP (LADSPA (2151)<br>\n"
"    Égaliseur 8 bandes avec fréquences centrales et bande passante réglables."

