#. i18n: file: data/effects/avfilter/avfilter_compand.xml
#: rc.cpp:5388
#, kde-format
msgid "Attacks"
msgstr "Atakoj"

#. i18n: file: data/effects/avfilter/avfilter_compand.xml
#: rc.cpp:5390 rc.cpp:5394
#, kde-format
msgid ""
"A list of times in seconds for each channel over which the instantaneous "
"level of the input signal is averaged to determine its volume. Attacks "
"refers to increase of volume and decays refers to decrease of volume. For "
"most situations, the attack time (response to the audio getting louder) "
"should be shorter than the decay time, because the human ear is more "
"sensitive to sudden loud audio than sudden soft audio. A typical value for "
"attack is 0.3 seconds and a typical value for decay is 0.8 seconds. If "
"specified number of attacks and decays is lower than number of channels, the "
"last set attack/decay will be used for all remaining channels."
msgstr ""
"Listo de fojoj en sekundoj por ĉiu kanalo super kiu la tuja nivelo de la "
"eniga signalo estas mezume determini ĝian laŭtecon. Atakoj rilatas al pliigo "
"de laŭteco kaj kadukiĝoj rilatas al malpliigo de laŭteco. Por plej multaj "
"situacioj, la atakotempo (respondo al la audio pli kaj pli alta) devas esti "
"pli mallonga ol la kadukiĝa tempo, ĉar la homa orelo estas pli sentema al "
"subita laŭta audio ol subita mola audio. Tipa valoro por atako estas 0.3 "
"sekundoj kaj tipa valoro por kadukiĝo estas 0.8 sekundoj. Se specifita "
"nombro da atakoj kaj kadukiĝoj estas malpli ol nombro de kanaloj, la lasta "
"fiksita atako/kadukiĝo estos uzata por ĉiuj ceteraj kanaloj."

#. i18n: file: data/effects/avfilter/avfilter_compand.xml
#: rc.cpp:5392
#, kde-format
msgid "Decays"
msgstr "Kadukiĝas"

