# https://userbase.kde.org/Wunjo
# Make/Manual/Effects/Alpha_manipulation/Mask0Mate
# Previously known as Mask0Mate. This is FilterFrei0r-mask0mate
# Creates an rectangular alpha-channel mask
# Дронова
#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_mask.xml
#: rc.cpp:2540
#, kde-format
msgid "VR360 Equirectangular Mask"
msgstr "Эквидистантная маска VR360"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_mask.xml
#: rc.cpp:2542
#, kde-format
msgid ""
"Adds a black matte to the frame. Use this if you filmed using a 360 camera "
"but only want to use part of the 360 image - for example if you and the film "
"crew occupy the 90 degrees behind the camera."
msgstr ""
"Добавляет чёрное матирование к кадру. Воспользуйтесь этим фильтром, если "
"съёмка была выполнена на 360-градусную камеру, но нужна только часть 360-"
"градусного изображения — например, если вы со съёмочной группой находитесь в "
"пределах 90 градусов за камерой."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_mask.xml
#: rc.cpp:2544
#, kde-format
msgid "Vertical start"
msgstr "Начало по вертикали"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_mask.xml
#: rc.cpp:2546
#, kde-format
msgid ""
"The <b>Start</b> is half the height in degrees of the un-matted area. The "
"<b>End</b> is the half the height in degrees where the matte is at 100%."
msgstr ""
"<b>Начало</b> — половина высоты в градусах области без матирования. "
"<b>Конец</b> — половина высоты в градусах области, где матирование "
"составляет 100%."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_mask.xml
#: rc.cpp:2548
#, kde-format
msgid "Vertical end"
msgstr "Конец по вертикали"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_mask.xml
#: rc.cpp:2550
#, kde-format
msgid ""
"The Start is half the height in degrees of the un-matted area. The End is "
"the half the height in degrees where the matte is at 100%."
msgstr ""
"«Начало» — половина высоты в градусах области без матирования. «Конец» — "
"половина высоты в градусах области, где матирование составляет 100%."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_mask.xml
#: rc.cpp:2552
#, kde-format
msgid "Horizontal start"
msgstr "Начало по горизонтали"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_mask.xml
#: rc.cpp:2554 rc.cpp:2558
#, kde-format
msgid ""
"The <b>Start</b> is the width in degrees of the un-matted area. The <b>End</"
"b> is the width in degrees where the matte is at 100%."
msgstr ""
"<b>Начало</b> — ширина в градусах области без матирования. <b>Конец</b> — "
"ширина в градусах области, где матирование составляет 100%."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_mask.xml
#: rc.cpp:2556
#, kde-format
msgid "Horizontal end"
msgstr "Конец по горизонтали"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#: rc.cpp:2566
#, kde-format
msgid "VR360 Equirectangular to Rectilinear"
msgstr "Эквидистантный VR360 в прямоугольный"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#: rc.cpp:2568
#, kde-format
msgid ""
"Converts an equirectangular frame (panoramic) to a rectilinear frame (what "
"you're used to seeing). Can be used to preview what will be shown in a 360 "
"video viewer. Delayed frame blitting mapped on a time bitmap"
msgstr ""
"Преобразует эквидистантный (панорамный) кадр в прямоугольный (обычно "
"используемый для просмотра). Можно использовать для предпросмотра того, что "
"будет показано в 360-градусном средстве просмотра. Отложенный блиттинг "
"кадров по битовой карте времени."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_stereo.xml
