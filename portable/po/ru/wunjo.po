#. i18n: file: data/effects/audiospectrum.xml
#: rc.cpp:522
#, kde-format
msgid ""
"An audio visualization filter that draws an audio spectrum on the image."
msgstr ""
"Фильтр визуализации звука, отображает спектр звуковых частот на изображении."

#. i18n: file: data/effects/audiospectrum.xml
#: rc.cpp:526
#, kde-format
msgid "The type of graph to display the spectrum."
msgstr "Тип графика для отображения спектра."

#. i18n: file: data/effects/audiospectrum.xml
#: rc.cpp:528
#, kde-format
msgid "Line,Bar"
msgstr "Строки,Столбцы"

#. i18n: file: data/effects/audiospectrum.xml
#: rc.cpp:532
#, kde-format
msgid ""
"The background color to be applied to the entire frame. The default color is "
"transparent."
msgstr ""
"Цвет фона, применяемый ко всему кадру. По умолчанию используется прозрачный "
"цвет."

#. i18n: file: data/effects/audiospectrum.xml
#. i18n: file: data/effects/gpstext.xml
#: rc.cpp:534 rc.cpp:1146
#, kde-format
msgid "Foreground color"
msgstr "Цвет переднего плана"

#. i18n: file: data/effects/audiospectrum.xml
#: rc.cpp:536
#, kde-format
msgid "The color of the waveform."
msgstr "Цвет звукового спектра."

#. i18n: file: data/effects/audiospectrum.xml
#: rc.cpp:540
#, kde-format
msgid ""
"The thickness of the line used to draw the waveform for line graph. The "
"thickness of the bar for bar graph."
msgstr ""
"Толщина линий для построения звукового спектра в виде линейного графика. "
"Толщина столбцов для столбчатого графика."

#. i18n: file: data/effects/audiospectrum.xml
#: rc.cpp:552
#, kde-format
msgid ""
"Whether the area under the waveform should be filled in. Only applies to "
"line graph type."
msgstr ""
"Следует ли заливать цветом области под звуковым спектром.Применимо только "
"для линейных графиков."

#. i18n: file: data/effects/audiospectrum.xml
#: rc.cpp:560
#, kde-format
msgid "Draw the points starting with the highest frequency first."
msgstr "Отрисовка точек начинается с самой высокой частоты."

#. i18n: file: data/effects/audiospectrum.xml
#: rc.cpp:562
#, kde-format
msgid "Line Tension"
msgstr "Натяжение линии"

#. i18n: file: data/effects/audiospectrum.xml
#: rc.cpp:564
#, kde-format
msgid ""
"Affects the amount of curve in the line interpolating between points. 0.0 = "
"a straight line between points. 100 = very curved lines between points. "
"Values < 0 and > 100 will cause loops in the lines. Only applies to line "
"graph type."
msgstr ""
"Определяет кривизну линии между точками. 0,0 = линия между точками прямая. "
"100 = линия между точками имеет сильно изогнутую форму. Значения < 0 и > 100 "
"будут вызывать появление петель на линиях. Параметр применим только для "
"линейных графиков."

#. i18n: file: data/effects/audiospectrum.xml
#: rc.cpp:566
#, kde-format
msgid "Points"
msgstr "Точки"

#. i18n: file: data/effects/audiospectrum.xml
#: rc.cpp:568
#, kde-format
msgid ""
"The number of bands to draw in the spectrum. Each band shows up as a data "
"point in the graph."
msgstr ""
"Количество полос для отображения спектра. Каждой полосе соответствует точка "
"данных на графике."

#. i18n: file: data/effects/audiospectrum.xml
#. i18n: file: data/effects/dance.xml
#: rc.cpp:570 rc.cpp:736
#, kde-format
msgid "Low Frequency"
msgstr "Низкие частоты"

#. i18n: file: data/effects/audiospectrum.xml
#: rc.cpp:572
#, kde-format
msgid "The low end of the frequency range to be used for the graph."
msgstr "Нижний предел диапазона частот для графика."

#. i18n: file: data/effects/audiospectrum.xml
#. i18n: file: data/effects/dance.xml
#: rc.cpp:574 rc.cpp:738
#, kde-format
msgid "High Frequency"
msgstr "Высокие частоты"

#. i18n: file: data/effects/audiospectrum.xml
#: rc.cpp:576
#, kde-format
msgid "The high end of the frequency range to be used for the graph."
msgstr "Верхний предел диапазона частот для графика."

#. i18n: file: data/effects/audiospectrum.xml
#. i18n: file: data/effects/dance.xml
#: rc.cpp:578 rc.cpp:740
#, kde-format
msgid "Level Threshold"
msgstr "Пороговый уровень"

#. i18n: file: data/effects/audiospectrum.xml
#: rc.cpp:580
#, kde-format
msgid ""
"The minimum amplitude of sound that must occur within the frequency range to "
"cause the value to be applied."
msgstr ""
"Минимальная амплитуда звукового сигнала, который должен находиться в "
"пределах диапазона частот для применения значения на графике."

#. i18n: file: data/effects/audiospectrum.xml
#. i18n: file: data/effects/dance.xml
#: rc.cpp:582 rc.cpp:760
#, kde-format
msgid "Window Size"
msgstr "Размер окна"

#. i18n: file: data/effects/audiospectrum.xml
#: rc.cpp:584
#, kde-format
msgid ""
"The number of samples that the FFT will be performed on. If window size is "
"less than the number of samples in a frame, extra samples will be ignored. "
"If window size is more than the number of samples in a frame, samples will "
"be buffered from previous frames to fill the window. The buffering is "
"performed as a sliding window so that the most recent samples are always "
"transformed."
msgstr ""
"Количество семплов, на которых будет выполнено БПФ. Если размер окна меньше "
"количества семплов в кадре, то дополнительные семплы будут игнорироваться. "
"Если размер окна больше, чем количество семплов в кадре, то семплы будут "
"буферизованы из предыдущих кадров для заполнения окна. Буферизация "
"выполняется в виде движущегося окна, чтобы обеспечить преобразование самых "
"последних семплов."

