#, kde-format
msgid "Dry Level"
msgstr "Уровень «сухого»"

#. i18n: file: data/effects/ladspa/ladspa_2142.xml
#. i18n: file: data/effects/ladspa/ladspa_2148.xml
#. i18n: file: data/effects/ladspa/ladspa_2150.xml
