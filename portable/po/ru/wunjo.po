#: rc.cpp:6988
#, kde-format
msgid "SOFAlizer"
msgstr "SOFAлизатор"

#. i18n: file: data/effects/avfilter/avfilter_sofalizer.xml
#: rc.cpp:6990
#, kde-format
msgid ""
"SOFAlizer uses head-related transfer functions (HRTFs) to create virtual "
"loudspeakers around the user for binaural listening via headphones (audio "
"formats up to 9 channels supported). The HRTFs are stored in SOFA files (see "
"http://www.sofacoustics.org/ for a database). SOFAlizer is developed at the "
"Acoustics Research Institute (ARI) of the Austrian Academy of Sciences."
msgstr ""
"SOFAлизатор использует передаточные функции слухового аппарата человека для "
"создания виртуальных динамиков около пользователя для бинаурального "
"прослушивания через наушники (поддерживается до 9 каналов). Эти функции "
"хранятся в файлах SOFA (база данных доступна здесь: http://www.sofacoustics."
"org/). SOFAлизатор разрабатывается Исследовательским институтом акустики "
"Австрийской академии наук."

