msgstr "Постеризация (ELBG)"

#. i18n: file: data/effects/avfilter/avfilter_elbg.xml
#: rc.cpp:5772
#, kde-format
msgid "Apply posterize effect using the ELBG algorithm"
msgstr "Применение эффекта постеризации с использованием алгоритма ELBG"

#. i18n: file: data/effects/avfilter/avfilter_elbg.xml
#: rc.cpp:5774
#, kde-format
msgid "Codebook Length"
msgstr "Длина книги шифров"

#. i18n: file: data/effects/avfilter/avfilter_elbg.xml
#. i18n: file: data/effects/avfilter/avfilter_gblur.xml
#. i18n: file: data/effects/avfilter/avfilter_vaguedenoiser.xml
#: rc.cpp:5776 rc.cpp:6024 rc.cpp:7228
#, kde-format
msgid "Steps"
msgstr "Шаги"

#. i18n: file: data/effects/avfilter/avfilter_elbg.xml
#: rc.cpp:5778
#, kde-format
msgid "Pal8 Output"
msgstr "Вывод Pal8"

#. i18n: file: data/effects/avfilter/avfilter_elbg.xml
#: rc.cpp:5780
#, kde-format
msgid "Include Alpha Values"
msgstr "Включить значения альфа"

#. i18n: file: data/effects/avfilter/avfilter_epx.xml
#: rc.cpp:5782
#, kde-format
msgid "EPX Scaler"
msgstr "Масштабирование по алгоритму EPX"

#. i18n: file: data/effects/avfilter/avfilter_epx.xml
#: rc.cpp:5784
#, kde-format
msgid "Scale the input using EPX algorithm."
msgstr "Масштабирование входных данных с помощью алгоритма EPX."

#. i18n: file: data/effects/avfilter/avfilter_epx.xml
#. i18n: file: data/effects/avfilter/avfilter_hqx.xml
#: rc.cpp:5786 rc.cpp:6230
#, kde-format
msgid "Scale factor"
msgstr "Коэффициент масштабирования"

#. i18n: file: data/effects/avfilter/avfilter_epx.xml
#: rc.cpp:5788
#, kde-format
msgid "2x,3x"
msgstr "2x,3x"

#. i18n: file: data/effects/avfilter/avfilter_eq.xml
#: rc.cpp:5790
#, kde-format
msgid "Video Equalizer"
msgstr "Эквалайзер видео"

#. i18n: file: data/effects/avfilter/avfilter_eq.xml
#: rc.cpp:5792
#, kde-format
msgid "Adjust Brightness, contrast, gamma, saturation"
msgstr "Настройка яркости, контрастности, гаммы, насыщенности"

#. i18n: file: data/effects/avfilter/avfilter_eq.xml
#: rc.cpp:5802
#, kde-format
msgid "Red Gamma"
msgstr "Гамма красного"

#. i18n: file: data/effects/avfilter/avfilter_eq.xml
#: rc.cpp:5804
#, kde-format
msgid "Green Gamma"
msgstr "Гамма зелёного"

#. i18n: file: data/effects/avfilter/avfilter_eq.xml
#: rc.cpp:5806
#, kde-format
msgid "Blue Gamma"
msgstr "Гамма синего"

#. i18n: file: data/effects/avfilter/avfilter_eq.xml
#: rc.cpp:5808
#, kde-format
msgid "Gamma Weight"
msgstr "Вес гаммы"

#. i18n: file: data/effects/avfilter/avfilter_equalizer.xml
#: rc.cpp:5810
#, kde-format
msgid "Audio Equalizer (avfilter)"
msgstr "Эквалайзер звука (avfilter)"

#. i18n: file: data/effects/avfilter/avfilter_equalizer.xml
#: rc.cpp:5812
#, kde-format
msgid ""
"Apply two-pole peaking equalization (EQ) filter. With this filter, the "
"signal-level at and around a selected frequency can be increased or "
"decreased, whilst (unlike bandpass and bandreject filters) that at all other "
"frequencies is unchanged."
msgstr ""
"Применение двухполюсного фильтра пикового выравнивания. С помощью этого "
"фильтра можно увеличивать или уменьшать уровень сигнала на выбранной частоте "
"и рядом с ней, и при этом (в отличие от полосно-пропускающего и полосно-"
"задерживающего фильтров) его значение на всех остальных частотах остаётся "
"неизменным."

#. i18n: file: data/effects/avfilter/avfilter_equalizer.xml
#: rc.cpp:5816
#, kde-format
msgid "Width Type"
msgstr "Тип ширины"

#. i18n: file: data/effects/avfilter/avfilter_equalizer.xml
#: rc.cpp:5818
#, kde-format
msgid "Hertz,Q-Factor,Octave,Slope,kHz"
msgstr "Герц,Q-коэффициент,Октава,Спад,кГц"

#. i18n: file: data/effects/avfilter/avfilter_equalizer.xml
#: rc.cpp:5820
#, kde-format
msgid "Band Width"
msgstr "Ширина полосы"

#. i18n: file: data/effects/avfilter/avfilter_erosion.xml
#: rc.cpp:5836
#, kde-format
msgid "Erosion"
msgstr "Эрозия"

#. i18n: file: data/effects/avfilter/avfilter_erosion.xml
#: rc.cpp:5838
#, kde-format
msgid ""
"Apply erosion effect.<br>\n"
"    Simulates image erosion, an effect which will enlarge the darkest pixels "
"in the image by replacing the pixel by the local (3x3) minimum."
msgstr ""
"Применение эффекта эрозии.<br>\n"
"    Имитирует эрозию изображения; эффект, который увеличивает самые тёмные "
"пикселы изображения, заменяя пиксел локальным минимумом (3x3)."

#. i18n: file: data/effects/avfilter/avfilter_exposure.xml
#: rc.cpp:5860 rc.cpp:5864
#, kde-format
msgid "Exposure"
msgstr "Экспозиция"

#. i18n: file: data/effects/avfilter/avfilter_exposure.xml
#: rc.cpp:5862
#, kde-format
msgid "Adjust exposure of the video stream."
msgstr "Настройка экспозиции видеопотока."

#. i18n: file: data/effects/avfilter/avfilter_extrastereo.xml
#: rc.cpp:5868
#, kde-format
msgid "Extrastereo"
msgstr "Экстрастерео"

#. i18n: file: data/effects/avfilter/avfilter_extrastereo.xml
#: rc.cpp:5870
#, kde-format
msgid ""
"Linearly increases the difference between left and right channels which adds "
"some sort of \"live\" effect to playback."
msgstr ""
"Линейно увеличивает разницу между левым и правым каналами, что добавляет "
"эффект «живого присутствия» при воспроизведении."

#. i18n: file: data/effects/avfilter/avfilter_extrastereo.xml
#: rc.cpp:5874
#, kde-format
msgid ""
"Sets the difference coefficient (default: 2.5).\n"
"0.0 means mono sound (average of both channels),\n"
"with 1.0 sound will be unchanged, with -1.0 left and right channels will be "
"swapped."
msgstr ""
"Устанавливает коэффициент разницы (по умолчанию: 2.5).\n"
"0.0 означает монозвук (среднее обоих каналов),\n"
"1.0 — звук не будет изменён, -1.0 — левый и правый каналы поменяются местами."

#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:5878
#, kde-format
msgid "3D FFT Denoiser"
msgstr "Устранение шума в 3D с помощью быстрого преобразования Фурье"

#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:5880
#, kde-format
msgid "Denoise frames using 3D FFT (frequency domain filtering)"
msgstr ""
"Устранение шума на кадрах в 3D с помощью быстрого преобразования Фурье "
"(фильтрация в области частот)"

#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:5884
#, kde-format
msgid ""
"Set the noise sigma constant.<br>\n"
"       \tThis sets denoising strength. Using very high sigma with low "
"overlap may give blocking artifacts."
msgstr ""
"Установить постоянную сигма шума.<br>\n"
"       \tЭто значение указывает силу устранения шума. Очень высокое значение "
"сигма при низком перекрытии может привести к появлению блоковых артефактов."

#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:5888
#, kde-format
msgid ""
"Set the amount of denoising.<br>\n"
"       \tBy default all detected noise is reduced."
msgstr ""
"Установить объём устранения шума.<br>\n"
"       \tПо умолчанию выполняется уменьшение всего обнаруженного шума."

#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:5890
#, kde-format
msgid "Block"
msgstr "Блок"

#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:5892
#, kde-format
msgid "Set size of block in pixels"
msgstr "Установить размер блока в пикселах"

#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:5896
#, kde-format
msgid "Set block overlap"
msgstr "Установить перекрытие блоков"

#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:5900
#, kde-format
msgid "Set denoising method"
msgstr "Установить метод устранения шума"

#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:5902
#, kde-format
msgid "Wiener,Hard"
msgstr "Винер,Жёсткий"

#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:5904
#, kde-format
msgid ""
"Add <em>previous</em> frame<br>\n"
"        for temporal denoising"
msgstr ""
"Добавляет <em>предыдущий</em> кадр<br>\n"
"        для временного устранения шума"

#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:5906
#, kde-format
msgid ""
"Add <em>next</em> frame<br>\n"
"        for temporal denoising"
msgstr ""
"Добавляет <em>следующий</em> кадр<br>\n"
"        для временного устранения шума"

#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#. i18n: file: data/effects/avfilter/avfilter_median.xml
#. i18n: file: data/effects/avfilter/avfilter_oscilloscope.xml
#: rc.cpp:5910 rc.cpp:6558 rc.cpp:6700
#, kde-format
msgid "None,Y,U,YU,V,YV,UV,All"
msgstr "Нет,Y,U,YU,V,YV,UV,Все"

#. i18n: file: data/effects/avfilter/avfilter_fftfilt.xml
#: rc.cpp:5912
#, kde-format
msgid "FTT-based FIR"
msgstr ""
"Фильтр с конечным импульсным откликом на основе быстрого преобразования Фурье"

#. i18n: file: data/effects/avfilter/avfilter_fftfilt.xml
#: rc.cpp:5914
#, kde-format
msgid "Apply arbitrary expressions to samples in frequency domain"
msgstr "Применение произвольных выражений к семплам в частотной области"

#. i18n: file: data/effects/avfilter/avfilter_fftfilt.xml
#: rc.cpp:5916
#, kde-format
msgid "Gain in Y plane"
msgstr "Усиление в плоскости Y"

#. i18n: file: data/effects/avfilter/avfilter_fftfilt.xml
#: rc.cpp:5918
#, kde-format
msgid "Gain in U plane"
msgstr "Усиление в плоскости U"

#. i18n: file: data/effects/avfilter/avfilter_fftfilt.xml
#: rc.cpp:5920
#, kde-format
msgid "Gain in V plane"
msgstr "Усиление в плоскости V"

#. i18n: file: data/effects/avfilter/avfilter_fftfilt.xml
#: rc.cpp:5922
#, kde-format
msgid "Luminance Y plane"
msgstr "Плоскость яркости Y"

#. i18n: file: data/effects/avfilter/avfilter_fftfilt.xml
#: rc.cpp:5924
#, kde-format
msgid "Luminance U plane"
msgstr "Плоскость яркости U"

#. i18n: file: data/effects/avfilter/avfilter_fftfilt.xml
#: rc.cpp:5926
#, kde-format
msgid "Luminance V plane"
msgstr "Плоскость яркости V"

#. i18n: file: data/effects/avfilter/avfilter_fftfilt.xml
#: rc.cpp:5928
#, kde-format
msgid "Evaluate"
msgstr "Вычисление"

#. i18n: file: data/effects/avfilter/avfilter_fftfilt.xml
#: rc.cpp:5930
#, kde-format
msgid "init,frame"
msgstr "инициализация,кадр"

#. i18n: file: data/effects/avfilter/avfilter_field.xml
#: rc.cpp:5932
#, kde-format
msgid "Field Extractor"
msgstr "Извлечение полей"

#. i18n: file: data/effects/avfilter/avfilter_field.xml
#: rc.cpp:5934
#, kde-format
msgid "Extract a field from the input video"
msgstr "Извлечение поля из входного видео"

#. i18n: file: data/effects/avfilter/avfilter_field.xml
#. i18n: file: data/effects/avfilter/avfilter_fieldorder.xml
#: rc.cpp:5936 rc.cpp:5944
#, kde-format
msgid "Field priority"
msgstr "Приоритет полей"

#. i18n: file: data/effects/avfilter/avfilter_fieldorder.xml
#: rc.cpp:5940
#, kde-format
msgid "Interlace field order"
msgstr "Порядок полей с чересстрочностью"

#. i18n: file: data/effects/avfilter/avfilter_fieldorder.xml
#: rc.cpp:5942
#, kde-format
msgid "Transform the field order of the input video."
msgstr "Преобразование порядка полей входного видео"

#. i18n: file: data/effects/avfilter/avfilter_fillborders.xml
#: rc.cpp:5948
#, kde-format
msgid "Fill Borders"
msgstr "Заполнение по краям"

#. i18n: file: data/effects/avfilter/avfilter_fillborders.xml
#: rc.cpp:5950
#, kde-format
msgid ""
"Fill borders of the input video without changing video stream dimensions. "
"Sometimes video can have garbage at the four edges and you may not want to "
"crop video input to keep the size multiple of some number"
msgstr ""
"Заполнение крайних участков входного видео без изменения размеров "
"видеопотока. Иногда по краям видео имеется шум, а обрезать его нежелательно "
"(чтобы сохранить верные пропорции для кадров)"

#. i18n: file: data/effects/avfilter/avfilter_fillborders.xml
#: rc.cpp:5954
#, kde-format
msgid "Smear,Mirror,Color,Reflect,Wrap,Fade,Margins"
msgstr "Смазывание,Зеркальное отражение,Цвет,Отражение,Обтекание,Угасание,Поля"

#. i18n: file: data/effects/avfilter/avfilter_flanger.xml
#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:5960 rc.cpp:7484
#, kde-format
msgid "Flanger"
msgstr "Флэнжер"

#. i18n: file: data/effects/avfilter/avfilter_flanger.xml
#: rc.cpp:5962
#, kde-format
msgid "Apply a flanging effect to the audio."
msgstr "Применение к звуку эффекта флэнжера."

#. i18n: file: data/effects/avfilter/avfilter_flanger.xml
#: rc.cpp:5966
#, kde-format
msgid "Set base delay in milliseconds. Range from 0 to 30."
msgstr "Установить базовую задержку в миллисекундах. Диапазон: от 0 до 30."

#. i18n: file: data/effects/avfilter/avfilter_flanger.xml
#. i18n: file: data/effects/avfilter/avfilter_vibrato.xml
#. i18n: file: data/effects/ladspa/ladspa_2144.xml
#. i18n: file: data/effects/ladspa/ladspa_2146.xml
#. i18n: file: data/effects/ladspa/ladspa_2148.xml
#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#. i18n: file: data/effects/ladspa/ladspa_phaser.xml
#. i18n: file: data/effects/sox/sox_flanger.xml
#: rc.cpp:5968 rc.cpp:7308 rc.cpp:8244 rc.cpp:8266 rc.cpp:8300 rc.cpp:8538
#: rc.cpp:8634 rc.cpp:8744
#, kde-format
msgid "Depth"
msgstr "Глубина"

#. i18n: file: data/effects/avfilter/avfilter_flanger.xml
#: rc.cpp:5970
#, kde-format
msgid "Set added sweep delay in milliseconds. Range from 0 to 10."
msgstr ""
"Установить добавленную задержку пробежки в миллисекундах. Диапазон: от 0 до "
"10."

#. i18n: file: data/effects/avfilter/avfilter_flanger.xml
#. i18n: file: data/effects/sox/sox_flanger.xml
#: rc.cpp:5972 rc.cpp:8746
#, kde-format
msgid "Regeneration"
msgstr "Регенерация"

#. i18n: file: data/effects/avfilter/avfilter_flanger.xml
#: rc.cpp:5974
#, kde-format
msgid ""
"Set percentage regeneration (delayed signal feedback). Range from -95 to 95."
msgstr ""
"Установить процент регенерации (обратная связь задержанного сигнала). "
"Диапазон: от -95 до 95."

#. i18n: file: data/effects/avfilter/avfilter_flanger.xml
#: rc.cpp:5978
#, kde-format
msgid ""
"Set percentage of delayed signal mixed with original. Range from 0 to 100."
msgstr ""
"Установить процент задержанного сигнала, смешанного с исходным. Диапазон: от "
"0 до 100."

#. i18n: file: data/effects/avfilter/avfilter_flanger.xml
#: rc.cpp:5982
#, kde-format
msgid "Set sweeps per second (Hz). Range from 0.1 to 10."
msgstr "Установить количество пробежек в секунду (Гц). Диапазон: от 0.1 до 10."

#. i18n: file: data/effects/avfilter/avfilter_flanger.xml
#: rc.cpp:5986
#, kde-format
msgid "Set swept wave shape, can be triangular or sinusoidal."
msgstr "Установить форму бегущей волны (треугольная или синусоидальная)."

#. i18n: file: data/effects/avfilter/avfilter_flanger.xml
#. i18n: file: data/effects/avfilter/avfilter_phase.xml
#. i18n: file: data/effects/sox/sox_flanger.xml
#: rc.cpp:5990 rc.cpp:6714 rc.cpp:8754
#, kde-format
msgid "Phase"
msgstr "Фаза"

#. i18n: file: data/effects/avfilter/avfilter_flanger.xml
