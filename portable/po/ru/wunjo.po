#. i18n: file: data/effects/ladspa/ladspa_2142.xml
#: rc.cpp:8186
#, kde-format
msgid "TAP Reverberator"
msgstr "Ревербератор TAP"

#. i18n: file: data/effects/ladspa/ladspa_2142.xml
#: rc.cpp:8188
#, kde-format
msgid ""
"TAP Reverberator (LADSPA 2142)<br>\n"
"   Versatile reverb filter based on the comb/allpass filter model. For "
"recommended decay times for reverb types refer to the effect documentation "
"linked below."
msgstr ""
"Ревербератор TAP (LADSPA 2142).<br>\n"
"   Гибкий фильтр реверберации на основе модели гребенчатого/всепропускающего "
"фильтра. Рекомендованное время затухания для типов реверберации доступно в "
"документации по эффекту по ссылке ниже."

#. i18n: file: data/effects/ladspa/ladspa_2142.xml
#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#. i18n: file: data/effects/ladspa/ladspa_2148.xml
