#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8212
#, kde-format
msgid "TAP Stereo Echo"
msgstr "Стереоэхо TAP"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8214
#, kde-format
msgid ""
"TAP Stereo Echo (LADSPA 2143)<br>\n"
"   Supports conventional mono and stereo delays, ping-pong delays and the "
"Haas effect (also known as Cross Delay Stereo)."
msgstr ""
"Стереоэхо TAP (LADSPA 2143).<br>\n"
"   Поддерживает обычные задержки моно и стерео, задержки «пинг-понг», а "
"также эффект Хааса."

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8216
#, kde-format
msgid "Cross Mode"
msgstr "Перекрёстный режим"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8218
#, kde-format
msgid "Haas Effect"
msgstr "Эффект Хааса"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8220
#, kde-format
msgid "Swap Outputs"
msgstr "Поменять выходы местами"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8222
#, kde-format
msgid "L Delay"
msgstr "Задержка Л"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8224
#, kde-format
msgid "L Feedback"
msgstr "Обратная связь Л"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8226
#, kde-format
msgid "R/Haas Delay"
msgstr "Задержка П/Хааса"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8228
#, kde-format
msgid "R/Haas Feedback"
msgstr "Обратная связь П/Хааса"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8230
#, kde-format
msgid "L Echo Level"
msgstr "Уровень эха Л"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8232
#, kde-format
msgid "R Echo Level"
msgstr "Уровень эха П"

#. i18n: file: data/effects/ladspa/ladspa_2144.xml
#: rc.cpp:8238
#, kde-format
msgid "TAP Tremolo"
msgstr "Тремоло TAP"

#. i18n: file: data/effects/ladspa/ladspa_2144.xml
#: rc.cpp:8240
#, kde-format
msgid ""
"TAP Tremolo (LADSPA 2144)<br>\n"
"   Sounds good mainly on acoustic or electric guitar tracks."
msgstr ""
"Тремоло TAP (LADSPA 2144).<br>\n"
"   Хорошо звучит в основном на дорожках с акустической гитарой или "
"электрогитарой."

#. i18n: file: data/effects/ladspa/ladspa_2145.xml
#: rc.cpp:8250
#, kde-format
msgid "TAP Scaling Limiter"
msgstr "Масштабный ограничитель TAP"

#. i18n: file: data/effects/ladspa/ladspa_2145.xml
#: rc.cpp:8252
#, kde-format
msgid ""
"TAP Scaling Limiter (LADSPA 2145)<br>\n"
"   Achieves signal level limiting without audible artifacts."
msgstr ""
"Масштабный ограничитель TAP (LADSPA 2145).<br>\n"
"   Позволяет ограничить уровень сигнала без слышимых артефактов."

#. i18n: file: data/effects/ladspa/ladspa_2145.xml
#: rc.cpp:8254
#, kde-format
msgid "Limit Level"
msgstr "Уровень ограничения"

#. i18n: file: data/effects/ladspa/ladspa_2145.xml
#: rc.cpp:8256
#, kde-format
msgid "Output Volume"
msgstr "Выходная громкость"

#. i18n: file: data/effects/ladspa/ladspa_2146.xml
#: rc.cpp:8260
#, kde-format
msgid "TAP AutoPanner"
msgstr "Автопанорамизатор TAP"

#. i18n: file: data/effects/ladspa/ladspa_2146.xml
#: rc.cpp:8262
#, kde-format
msgid ""
"TAP AutoPanner (LADSPA 2146)<br>\n"
"   Main use is to liven up synth tracks in the mix"
msgstr ""
"Автопанорамизатор TAP (LADSPA 2146).<br>\n"
"   В основном используется для придания живости синтезаторным дорожкам в "
"миксе."

#. i18n: file: data/effects/ladspa/ladspa_2146.xml
#: rc.cpp:8268
#, kde-format
msgid ""
"Sets the wideness of panning.<br>\n"
"      A setting of 100% means that mono input signal is panned between the "
"extreme left and right positions"
msgstr ""
"Устанавливает ширину панорамирования.<br>\n"
"      100% означает панорамирование монофонического входного сигнала между "
"крайними левой и правой позициями."

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8274
#, kde-format
msgid "TAP DeEsser"
msgstr "Деэссер TAP"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8276
#, kde-format
msgid ""
"TAP DeEsser (LADSPA 2147)<br>\n"
"   Used for attenuating higher pitched frequencies in vocals such as those "
"found in 'ess', 'shh' and 'chh' sounds."
msgstr ""
"Деэссер TAP (LADSPA 2147).<br>\n"
"   Используется для ослабления более высоких частот в вокале (например, "
"присутствующих в звуках «эсс», «шш» и «чх»)."

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8278
#, kde-format
msgid "Threshold Level"
msgstr "Уровень порога"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8282
#, kde-format
msgid "Sidechain Filter"
msgstr "Фильтр боковой цепи"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8284
#, kde-format
msgid ""
"The chosen filter's frequency<br>\n"
"      is set by the <b>Frequency</b> parameter"
msgstr ""
"Частота выбранного фильтра<br>\n"
"      задаётся с помощью параметра <b>Частота</b>"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8286
#, kde-format
msgid "Highpass,Bandpass"
msgstr "Высокочастотный,Полосно-пропускающий"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8288
#, kde-format
msgid "Monitor On"
msgstr "Монитор"

#. i18n: file: data/effects/ladspa/ladspa_2148.xml
#: rc.cpp:8292
#, kde-format
msgid "TAP Vibrato"
msgstr "Вибрато TAP"

#. i18n: file: data/effects/ladspa/ladspa_2148.xml
#: rc.cpp:8294
#, kde-format
msgid ""
"TAP Vibrato (LADSPA 2148)<br>\n"
"   Modulates the pitch of its input signal with a low-frequency sinusoidal "
"signal. It is useful for guitar and synth tracks, and it can also come handy "
"if a strange effect is needed."
msgstr ""
"Вибрато TAP (LADSPA 2148).<br>\n"
"   Модулирует тон входного сигнала с помощью низкочастотного синусоидального "
"сигнала. Подходит для дорожек с электрогитарой и синтезатором, а также может "
"пригодиться, когда нужен необычный эффект."

#. i18n: file: data/effects/ladspa/ladspa_2148.xml
#: rc.cpp:8298
#, kde-format
msgid "Determines how fast the pitch is modulated up-down"
msgstr "Определяет, насколько быстро модулируется вверх-вниз тон"

#. i18n: file: data/effects/ladspa/ladspa_2148.xml
#: rc.cpp:8302
#, kde-format
msgid "Sets the amount of pitch modulation"
msgstr "Устанавливает степень модуляции тона"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8310
#, kde-format
msgid "TAP Rotary Speaker"
msgstr "Поворотный динамик TAP"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8312
#, kde-format
msgid ""
"TAP Rotary Speaker (LADSPA 2149)<br>\n"
"   Simulates the sound of rotating speakers."
msgstr ""
"Вращающийся динамик TAP (LADSPA 2149).<br>\n"
"   Имитация звука вращающихся динамиков."

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8314
#, kde-format
msgid "Rotor Frequency"
msgstr "Частота НЧ-динамика"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8316
#, kde-format
msgid "Horn Frequency"
msgstr "Частота ВЧ-динамика"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8318
#, kde-format
msgid "Mic Distance"
msgstr "Расстояние до микрофона"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8320
#, kde-format
msgid "Rotor/Horn Mix"
msgstr "Баланс между НЧ-динамиком и ВЧ-динамиком"

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8324
#, kde-format
msgid "TAP Pitch Shifter"
msgstr "Изменение высоты тона TAP"

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8326
#, kde-format
msgid ""
"TAP Pitch Shifter (LADSPA 2150)<br>\n"
"   Change the pitch in the range of plus/minus one octave."
msgstr ""
"Изменение высоты тона TAP (LADSPA 2150).<br>\n"
"   Изменяет высоту тона в диапазоне плюс/минус одной октавы."

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8328
#, kde-format
msgid "Semitone Shift"
msgstr "Смещение полутона"

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8330
#, kde-format
msgid ""
"Does the same thing as <b>Rate Shift</b></br>\n"
"      but allows to set musically sensible pitch shift rates."
msgstr ""
"Работает аналогично параметру <b>Смещение частоты</b>,</br>\n"
"      но позволяет установить уместное с музыкальной точки зрения смещение "
"частоты тона."

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8332
#, kde-format
msgid "Rate Shift"
msgstr "Смещение частоты"

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8334
#, kde-format
msgid ""
"Does the same thing as <b>Semitone Shift</b><br>\n"
"      but in percentage of the original pitch, so that is closer to a "
"\"physical\", non-musical approach"
msgstr ""
"Работает аналогично параметру <b>Смещение полутона</b>,<br>\n"
"      но в процентах от исходного тона; ближе к «физическому», а не "
"музыкальному подходу."

#. i18n: file: data/effects/ladspa/ladspa_2151.xml
#: rc.cpp:8342
#, kde-format
msgid "TAP Equalizer/BW"
msgstr "Эквалайзер/Полоса пропускания TAP"

#. i18n: file: data/effects/ladspa/ladspa_2151.xml
#: rc.cpp:8344
#, kde-format
msgid ""
"TAP Equalizer (LADSPA (2151)<br>\n"
"    8-band equalizer with adjustable band center frequencies and bandwidth."
msgstr ""
"Эквалайзер TAP (LADSPA (2151).<br>\n"
"    Восьмиполосный эквалайзер с настраиваемыми средними частотами и полосой "
"пропускания."

#. i18n: file: data/effects/ladspa/ladspa_2151.xml
#: rc.cpp:8350 rc.cpp:8356 rc.cpp:8362 rc.cpp:8368 rc.cpp:8374 rc.cpp:8380
#: rc.cpp:8386 rc.cpp:8392
#, kde-format
msgid "BW"
msgstr "Полоса пропускания"

#. i18n: file: data/effects/ladspa/ladspa_2151.xml
#: rc.cpp:8360
#, kde-format
msgid "<Gain"
msgstr "Усиление"

#. i18n: file: data/effects/ladspa/ladspa_2152.xml
#: rc.cpp:8396
#, kde-format
msgid "TAP Dynamics (M)"
msgstr "Динамика TAP (моно)"

#. i18n: file: data/effects/ladspa/ladspa_2152.xml
#: rc.cpp:8398
#, kde-format
msgid ""
"TAP Dynamics Mono (LADSPA 2152)<br>\n"
"   Allows changing the dynamic content of the audio stream"
msgstr ""
"Динамическое моно TAP (LADSPA 2152).<br>\n"
"   Изменение динамического содержимого звукового потока."

#. i18n: file: data/effects/ladspa/ladspa_2152.xml
#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8404 rc.cpp:8422
#, kde-format
msgid "Offset Gain"
msgstr "Усиление смещения"

#. i18n: file: data/effects/ladspa/ladspa_2152.xml
#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8406 rc.cpp:8424
#, kde-format
msgid "Makeup Gain"
msgstr "Компенсационное усиление"

#. i18n: file: data/effects/ladspa/ladspa_2152.xml
#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8408 rc.cpp:8432
#, kde-format
msgid "Dynamics Transfer Function"
msgstr "Функция динамической передачи"

#. i18n: file: data/effects/ladspa/ladspa_2152.xml
#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8410 rc.cpp:8434
#, kde-format
msgid ""
"2:1 comp at -6dB,2:1 comp at -9dB,2:1 comp at -12dB,2:1 comp at -18dB,2.5 "
"comp at -18dB,3:1 comp at -12dB,3:1 comp at -15dB,Compressor/Gate,Expander,"
"Hard limiter at -6dB;Hard limiter at -12dB;Hard gate at -35dB;Soft limiter;"
"Soft knee comp/gate;Softgate below -36dB"
msgstr ""
"2:1 сжатие на -6 дБ,2:1 сжатие на -9 дБ,2:1 сжатие на -12 дБ,2:1 сжатие на "
"-18 дБ,2.5 сжатие на -18 дБ,3:1 сжатие на -12 дБ,3:1 сжатие на -15 дБ,"
"Сжиматель/Шлюз,Расширитель,Жёсткое ограничение на -6 дБ;Жёсткое ограничение "
"на -12 дБ;Жёсткий шлюз на -35 дБ;Мягкое ограничение;Мягкое коленчатое сжатие/"
"шлюз;Мягкий шлюз ниже -36 дБ"

#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8414
#, kde-format
msgid "TAP Dynamics (St)"
msgstr "Динамика TAP (стерео)"

#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8416
#, kde-format
msgid ""
"TAP Dynamics Stereo (LADSPA 2153)<br>\n"
"   Allows changing the dynamic content of the audio stream"
msgstr ""
"Динамическое стерео TAP (LADSPA 2153).<br>\n"
"   Изменение динамического содержимого звукового потока."

#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8428
#, kde-format
msgid ""
"Controls how the envelope levels<br>\n"
"      are used to determine the needed gain adjustment"
msgstr ""
"Управление использованием уровней обёртки<br>\n"
"      для определения необходимой корректировки усиления"

#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8430
#, kde-format
msgid "Independent,Average,Peak"
msgstr "Независимый,Средний,Пиковый"

#. i18n: file: data/effects/ladspa/ladspa_2154.xml
#: rc.cpp:8438
#, kde-format
msgid "TAP Reflector"
msgstr "Рефлектор TAP"

#. i18n: file: data/effects/ladspa/ladspa_2154.xml
#: rc.cpp:8440
#, kde-format
msgid ""
"TAP Reflector (LADSPA 2154)<br>\n"
"    Creates a psychedelic reverse audio effect."
msgstr ""
"Рефлектор TAP (LADSPA 2154).<br>\n"
"    Создаёт психоделический эффект воспроизведения звука задом наперёд."

#. i18n: file: data/effects/ladspa/ladspa_2154.xml
#: rc.cpp:8442
#, kde-format
msgid "Fragment Length"
msgstr "Длина фрагмента"

#. i18n: file: data/effects/ladspa/ladspa_2154.xml
#: rc.cpp:8444
#, kde-format
msgid ""
"It is best to set it to<br>\n"
"      approximately match the tempo of the track, so the Fragment Length is "
"equal to the time of one measure."
msgstr ""
"Рекомендуется установить в значение,<br>\n"
"      приблизительно соответствующее темпу дорожки (так, чтобы «Длина "
"фрагмента» была равна времени одного такта)."

#. i18n: file: data/effects/ladspa/ladspa_2155.xml
#: rc.cpp:8452
#, kde-format
msgid "TAP Pink/Fractal Noise"
msgstr "Розовый/Фрактальный шум TAP"

#. i18n: file: data/effects/ladspa/ladspa_2155.xml
#: rc.cpp:8454
#, kde-format
msgid ""
"TAP Pink/Fractal Noise (LADSPA 2155)<br>\n"
"    Adds pink noise to the incoming signal using a one-dimensional random "
"fractal line generated by the Midpoint Displacement Method."
msgstr ""
"Розовый/Фрактальный шум TAP (LADSPA 2155).<br>\n"
"    Добавляет розовый шум к входящему сигналу с помощью одномерной случайной "
"фрактальной линии, созданной методом смещения средней точки."

#. i18n: file: data/effects/ladspa/ladspa_2155.xml
#: rc.cpp:8456
#, kde-format
msgid "Fractal Dimension"
msgstr "Фрактальная размерность"

#. i18n: file: data/effects/ladspa/ladspa_2155.xml
#: rc.cpp:8458
#, kde-format
msgid "Signal Level"
msgstr "Уровень сигнала"

#. i18n: file: data/effects/ladspa/ladspa_2155.xml
#: rc.cpp:8460
#, kde-format
msgid "Noise Level"
msgstr "Уровень шума"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8464
#, kde-format
msgid "TAP Fractal Doubler"
msgstr "Фрактальный удвоитель TAP"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8466
#, kde-format
msgid ""
"TAP Fractal Doubler (LADSPA 2156)<br>\n"
"    Suitable for doubling tracks with vocals, acoustic/electric guitars, "
"bass and just about any other instrument on them."
msgstr ""
"Фрактальный удвоитель TAP (LADSPA 2156).<br>\n"
"    Подходит для дублирования дорожек с вокалом, акустическими или "
"электрическими гитарами, басом и практически любым другим инструментом."

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8468
#, kde-format
msgid "Time Tracking"
msgstr "Отслеживание времени"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8470 rc.cpp:8474
#, kde-format
msgid ""
"Determines how \"rough\" and how big<br>\n"
"      these changes are. When set to 0, changes are bigger and more chaotic "
"(\"bad backup singer\"). When set to 1, changes are smaller and smoother "
"(\"better tracking of the original\")."
msgstr ""
"Определяет, насколько «грубыми» и большими<br>\n"
"      являются эти изменения. При установке значения «0» изменения будут "
"больше и хаотичнее («плохой бэк-вокалист»). При установке значения «1» "
"изменения будут меньше и плавнее («лучшее отслеживание оригинала»)."

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8472
#, kde-format
msgid "Pitch Tracking"
msgstr "Отслеживание тона"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8478
#, kde-format
msgid "Dry Left Position"
msgstr "Позиция «сухого» слева"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8480 rc.cpp:8484 rc.cpp:8490 rc.cpp:8494
#, kde-format
msgid ""
"These controls range between 0 and 1,<br>\n"
"      0 meaning hard left and 1 meaning hard right position."
msgstr ""
"Эти параметры управляют диапазоном от 0 до 1:<br>\n"
"      0 — максимально слева, 1 — максимально справа"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8482
#, kde-format
msgid "Dry Right Position"
msgstr "Позиция «сухого» справа"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8488
#, kde-format
msgid "Wet Left Position"
msgstr "Позиция «мокрого» слева"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8492
#, kde-format
msgid "Wet Right Position"
msgstr "Позиция «мокрого» справа"

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8498
#, kde-format
msgid "TAP Sigmoid Booster"
msgstr "Сигмоидальный усилитель TAP"

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8500
#, kde-format
msgid ""
"TAP Sigmoid Booster (LADSPA 2157)<br>\n"
"   Applies a time-invariant nonlinear amplitude transfer function to the "
"signal."
msgstr ""
"Сигмоидальный усилитель TAP (LADSPA 2157).<br>\n"
"   Применяет неизменяемую по времени нелинейную амплитудную передаточную "
"функцию к сигналу."

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8502
#, kde-format
msgid "Pre Gain"
msgstr "До усиления"

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8504
#, kde-format
msgid "Scales the input signal before the transfer function is applied to it."
msgstr "Масштабирует входной сигнал перед применением функции передачи."

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8506
#, kde-format
msgid "Post Gain"
msgstr "После усиления"

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8508
#, kde-format
msgid "Can be used to adjust the output gain of the effect."
msgstr "Можно использовать для настройки усиления на выходе эффекта."

#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:8512
#, kde-format
msgid "TAP TubeWarmth"
msgstr "Ламповая теплота TAP"

#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:8514
#, kde-format
msgid ""
"TAP TubeWarmth (LADSPA 2158)<br>\n"
"   Adds the character of vacuum tube amplification by emulating the "
"sonically desirable nonlinear characteristics of triodes. It also supports "
"emulating analog tape saturation."
msgstr ""
"Ламповая теплота TAP (LADSPA 2158).<br>\n"
"   Придаёт характер лампового усиления, имитируя желаемые с точки зрения "
"звучания нелинейные характеристики триодов. Также предусмотрена поддержка "
"имитации насыщенности ленты для аналоговой записи."

#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:8518
#, kde-format
msgid "Adjusts the amount of the effect"
msgstr "Настройка интенсивности эффекта"

#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:8520
#, kde-format
msgid "Tape--Tube Blend"
msgstr "Смешивание ленты-лампы"

#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:8522
#, kde-format
msgid "Controls the color of the TubeWarmth sound"
msgstr "Управляет цветом звука ламповой теплоты"

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8526
#, kde-format
msgid "TAP Chorus/Flange"
msgstr "Хор/Фланжер TAP"

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8528
#, kde-format
msgid ""
"TAP Chorus/Flange (LADSPA 2159)<br>\n"
"    Creates traditional Chorus and Flanger effects, spiced up a bit to make "
"use of stereo processing. It sounds best on guitar and synth tracks."
msgstr ""
"Хор/Флэнжер TAP (LADSPA 2159).<br>\n"
"    Создаёт традиционные эффекты «Хор» и «Флэнжер» с небольшими изменениями, "
"которые позволяют использовать возможности обработки стереосигнала. Лучше "
"всего подходит для дорожек гитары и синтезатора."

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8532
#, kde-format
msgid ""
"Determines the LFO frequency<br>\n"
"      with which the time-varying delay is modulated. The higher the "
"frequency, the more intense the effect will be."
msgstr ""
"Определяет частоту НЧ-модулятора,<br>\n"
"      которая используется для переменной по времени задержки. Чем выше "
"частота, тем интенсивнее будет эффект."

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8534
#, kde-format
msgid "L/R Phase Shift"
msgstr "Сдвиг фазы Л/П"

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8536
#, kde-format
msgid ""
"Controls the phase shift between the two<br>\n"
"      LFOs. The higher this setting, the stronger the \"stereo-ness\" of the "
"effect will be. When set to 0, processing of the two channels will be in-"
"phase; when set to 180 degrees, the two LFO's are is counter-phase to create "
"the widest stereo effect."
msgstr ""
"Управляет сдвигом фазы между двумя<br>\n"
"      НЧ-модуляторами. Чем выше значение, тем сильнее «стерео» эффекта. Если "
"установить значение равным нулю, обработка двух каналов будет синфазной; "
"если установить значение равным 180 градусам, два НЧ-модулятора находятся в "
"противофазе, что создаст максимально широкий стереоэффект."

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8540
#, kde-format
msgid ""
"Adjusts the modulation depth of the delay.<br>\n"
"      Increasing it will result in stronger modulation using the same LFO "
"frequency."
msgstr ""
"Настройка глубины модуляции задержки.<br>\n"
"      При увеличении значения модуляция будет сильнее при той же частоте НЧ-"
"модулятора."

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8544
#, kde-format
msgid ""
"Determines the fixed amount of time with<br>\n"
"      which the signal is delayed after the time-varying delay has been "
"applied. The setting of this control distinguishes between the Chorus and "
"Flanger effects. Delays smaller than 10 ms can be labeled Flanger, delays "
"above 20 ms yield Chorus, and delays in the range of 10-20 ms result in a "
"blend between Chorus and Flanger."
msgstr ""
"Определяет фиксированное количество времени, на которое<br>\n"
"      сигнал задерживается после применения переменной по времени задержки. "
"Этот параметр предусматривает эффекты «Хор» и «Флэнжер». Если задержка "
"меньше 10 мс, это «Флэнжер», свыше 20 мс — «Хор». Когда задержка находится в "
"диапазоне от 10 до 20 мс, получается смесь этих двух эффектов."

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8546
#, kde-format
msgid "Contour"
msgstr "Контур"

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8548
#, kde-format
msgid ""
"The cutoff frequency of a high-pass<br>\n"
"      filter applied to the now twice-delayed signal."
msgstr ""
"Частота отсечки высокочастотного фильтра,<br>\n"
"      применяемого к уже дважды задержанному сигналу"

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8552 rc.cpp:8556
#, kde-format
msgid ""
"Allows for a final tuning of the sound.<br>\n"
"      The strongest effect is achieved if the two settings are about the "
"same. Decreasing one of them (preferably the Wet Level, to mitigate any "
"unwanted side effects) results in a subtler effect."
msgstr ""
"Позволяет выполнить финальную настройку звуку.<br>\n"
"      Эффект будет максимально сильным, если установить приблизительно "
"одинаковые значения для обоих параметров. Эффект будет менее заметным, если "
"уменьшить значение одного из них (рекомендуется сделать это для параметра "
"«Уровень \"мокрого\"», чтобы смягчить нежелательные побочные эффекты)."

#. i18n: file: data/effects/ladspa/ladspa_declipper.xml
#: rc.cpp:8562
#, kde-format
msgid "LADSPA declipper audio effect"
msgstr "Удаление треска (эффект LADSPA)"

#. i18n: file: data/effects/ladspa/ladspa_equalizer.xml
#: rc.cpp:8564
#, kde-format
msgid "Equalizer"
msgstr "Эквалайзер"

#. i18n: file: data/effects/ladspa/ladspa_equalizer.xml
#: rc.cpp:8566
#, kde-format
msgid "LADSPA equalizer audio effect"
msgstr "Эквалайзер (эффект LADSPA)"

#. i18n: file: data/effects/ladspa/ladspa_equalizer.xml
#: rc.cpp:8568
#, kde-format
msgid "Lo gain"
msgstr "Малое усиление"

#. i18n: file: data/effects/ladspa/ladspa_equalizer.xml
#: rc.cpp:8570
#, kde-format
msgid "Mid gain"
msgstr "Среднее усиление"

#. i18n: file: data/effects/ladspa/ladspa_equalizer.xml
#: rc.cpp:8572
#, kde-format
msgid "Hi gain"
msgstr "Большое усиление"

#. i18n: file: data/effects/ladspa/ladspa_equalizer_15.xml
#: rc.cpp:8574
#, kde-format
msgid "15 Band Equalizer"
msgstr "15-полосный эквалайзер"

#. i18n: file: data/effects/ladspa/ladspa_equalizer_15.xml
#: rc.cpp:8576
#, kde-format
msgid "LADSPA equalizer audio effect (15 band)"
msgstr "15-полосный эквалайзер (эффект LADSPA)"

#. i18n: file: data/effects/ladspa/ladspa_equalizer_15.xml
#: rc.cpp:8578
#, kde-format
msgid "50 Hz"
msgstr "50 Гц"

#. i18n: file: data/effects/ladspa/ladspa_equalizer_15.xml
#: rc.cpp:8580
#, kde-format
msgid "100 Hz"
msgstr "100 Гц"

#. i18n: file: data/effects/ladspa/ladspa_equalizer_15.xml
#: rc.cpp:8582
#, kde-format
msgid "156 Hz"
msgstr "156 Гц"

#. i18n: file: data/effects/ladspa/ladspa_equalizer_15.xml
#: rc.cpp:8584
#, kde-format
msgid "220 Hz"
msgstr "220 Гц"

#. i18n: file: data/effects/ladspa/ladspa_equalizer_15.xml
#: rc.cpp:8586
#, kde-format
msgid "311 Hz"
msgstr "311 Гц"

#. i18n: file: data/effects/ladspa/ladspa_equalizer_15.xml
#: rc.cpp:8588
#, kde-format
msgid "440 Hz"
msgstr "440 Гц"

#. i18n: file: data/effects/ladspa/ladspa_equalizer_15.xml
#: rc.cpp:8590
#, kde-format
msgid "622 Hz"
msgstr "622 Гц"

#. i18n: file: data/effects/ladspa/ladspa_equalizer_15.xml
#: rc.cpp:8592
