msgstr ""
"Устранение чересстрочности входного видео («yadif» — это «yet another "
"deinterlacing filter», то есть «ещё один фильтр для устранения "
"чересстрочности»)"

#. i18n: file: data/effects/avfilter/avfilter_yadif.xml
#: rc.cpp:7432
#, kde-format
msgid "Send frame,Send field,Send frame nospatial,Send field nospatial"
msgstr ""
"Отправить кадр,Отправить поле,Отправить кадр непространственно,Отправить "
"поле непространственно"

#. i18n: file: data/effects/avfilter/avfilter_yadif.xml
#: rc.cpp:7436
#, kde-format
msgid "Top field first,Bottom field first,Auto"
msgstr "Сначала верхнее поле,Сначала нижнее поле,Автоматически"

#. i18n: file: data/effects/avfilter/avfilter_zoompan.xml
#: rc.cpp:7442
#, kde-format
msgid "Zoom Pan"
msgstr "Масштабирование с панорамированием"

#. i18n: file: data/effects/avfilter/avfilter_zoompan.xml
#: rc.cpp:7444
#, kde-format
