#: rc.cpp:8194 rc.cpp:8306 rc.cpp:8338 rc.cpp:8448 rc.cpp:8486 rc.cpp:8554
#, kde-format
msgid "Wet Level"
msgstr "Уровень «мокрого»"

#. i18n: file: data/effects/ladspa/ladspa_2142.xml
#: rc.cpp:8196
#, kde-format
msgid "Comb Filters"
msgstr "Гребенчатые фильтры"

#. i18n: file: data/effects/ladspa/ladspa_2142.xml
#: rc.cpp:8198
#, kde-format
msgid "Allpass Filters"
msgstr "Всепропускающие фильтры"

#. i18n: file: data/effects/ladspa/ladspa_2142.xml
#: rc.cpp:8200
#, kde-format
msgid "Bandpass Filter"
msgstr "Полосно-пропускающий фильтр"

#. i18n: file: data/effects/ladspa/ladspa_2142.xml
#: rc.cpp:8202
#, kde-format
msgid "Enhanced Stereo"
msgstr "Улучшенное стерео"

#. i18n: file: data/effects/ladspa/ladspa_2142.xml
#: rc.cpp:8204
#, kde-format
msgid "Reverb Type"
msgstr "Тип реверберации"

#. i18n: file: data/effects/ladspa/ladspa_2142.xml
#: rc.cpp:8206
#, kde-format
msgid ""
"HD stands for <i>High Density</i>.<br>\n"
"      Reverb types with HD are enhanced versions of the other types and "
"usually result in an even smoother reverb effect."
msgstr ""
"HD — это <i>High Density</i> (высокая плотность).<br>\n"
"      Типы реверберации с высокой плотностью представляют собой улучшенные "
"версии других типов и обычно позволяют получить ещё более плавный эффект "
"реверберации."

