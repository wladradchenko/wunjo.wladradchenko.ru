msgstr "Верхний порог"

#. i18n: file: data/effects/avfilter/avfilter_edgedetect.xml
#: rc.cpp:5762
#, kde-format
msgid "Modes"
msgstr "Режимы"

#. i18n: file: data/effects/avfilter/avfilter_edgedetect.xml
#: rc.cpp:5764
#, kde-format
msgid "Wires,Colormix,Canny"
msgstr "Каркас,Цветомикс,Кэнни"

#. i18n: file: data/effects/avfilter/avfilter_edgedetect.xml
