#, kde-format
msgid "Band-Reject"
msgstr "Band-niet-doorlaten"

#. i18n: file: data/effects/avfilter/avfilter_bandreject.xml
#: rc.cpp:4908
#, kde-format
msgid ""
"Apply a two-pole Butterworth band-reject filter with central frequency and "
"(3dB-point) band-width. The filter roll off at 6dB per octave (20dB per "
"decade)."
msgstr ""
"Twee-polige Butterworth bandverwerpfilter met centrale frequentie en (3dB-"
"punt) bandbreedte toepassen. De filter-roll-off op 6dB per octaaf (20dB per "
"decade)"

