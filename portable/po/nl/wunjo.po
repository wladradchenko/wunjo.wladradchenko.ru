#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8498
#, kde-format
msgid "TAP Sigmoid Booster"
msgstr "TAP-sigmoid-booster"

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8500
#, kde-format
msgid ""
"TAP Sigmoid Booster (LADSPA 2157)<br>\n"
"   Applies a time-invariant nonlinear amplitude transfer function to the "
"signal."
msgstr ""
"TAP-sigmoid-booster (LADSPA 2157)<br>\n"
"   past een tijd-onveranderlijke niet-lineaire amplitude overdrachtsfunctie "
"toe op het signa."

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8502
#, kde-format
msgid "Pre Gain"
msgstr "Voorversterking"

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8504
#, kde-format
msgid "Scales the input signal before the transfer function is applied to it."
msgstr ""
"Schaalt het invoersignaal voordat de transferfunctie er op wordt toegepast."

# gain = toenemen ?
#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8506
#, kde-format
msgid "Post Gain"
msgstr "Naversterking"

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8508
#, kde-format
msgid "Can be used to adjust the output gain of the effect."
msgstr ""
"Kan worden gebruikt om de uitvoerversterking van het effect aan te passen."

#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:8512
#, kde-format
msgid "TAP TubeWarmth"
msgstr "TAP-tubeWarmth"

#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:8514
#, kde-format
msgid ""
"TAP TubeWarmth (LADSPA 2158)<br>\n"
"   Adds the character of vacuum tube amplification by emulating the "
"sonically desirable nonlinear characteristics of triodes. It also supports "
"emulating analog tape saturation."
msgstr ""
"TAP-tubeWarmth (LADSPA 2158)<br>\n"
"   Voegt het teken toe van de vacuumbuisversterking door het emuleren van de "
"sonisch gewenste niet-lineaire karakteristiek van triodes. Het ondersteunt "
"ook emuleren van verzadiging van analoge tape."

#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:8518
#, kde-format
msgid "Adjusts the amount of the effect"
msgstr "Pas de hoeveelheid van het effect aan"

#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:8520
#, kde-format
msgid "Tape--Tube Blend"
msgstr "Tape--buismenging"

#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:8522
#, kde-format
msgid "Controls the color of the TubeWarmth sound"
msgstr "Bestuurt de kleur van het TubeWarmth geluid"

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8526
#, kde-format
msgid "TAP Chorus/Flange"
msgstr "TAP-koor/flange"

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8528
#, kde-format
msgid ""
"TAP Chorus/Flange (LADSPA 2159)<br>\n"
"    Creates traditional Chorus and Flanger effects, spiced up a bit to make "
"use of stereo processing. It sounds best on guitar and synth tracks."
msgstr ""
"TAP-koor (LADSPA 2159)<br>\n"
"    Creates traditional Chorus- en Flanger-effecten, een beetje gekruid om "
"gebruik te maken van stereoverwerking. Het klink het best op gitaar en "
"synthetische tracks."

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8532
#, kde-format
msgid ""
"Determines the LFO frequency<br>\n"
"      with which the time-varying delay is modulated. The higher the "
"frequency, the more intense the effect will be."
msgstr ""
"Bepaalt de LFO-frequentie<br>\n"
"      waarmee de tijd-variërende vertraging wordt gemoduleerd. Hoe hoger de "
"frequentie, hoe intenser het effect zal zijn."

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8534
#, kde-format
msgid "L/R Phase Shift"
msgstr "L/R faseverschuiving"

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8536
#, kde-format
msgid ""
"Controls the phase shift between the two<br>\n"
"      LFOs. The higher this setting, the stronger the \"stereo-ness\" of the "
"effect will be. When set to 0, processing of the two channels will be in-"
"phase; when set to 180 degrees, the two LFO's are is counter-phase to create "
"the widest stereo effect."
msgstr ""
"Bestuurt de faseverschuiving tussen de twee LFO's<br>\n"
"      Hoe hoger deze instelling, hoe sterker de \"mate van stereo\" van het "
"effect zal zijn. Indien gezet op 0, verwerking van de twee kanalen zal in-"
"fase zijn; indien op 180 graden, dan zijn de twee LFO's in tegenfase om het "
"breedste stereo-effect te maken."

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8540
#, kde-format
msgid ""
"Adjusts the modulation depth of the delay.<br>\n"
"      Increasing it will result in stronger modulation using the same LFO "
"frequency."
msgstr ""
"Past de modulatiediepte van de vertraging aan.<br>\n"
"      Deze verhogen het resultaat in een sterkere modulatie met gebruik van "
"dezelfde LFO frequentie."

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8544
#, kde-format
msgid ""
"Determines the fixed amount of time with<br>\n"
"      which the signal is delayed after the time-varying delay has been "
"applied. The setting of this control distinguishes between the Chorus and "
"Flanger effects. Delays smaller than 10 ms can be labeled Flanger, delays "
"above 20 ms yield Chorus, and delays in the range of 10-20 ms result in a "
"blend between Chorus and Flanger."
msgstr ""
"Bepaalt de vaste hoeveelheid tijd waarmee<br>\n"
"      het signaal wordt vertraagd nadat de in tijd variërende vertraging is "
"toegepast. De instelling van deze besturing onderscheidt tussen het Chorus- "
"en Flanger-effecten. Vertragingen kleiner dan 10 ms kunnen het label Flanger "
"krijgen, vertragingen boven 20 ms krijgen Chorus en vertragingen in de reeks "
"van 10-20 ms resulteren in een mengsel tussen Chorus en Flanger."

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8546
#, kde-format
msgid "Contour"
msgstr "Contour"

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8548
#, kde-format
msgid ""
"The cutoff frequency of a high-pass<br>\n"
"      filter applied to the now twice-delayed signal."
msgstr ""
"De afsnijfrequentie van een hoogdoorlaat<br>\n"
"      filter toegepast op het nu tweemaal vertraagde signaal."

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8552 rc.cpp:8556
#, kde-format
msgid ""
"Allows for a final tuning of the sound.<br>\n"
"      The strongest effect is achieved if the two settings are about the "
"same. Decreasing one of them (preferably the Wet Level, to mitigate any "
"unwanted side effects) results in a subtler effect."
msgstr ""
"Staat een finale afstemming van het geluid toe.<br>\n"
"      Het sterkste effect is bereikt als de twee instellingen ongeveer "
"hetzelfde zijn. Een van hen verminderen (bij voorkeur het natte niveau, om "
"elk ongewenst side-effect te verminderen) resulteert in een subtieler effect."

