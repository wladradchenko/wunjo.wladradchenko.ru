#: rc.cpp:8416
#, kde-format
msgid ""
"TAP Dynamics Stereo (LADSPA 2153)<br>\n"
"   Allows changing the dynamic content of the audio stream"
msgstr ""
"TAP-dynamieken stereo (LADSPA 2153)<br>\n"
"   Biedt het wijzigen van de dynamische inhoud van de audiostream"

#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8428
#, kde-format
