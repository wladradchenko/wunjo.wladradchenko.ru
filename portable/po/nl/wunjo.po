#. i18n: file: data/effects/ladspa/ladspa_1430.xml
#: rc.cpp:7802
#, kde-format
msgid "Chebyshev Distortion"
msgstr "Chebyshev-vervorming"

#. i18n: file: data/effects/ladspa/ladspa_1430.xml
#: rc.cpp:7804
#, kde-format
msgid ""
"Chebyshev Distortion (LADSPA 1430)<br>\n"
"   This effect is seeded from incoming signal envelope. As the level of the "
"signal rises more and more harmonics will for added to the output signal. "
"The distortion control sets the sensitivity of the input."
msgstr ""
"Chebyshev-vervorming (LADSPA 1430)<br>   Dit effect wordt aangestuurd door "
"de envelop van het inkomende signaal. Naarmate het signaalniveau stijgt, "
"worden er steeds meer harmonischen aan het uitgangssignaal toegevoegd. De "
"vervormingsregelaar bepaalt de gevoeligheid van de ingang."

#. i18n: file: data/effects/ladspa/ladspa_1430.xml
#: rc.cpp:7806
