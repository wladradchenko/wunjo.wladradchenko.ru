msgstr "Vertragingsbereik"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7648
#, kde-format
msgid "The time difference between the first and last delay"
msgstr "Het tijdsverschil tussen de eerste en de laatste vertraging"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7650
#, kde-format
msgid "Delay Change"
msgstr "Vertragingswijziging"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7652
#, kde-format
