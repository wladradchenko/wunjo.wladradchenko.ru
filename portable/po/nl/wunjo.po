msgid "Crossover Distortion"
msgstr "Crossover-vervorming"

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7692
#, kde-format
msgid ""
"Crossover Distortion (LADSPA 1404)<br>\n"
"   This is a simulation of the distortion that happens in class B and AB "
"power amps when the signal crosses 0."
msgstr ""
"Crossover-vervorming (LADSPA 1404)<br>\n"
"    Dit is een simulatie van de vervorming die optreedt in klasse B- en AB-"
"eindversterkers wanneer het signaal de nulgrens passeert."

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7694
#, kde-format
msgid "Crossover Amplitude"
msgstr "Crossover-amplitude"

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7696
#, kde-format
msgid "Controls the point at which the output signal becomes linear"
msgstr "Bepaalt het punt waarop het uitgangssignaal lineair wordt"

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7700
#, kde-format
msgid "Controls degree of smoothing of the crossover point"
msgstr "Regelt de mate van afvlakking van het crossover-punt"

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7704
#, kde-format
msgid "Aliasing"
msgstr "Aliasing"

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7706
#, kde-format
msgid ""
"Aliasing (LADSPA 1407)<br>\n"
"   Simulates aliasing using nyquist frequency modulation. Produces wacky "
"results if the blocks aren't even numbers of samples long."
msgstr ""
"Aliasing (LADSPA 1407)<br>   Simuleert aliasing door middel van Nyquist-"
"frequentiemodulatie. Levert eigenzinnige resultaten op als de blokken niet "
"uit een even aantal samples bestaan."

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7708
#, kde-format
msgid "Aliasing Level"
msgstr "Aliasing-niveau"

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7710
#, kde-format
msgid "Controls the amount of simulated aliasing in the output."
msgstr "Regelt de hoeveelheid gesimuleerde aliasing in de uitvoer."

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7714
#, kde-format
msgid "Barry's Satan Maximiser"
msgstr "Barry's Satan Maximiser"

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7716
#, kde-format
msgid ""
"Barry's Satan Maximiser (LADSPA 1408)<br>\n"
"   Compresses signals with a stupidly short attack and decay, infinite ratio "
"and hard knee. Not really as a compressor, but good harsh (non-musical) "
"distortion."
msgstr ""
"Barry's Satan Maximiser (LADSPA 1408)<br>\n"
"   Comprimeert signalen met een absurd korte attack en decay, een oneindige "
"ratio en een 'hard knee'. Niet echt bedoeld als compressor, maar wel goed "
"voor rauwe, harde (niet-muzikale) vervorming."

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7718
#, kde-format
msgid "Decay Time (samples)"
msgstr "Vervaltijd (monsters)"

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7720
#, kde-format
msgid "Controls the envelope decay time."
msgstr "Regelt de vervaltijd van de envelop."

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7722
#, kde-format
msgid "Knee Point"
msgstr "Knikpunt"

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7724
#, kde-format
msgid ""
"Controls the knee roll-off point,<br>\n"
"      ie. the point above which the compression kicks in. 0 will have no "
"effect, -90 will remove virtually all dynamic range."
msgstr ""
"Regelt het knikpunt van de afrol,<br>\n"
"      d.w.z. het punt waarboven de compressie inkomt. 0 zal geen effect "
"hebben, -90 zal virtueel de gehele dynamische reeks verwijderen."

