#: rc.cpp:7056 rc.cpp:7060
#, kde-format
msgid ""
"Set input level before filtering for both channels.\n"
"Allowed range is from 0.015625 to 64."
msgstr ""
"Zet invoerniveau voor filtering voor beide kanalen.\n"
"Toegestane reeks is van 0,015625 tot 64."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7058
#, kde-format
msgid "Level OUT"
msgstr "Niveau UIT"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7062 rc.cpp:7120
#, kde-format
msgid "Balance IN"
msgstr "Balans IN"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7064 rc.cpp:7068
#, kde-format
msgid ""
"Set input balance between both channels. Default is 0. Allowed range is from "
"-1 to 1."
msgstr ""
"Zet invoerbalans tussen beide kanalen. Standaard is 0. Toegestane reeks is "
"van -1 tot 1."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7066 rc.cpp:7126
#, kde-format
msgid "Balance OUT"
msgstr "Balans UIT"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7070
#, kde-format
msgid "Softclip"
msgstr "Softclip"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7072
#, kde-format
msgid ""
"Enable softclipping. Results in analog distortion instead of harsh digital "
"0dB clipping."
msgstr ""
"Met softclip werken inschakelen. Resultaten in analoge distorsie in plaats "
"van hard digitaal 0dB clipping."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7074
