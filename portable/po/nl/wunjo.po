#: rc.cpp:8214
#, kde-format
msgid ""
"TAP Stereo Echo (LADSPA 2143)<br>\n"
"   Supports conventional mono and stereo delays, ping-pong delays and the "
"Haas effect (also known as Cross Delay Stereo)."
msgstr ""
"TAP-stereo echo (LADSPA 2143)<br>\n"
"   Ondersteunt conventionele mono en stereo vertragingen, ping-pong "
"vertragingen en het Haaseffect (ook bekend als Cross Delay Stereo)."

