#: rc.cpp:8288
#, kde-format
msgid "Monitor On"
msgstr "Monitor aan"

#. i18n: file: data/effects/ladspa/ladspa_2148.xml
#: rc.cpp:8292
#, kde-format
msgid "TAP Vibrato"
msgstr "TAP-vibrato"

#. i18n: file: data/effects/ladspa/ladspa_2148.xml
#: rc.cpp:8294
#, kde-format
msgid ""
"TAP Vibrato (LADSPA 2148)<br>\n"
"   Modulates the pitch of its input signal with a low-frequency sinusoidal "
"signal. It is useful for guitar and synth tracks, and it can also come handy "
"if a strange effect is needed."
msgstr ""
"TAP-vibrato (LADSPA 2148)<br>\n"
"   Moduleert de toonhoogte van het ingangssignaal met een laagfrequent "
"sinusvormig signaal. Dit is handig voor gitaar- en synthesizertracks, en kan "
"ook van pas komen als er een vreemd effect nodig is."

#. i18n: file: data/effects/ladspa/ladspa_2148.xml
#: rc.cpp:8298
#, kde-format
msgid "Determines how fast the pitch is modulated up-down"
msgstr "Bepaalt hoe snel de toonhoogte op en neer wordt gemoduleerd"

#. i18n: file: data/effects/ladspa/ladspa_2148.xml
#: rc.cpp:8302
#, kde-format
msgid "Sets the amount of pitch modulation"
msgstr "Stelt de hoeveelheid modulatie van de toonhoogte in"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8310
#, kde-format
msgid "TAP Rotary Speaker"
msgstr "TAP ronddraaiende speaker"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8312
#, kde-format
msgid ""
"TAP Rotary Speaker (LADSPA 2149)<br>\n"
"   Simulates the sound of rotating speakers."
msgstr ""
"TAP ronddraaiende speaker (LADSPA 2149)<br>\n"
"   Simuleert het geluid van ronddraaiende speakers."

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8314
#, kde-format
msgid "Rotor Frequency"
msgstr "Draaifrequentie"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8316
#, kde-format
msgid "Horn Frequency"
msgstr "Hoornfrequentie"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8318
#, kde-format
msgid "Mic Distance"
msgstr "Microfoonafstand"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8320
#, kde-format
msgid "Rotor/Horn Mix"
msgstr "Rotor/hoorn mix"

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8324
#, kde-format
msgid "TAP Pitch Shifter"
msgstr "TAP-toonhoogteschuif"

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8326
#, kde-format
msgid ""
"TAP Pitch Shifter (LADSPA 2150)<br>\n"
"   Change the pitch in the range of plus/minus one octave."
msgstr ""
"TAP-toonhoogteschuif (LADSPA 2150)<br>\n"
"   wijzigt de toonhoogte in de reeks van plus-minus één octaaf."

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8328
#, kde-format
msgid "Semitone Shift"
msgstr "Halftoonverschuiving"

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8330
#, kde-format
msgid ""
"Does the same thing as <b>Rate Shift</b></br>\n"
"      but allows to set musically sensible pitch shift rates."
msgstr ""
"Doet hetzelfde als <b>Verhoudingverschuiving</b></br>\n"
"      maar biedt het zetten van musicologisch zinvolle "
"toonhoogteverschuivingsverhoudingen."

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8332
#, kde-format
msgid "Rate Shift"
msgstr "Verhoudingsverschuiving"

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8334
#, kde-format
msgid ""
"Does the same thing as <b>Semitone Shift</b><br>\n"
"      but in percentage of the original pitch, so that is closer to a "
"\"physical\", non-musical approach"
msgstr ""
"Doet hetzelfde als <b>Halftoonverschuiving</b><br>\n"
"      maar in percentage van de originele toonhoogte, zodat het dichter is "
"bij een \"fysieke\", niet-musicale benadering"

#. i18n: file: data/effects/ladspa/ladspa_2151.xml
#: rc.cpp:8342
#, kde-format
msgid "TAP Equalizer/BW"
msgstr "TAP-equalizer/BW"

#. i18n: file: data/effects/ladspa/ladspa_2151.xml
#: rc.cpp:8344
#, kde-format
msgid ""
"TAP Equalizer (LADSPA (2151)<br>\n"
"    8-band equalizer with adjustable band center frequencies and bandwidth."
msgstr ""
"TAP-equalizer (LADSPA (2151)<br>\n"
"    8-banden equalizer met aanpasbare bandcentrum frequenties en bandbreedte."

