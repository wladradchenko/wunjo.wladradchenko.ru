msgstr "Vervorming"

#. i18n: file: data/effects/ladspa/ladspa_1430.xml
#: rc.cpp:7808
#, kde-format
msgid "Sets the sensitivity of the input"
msgstr "Stel de gevoeligheid van de invoer in"

#. i18n: file: data/effects/ladspa/ladspa_1431.xml
#: rc.cpp:7812
#, kde-format
msgid "Bode Frequency Shifter"
msgstr "Bode frequentie-shifter "

#. i18n: file: data/effects/ladspa/ladspa_1431.xml
#: rc.cpp:7814
#, kde-format
msgid ""
"<b>Bode Frequency Shifter</b> (LADSPA 1431)<br>\n"
"   A Bode/Moog Frequency Shifter is a popular analogue synth module that "
"works by shifting all the frequencies of an input signal up or down by a "
"specified frequency. This effect shifts in both directions at the same time "
"as it is almost no extra work and is often useful to have both directions. "
"In contrast to the analogue Bode/Moog, which use Dome filters as the core, "
"it uses a Hilbert Transformer, which is much simpler to implement in digital "
"systems."
msgstr ""
"<b>Bode Frequentie-shifter</b> (LADSPA 1431)<br>\n"
"   Een Bode/Moog Frequentie-shifter is een populaire analoge synthesizer-"
"module die werkt door alle frequenties van een ingangssignaal met een "
"bepaalde waarde omhoog of omlaag te verschuiven. Dit effect verschuift het "
"signaal gelijktijdig in beide richtingen; dit vergt nauwelijks extra "
"rekenkracht en het is vaak nuttig om over beide richtingen te beschikken. In "
"tegenstelling tot de analoge Bode/Moog, die gebruikmaakt van Dome-filters "
"als kern, maakt deze module gebruik van een Hilbert-transformator, die veel "
"eenvoudiger te implementeren is in digitale systemen."

#. i18n: file: data/effects/ladspa/ladspa_1431.xml
#: rc.cpp:7816
#, kde-format
msgid "Frequency Shift"
msgstr "Frequentie-shift"

#. i18n: file: data/effects/ladspa/ladspa_1431.xml
#. i18n: file: data/effects/ladspa/ladspa_1432.xml
#: rc.cpp:7818 rc.cpp:7836
#, kde-format
msgid "Controls the frequency shift applied to the input signal"
msgstr ""
"Regelt de frequentieverschuiving die op het ingangssignaal wordt toegepast"

#. i18n: file: data/effects/ladspa/ladspa_1432.xml
#: rc.cpp:7822
#, kde-format
msgid "Bode Frequency Shifter (CV)"
msgstr "Bode frequentie-shifter (CV)"

#. i18n: file: data/effects/ladspa/ladspa_1432.xml
#: rc.cpp:7824
#, kde-format
msgid ""
"<b>Bode Frequency Shifter (CV)</b> (LADSPA 1432)<br>\n"
"   A Bode/Moog Frequency Shifter is a popular analogue synth module that "
"works by shifting all the frequencies of an input signal up or down by a "
"specified frequency. This effect shifts in both directions at the same time "
"as it is almost no extra work and is often useful to have both directions. "
"In contrast to the analogue Bode/Moog, which use Dome filters as the core, "
"it uses a Hilbert Transformer, which is much simpler to implement in digital "
"systems."
msgstr ""
"<b>Bode Frequentie-shifter (CV)</b> (LADSPA 1432)<br>\n"
"   Een Bode/Moog Frequentie-shifter is een populaire analoge synthesizer-"
"module die werkt door alle frequenties van een ingangssignaal met een "
"bepaalde waarde omhoog of omlaag te verschuiven. Dit effect verschuift het "
"signaal in beide richtingen tegelijk; dit vergt nauwelijks extra rekenkracht "
"en het is vaak handig om over beide richtingen te beschikken. In "
"tegenstelling tot de analoge Bode/Moog, die gebruikmaakt van Dome-filters "
"als kern, maakt deze versie gebruik van een Hilbert-transformator, die veel "
"eenvoudiger te implementeren is in digitale systemen."

#. i18n: file: data/effects/ladspa/ladspa_1432.xml
