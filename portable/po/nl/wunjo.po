#: rc.cpp:7100
#, kde-format
msgid ""
"Set level of the middle signal. Default is 1. Allowed range is from 0.015625 "
"to 64."
msgstr ""
"Zet niveau van het midden signaal. Standaard is 1. Toegestane reeks is van "
"0,015625 tot 64."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7102
#, kde-format
msgid "Mid Pan"
msgstr "Midden rondkijken"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7104
#, kde-format
msgid "Set middle signal pan. Default is 0. Allowed range is from -1 to 1."
msgstr ""
"Zet midden signaal heen-en-weer. Standaard is 0. Toegestane reeks is van -1 "
"tot 1."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7106
#, kde-format
msgid "Stereo base"
msgstr "Stereobasis"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7108
#, kde-format
msgid ""
"Set stereo base between mono and inverted channels. Default is 0. Allowed "
"range is from -1 to 1."
msgstr ""
"Zet stereobasis tussen mono en en omgewisselde kanalen. Standaard is 0. "
"Toegestane reeks is van -1 tot 1."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7112
#, kde-format
msgid ""
"Set delay in milliseconds how much to delay left from right channel and vice "
"versa. Default is 0. Allowed range is from -20 to 20."
msgstr ""
"Zet vertraging in milliseconden hoeveel het linker kanaal te vertragen vanaf "
"het rechter kanaal en omgekeerd. Standaard is 0. Toegestane reeks is van -20 "
"tot 20."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7114
#, kde-format
msgid "S/C level"
msgstr "S/C-niveau"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7116
#, kde-format
msgid "Stereo phase"
msgstr "Stereofase"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7118
#, kde-format
msgid "Set the stereo phase in degrees."
msgstr "Zet de stereofase in graden."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7122 rc.cpp:7128
#, kde-format
msgid ""
"‘balance’\n"
"Classic balance mode. Attenuate one channel at a time. Gain is raised up to "
"1.\n"
"‘amplitude’\n"
"Similar to classic mode above but gain is raised up to 2.\n"
"‘power’\n"
"Equal power distribution, from -6dB to +6dB range."
msgstr ""
"‘balans’\n"
"Klassieke balansmodus. Verzwakking één kanaal tegelijk. Versterking is "
"verhoogd naar 1.\n"
"‘amplitude’\n"
"Net als de klassieke modus boven maar versterking is verhoogd naar 2.\n"
"‘energie’\n"
"Gelijke energiedistributie, van -6dB tot +6dB reeks."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7124 rc.cpp:7130
#, kde-format
msgid "balance,amplitude,power"
msgstr "balans,amplitude,energie"

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7132
#, kde-format
msgid "Stereo widener"
msgstr "Stereoverbreder"

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7134
#, kde-format
msgid ""
"This filter enhance the stereo effect by suppressing signal common to both "
"channels and by delaying the signal of left into right and vice versa, "
"thereby widening the stereo effect."
msgstr ""
"Dit filter verhoogt het stereo-effect door onderdrukken van "
"gemeenschappelijke signalen gelijk in beide kanalen en door het signaal van "
"links naar rechts te vertragen en vice versa, waarbij het stereo-effect "
"verbreedt wordt."

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7138
#, kde-format
msgid ""
"Time in milliseconds of the delay of left signal into right and vice versa."
msgstr ""
"Tijd in milliseconden van de vertraging van het linker signaal in het "
"rechter en vice versa."

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7140
#, kde-format
msgid "Feedback Gain"
msgstr "Versterking van terugkoppeling"

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7142
#, kde-format
msgid ""
"Amount of gain in delayed signal into right and vice versa.\n"
"Gives a delay effect of left signal in right output and vice versa which "
"gives widening effect."
msgstr ""
"Hoeveelheid versterking in vertraagd signaal in het rechter en vice versa.\n"
"Geeft een vertragingseffect van het linker signaal in de rechter uitvoer en "
"vice versa wat een verbredingseffect geeft."

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7144
#, kde-format
msgid "Cross feed"
msgstr "Cross-feed"

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7146
#, kde-format
msgid ""
"Cross feed of left into right with inverted phase. This helps in suppressing "
"the mono.\n"
"If the value is 1 it will cancel all the signal common to both channels."
msgstr ""
"Kruiselings invoer van linker in rechter met geïnverteerde fase. Dit helpt "
"in het onderdrukken van het mono.\n"
"Als de waarde 1 is zal het alle gemeenschappelijke signaal naar beide "
"kanalen uitdoven."

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7148
#, kde-format
msgid "Drymix"
msgstr "Drymix"

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7150
#, kde-format
