"links,Midden/zijkant naar Links/links,Midden/zijkant naar Rechts/rechts,"
"Midden/zijkant naar Rechts/links,Linker/rechts naar Links - Rechts"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7090
#, kde-format
msgid "Side Level"
msgstr "Zijniveau"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7092
#, kde-format
msgid ""
"Set level of side signal. Default is 1. Allowed range is from 0.015625 to 64."
msgstr ""
"Niveau van zijsignaal zetten. Standaard is 1. Toegestane reeks is van "
"0.015625 tot 64."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7094
#, kde-format
msgid "Side Balance"
msgstr "Zijbalans"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7096
#, kde-format
msgid ""
"Set balance of side signal. Default is 0. Allowed range is from -1 to 1."
msgstr ""
"Balans van zijsignaal zetten. Standaard is 0. Toegestane reeks is van -1 tot "
"1."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7098
#, kde-format
msgid "Mid Level"
msgstr "Middenniveau"

