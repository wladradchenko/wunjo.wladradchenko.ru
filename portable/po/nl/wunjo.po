msgstr "Dyson-compressor (LADSPA 1403)"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#: rc.cpp:7676
#, kde-format
msgid "Peak Limit"
msgstr "Pieklimiet"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#: rc.cpp:7678
#, kde-format
msgid ""
"Controls the desired limit<br>\n"
"      of the output signal"
msgstr ""
"Regelt de gewenste limiet<br>\n"
"      van het uitgangssignaal"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#. i18n: file: data/effects/ladspa/ladspa_1913.xml
#: rc.cpp:7680 rc.cpp:8138
#, kde-format
msgid "Release Time"
msgstr "Uitgavetijd"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#: rc.cpp:7682
#, kde-format
msgid ""
"Controls the time taken for<br>\n"
"      the compressor to relax its gain control over the input signal"
msgstr ""
"Regelt de tijd die de compressor nodig heeft om<br>\n"
"      de versterkingsregeling op het ingangssignaal los te laten"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
