#. i18n: file: data/effects/avfilter/avfilter_bandpass.xml
#: rc.cpp:4882
#, kde-format
msgid ""
"Apply a two-pole Butterworth band-pass filter with central frequency and "
"(3dB-point) band-width. The CSG option selects a constant skirt gain (peak "
"gain = Q) instead of the default: constant 0dB peak gain. The filter roll "
"off at 6dB per octave (20dB per decade)."
msgstr ""
"Een twee-polige Butterworth banddoorlaatfilter met centrale frequentie en "
"(3dB-punt) bandbreedte toepassen. De optie CSG selecteert een constante "
"skirt-versterking (piekversterking = Q) in plaats van de standaard: "
"constante 0dB piekversterking. De filter-roll-off is 6dB per octaaf (20dB "
"per decade)."

#. i18n: file: data/effects/avfilter/avfilter_bandpass.xml
#: rc.cpp:4886
#, kde-format
msgid "Constant Skirt Gain"
msgstr "Constante skirt-versterking"

