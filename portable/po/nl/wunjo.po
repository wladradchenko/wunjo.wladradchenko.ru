msgstr "De schaalfactor tussen de ene vertraging en de volgende"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7654
#, kde-format
msgid "Delay Random"
msgstr "Willekeurig vertragen"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7656
#, kde-format
