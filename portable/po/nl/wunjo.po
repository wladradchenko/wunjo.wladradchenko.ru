msgid "TAP Tremolo"
msgstr "TAP-tremolo"

#. i18n: file: data/effects/ladspa/ladspa_2144.xml
#: rc.cpp:8240
#, kde-format
msgid ""
"TAP Tremolo (LADSPA 2144)<br>\n"
"   Sounds good mainly on acoustic or electric guitar tracks."
msgstr ""
"TAP-tremolo (LADSPA 2144)<br>\n"
"   Klinkt vooral goed op akoestische of elektrische gitaartracks."

#. i18n: file: data/effects/ladspa/ladspa_2145.xml
#: rc.cpp:8250
#, kde-format
msgid "TAP Scaling Limiter"
msgstr "TAP-schaalbegrenzer"

#. i18n: file: data/effects/ladspa/ladspa_2145.xml
#: rc.cpp:8252
#, kde-format
msgid ""
"TAP Scaling Limiter (LADSPA 2145)<br>\n"
"   Achieves signal level limiting without audible artifacts."
msgstr ""
"TAP-schaalbegrenzer (LADSPA 2145)<br>\n"
"   Behaalt beperking van signaalniveau zonder hoorbare artifacts."

#. i18n: file: data/effects/ladspa/ladspa_2145.xml
#: rc.cpp:8254
#, kde-format
msgid "Limit Level"
msgstr "Limiet van niveau"

#. i18n: file: data/effects/ladspa/ladspa_2145.xml
#: rc.cpp:8256
#, kde-format
msgid "Output Volume"
msgstr "Uitvoervolume"

#. i18n: file: data/effects/ladspa/ladspa_2146.xml
#: rc.cpp:8260
#, kde-format
msgid "TAP AutoPanner"
msgstr "TAP-autopanner"

#. i18n: file: data/effects/ladspa/ladspa_2146.xml
#: rc.cpp:8262
#, kde-format
msgid ""
"TAP AutoPanner (LADSPA 2146)<br>\n"
"   Main use is to liven up synth tracks in the mix"
msgstr ""
"TAP-autopanner (LADSPA 2146)<br>\n"
"   Hoofdgebruik is om synth-tracks te verlevendigen in de mix"

#. i18n: file: data/effects/ladspa/ladspa_2146.xml
#: rc.cpp:8268
#, kde-format
msgid ""
"Sets the wideness of panning.<br>\n"
"      A setting of 100% means that mono input signal is panned between the "
"extreme left and right positions"
msgstr ""
"Stelt de breedheid van panning in.<br>\n"
"      Een instelling van 100% betekent dat het monoinvoersignaal wordt heen "
"en weer bewogen tussen de uiterst links en rechts posities"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8274
#, kde-format
msgid "TAP DeEsser"
msgstr "TAP-de-esser"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8276
#, kde-format
msgid ""
"TAP DeEsser (LADSPA 2147)<br>\n"
"   Used for attenuating higher pitched frequencies in vocals such as those "
"found in 'ess', 'shh' and 'chh' sounds."
msgstr ""
"TAP-de-esser (LADSPA 2147)<br>\n"
"   Gebruikt voor verzwakken van hogere frequenties in stemmen zoals die "
"gevonden in 'es', 'shh' en 'chh' geluiden."

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8278
#, kde-format
msgid "Threshold Level"
msgstr "Drempe&lniveau"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8282
#, kde-format
msgid "Sidechain Filter"
msgstr "Sidechain-filter"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8284
#, kde-format
msgid ""
"The chosen filter's frequency<br>\n"
"      is set by the <b>Frequency</b> parameter"
msgstr ""
"De gekozen filterfrequentie<br>\n"
"      wordt ingesteld door de parameter <b>Frequentie</b>"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8286
#, kde-format
