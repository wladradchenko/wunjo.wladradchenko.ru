msgstr "Delayorama (LADSPA 1402)"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7628
#, kde-format
msgid ""
"Controls the random numbers that<br>\n"
"      will be used to stagger the delays and amplitudes if random is turned "
"up on them. Changing this forces the random values to be recalculated."
msgstr ""
"Bepaalt de toevalsgetallen die<br>\n"
"      worden gebruikt om de vertragingen en amplitudes te variëren wanneer "
"de random-functie hiervoor is ingeschakeld. Het wijzigen hiervan zorgt "
"ervoor dat de toevalswaarden opnieuw worden berekend."

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7632
#, kde-format
msgid "Controls the gain of the input signal"
msgstr "Regelt de versterking van het invoersignaal"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7636
#, kde-format
msgid "Controls the amount of output signal fed back into the input"
msgstr ""
"Regelt de hoeveelheid uitgangssignaal die naar de ingang wordt teruggevoerd"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7638
#, kde-format
msgid "Number of Taps"
msgstr "Aantal taps"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
