#. i18n: file: data/effects/ladspa/ladspa_1433.xml
#: rc.cpp:7840
#, kde-format
msgid "AM Pitch Shifter"
msgstr "AM-toonhoogte-shifter"

#. i18n: file: data/effects/ladspa/ladspa_1433.xml
#: rc.cpp:7842
#, kde-format
msgid ""
"AM Pitch Shifter (LADSPA 1433)<br>\n"
"   This effect works by running a single write pointer (monotonic) and two "
"read pointers (pitchscaled) over a ringbuffer. The output is faded between "
"the two readpointers according to the sine of the distance from the write "
"pointer."
msgstr ""
"AM toonhoogte-shifter (LADSPA 1433)<br>\n"
"   Dit effect werkt door één enkele schrijfwijzer (monotoon) en twee "
"leeswijzers (met aangepaste toonhoogte) over een ringbuffer te laten lopen. "
"De uitvoer wordt tussen de twee leeswijzers in elkaar overgevloeid op basis "
"van de sinus van de afstand tot de schrijfwijzer."

#. i18n: file: data/effects/ladspa/ladspa_1433.xml
#. i18n: file: data/effects/ladspa/ladspa_pitch.xml
#: rc.cpp:7844 rc.cpp:8640
#, kde-format
msgid "Pitch Shift"
msgstr "Toonhoogteverschuiving"

#. i18n: file: data/effects/ladspa/ladspa_1433.xml
#: rc.cpp:7846
#, kde-format
msgid ""
"The multiple of the output pitch.<br>\n"
"      For example, 2.00 will increase the pitch by one octave."
msgstr ""
"De vermenigvuldiger van de uitvoer-toonhoogte.<br>\n"
"      Een waarde van bijvoorbeeld 2,00 verhoogt de toonhoogte met een octaaf."

#. i18n: file: data/effects/ladspa/ladspa_1433.xml
