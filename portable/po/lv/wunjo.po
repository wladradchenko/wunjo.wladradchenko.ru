msgstr "Apgriešanas beigas (%)"

#. i18n: file: data/effects/gpsgraphic.xml
#: rc.cpp:1170
#, fuzzy, kde-format
#| msgid ""
#| "<![CDATA[Trim data from the end of the gps file (as a percentage of "
#| "total). <br>\n"
#| "    \tNote: both <em>Trim start</em> and <em>Trim end</em> are computed "
#| "from the total file, so trimming 50% start and 50% end will result in "
#| "trimming the entire file.]]>"
msgid ""
"Trim data from the end of the gps file (as a percentage of total). <br>\n"
"    \tNote: both <em>Trim start</em> and <em>Trim end</em> are computed from "
"the total file, so trimming 50% start and 50% end will result in trimming "
"the entire file."
msgstr ""
"<![CDATA[Apgriešanas dati no GPS datnes beigām (procentuāli no kopējiem). "
"<br>\n"
"    \tIevērībai: gan <em>apgriešanas sākums</em>, gan <em>apgriešanas "
"beigas</em> programma aprēķina no kopējās datnes, tāpēc 50 % apgriešana no "
"sākuma un 50 % apgriešana no beigām nozīmēs visas datnes apgriešanu.]]>"

#. i18n: file: data/effects/gpsgraphic.xml
#: rc.cpp:1172
#, kde-format
msgid "Crop mode horizontal"
msgstr "Horizontālās kadrēšanas režīms"

#. i18n: file: data/effects/gpsgraphic.xml
#: rc.cpp:1174
#, fuzzy, kde-format
#| msgid ""
#| "<![CDATA[Decides how to interpret the <em>Crop left</em> and <em>Crop "
#| "right</em> values.<br>\n"
#| "    \tNote: for the horizontal type, absolute values are the longitude "
