#. i18n: file: data/effects/mask_start_shape.xml
#. i18n: file: data/effects/shape.xml
#: rc.cpp:1484 rc.cpp:1854
#, kde-format
msgid "Use the image luma instead of the alpha channel."
msgstr "Використовувати яскравість зображення замість каналу прозорості."

#. i18n: file: data/effects/mask_start_shape.xml
#. i18n: file: data/effects/shape.xml
#: rc.cpp:1486 rc.cpp:1856
#, kde-format
msgid "Use Threshold"
