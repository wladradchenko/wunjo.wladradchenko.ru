#. i18n: file: data/effects/avfilter/avfilter_sofalizer.xml
#: rc.cpp:7022
#, kde-format
msgid "Radstep"
msgstr "Крокрад"

#. i18n: file: data/effects/avfilter/avfilter_sr.xml
#: rc.cpp:7026
#, kde-format
msgid "AI Super resolution"
msgstr "Суперроздільність ШІ"

#. i18n: file: data/effects/avfilter/avfilter_sr.xml
#: rc.cpp:7028
#, kde-format
msgid ""
"Scale the input by applying one of the super-resolution methods based on "
"convolutional neural networks."
msgstr ""
"Масштабувати вхідні дані застосуванням одного з методів суперроздільності на "
"основі згорткових нейронних мереж."

#. i18n: file: data/effects/avfilter/avfilter_sr.xml
#: rc.cpp:7036
#, kde-format
msgid "Scale factor for SRCNN"
msgstr "Масштаб для SRCNN"

#. i18n: file: data/effects/avfilter/avfilter_stereo3D.xml
#: rc.cpp:7038
#, kde-format
msgid "Stereoscopic 3D"
msgstr "Стереоскопічне 3D"

#. i18n: file: data/effects/avfilter/avfilter_stereo3D.xml
#: rc.cpp:7040
#, kde-format
msgid "Convert between different stereoscopic image formats."
msgstr "Перетворення між різними форматами стереоскопічних зображень."

#. i18n: file: data/effects/avfilter/avfilter_stereo3D.xml
#: rc.cpp:7042
#, kde-format
msgid "Input format"
msgstr "Вхідний формат"

#. i18n: file: data/effects/avfilter/avfilter_stereo3D.xml
#: rc.cpp:7044
#, kde-format
msgid ""
"side by side parallel,side by side crosseye,above-below (left above),above-"
"below (right above),interleaved rows (left top),interleaved rows (right top),"
"interleaved columns left eye first,interleaved columns right eye first"
msgstr ""
"обабіч паралельно,обабіч навхрест,згори-внизу (ліворуч угорі),згори-внизу "
"(праворуч угорі),перемежовані рядки (ліворуч угорі),перемежовані рядки "
"(праворуч угорі),перемежовані стовпці спочатку ліве око,перемежовані стовпці "
"спочатку праве око"

#. i18n: file: data/effects/avfilter/avfilter_stereo3D.xml
#: rc.cpp:7046
#, kde-format
msgid "Output format"
msgstr "Вихідний формат"

#. i18n: file: data/effects/avfilter/avfilter_stereo3D.xml
#: rc.cpp:7048
#, kde-format
msgid ""
"side by side parallel,side by side crosseye,above-below left top,above-below "
"right top,interleaved rows (left top),interleaved rows (right top),anaglyph "
"red/blue gray,anaglyph red/green gray,anaglyph red/cyan gray,anaglyph red/"
"cyan half colored,anaglyph red/cyan color,anaglyph red/cyan dubois,anaglyph "
"green/magenta gray,anaglyph green/magenta half colored,anaglyph green/"
"magenta colored,anaglyph green/magenta dubois,anaglyph yellow/blue gray,"
"anaglyph yellow/blue half colored,anaglyph yellow/blue colored,anaglyph "
"yellow/blue dubois,mono output left,mono output right,checkerboard left eye "
"first,checkerboard right eye first,interleaved columns left eye first,"
"interleaved columns right eye first,HDMI frame pack"
msgstr ""
"обабіч паралельно,обабіч перехресне око,згори-знизу зліва вгорі,згори-знизу "
"справа вгорі,рядки з чергуванням (лівий згори), рядки з чергуванням (правий "
"згори),анагліф червоний/синьо-сірий,анагліф червоний/зелений сірий,анагліф "
"червоний/блакитний сірий,анагліф червоний/блакитний напівкольоровий,анагліф "
"червоний/блакитний кольоровий,анагліф червоний/блакитний Дюбуа,анагліф "
"зелений/пурпуровий сірий,анагліф зелений/пурпуровий напівкольоровий,анагліф "
"зелений/пурпурний кольоровий,анагліф зелений/пурпуровий Дюбуа,анагліф жовтий/"
"синьо-сірий,анагліф жовтий/синій напівкольоровий,анагліф жовтий/синій "
"кольоровий,анагліф жовтий/синій Дюбуа,моно вихід ліворуч,моно вихід праворуч,"
"шахівниця ліворуч спочатку око, спочатку праве око в шаховому порядку, "
"стовпці з чергуванням спочатку ліве око, стовпці з чергуванням спочатку "
"праве око, пакет кадрів HDMI"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7050
#, kde-format
msgid "Stereo tools"
msgstr "Стереоінструменти"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7052
#, kde-format
msgid ""
"This filter has some handy utilities to manage stereo signals, for "
"converting M/S stereo recordings to L/R signal while having control over the "
"parameters or spreading the stereo image of master track."
msgstr ""
"Цей фільтр має певні зручні допоміжні інструменти для керування "
"стереосигналами для перетворення M/S-стереозаписів на сигнал Л/П, керуючи "
"параметрами або поширюючи стереобраз основної доріжки."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7054
#, kde-format
msgid "Level IN"
msgstr "Рівень на вході"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7056 rc.cpp:7060
#, kde-format
msgid ""
"Set input level before filtering for both channels.\n"
"Allowed range is from 0.015625 to 64."
msgstr ""
"Встановити вхідний рівень до фільтрування для обох каналів.\n"
"Дозволений діапазон — від 0,015625 до 64."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7058
#, kde-format
msgid "Level OUT"
msgstr "Рівень на виході"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7062 rc.cpp:7120
#, kde-format
msgid "Balance IN"
msgstr "Баланс на вході"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7064 rc.cpp:7068
#, kde-format
msgid ""
"Set input balance between both channels. Default is 0. Allowed range is from "
"-1 to 1."
msgstr ""
"Встановити рівень на вході між обома каналами. Типовим є 0. Діапазон "
"можливих значень — від -1 до 1."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7066 rc.cpp:7126
#, kde-format
msgid "Balance OUT"
msgstr "Баланс на виході"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7070
#, kde-format
msgid "Softclip"
msgstr "М'яке обрізання"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7072
#, kde-format
msgid ""
"Enable softclipping. Results in analog distortion instead of harsh digital "
"0dB clipping."
msgstr ""
"Уможливити м'яке обрізання. У результаті маємо аналогове викривлення замість "
"жорсткого цифрового обрізання на 0 дБ."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7074
#, kde-format
msgid "Mute Left"
msgstr "Заглушити лівий"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7076
#, kde-format
msgid "Mute Right"
msgstr "Заглушити правий"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7078
#, kde-format
msgid "Phase Left"
msgstr "Фаза лівого"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7080
#, kde-format
msgid "Change the phase of the left channel."
msgstr "Змінити фазу лівого каналу."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7082
#, kde-format
msgid "Phase Right"
msgstr "Фаза правого"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7084
#, kde-format
msgid "Change the phase of the right channel."
msgstr "Змінити фазу правого каналу."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:7086 rc.cpp:8426
#, kde-format
msgid "Stereo Mode"
msgstr "Режим стерео"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7088
#, kde-format
msgid ""
"Left/Right to Left/Right,Left/Right to Mid/Side,Mid/Side to Left/Right,Left/"
"Right to Left/Left,Left/Right to Right/Right,Left/Right to Left + Right,Left/"
"Right to Right/Left,Mid/Side to Left/Left,Mid/Side to Right/Right,Mid/Side "
"to Right/Left,Left/Right to Left - Right"
msgstr ""
"Лівий/Правий на Лівий/Правий,Лівий/Правий на Середній/Бічний,Середній/Бічний "
"на Лівий/Правий,Лівий/Правий на Лівий/Лівий,Лівий/Правий на Правий/Правий,"
"Лівий/Правий на Лівий + Правий,Лівий/Правий на Правий/Лівий,Середній/Бічний "
"на Лівий/Лівий,Середній/Бічний на Правий/Правий,Середній/Бічний на Правий/"
"Лівий,Лівий/Правий на Лівий - Правий"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7090
#, kde-format
msgid "Side Level"
msgstr "Бічний рівень"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7092
#, kde-format
msgid ""
"Set level of side signal. Default is 1. Allowed range is from 0.015625 to 64."
msgstr ""
"Встановити рівень бічного сигналу. Типовим значенням є 1. Можливі значення — "
"від 0.015625 до 64."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7094
#, kde-format
msgid "Side Balance"
msgstr "Бічний баланс"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7096
#, kde-format
msgid ""
"Set balance of side signal. Default is 0. Allowed range is from -1 to 1."
msgstr ""
"Встановити баланс бічного сигналу. Типовим значенням є 0. Можливі значення — "
"від -1 до 1."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7098
#, kde-format
msgid "Mid Level"
msgstr "Середній рівень"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7100
#, kde-format
msgid ""
"Set level of the middle signal. Default is 1. Allowed range is from 0.015625 "
"to 64."
msgstr ""
"Встановити рівень середнього сигналу. Типовим значенням є 1. Можливі "
"значення — від 0.015625 до 64."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7102
#, kde-format
msgid "Mid Pan"
msgstr "Середнє панорамування"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7104
#, kde-format
msgid "Set middle signal pan. Default is 0. Allowed range is from -1 to 1."
msgstr ""
"Встановити панорамування середини сигналу. Типовим значенням є 0. Можливі "
"значення — від -1 до 1."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7106
#, kde-format
msgid "Stereo base"
msgstr "База стерео"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7108
#, kde-format
msgid ""
"Set stereo base between mono and inverted channels. Default is 0. Allowed "
"range is from -1 to 1."
msgstr ""
"Встановити базу стерео між каналами моно і інверсії. Типовою є 0. Діапазон "
"можливих значень — від -1 до 1."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7112
#, kde-format
msgid ""
"Set delay in milliseconds how much to delay left from right channel and vice "
"versa. Default is 0. Allowed range is from -20 to 20."
msgstr ""
"Встановити затримку у мілісекундах для відставання лівого каналу від правого "
"і навпаки. Типовим є значення 0. Можливий діапазон — від -20 до 20."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7114
#, kde-format
msgid "S/C level"
msgstr "Рівень S/C"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7116
#, kde-format
msgid "Stereo phase"
msgstr "Фаза стерео"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7118
#, kde-format
msgid "Set the stereo phase in degrees."
msgstr "Встановити фазу стерео у градусах."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7122 rc.cpp:7128
#, kde-format
msgid ""
"‘balance’\n"
"Classic balance mode. Attenuate one channel at a time. Gain is raised up to "
"1.\n"
"‘amplitude’\n"
"Similar to classic mode above but gain is raised up to 2.\n"
"‘power’\n"
"Equal power distribution, from -6dB to +6dB range."
msgstr ""
"«баланс»\n"
"Класичний режим балансування. Одночасно послаблювати лише один канал. "
"Підсилення буде піднято до 1.\n"
"«амплітуда»\n"
"Подібний до класичного режиму вище, але підсилення буде піднято до 2.\n"
"«потужність»\n"
"Рівномірний розподіл потужності у діапазоні від -6дБ до +6дБ."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7124 rc.cpp:7130
#, kde-format
msgid "balance,amplitude,power"
msgstr "баланс,амплітуда,потужність"

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7132
#, kde-format
msgid "Stereo widener"
msgstr "Стереорозширювач"

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7134
#, kde-format
msgid ""
"This filter enhance the stereo effect by suppressing signal common to both "
"channels and by delaying the signal of left into right and vice versa, "
"thereby widening the stereo effect."
msgstr ""
"Цей фільтр удосконалює стереоефект придушуючи сигнал, який є спільним на "
"обох каналах і затримуючи сигнал лівого каналу щодо правого і навпаки, таким "
"чином розширюючи стереоефект."

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7138
#, kde-format
msgid ""
"Time in milliseconds of the delay of left signal into right and vice versa."
msgstr "Час затримки лівого сигналу щодо правого і навпаки у мілісекундах."

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7140
#, kde-format
msgid "Feedback Gain"
msgstr "Підсилання відгуку"

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7142
#, kde-format
msgid ""
"Amount of gain in delayed signal into right and vice versa.\n"
"Gives a delay effect of left signal in right output and vice versa which "
"gives widening effect."
msgstr ""
"Величина підсилення затриманого сигналу вправо і навпаки.\n"
"Дає ефект затримки лівого сигналу на правому виході і навпаки, що дає ефект "
"розширення."

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7144
#, kde-format
msgid "Cross feed"
msgstr "Перехресний перехід"

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7146
#, kde-format
msgid ""
"Cross feed of left into right with inverted phase. This helps in suppressing "
"the mono.\n"
"If the value is 1 it will cancel all the signal common to both channels."
msgstr ""
"Перехресне передавання зліва направо з інвертованою фазою. Це допомагає "
"придушити моно.\n"
"Якщо значення дорівнює 1, буде скасовано весь сигнал, спільний для обох "
"каналів."

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7148
#, kde-format
msgid "Drymix"
msgstr "Сухе мікшування"

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7150
#, kde-format
msgid "Set level of input signal of original channel."
msgstr "Встановити рівень вхідного сигналу початкового каналу."

#. i18n: file: data/effects/avfilter/avfilter_swapuv.xml
#: rc.cpp:7152
#, kde-format
msgid "Swap UV"
msgstr "Переставити UV"

#. i18n: file: data/effects/avfilter/avfilter_swapuv.xml
#: rc.cpp:7154
#, kde-format
msgid "Swap U and V components"
msgstr "Поміняти місцями компоненти U і V"

#. i18n: file: data/effects/avfilter/avfilter_tmix.xml
#: rc.cpp:7156
#, kde-format
msgid "Temporal frames Mixer"
msgstr "Мікшер кадрів за часом"

#. i18n: file: data/effects/avfilter/avfilter_tmix.xml
#: rc.cpp:7158
#, kde-format
msgid "Mix successive video frames"
msgstr "Мікшування послідовних відеокадрів"

#. i18n: file: data/effects/avfilter/avfilter_tmix.xml
#: rc.cpp:7160
#, kde-format
msgid "Frames to mix"
msgstr "Кадри для мікшування"

#. i18n: file: data/effects/avfilter/avfilter_transpose.xml
#: rc.cpp:7162
#, kde-format
msgid "Transpose"
msgstr "Транспонувати"

#. i18n: file: data/effects/avfilter/avfilter_transpose.xml
#: rc.cpp:7164
#, kde-format
msgid "Transpose rows with columns in the input video and optionally flip it"
msgstr ""
"Виконати транспонування рядків і стовпчиків у вхідному відео і, "
"необов'язково, його віддзеркалення"

#. i18n: file: data/effects/avfilter/avfilter_transpose.xml
#: rc.cpp:7168
#, kde-format
msgid "Clock,Clock flip,Counter clock,Counter clock flip"
msgstr ""
"За годинниковою стрілкою,Віддзеркалити за годинниковою стрілкою,Проти "
"годинникової стрілки,Віддзеркалити проти годинникової стрілки"

#. i18n: file: data/effects/avfilter/avfilter_transpose.xml
#: rc.cpp:7170
#, kde-format
msgid "Override if"
msgstr "Умова перевизначення"

#. i18n: file: data/effects/avfilter/avfilter_transpose.xml
#: rc.cpp:7172
#, kde-format
msgid "None,Portrait,Landscape"
msgstr "немає,книжковий,альбомний"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7174
#, kde-format
msgid "Sharp/Unsharp"
msgstr "Збільшення/Зменшення різкості"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7176
#, kde-format
msgid "Sharpen or unsharpen/blur your video"
msgstr "Збільшення/Зменшення різкості або розмивання відео"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7178
#, kde-format
msgid "Luma horizontal matrix"
msgstr "Горизонтальний матриці освітленості"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7180
#, kde-format
msgid "Set the luma matrix horizontal size"
msgstr "Встановити горизонтальний розмір матриці освітленості"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7182
#, kde-format
msgid "Luma vertical matrix"
msgstr "Вертикальний матриці освітленості"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7184
#, kde-format
msgid "Set the luma matrix vertical size"
msgstr "Встановити вертикальний розмір матриці освітленості"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7188
#, kde-format
msgid ""
"Set the luma effect strength.<br>\n"
"            Reasonable values are between -1.5 and 1.5. Negative values will "
"blur the input video, while positive values will sharpen it, a value of 0 "
"will disable the effect."
msgstr ""
"Встановити потужність ефекту яскравості.<br>\n"
"            Притомні значення – від -1,5 до 1,5. Від'ємні значення "
"призведуть до розмивання вхідного відео, тоді як додатні значення збільшать "
"його різкість, значення 0 вимкне ефект."

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7190
#, kde-format
msgid "Chroma horizontal matrix"
msgstr "Горизонтальний матриці освітленості"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
