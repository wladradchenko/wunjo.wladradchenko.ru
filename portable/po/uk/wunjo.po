#: rc.cpp:3492
#, kde-format
msgid "Origin X"
msgstr "Початок за X"

#. i18n: file: data/effects/frei0r/frei0r_kaleid0sc0pe.xml
#: rc.cpp:3494
#, kde-format
msgid "Move the origin of the kaleidoscope along the X axis"
