msgstr "Режим виведення"

#. i18n: file: data/effects/avfilter/avfilter_deesser.xml
#: rc.cpp:5616
#, kde-format
msgid "Set the output mode."
msgstr "Встановлює режим виведення."

#. i18n: file: data/effects/avfilter/avfilter_deesser.xml
#: rc.cpp:5618
#, kde-format
msgid "Input,Output,Ess only"
msgstr "Вхід,Вихід,Лише есс"

#. i18n: file: data/effects/avfilter/avfilter_deflate.xml
