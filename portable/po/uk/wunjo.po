#: rc.cpp:7444
#, kde-format
msgid "Apply Zoom and Pan effect"
msgstr "Застосувати ефект масштабування і панорамування"

#. i18n: file: data/effects/avfilter/subtitles.xml
#: rc.cpp:7456
#, kde-format
msgid "Render subtitles onto the video"
msgstr "Вбудувати субтитри до відео"

#. i18n: file: data/effects/avfilter/subtitles.xml
#: rc.cpp:7458
#, kde-format
msgid "Subtitle file to apply"
msgstr "Файл субтитрів для застосування"

#. i18n: file: data/effects/ladspa/ladspa_1185.xml
#: rc.cpp:7460
#, kde-format
msgid "Diode Processor"
msgstr "Diode Processor"

#. i18n: file: data/effects/ladspa/ladspa_1185.xml
#: rc.cpp:7462
#, kde-format
msgid ""
"Diode Processor (LADSPA 1185)<br>\n"
"   Mangles the signal as if it had been passed through a diode rectifier "
"network. You should probably follow this with a <i>DC Offset Remover</i>, "
"unless you want the offset."
msgstr ""
"Діодний процесор (LADSPA 1185)<br>\n"
"Спотворює сигнал так, ніби він пройшов через діодну випрямну мережу. "
"Ймовірно, вам слід після цього скористатися засобом вилучення постійного "
"зміщення, якщо вам не потрібне зміщення."

#. i18n: file: data/effects/ladspa/ladspa_1185.xml
#: rc.cpp:7466
#, kde-format
msgid ""
"The <i>Mode</i> parameter is<br>\n"
"      continuously variable from thru to half-wave (1) rectification to full-"
"wave (2) to silence (0)"
msgstr ""
"Параметр <i>Режим</i><br>\n"
"безперервно змінюється від повного до півхвильового (1), випрямлення до "
"повної хвилі (2) до тиші (0)"

