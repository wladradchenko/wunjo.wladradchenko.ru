msgstr ""
"Виконати переплетення вхідних полів відео для подвоєння кількості кадрів"

#. i18n: file: data/effects/avfilter/avfilter_doubleweave.xml
#. i18n: file: data/effects/avfilter/avfilter_weave.xml
#: rc.cpp:5700 rc.cpp:7414
#, kde-format
msgid "First Field"
msgstr "Перше поле"

#. i18n: file: data/effects/avfilter/avfilter_doubleweave.xml
