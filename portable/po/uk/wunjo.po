msgstr "Слабка,Сильна"

#. i18n: file: data/effects/avfilter/avfilter_deblock.xml
#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:5570 rc.cpp:6972
#, kde-format
msgid "Alpha threshold"
msgstr "Поріг альфа-каналу"

#. i18n: file: data/effects/avfilter/avfilter_deblock.xml
#: rc.cpp:5572
#, kde-format
msgid "Beta threshold"
msgstr "Бета-поріг"

#. i18n: file: data/effects/avfilter/avfilter_deblock.xml
#: rc.cpp:5574
#, kde-format
msgid "Gamma threshold"
msgstr "Поріг гамми"

#. i18n: file: data/effects/avfilter/avfilter_deblock.xml
#: rc.cpp:5576
#, kde-format
msgid "Delta threshold"
msgstr "Поріг дельти"

#. i18n: file: data/effects/avfilter/avfilter_deblock.xml
#: rc.cpp:5580
#, kde-format
