msgstr "Пріоритетність полів"

#. i18n: file: data/effects/avfilter/avfilter_fieldorder.xml
#: rc.cpp:5940
#, kde-format
msgid "Interlace field order"
msgstr "Чергування порядку полів"

#. i18n: file: data/effects/avfilter/avfilter_fieldorder.xml
#: rc.cpp:5942
#, kde-format
msgid "Transform the field order of the input video."
msgstr "Перетворити порядок полів у вхідному відео."

#. i18n: file: data/effects/avfilter/avfilter_fillborders.xml
#: rc.cpp:5948
#, kde-format
msgid "Fill Borders"
msgstr "Рамки заповнення"

#. i18n: file: data/effects/avfilter/avfilter_fillborders.xml
#: rc.cpp:5950
#, kde-format
msgid ""
"Fill borders of the input video without changing video stream dimensions. "
"Sometimes video can have garbage at the four edges and you may not want to "
"crop video input to keep the size multiple of some number"
msgstr ""
"Заповнює крайові частини вхідного відео без зміни розмірностей кадру "
"вхідного відеопотоку. Іноді на краях відеоматеріалу з'являється шум, а ви не "
"хочете обрізати відео, щоб зберегти певні пропорції для розмірів кадру"

#. i18n: file: data/effects/avfilter/avfilter_fillborders.xml
#: rc.cpp:5954
#, kde-format
msgid "Smear,Mirror,Color,Reflect,Wrap,Fade,Margins"
msgstr "Розмазати,Віддзеркалити,Колір,Відбити,Огорнути,Згасання,Поля"

#. i18n: file: data/effects/avfilter/avfilter_flanger.xml
#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:5960 rc.cpp:7484
#, kde-format
msgid "Flanger"
msgstr "Flanger"

#. i18n: file: data/effects/avfilter/avfilter_flanger.xml
#: rc.cpp:5962
#, kde-format
msgid "Apply a flanging effect to the audio."
msgstr "Застосувати до звукових даних ефект флендже."

#. i18n: file: data/effects/avfilter/avfilter_flanger.xml
#: rc.cpp:5966
#, kde-format
msgid "Set base delay in milliseconds. Range from 0 to 30."
msgstr "Встановити базову затримку у мілісекундах. Діапазон від 0 до 30."

