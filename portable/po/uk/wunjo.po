#. i18n: file: data/effects/avfilter/avfilter_drawbox.xml
#: rc.cpp:5704
#, kde-format
msgid "Draw Box"
msgstr "Малювання рамки"

#. i18n: file: data/effects/avfilter/avfilter_drawbox.xml
#: rc.cpp:5706
#, kde-format
msgid "Draw a colored box on the input video"
msgstr "Намалювати кольорову панель на вхідному відео"

#. i18n: file: data/effects/avfilter/avfilter_drawbox.xml
#: rc.cpp:5712
#, kde-format
msgid ""
"Select a color for the line.<br>\n"
"    \tUse the <em>Alpha</em> value to make the line semi-transparent."
msgstr ""
"Вибрати колір лінії.<br>\n"
"    \tВиберіть значення <em>Альфа</em>, щоб зробити рамку напівпрозорою."

#. i18n: file: data/effects/avfilter/avfilter_drawbox.xml
#. i18n: file: data/effects/avfilter/avfilter_drawgrid.xml
#: rc.cpp:5714 rc.cpp:5746
#, kde-format
msgid "Thickness (px)"
msgstr "Товщина (пк)"

#. i18n: file: data/effects/avfilter/avfilter_drawbox.xml
#: rc.cpp:5716
#, kde-format
msgid "Sets the thickness for the line in pixels"
msgstr "Встановлює товщину лінії графіка у пікселях."

#. i18n: file: data/effects/avfilter/avfilter_drawbox.xml
#. i18n: file: data/effects/avfilter/avfilter_drawgrid.xml
#: rc.cpp:5718 rc.cpp:5750
#, kde-format
msgid "Replace color and alpha"
msgstr "Замінити колір і прозорість"

#. i18n: file: data/effects/avfilter/avfilter_drawbox.xml
#: rc.cpp:5720
#, kde-format
msgid ""
"If the input has alpha, checking this<br>\n"
"    \twill overwrite the video's color and alpha pixels with the pixels of "
"the painted box.<br>\n"
"    \tBy default, the box will be composited onto the input, leaving the "
"video's alpha intact."
msgstr ""
"Якщо у вхідних даних є прозорість, позначення цього пункту<br>\n"
"    \tпризведе до перезапису кольорових і напівпрозорих пікселів на відео "
"пікселями із намальованої рамки.<br>\n"
"    \tТипово, рамку буде скомпоновано з вхідними даними, без змін у "
"прозорості відео."

#. i18n: file: data/effects/avfilter/avfilter_drawgrid.xml
#: rc.cpp:5722
#, kde-format
msgid "Draw Grid"
msgstr "Малювання ґратки"

#. i18n: file: data/effects/avfilter/avfilter_drawgrid.xml
#: rc.cpp:5724
#, kde-format
msgid "Draw a colored grid on the input video"
msgstr "Намалювати кольорову ґратку на вхідному відео"

#. i18n: file: data/effects/avfilter/avfilter_drawgrid.xml
#: rc.cpp:5728
#, kde-format
msgid "Distance from the left edge in pixel"
msgstr "Відстань від лівого краю у пікселях"

#. i18n: file: data/effects/avfilter/avfilter_drawgrid.xml
#: rc.cpp:5732
#, kde-format
msgid "Distance from the top edge in pixel"
msgstr "Відстань від верхнього краю у пікселях"

#. i18n: file: data/effects/avfilter/avfilter_drawgrid.xml
#: rc.cpp:5736
#, kde-format
msgid "Distance between vertical lines in pixel"
msgstr "Відстань між вертикальними лініями у пікселях"

#. i18n: file: data/effects/avfilter/avfilter_drawgrid.xml
#: rc.cpp:5740
#, kde-format
msgid "Distance between horizontal lines in pixel"
msgstr "Відстань між горизонтальними лініями у пікселях"

#. i18n: file: data/effects/avfilter/avfilter_drawgrid.xml
#: rc.cpp:5744
#, kde-format
msgid ""
"Select a color for the grid lines.<br>\n"
"    \tUse the <em>Alpha</em> value to make the grid semi-transparent."
msgstr ""
"Вибрати колір ліній ґратки.<br>\n"
"    \tВиберіть значення <em>Альфа</em>, щоб зробити ґратку напівпрозорою."

#. i18n: file: data/effects/avfilter/avfilter_drawgrid.xml
#: rc.cpp:5748
#, kde-format
msgid "Sets the thickness for the grid lines in pixels"
msgstr "Встановлює товщину ліній ґратки у пікселях"

#. i18n: file: data/effects/avfilter/avfilter_drawgrid.xml
#: rc.cpp:5752
#, kde-format
msgid ""
"If the input has alpha, checking this<br>\n"
"    \twill overwrite the video's color and alpha pixels with the pixels of "
"the grid lines.<br>\n"
"    \tBy default, the grid lines will be composited onto the input, leaving "
"the video's alpha intact."
msgstr ""
"Якщо у вхідних даних є прозорість, позначення цього пункту<br>\n"
"    \tпризведе до перезапису кольорових і напівпрозорих пікселів на відео "
"пікселями ліній ґратки.<br>\n"
"    \tТипово, лінії ґратки буде скомпоновано з вхідними даними, без змін у "
"прозорості відео."

