#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_cap.xml
#: rc.cpp:2470
#, kde-format
msgid ""
"Degrees from the horizon<br>\n"
"    \twhere we reach maximum blur"
msgstr ""
"Градуси від горизонталі,<br>\n"
"    \tде розмиття досягає максимуму"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_cap.xml
#: rc.cpp:2472 rc.cpp:2512
#, kde-format
msgid "Blend In"
msgstr "Вмішати"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_cap.xml
#: rc.cpp:2474 rc.cpp:2514
#, kde-format
msgid "Degrees towards the horizon to sample from"
msgstr "Градуси до горизонту, звідки слід починати дискретизацію"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_cap.xml
#: rc.cpp:2476 rc.cpp:2516
#, kde-format
msgid "Blend Out"
msgstr "Вимішати"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_cap.xml
#: rc.cpp:2478 rc.cpp:2518
#, kde-format
msgid "Degrees away from the horizon to sample to"
msgstr "Градуси до горизонту, до якого слід виконувати дискретизацію"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_cap.xml
#: rc.cpp:2480 rc.cpp:2520
#, kde-format
msgid "Fade In"
msgstr "Наростання"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_cap.xml
#: rc.cpp:2482 rc.cpp:2522
#, kde-format
msgid "Degrees to fade the effect in over"
msgstr "Градуси, протягом яких наростає ефект"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_cap.xml
#: rc.cpp:2484 rc.cpp:2524
#, kde-format
msgid "Blur width at start"
msgstr "Ширина розмивання на початку"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_cap.xml
#: rc.cpp:2486
#, kde-format
msgid "Horizontal angle to blur over at the start of the fill-in"
msgstr "Кут за горизонталлю для розмиття на початку заповнення"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_cap.xml
#: rc.cpp:2488 rc.cpp:2528
#, kde-format
msgid "Blur width at end"
msgstr "Ширина розмивання наприкінці"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_cap.xml
#: rc.cpp:2490 rc.cpp:2530
#, kde-format
msgid "Horizontal angle to blur over\tat the end of the fill-in"
msgstr "Кут за горизонталлю для розмивання наприкінці заповнення"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_cap.xml
#: rc.cpp:2492 rc.cpp:2532
#, kde-format
msgid "Blur height at start"
msgstr "Висота розмивання на початку"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_cap.xml
#: rc.cpp:2494 rc.cpp:2534
#, kde-format
msgid "Vertical angle to blur over at the start of the fill-in"
msgstr "Кут за вертикаллю для розмивання наприкінці заповнення"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_cap.xml
#: rc.cpp:2496 rc.cpp:2536
#, kde-format
msgid "Blur height at end"
msgstr "Висота розмивання наприкінці"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_cap.xml
#: rc.cpp:2498 rc.cpp:2538
#, kde-format
msgid "Vertical angle to blur over at the end of the fill-in"
msgstr "Кут за вертикаллю для розмивання наприкінці заповнення"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_cap.xml
#: rc.cpp:2500
#, kde-format
msgid "Bottom Enabled"
msgstr "Низ увімкнено"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_cap.xml
#: rc.cpp:2502
#, kde-format
msgid "comment"
msgstr "коментар"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_cap.xml
#: rc.cpp:2504
#, kde-format
msgid "<b>--Bottom--</b> Start"
msgstr "<b>--Низ--</b> Початок"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_cap.xml
#: rc.cpp:2506
#, kde-format
msgid "Degrees from the horizon where we start to fill in"
msgstr "Градуси від горизонту, де ми починаємо заповнення"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_cap.xml
#: rc.cpp:2510
#, kde-format
msgid "Degrees from the horizon where we reach maximum blur"
msgstr "Градуси від горизонту, де досягається максимальне розмивання"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_cap.xml
#: rc.cpp:2526
#, kde-format
msgid "Horizontal angle to blur over\tat the start of the fill-in"
msgstr "Кут за горизонталлю, до якого слід розмивати на початку заповнення"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_mask.xml
#: rc.cpp:2540
#, kde-format
msgid "VR360 Equirectangular Mask"
msgstr "Еквідистантна маска VR360"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_mask.xml
#: rc.cpp:2542
#, kde-format
msgid ""
"Adds a black matte to the frame. Use this if you filmed using a 360 camera "
"but only want to use part of the 360 image - for example if you and the film "
"crew occupy the 90 degrees behind the camera."
msgstr ""
"Додає чорне матування до кадру. Скористайтеся цим фільтром, якщо ви знімали "
"на 360-градусну камеру, але вам потрібна лише частина 360-градусного "
"зображення — наприклад, якщо ви і знімальна команда перебувати у межах 90 "
"градусів за камерою."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_mask.xml
#: rc.cpp:2544
#, kde-format
msgid "Vertical start"
msgstr "Початок за вертикаллю"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_mask.xml
#: rc.cpp:2546
#, kde-format
msgid ""
"The <b>Start</b> is half the height in degrees of the un-matted area. The "
"<b>End</b> is the half the height in degrees where the matte is at 100%."
msgstr ""
"<b>Початок</b> визначає половину висоти у градусах нематованої ділянки; "
"<b>Кінець</b> визначає половину висоти у градусах ділянки, де матування  "
"100%."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_mask.xml
#: rc.cpp:2548
#, kde-format
msgid "Vertical end"
msgstr "Кінець за вертикаллю"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_mask.xml
#: rc.cpp:2550
#, kde-format
msgid ""
"The Start is half the height in degrees of the un-matted area. The End is "
"the half the height in degrees where the matte is at 100%."
msgstr ""
"«Початок» визначає половину висоти у градусах нематованої ділянки; «Кінець» "
"визначає половину висоти у градусах ділянки, де матування 100%."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_mask.xml
#: rc.cpp:2552
#, kde-format
msgid "Horizontal start"
msgstr "Початок за горизонталлю"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_mask.xml
#: rc.cpp:2554 rc.cpp:2558
#, kde-format
msgid ""
"The <b>Start</b> is the width in degrees of the un-matted area. The <b>End</"
"b> is the width in degrees where the matte is at 100%."
msgstr ""
"<b>Початок</b> визначає половину ширини у градусах нематованої ділянки; "
"<b>Кінець</b> визначає половину ширини у градусах ділянки, де матування 100%."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_mask.xml
#: rc.cpp:2556
#, kde-format
msgid "Horizontal end"
msgstr "Кінець за горизонталлю"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#: rc.cpp:2566
#, kde-format
msgid "VR360 Equirectangular to Rectilinear"
msgstr "Еквідистантний VR360 у прямокутний"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#: rc.cpp:2568
#, kde-format
msgid ""
"Converts an equirectangular frame (panoramic) to a rectilinear frame (what "
"you're used to seeing). Can be used to preview what will be shown in a 360 "
"video viewer. Delayed frame blitting mapped on a time bitmap"
msgstr ""
"Перетворює еквідистантний (панорамний) кадр на прямокутний кадр (який "
"використовується для перегляду). Можна скористатися для попереднього "
"перегляду того, що буде показано у 360-градусному засобі перегляду. "
"Затримане блітування кадру з відображенням на бітову карту за часом."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_stereo.xml
#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_transform_360.xml
#: rc.cpp:2570 rc.cpp:2598 rc.cpp:2860
#, kde-format
msgid "Yaw"
msgstr "Рискання"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_transform_360.xml
#: rc.cpp:2572 rc.cpp:2862
#, kde-format
msgid ""
"The amount to rotate the image<br>\n"
"    \t(nose moves from side to side)."
msgstr ""
"Величина обертання зображення<br>\n"
"    \t(ніс пересувається з боку до боку)."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_stereo.xml
#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_transform_360.xml
#: rc.cpp:2574 rc.cpp:2600 rc.cpp:2864
#, kde-format
msgid "Pitch"
msgstr "Нахил"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_transform_360.xml
#: rc.cpp:2576 rc.cpp:2866
#, kde-format
msgid ""
"The amount to rotate the image<br>\n"
"    \t(nose up or down)."
msgstr ""
"Величина обертання зображення<br>\n"
"    \t(ніс рухається вгору або вниз)."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_stereo.xml
#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_transform_360.xml
#: rc.cpp:2578 rc.cpp:2602 rc.cpp:2868
#, kde-format
msgid "Roll"
msgstr "Обертання"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_transform_360.xml
#: rc.cpp:2580 rc.cpp:2870
#, kde-format
msgid ""
"The amount to rotate the image<br>\n"
"    \t(clockwise or anticlockwise rotation along the axis of movement)."
msgstr ""
"Величина обертання зображення<br>\n"
"    \t(обертання за годинниковою стрілкою або проти неї уздовж вісі руху)."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_stereo.xml
#: rc.cpp:2582 rc.cpp:2604
#, kde-format
msgid "FOV"
msgstr "ПЗ"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#: rc.cpp:2584
#, kde-format
msgid ""
"The horizontal field of view, in degrees, of the resulting frame.<br>\n"
"    \tAny value over 179 results in a fisheye projection."
msgstr ""
"Поле зону за горизонталлю, у градусах, кадру-результату.<br>\n"
"    \tБудь-яке значення понад 179 призведе до проєкції «риб'ячого ока»."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#: rc.cpp:2586
#, kde-format
msgid "Fisheye"
msgstr "Риб'яче око"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#: rc.cpp:2588
#, kde-format
msgid ""
"The amount of fisheye to mix in.<br>\n"
"    \t100 means that you get a 100% fisheye lens."
msgstr ""
"Величина «риб'ячого ока» для вмікшовування.<br>\n"
"    \t100 означає, що ви отримаєте 100% об'єктив «риб'яче око»."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_stereo.xml
#: rc.cpp:2594
#, kde-format
msgid "VR360 Equirectangular to Stereo"
msgstr "Еквідистантний VR360 до стерео"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_stereo.xml
#: rc.cpp:2596
#, kde-format
msgid ""
"Projects a stereographic image from an equirectangular. Use this to create "
"the little planet effect from a VR360 footage."
msgstr ""
"Виконує проєктування стереографічного зображення з еквідистантного. "
"Скористайтеся ним для створення ефекту «малої планети» з матеріалу VR360."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_stereo.xml
#. i18n: file: data/effects/frei0r/frei0r_defish0r.xml
#. i18n: file: data/effects/frei0r/frei0r_iirblur.xml
#. i18n: file: data/effects/frei0r/frei0r_sharpness.xml
#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:2606 rc.cpp:3164 rc.cpp:3470 rc.cpp:4380 rc.cpp:5886
#, kde-format
msgid "Amount"
msgstr "Потужність"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_stereo.xml
#: rc.cpp:2610
#, kde-format
msgid "Nearest-neighbor,Bilinear"
msgstr "Найближче суміжне,білінійне"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_wrap.xml
#: rc.cpp:2612
#, kde-format
msgid "VR360 Wrap"
msgstr "Загортання VR360"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_wrap.xml
#: rc.cpp:2614
#, kde-format
msgid ""
"Stretches a section of the equirectangular panorama to cover the entire VR "
"sphere"
msgstr ""
"Розтягує ділянку рівнодистантної панорами, щоб вона покрила усію сферу ВР"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_wrap.xml
#: rc.cpp:2618
#, kde-format
msgid "Determines the sampling method"
msgstr "Визначає спосіб дискретизації"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_wrap.xml
#: rc.cpp:2624 rc.cpp:2628 rc.cpp:2632 rc.cpp:2636
#, kde-format
msgid "Degrees from the center of the image to keep unchanged"
msgstr "Область у градусах від центру зображення, яка лишиться незмінною"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_wrap.xml
#: rc.cpp:2638
#, kde-format
msgid "Blur start"
msgstr "Початок розмивання"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_wrap.xml
#: rc.cpp:2640
#, kde-format
msgid ""
"Horizontal fraction of the unchanged area to blur over in the equator band"
msgstr ""
"Горизонтальна частка незмінної області для розмивання в екваторіальній смузі"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_wrap.xml
#: rc.cpp:2642
#, kde-format
msgid "Blur end"
msgstr "Кінець розмивання"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_wrap.xml
#: rc.cpp:2644
#, kde-format
msgid "Horizontal fraction of the unchanged area to blur over at the poles"
msgstr "Горизонтальна частка незмінної області для розмивання на полюсах"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2646
#, kde-format
msgid "VR360 Hemispherical to Equirectangular"
msgstr "Півсферичний VR360 у еквідистантний"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2648
#, kde-format
msgid ""
"Converts a video frame with two hemispherical images to a single "
"equirectangular frame. The plugin assumes that both hemispheres are in the "
"frame"
msgstr ""
"Перетворює відеокадр із двома напівсферичними зображенням на єдиний "
"еквідистантний кадр. У засобах обробки додатка зроблено припущення, що "
"обидві пів сфери перебувають у кадрі."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2650
#, kde-format
msgid "Alignment yaw"
msgstr "Рискання вирівнювання"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2652 rc.cpp:2656 rc.cpp:2660
#, kde-format
msgid ""
"The two fisheye cameras of a 360 camera are rarely perfectly 180 degrees "
"apart.<br>\n"
"    \tThese parameters adds a rotation to both lenses to correct for this."
msgstr ""
"Дві камери «риб'яче око» 360-градусної камери нечасто розділяються ідеально "
"по 180 градусах.<br>\n"
"    \tЦі параметри додають обертання до обох об'єктиві для виправлення цього "
"ефекту."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2654
#, kde-format
msgid "Alignment pitch"
msgstr "Нахил вирівнювання"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2658
#, kde-format
msgid "Alignment roll"
msgstr "Загортання вирівнювання"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2662
#, kde-format
msgid "Projection"
msgstr "Проєкція"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2664
#, kde-format
msgid ""
"The fisheye projection type. Currently only equidistant fisheyes, like the "
"Ricoh Theta and Garmin Virb360 are supported."
msgstr ""
"Тип проєкції «риб'ячого ока». У поточній версії передбачено підтримку лише "
"рівнодистантного «риб'ячого ока», подібного до того, підтримку якого "
"передбачено у Ricoh Theta та Garmin Virb360."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2666
#, kde-format
msgid "Equidistant Fisheye"
msgstr "Еквідистантне риб'яче око"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2668
#, kde-format
msgid "Lens FOV"
msgstr "Поле зору об'єктива"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2670
#, kde-format
msgid ""
"The field of view of a single hemisphere in degrees, expressed as a fraction "
"of the frame width."
msgstr ""
"Поле зору єдиної напів сфери у градусах, виражене у частці ширити кадру."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2672
#, kde-format
msgid "Lens radius"
msgstr "Радіус об'єктива"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2674
#, kde-format
msgid ""
"The radius of the image circle, expressed as a fraction of the frame width."
msgstr "Радіус кругу зображення, виражений як частка ширини кадру."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2676
#, kde-format
msgid "Front X"
msgstr "Передній X"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2678
#, kde-format
msgid ""
"The image center and image orientation for the front-facing camera.<br>\n"
"    \tThe X parameter is a fraction of the image width."
msgstr ""
"Центр зображення та орієнтація зображення для передньої камери.<br>\n"
"    \tПараметр X є часткою ширини зображення."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2680
#, kde-format
msgid "Front Y"
msgstr "Передній Y"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2682
#, kde-format
msgid ""
"The image center and image orientation for the front-facing camera.<br>\n"
"    \tThe Y parameter a fraction of the image height."
msgstr ""
"Центр зображення та орієнтація зображення для передньої камери.<br>\n"
"    \tПараметр Y є часткою висоти зображення."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2684
#, kde-format
msgid "Front Up"
msgstr "Передній верх"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2686
#, kde-format
msgid ""
"The image center and image orientation for the front-facing camera.<br>\n"
"    \tUp is the \"up\" direction in the image, in degrees clockwise from a "
"direction towards the frame top edge."
msgstr ""
"Центр зображення та орієнтація зображення для передньої камери.<br>\n"
"    \t«Верх» є напрямком вгору зображення у градусах за годинниковою "
"стрілкою від напрямку верхнього краю кадру."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2688
#, kde-format
msgid "Back X"
msgstr "Задній X"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2690
#, kde-format
msgid ""
"The image center and image orientation for the back-facing camera.<br>\n"
"    \tThe X parameter is a fraction of the image width.."
msgstr ""
"Центр зображення та орієнтація зображення для задньої камери..<br>\n"
"    \tПараметр X є часткою ширини зображення."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2692
#, kde-format
msgid "Back Y"
msgstr "Задній Y"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2694
#, kde-format
msgid ""
"The image center and image orientation for the back-facing camera.<br>\n"
"    \tThe Y parameter a fraction of the image height."
msgstr ""
"Центр зображення та орієнтація зображення для задньої камери.<br>\n"
"    \tПараметр Y є часткою висоти зображення."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2696
#, kde-format
msgid "Back Up"
msgstr "Резервна копія"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2698
#, kde-format
msgid ""
"The image center and image orientation for the back-facing camera.<br>\n"
"    \tUp is the \"up\" direction in the image, in degrees clockwise from a "
"direction towards the frame top edge."
msgstr ""
"Центр зображення та орієнтація зображення для задньої камери.<br>\n"
"    \t«Верх» є напрямком вгору зображення у градусах за годинниковою "
"стрілкою від напрямку верхнього краю кадру."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2700
#, kde-format
msgid "Nadir radius"
msgstr "Надирний радіус"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2702 rc.cpp:2706
#, kde-format
msgid ""
"360 cameras like the Theta have a problem with the nadir direction where, no "
"matter what, you will have a little of the camera in the image.<br>\n"
"    \tThis parameter \"stretches\" the image near nadir to cover up the "
"missing parts."
msgstr ""
"360-градусні камери, такі як Theta, мають проблему з надиром, де, незалежно "
"від обставин, на зображенні буде лише невелика частина камери.<br>\n"
"    \tЦей параметр «розтягує» зображення поблизу надиру, щоб приховати "
"пропущені частини."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2704
#, kde-format
msgid "Nadir start"
msgstr "Надирний початок"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2708
#, kde-format
msgid "Lens distortion A"
msgstr "Викривлення об'єктивом, A"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2710 rc.cpp:2714 rc.cpp:2718
#, kde-format
msgid ""
"Lens distortion correction parameters.<br>\n"
"    \tThe first three parameters are the same as in Hugin."
msgstr ""
"Параметри виправлення викривлення об'єктивом.<br>\n"
"    \tПерші три параметри є такими самими, що і у Hugin."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2712
#, kde-format
msgid "Lens distortion B"
msgstr "Викривлення об'єктивом, B"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2716
#, kde-format
msgid "Lens distortion C"
msgstr "Викривлення об'єктивом, C"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2720
#, kde-format
msgid "Lens distortion radius"
msgstr "Радіус викривлення об'єктивом"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2722
#, kde-format
msgid ""
"Lens distortion correction parameters.<br>\n"
"    \tIf you use Hugin parameters, the Radius should be set to the value of "
"(0.5 * min(image width, image height) / image width). For a 2:1 aspect dual "
"hemispherical image, that would be 0.25."
msgstr ""
"Параметри виправлення викривлення об'єктивом.<br>\n"
"    \tЯкщо ви використовуєте параметри Hugin, радіус слід встановити у "
"значення (0,5 * min(ширина зображення, висота зображення) / ширина "
"зображення). Для зображення з двома напівсферичними зображеннями зі "
"співвідношенням сторін 2:1 це становитиме 0,25."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2724
#, kde-format
msgid "Lens vignetting A"
msgstr "Віньєтування об'єктивом, A"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2726 rc.cpp:2730 rc.cpp:2734 rc.cpp:2738
#, kde-format
msgid ""
"Lens vignetting correction parameters.<br>\n"
"    \tThe first four parameters are the same as in Hugin, corresponding to "
"the Va, Vb, Vc and Vd image parameters."
msgstr ""
"Параметри виправлення віньєтування об'єктивом.<br>\n"
"    \tПерші чотири параметри є такими самими, що і у Hugin, відповідає "
"параметрам зображення Va, Vb, Vc і Vd."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2728
#, kde-format
msgid "Lens vignetting B"
msgstr "Віньєтування об'єктивом, B"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2732
#, kde-format
msgid "Lens vignetting C"
msgstr "Віньєтування об'єктивом, C"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2736
#, kde-format
msgid "Lens vignetting D"
msgstr "Віньєтування об'єктивом, D"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2740
#, kde-format
msgid "Lens vignetting radius"
msgstr "Радіус віньєтування об'єктивом"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2742
#, kde-format
msgid ""
"If you use Hugin parameters, the radius should be set to the value of (0.5 * "
"image diagonal / image width).<br>\n"
"    \tFor a 2:1 aspect dual hemispherical image, that would be 0.5590. Use "
"the A parameter to scale the effect and avoid overexposing highlights"
msgstr ""
"Якщо ви використовуєте параметри Hugin, радіус слід встановити у значення "
"(0,5 * діагональ зображення / ширина зображення).<br>\n"
"    \tДля зображення з двома півсферичними зображеннями з співвідношенням "
"сторін 2:1 це буде 0,5590. Використовуйте параметр A, щоб масштабувати ефект "
"та уникнути переекспонування світлих ділянок."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2744
#, kde-format
msgid "Use sensor response parameters"
msgstr "Використовувати параметри реакції датчика"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2746
#, kde-format
msgid "Switch on to use sensor response parameters (EMoR h(x))"
msgstr "Увімкніть, щоб скористатися параметрами відгуку датчика (EMoR h(x))"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2748
#, kde-format
msgid "EMoR h(1)"
msgstr "EMoR h(1)"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2750 rc.cpp:2754 rc.cpp:2758 rc.cpp:2762 rc.cpp:2766
#, kde-format
msgid ""
"Sensor response parameters.<br>\n"
"    \tThe EMoR h(x) parameters are the same as Hugin's Ra - Re in the lens "
"parameters. If you use Hugin-derived values for vignetting correction, you "
"should also use these parameters, as Hugin's vignetting correction assumes "
"that the sensor response has been corrected."
msgstr ""
"Параметри відгуку датчика.<br>\n"
"    \tПараметри EMoR h(x) такі ж, як і Ra - Re Hugin у параметрах об'єктива. "
"Якщо ви використовуєте значення, отримані з Hugin, для виправлення "
"віньєтування, вам також слід використовувати ці параметри, оскільки "
"виправлення віньєтування Hugin передбачає, що відгук датчика було "
"скориговано."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2752
#, kde-format
msgid "EMoR h(2)"
msgstr "EMoR h(2)"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2756
#, kde-format
msgid "EMoR h(3)"
msgstr "EMoR h(3)"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2760
#, kde-format
msgid "EMoR h(4)"
msgstr "EMoR h(4)"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2764
#, kde-format
msgid "EMoR h(5)"
msgstr "EMoR h(5)"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_rect_to_eq.xml
#: rc.cpp:2772
#, kde-format
msgid "VR360 Rectilinear to Equirectangular"
msgstr "Прямолінійний VR360 у еквідистантний"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_rect_to_eq.xml
#: rc.cpp:2774
#, kde-format
msgid ""
"Converts a rectilinear (a normal-looking) image to an equirectangular image. "
"Use this together with Transform 360 to place \"normal\" footage in a 360 "
"movie."
msgstr ""
"Перетворює прямолінійне (звичайне) зображення на еквідистантне зображення. "
"Скористайтеся цим ефектом разом із 360-градусним перетворенням для "
"перетворення «звичайного» відзнятого матеріалу на 360-градусне відео."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2784
#, kde-format
msgid "VR360 Stabilize"
msgstr "Стабілізація VR360"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2786
#, kde-format
msgid ""
"Stabilizes 360 footage.<br>\n"
"    The plugin works in two phases - analysis and stabilization. When "
"analyzing footage, it detects frame-to-frame rotation, and when stabilizing "
"it tries to correct high-frequency motion (shake)."
msgstr ""
"Стабілізує 360-градусний матеріал.<br>Додаток працює у два кроки — аналіз і "
"стабілізація. Під час аналізу відзнятого матеріалу додаток виявляє обертання "
"у процесі зміни кадрів, а під час стабілізації намагається усунути "
"високочастотний рух (тремтіння)."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2788
#, kde-format
msgid "Analyze"
msgstr "Проаналізувати"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2790
#, kde-format
msgid "Switch on for analysis phase; switch off for stabilization phase."
msgstr "Увімкніть для фази аналізу; вимкніть для фази стабілізації."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2792
#, kde-format
msgid "Motion analysis file"
msgstr "Файл аналізу руху"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2794
#, kde-format
msgid "Select the file to store stabilization data in"
msgstr "Виберіть файл, до якого слід зберегти дані стабілізації"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2796
#, kde-format
msgid "Start offset"
msgstr "Відступ від початку"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2798
#, kde-format
msgid ""
"The offset into the stabilization file that corresponds to the start of this "
"clip.<br>\n"
"    \tFor example, if you have a 30 second clip, analyze it all, and then "
"split it into three clips of 10 seconds each, then the start offsets should "
"be 0s, 10s, and 20s."
msgstr ""
"Зсув у файлі стабілізації, що відповідає початку цього кліпу.<br>\n"
"    \tНаприклад, якщо у вас є 30-секундний кліп, ви аналізуєте його весь, а "
"потім розділяєте на три кліпи по 10 секунд кожен, тоді початкові зсуви мають "
"бути 0, 10 та 20 секунд."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2800
#, kde-format
msgid "Analysis sample radius"
msgstr "Радіус взірця для аналізу"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2802
#, kde-format
msgid "The radius of the square that the stabilizer will sample"
msgstr "Радіус квадрата, зразок з якого буде використано засобом стабілізації."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2804
#, kde-format
msgid "Analysis search radius"
msgstr "Радіус пошуку при аналізі"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2806
#, kde-format
msgid "The maximum amount of motion the stabilizer will detect"
msgstr "Максимальна величина руху, яку виявлятиме стабілізатор."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2808
#, kde-format
msgid "Analysis offset"
msgstr "Зсув аналізу"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2810
#, kde-format
msgid "The distance between the track points"
msgstr "Відстань між точками стеження."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2812
#, kde-format
msgid "Use backwards-facing track points"
msgstr "Використовувати спрямовані назад точки стеження"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2814
#, kde-format
msgid ""
"If set, six backwards-facing track points will also be used to detect pitch "
"and yaw motion.<br>\n"
"    \tDisable if, for example, you show up holding the camera there"
msgstr ""
"Якщо встановлено, шість точок маршруту назад також буде використано для "
"виявлення нахилу та рискання.<br>\n"
"    \tВимкніть, якщо, наприклад, ви з'являєтеся, тримаючи там камеру"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2816
#, kde-format
msgid "Yaw amount"
msgstr "Величина рискання"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2818 rc.cpp:2842
#, kde-format
msgid ""
"The amount of stabilization to apply.<br>\n"
"    \t100% means that the stabilizer will make the camera as steady as it "
"can. Smaller values reduce the amount of stabilization."
msgstr ""
"Величина застосованої стабілізації.<br>\n"
" \t100% означає, що стабілізатор зробить камеру якомога нерухомішою. Менші "
"значення зменшать величину стабілізації."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2820
#, kde-format
msgid "Yaw smoothing"
msgstr "Згладжування рискання"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2822
#, kde-format
msgid ""
"The number of frames to use to smooth out the shakes. The higher the value, "
"the slower the camera will follow any intended motion."
msgstr ""
"Величина стабілізації для застосування. 100% означає, що стабілізатор "
"зробить камеру якомога нерухомішою. Менші значення зменшать величину "
"стабілізації."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2824
#, kde-format
msgid "Yaw time bias"
msgstr "Зміщення рискання за часом"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2826 rc.cpp:2838 rc.cpp:2850
#, kde-format
msgid ""
"Shift the frames used to smooth out the shakes relative to the stabilized "
"frame.<br>\n"
"    \tA value less than zero will give more weight to past frames, and the "
"camera will seem to lag behind intended movement. A value greater than zero "
"will give more weight to future frames, and the camera will appear to move "
"ahead of the intended camera movement. A value of zero should make the "
"camera follow the intended path."
msgstr ""
"Зсунути кадри, які буде використано для згладжування вібрації відносно "
"стабілізованого кадру.<br>\n"
"\tЗначення, яке є меншим за нуль, надасть більшої ваги попереднім кадрам, і "
"здаватиметься, що камера затримуватиметься відносно навмисного руху. "
"Значення, яке є більшим за нуль, надасть більшої ваги майбутнім кадрам, і "
"здаватиметься, що камера випереджатиме навмисний рух камери. Нульове "
"значення має зробити рух камери відповідним до навмисного."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2828
#, kde-format
msgid "Pitch amount"
msgstr "Величина хитання"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2830
#, kde-format
msgid ""
"The amount of stabilization to apply. 100% means that the stabilizer will "
"make the camera as steady as it can. Smaller values reduce the amount of "
"stabilization."
msgstr ""
