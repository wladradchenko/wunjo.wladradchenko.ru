msgstr "Поріг для третьої площини"

#. i18n: file: data/effects/avfilter/avfilter_deflate.xml
#: rc.cpp:5630
#, kde-format
msgid "Threshold for 4th plane"
msgstr "Поріг для четвертої площини"

#. i18n: file: data/effects/avfilter/avfilter_delogo.xml
#: rc.cpp:5632
#, kde-format
msgid "DeLogo"
msgstr "Делого"

#. i18n: file: data/effects/avfilter/avfilter_delogo.xml
