msgstr "Поріг тимчасової освітленості"

#. i18n: file: data/effects/avfilter/avfilter_dedot.xml
#: rc.cpp:5594
#, kde-format
msgid "Temporal Chroma Variation"
msgstr "Варіація тимчасової палітри"

#. i18n: file: data/effects/avfilter/avfilter_dedot.xml
#: rc.cpp:5596
#, kde-format
msgid "Temporal Chroma Threshold"
msgstr "Поріг тимчасової палітри"

#. i18n: file: data/effects/avfilter/avfilter_deesser.xml
#: rc.cpp:5598
#, kde-format
msgid "Deesser"
msgstr "Деессер"

#. i18n: file: data/effects/avfilter/avfilter_deesser.xml
#: rc.cpp:5600
#, kde-format
msgid "Apply de-essing to the audio samples."
msgstr "Застосовує деесування до зразків звукових даних."

#. i18n: file: data/effects/avfilter/avfilter_deesser.xml
#: rc.cpp:5604
#, kde-format
msgid "Set intensity for triggering de-essing. Allowed range is from 0 to 1."
msgstr ""
"Встановлює інтенсивність запущеного деесування. Дозволений діапазон — від 0 "
"до 1."

#. i18n: file: data/effects/avfilter/avfilter_deesser.xml
#: rc.cpp:5606
#, kde-format
msgid "Max deessing"
msgstr "Максимальне деесування"

#. i18n: file: data/effects/avfilter/avfilter_deesser.xml
#: rc.cpp:5608
#, kde-format
msgid ""
"Set amount of ducking on treble part of sound. Allowed range is from 0 to 1."
msgstr ""
"Встановлює інтенсивність притлумлення на високочастотній частині звуку. "
"Дозволений діапазон — від 0 до 1."

#. i18n: file: data/effects/avfilter/avfilter_deesser.xml
#: rc.cpp:5612
#, kde-format
msgid ""
"How much of original frequency content to keep when de-essing. Allowed range "
