msgstr "Розтягування"

#. i18n: file: data/effects/avfilter/avfilter_dilation.xml
#: rc.cpp:5674
#, kde-format
msgid ""
"Apply dilation effect.<br>\n"
"    Simulates image dilation, an effect which will enlarge the lightest "
"pixels in the image by replacing the pixel by the local (3x3) maximum."
msgstr ""
"Застосувати ефект розтягування.<br>\n"
"    Імітує розтягування зображення, ефект, який збільшує найсвітліші пікселі "
"зображення, замінюючи піксель локальним максимумом (3x3)."

#. i18n: file: data/effects/avfilter/avfilter_dilation.xml
#. i18n: file: data/effects/avfilter/avfilter_erosion.xml
#: rc.cpp:5676 rc.cpp:5840
#, kde-format
msgid "1st Plane Threshold"
msgstr "Поріг 1-ої площини"

