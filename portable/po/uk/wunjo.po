msgstr "Керує підсиленням вхідного сигналу"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7636
#, kde-format
msgid "Controls the amount of output signal fed back into the input"
msgstr "Керує величиною відгуку вихідного сигналу до вхідного сигналу"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7638
#, kde-format
msgid "Number of Taps"
msgstr "Кількість перехоплень"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
