msgstr "Радіус колірності"

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6954
#, kde-format
msgid ""
"Set the chroma radius.<br>\n"
"            The value specifies the variance of the gaussian filter used to "
"blur the image (slower if larger). If not specified, it defaults to the "
"value set for <em>Luma radius</em>"
msgstr ""
"Встановити радіус колірності.<br>\n"
"            Значення визначає розсіювання використовуваного фільтра Гауса "
"для розмивання зображення (повільніше, якщо більше). Якщо не вказано, типове "
"значення буде взято з параметра <em>Радіус освітленості</em>"

