msgstr "ініціалізація,кадр"

#. i18n: file: data/effects/avfilter/avfilter_field.xml
#: rc.cpp:5932
#, kde-format
msgid "Field Extractor"
msgstr "Видобувач полів"

#. i18n: file: data/effects/avfilter/avfilter_field.xml
#: rc.cpp:5934
#, kde-format
msgid "Extract a field from the input video"
msgstr "Видобування поля з вхідного відео"

#. i18n: file: data/effects/avfilter/avfilter_field.xml
