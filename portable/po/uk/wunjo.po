msgstr "Вирівнювач відео"

#. i18n: file: data/effects/avfilter/avfilter_eq.xml
#: rc.cpp:5792
#, kde-format
msgid "Adjust Brightness, contrast, gamma, saturation"
msgstr "Скоригувати яскравість, контрастність, гамму, насиченість"

#. i18n: file: data/effects/avfilter/avfilter_eq.xml
#: rc.cpp:5802
