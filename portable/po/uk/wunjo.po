#: rc.cpp:7478 rc.cpp:7500 rc.cpp:7512 rc.cpp:7616 rc.cpp:7634 rc.cpp:7870
#: rc.cpp:8636
#, kde-format
msgid "Feedback"
msgstr "Зворотній зв’язок"

#. i18n: file: data/effects/ladspa/ladspa_1190.xml
#: rc.cpp:7480
#, kde-format
msgid "Feedback level, increases the distinctive wooshy phaser sound."
msgstr "Рівень зворотного зв'язку, підвищує характерний гучний звук фазера."

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7486
#, kde-format
msgid ""
"Flanger (LADSPA 1191)<br>\n"
"   A digital flanger implementation. Uses a novel zero excursion, controlled "
"bandwidth modulation function, which should make the modulation less "
"repetitive and noticeable."
msgstr ""
"Фленджер (LADSPA 1191)<br>\n"
"Реалізація цифрового фленджера. Використовує нову функцію модуляції смуги "
"пропускання з нульовим відхиленням, яка має зробити модуляцію менш "
"повторюваною та помітною."

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7488
#, kde-format
msgid "Delay Base"
msgstr "Основа затримки"

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7490
#, kde-format
msgid ""
"This is the offset from<br>\n"
"      the input time that the detune delay moves around"
msgstr ""
"Це зміщення від<br>\n"
"вхідного часу, навколо якого пересувається затримка розстроювання"

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7492
#, kde-format
msgid "Max Slowdown"
msgstr "Максимальне уповільнення"

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7494
#, kde-format
msgid ""
"This is the maximum<br>\n"
"      delay that will be applied to the delayed signal, relative to the dry "
"signal."
msgstr ""
"Це максимальна<br>\n"
"затримка, яка буде застосована до затриманого сигналу, відносно холодного "
"сигналу."

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7496
#, kde-format
msgid "LFO Frequency"
msgstr "Частота LFO"

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7498
#, kde-format
msgid ""
"This is the core frequency<br>\n"
"      that the 'LFO' will move at. The LFO isn't actually an oscillator, but "
"it does vary periodically."
msgstr ""
"Це основна частота,<br>\n"
"на якій пересуватиметься «LFO». LFO насправді не є осцилятором, але його "
"частота періодично змінюється."

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7502
#, kde-format
msgid ""
"Feedback applied from the<br>\n"
"      output to the input, increases the depth of the effect, but makes it "
"sound less like a real flanger."
msgstr ""
"Зворотний зв'язок,<br>\n"
"що подається з виходу на вхід, збільшує глибину ефекту, але робить його "
"звучання менш схожим на справжній фленджер."

#. i18n: file: data/effects/ladspa/ladspa_1192.xml
#: rc.cpp:7506
#, kde-format
msgid "Fractionally Addressed Delay Line"
msgstr "Fractionally Addressed Delay Line"

#. i18n: file: data/effects/ladspa/ladspa_1192.xml
#: rc.cpp:7508
#, kde-format
msgid ""
"Fractionally Addressed Delay Line (LADSPA 1192)<br>\n"
"   Automatically adapts to the number of channels and sampling rate of the "
"consumer."
msgstr ""
"Дробово адресована лінія затримки (LADSPA 1192)<br>\n"
"Автоматично адаптується до кількості каналів та частоти дискретизації "
"споживача."

#. i18n: file: data/effects/ladspa/ladspa_1195.xml
#. i18n: file: data/effects/ladspa/ladspa_declipper.xml
#: rc.cpp:7516 rc.cpp:8560
#, kde-format
msgid "Declipper"
msgstr "Декліпер"

#. i18n: file: data/effects/ladspa/ladspa_1195.xml
#: rc.cpp:7518
#, kde-format
msgid ""
"Declipper (LADSPA 1195)<br>\n"
"   Removes nasty clicks from input signals, not very kind to them though."
msgstr ""
"Declipper (LADSPA 1195)<br>\n"
"Вилучає неприємні клацання з вхідних сигналів, хоча й не дуже дбайливо до "
"них ставиться."

#. i18n: file: data/effects/ladspa/ladspa_1196.xml
#: rc.cpp:7522
#, kde-format
msgid "Fast Overdrive"
msgstr "Швидкий овердрайв"

#. i18n: file: data/effects/ladspa/ladspa_1196.xml
#: rc.cpp:7524
#, kde-format
msgid ""
"Fast Overdrive (LADSPA 1196)<br>\n"
"   A simple overdrive. Compresses the extreme peaks to make a sound similar "
"to an overdriven amplifier."
msgstr ""
"Швидкий овердрайв (LADSPA 1196)<br>\n"
"Простий овердрайв. Стискає екстремальні піки, щоб створити звук, подібний до "
"перевантаженого підсилювача."

#. i18n: file: data/effects/ladspa/ladspa_1196.xml
#: rc.cpp:7526
#, kde-format
msgid "Drive Level"
msgstr "Рівень ведення"

#. i18n: file: data/effects/ladspa/ladspa_1196.xml
#: rc.cpp:7528
#, kde-format
msgid ""
"Controls the point at<br>\n"
"      which the signal starts to distort, and the degree of distortion."
msgstr ""
"Контролює точку,<br>\n"
"в якій сигнал починає спотворюватися, та ступінь спотворення."

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7532
#, kde-format
msgid "Decimator"
msgstr "Decimator"

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7534
#, kde-format
msgid ""
"Decimator (LADSPA 1202)<br>\n"
"   Decimates (reduces the effective sample rate), and reduces the bit depth "
"of the input signal, allows non integer values for smooth transitions "
"between clean and lo-fi signals."
msgstr ""
"Дециматор (LADSPA 1202)<br>\n"
"Проріджує (зменшує ефективну частоту дискретизації) та зменшує розрядність "
"вхідного сигналу, дозволяє використовувати нецілочисельні значення для "
"плавних переходів між чистими та низькочастотними сигналами."

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7536
#, kde-format
msgid "Bit Depth"
msgstr "Бітова глибина"

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7538
#, kde-format
msgid "The bit depth that the signal will be reduced to"
msgstr "Бітова глибина, до якої буде спрощено сигнал"

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7540
#, kde-format
msgid "Sample Rate"
msgstr "Частота дискретизації"

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7542
#, kde-format
msgid "The sample rate that the signal will be resampled at"
msgstr "Частота дискретизації, з якою буде повторно дискретизуватися сигнал"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7546
#, kde-format
msgid "Single Band Parametric"
msgstr "Односмуговий параметричний"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7548
#, kde-format
msgid ""
"Single Band Parametric (LADSPA 1203)<br>\n"
"   A single band of a parametric filter."
msgstr ""
"Односмуговий параметричний (LADSPA 1203)<br>\n"
"   Одна смуга параметричного фільтра."

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7550
#, kde-format
msgid "Gain (dB)"
msgstr "Підсилення (дБ)"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7552
#, kde-format
msgid "The attenuation/gain of the eq"
msgstr "Згасання/Підсилення еквалайзера"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7554
#, kde-format
msgid "Frequency (Hz)"
msgstr "Частота (Гц)"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7556
#, kde-format
msgid ""
"The centre frequency (i.e. point of<br>\n"
"      most/least attenuation). Beware of high values for <i>Frequency</i> "
"and <i>Bandwidth</i>: if the high pitch (<i>Frequency</i> * 2^<i>Bandwidth</"
"i>) goes over half the sample rate, you will get aliasing."
msgstr ""
"Центральна частота (тобто точка<br>\n"
"найбільшого/найменшого затухання). Остерігайтеся високих значень для "
"<i>Частоти</i> та <i>Смуги пропускання</i>: якщо високий тон (<i>Частота</i> "
"* 2^<i>Смуга пропускання</i>) перевищує половину частоти дискретизації, ви "
"отримаєте згладжування."

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7558
#, kde-format
msgid "Bandwidth (octaves)"
msgstr "Ширина каналу (в октавах)"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7560
#, kde-format
msgid ""
"The pitch difference from the<br>\n"
"      centre before the attenuation has reached half the <i>Gain</i>."
msgstr ""
"Різниця у тоні від<br>\n"
"      центру до того, як згасання досягає половини <i>Підсилення</i>."

#. i18n: file: data/effects/ladspa/ladspa_1207.xml
#: rc.cpp:7564
#, kde-format
msgid "DC Offset Remover"
msgstr "Усування відхилення від центру"

#. i18n: file: data/effects/ladspa/ladspa_1207.xml
#: rc.cpp:7566
#, kde-format
msgid ""
"DC Offset Remover (LADSPA 1207)<br>\n"
"   Simply removes the DC (0 Hz) component from an audio signal, uses a high "
"pass filter, so has some side effects, but they should be minimal."
msgstr ""
"Усування відхилення від центру (LADSPA 1207)<br>\n"
"   Просто вилучає сталу складову (0 Гц) зі звукового сигналу, використовує "
"фільтр високих частот, тому має деякі побічні ефекти, але вони мають бути "
"мінімальними."

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#: rc.cpp:7570
#, kde-format
msgid "Foldover Distortion"
msgstr "Спотворення згинання"

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#: rc.cpp:7572
#, kde-format
msgid ""
"Foldover Distortion (LADSPA 1213)<br>\n"
"   Uses a sine wave approximation to simulate valve style foldover "
"distortion. Probably should have a <i>DC Offset Remover</i> on the output, "
"but it's not always necessary."
msgstr ""
"Спотворення згинання (LADSPA 1213)<br>\n"
"   Використовує наближення синусоїди для імітації спотворення, створюваного "
"за допомогою клапана. Ймовірно, на виході має бути **Усування відхилення від "
"центру**, але це не завжди необхідно."

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:7574 rc.cpp:8516
#, kde-format
msgid "Drive"
msgstr "Драйв"

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#: rc.cpp:7576
#, kde-format
msgid "Controls the degree of distortion"
msgstr "Керує ступенем викривлення"

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#: rc.cpp:7578
#, kde-format
msgid "Skew"
msgstr "Нахил"

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#: rc.cpp:7580
#, kde-format
msgid "Controls the asymmetry of the waveform"
msgstr "Керує асиметрією форми хвилі"

#. i18n: file: data/effects/ladspa/ladspa_1218.xml
#: rc.cpp:7584
#, kde-format
msgid "4x4 Pole Allpass"
msgstr "4 x 4 полюсів, усі діапазони"

#. i18n: file: data/effects/ladspa/ladspa_1218.xml
#: rc.cpp:7586
#, kde-format
msgid ""
