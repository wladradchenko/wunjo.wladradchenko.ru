msgstr "Усі,Y,U,V,Альфа,Червоний,Зелений,Синій"

#. i18n: file: data/effects/avfilter/avfilter_dedot.xml
#: rc.cpp:5582
#, kde-format
msgid "DeDot"
msgstr "ДеДот"

#. i18n: file: data/effects/avfilter/avfilter_dedot.xml
#: rc.cpp:5584
#, kde-format
