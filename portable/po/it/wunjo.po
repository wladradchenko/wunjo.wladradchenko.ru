#. i18n: file: data/effects/avfilter/avfilter_equalizer.xml
#: rc.cpp:5810
#, kde-format
msgid "Audio Equalizer (avfilter)"
msgstr "Equalizzatore audio (avfilter)"

#. i18n: file: data/effects/avfilter/avfilter_equalizer.xml
#: rc.cpp:5812
#, kde-format
msgid ""
"Apply two-pole peaking equalization (EQ) filter. With this filter, the "
"signal-level at and around a selected frequency can be increased or "
"decreased, whilst (unlike bandpass and bandreject filters) that at all other "
"frequencies is unchanged."
msgstr ""
"Applica un filtro di equalizzazione (EQ) a picco a due poli. Con questo "
"filtro, il livello del segnale in corrispondenza e intorno a una frequenza "
"selezionata può essere aumentato o diminuito, mentre (a differenza dei "
"filtri passa-banda ed elimina-banda) quello di tutte le altre frequenze "
"resta invariato."

#. i18n: file: data/effects/avfilter/avfilter_equalizer.xml
#: rc.cpp:5816
#, kde-format
msgid "Width Type"
msgstr "Tipo di larghezza"

#. i18n: file: data/effects/avfilter/avfilter_equalizer.xml
#: rc.cpp:5818
#, kde-format
msgid "Hertz,Q-Factor,Octave,Slope,kHz"
msgstr "Hertz,Fattore Q,Ottava,Pendenza,kHz"

#. i18n: file: data/effects/avfilter/avfilter_equalizer.xml
#: rc.cpp:5820
#, kde-format
msgid "Band Width"
msgstr "Larghezza di banda"

#. i18n: file: data/effects/avfilter/avfilter_erosion.xml
#: rc.cpp:5836
#, kde-format
msgid "Erosion"
msgstr "Erosione"

#. i18n: file: data/effects/avfilter/avfilter_erosion.xml
#: rc.cpp:5838
#, kde-format
msgid ""
"Apply erosion effect.<br>\n"
"    Simulates image erosion, an effect which will enlarge the darkest pixels "
"in the image by replacing the pixel by the local (3x3) minimum."
msgstr ""
"Applica l'effetto di erosione.<br>\n"
"    Simula l'erosione dell'immagine, un effetto che ingrandisce i pixel più "
"scuri dell'immagine e li sostituisce con il minimo locale (3x3)."

#. i18n: file: data/effects/avfilter/avfilter_exposure.xml
#: rc.cpp:5860 rc.cpp:5864
#, kde-format
msgid "Exposure"
msgstr "Esposizione"

#. i18n: file: data/effects/avfilter/avfilter_exposure.xml
#: rc.cpp:5862
#, kde-format
msgid "Adjust exposure of the video stream."
msgstr "Regola l'esposizione del flusso video."

#. i18n: file: data/effects/avfilter/avfilter_extrastereo.xml
#: rc.cpp:5868
#, kde-format
msgid "Extrastereo"
msgstr "Extrastereo"

#. i18n: file: data/effects/avfilter/avfilter_extrastereo.xml
#: rc.cpp:5870
#, kde-format
msgid ""
"Linearly increases the difference between left and right channels which adds "
"some sort of \"live\" effect to playback."
msgstr ""
"Aumenta linearmente la differenza tra i canali destro e sinistro, "
"aggiungendo alla riproduzione una sorta di effetto \"dal vivo\"."

#. i18n: file: data/effects/avfilter/avfilter_extrastereo.xml
#: rc.cpp:5874
#, kde-format
msgid ""
"Sets the difference coefficient (default: 2.5).\n"
"0.0 means mono sound (average of both channels),\n"
"with 1.0 sound will be unchanged, with -1.0 left and right channels will be "
"swapped."
msgstr ""
"Imposta il coefficiente di differenza (predefinito: 2.5).\n"
"0.0 significa suono mono (la media dei due canali),\n"
"con 1.0 il suono non verrà modificato, mentre con -1.0 i canali destro e "
"sinistro verranno scambiati."

#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:5878
#, kde-format
msgid "3D FFT Denoiser"
msgstr "Riduttore di disturbi FFT 3D"

#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:5880
#, kde-format
msgid "Denoise frames using 3D FFT (frequency domain filtering)"
msgstr ""
"Riduce i disturbi dei fotogrammi usando la FFT 3D (filtraggio nel dominio "
"delle frequenze)"

#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:5884
#, kde-format
msgid ""
"Set the noise sigma constant.<br>\n"
"       \tThis sets denoising strength. Using very high sigma with low "
"overlap may give blocking artifacts."
msgstr ""
"Imposta la costante sigma del rumore.<br>\n"
"       \tImposta l'intensità della riduzione del rumore. L'uso di un sigma "
"molto alta con una sovrapposizione bassa può causare artefatti di blocco."

#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:5888
#, kde-format
msgid ""
"Set the amount of denoising.<br>\n"
"       \tBy default all detected noise is reduced."
msgstr ""
"Imposta la quantità di riduzione dei disturbi.<br>\n"
"       \tPer impostazione predefinita, tutti i rumori vengono ridotti."

#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:5890
#, kde-format
msgid "Block"
msgstr "Blocco"

#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:5892
#, kde-format
msgid "Set size of block in pixels"
msgstr "Imposta la dimensione del blocco in pixel"

#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:5896
#, kde-format
msgid "Set block overlap"
msgstr "Imposta la sovrapposizione del blocco"

#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:5900
#, kde-format
msgid "Set denoising method"
msgstr "Imposta il metodo di riduzione dei disturbi"

#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:5902
#, kde-format
msgid "Wiener,Hard"
msgstr "Wiener,Rigida"

#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:5904
#, kde-format
msgid ""
"Add <em>previous</em> frame<br>\n"
"        for temporal denoising"
msgstr ""
"Aggiungi il fotogramma <em>precedente</em><br>\n"
"        per una riduzione del rumore temporale"

#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:5906
#, kde-format
msgid ""
"Add <em>next</em> frame<br>\n"
"        for temporal denoising"
msgstr ""
"Aggiungi il fotogramma <em>successivo<br>\n"
"        per una riduzione del rumore temporale"

