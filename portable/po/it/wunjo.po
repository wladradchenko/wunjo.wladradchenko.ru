msgstr "Direzione della segmentazione"

#. i18n: file: data/effects/frei0r/frei0r_kaleid0sc0pe.xml
#: rc.cpp:3514
#, kde-format
msgid "Direction of the segmentation."
msgstr "La direzione della segmentazione."

#. i18n: file: data/effects/frei0r/frei0r_kaleid0sc0pe.xml
#: rc.cpp:3516
#, kde-format
msgid "None,Counter Clockwise,Clockwise"
msgstr "Nessuno,In senso antiorario,In senso orario"

#. i18n: file: data/effects/frei0r/frei0r_kaleid0sc0pe.xml
#: rc.cpp:3518
#, kde-format
msgid "Reflect Edges"
msgstr "Rifletti i bordi"

#. i18n: file: data/effects/frei0r/frei0r_kaleid0sc0pe.xml
#: rc.cpp:3520
#, kde-format
msgid ""
"If checked, reflections that end up outside the source reflect back into it."
"<br>\n"
"        Otherwise the specified background color is used."
msgstr ""
"Se l'opzione è selezionata, le riflessioni che finiscono all'esterno della "
"sorgente si riflettono al suo interno. <br>\n"
"        Diversamente viene usato il colore specificato per lo sfondo."

#. i18n: file: data/effects/frei0r/frei0r_kaleid0sc0pe.xml
#: rc.cpp:3522
#, kde-format
msgid "Edge Threshold"
msgstr "Soglia per il bordo"

#. i18n: file: data/effects/frei0r/frei0r_kaleid0sc0pe.xml
#: rc.cpp:3524
#, kde-format
msgid ""
"Edge threshold / 4, reflections <br>\n"
"        outside the image but within this distance clamp to the edge."
msgstr ""
"Soglia del bordo / 4, i riflessi <br>\n"
"        all'esterno dell'immagine ma in questa distanza si attaccano al "
"bordo."

#. i18n: file: data/effects/frei0r/frei0r_kaleid0sc0pe.xml
#: rc.cpp:3526
#, kde-format
msgid "Preferred Corner"
msgstr "Angolo preferito"

#. i18n: file: data/effects/frei0r/frei0r_kaleid0sc0pe.xml
#: rc.cpp:3528
#, kde-format
msgid ""
"If <em>Reflect Edges</em> is not checked, <br>\n"
"        this parameter defines the preferred corner."
msgstr ""
"Se<em>Rifletti i bordi</em> non è spuntato, <br>\n"
"        questo parametro definisce l'angolo preferito."

#. i18n: file: data/effects/frei0r/frei0r_kaleid0sc0pe.xml
#: rc.cpp:3530
#, kde-format
msgid "Top right,Top left,Bottom left,Bottom right"
msgstr ""
"In alto a destra,In alto a sinistra,In basso a sinistra,In basso a destra"

#. i18n: file: data/effects/frei0r/frei0r_kaleid0sc0pe.xml
#: rc.cpp:3532
#, kde-format
msgid "Corner Search"
msgstr "Ricerca dell'angolo"

#. i18n: file: data/effects/frei0r/frei0r_kaleid0sc0pe.xml
#: rc.cpp:3534
#, kde-format
msgid ""
"If checked, search clockwise for furthest corner.<br>\n"
"        Otherwise search counter clockwise."
msgstr ""
"Se è selezionato, cerca l'angolo più lontano in senso orario.<br>\n"
"        Diversamente lo cerca in senso antiorario."

#. i18n: file: data/effects/frei0r/frei0r_kaleid0sc0pe.xml
#: rc.cpp:3538
#, kde-format
msgid ""
"Color to use if reflection<br>\n"
"        lies outside of the source image and not reflecting back in."
msgstr ""
"Colore da utilizzare se il riflesso si trova <br>\n"
"        all'esterno dell'immagine di origine, e non si riflette all'interno."

#. i18n: file: data/effects/frei0r/frei0r_kaleid0sc0pe.xml
#: rc.cpp:3540
#, kde-format
msgid "No Alpha Background"
msgstr "Nessuno sfondo alfa"

#. i18n: file: data/effects/frei0r/frei0r_kaleid0sc0pe.xml
#: rc.cpp:3542
#, kde-format
msgid ""
"If checked, the selected<br>\n"
"        color will be used, if reflection lies outside of the source image "
"and not reflecting back in."
msgstr ""
"Se è selezionato, il colore selezionato<br>\n"
"        verrà usata se il riflesso si trova all'esterno dell'immagine "
"sorgente e non si riflette indietro."

#. i18n: file: data/effects/frei0r/frei0r_keyspillm0pup.xml
#: rc.cpp:3544
#, kde-format
msgid "Key Spill Mop Up"
msgstr "Ripulitura perdita chiave del colore"

#. i18n: file: data/effects/frei0r/frei0r_keyspillm0pup.xml
#: rc.cpp:3546
#, kde-format
msgid "Reduces the visibility of key color spill in chroma keying"
msgstr ""
"Riduce la visibilità della fuoriuscita di colore chiave in chiave cromatica"

#. i18n: file: data/effects/frei0r/frei0r_keyspillm0pup.xml
#: rc.cpp:3548
#, kde-format
msgid "Key Color"
msgstr "Colore chiave"

#. i18n: file: data/effects/frei0r/frei0r_keyspillm0pup.xml
#: rc.cpp:3550
#, kde-format
msgid "Target Color"
msgstr "Colore di riferimento"

#. i18n: file: data/effects/frei0r/frei0r_keyspillm0pup.xml
#: rc.cpp:3552
#, kde-format
msgid "Mask Type"
msgstr "Tipo di maschera"

#. i18n: file: data/effects/frei0r/frei0r_keyspillm0pup.xml
#: rc.cpp:3554
#, kde-format
msgid "Color distance,Transparency,Edge inwards,Edge outwards"
msgstr ""
"Distanza fra colori, Trasparenza, Bordi verso l'interno, Bordi verso "
"l'esterno"

#. i18n: file: data/effects/frei0r/frei0r_keyspillm0pup.xml
#: rc.cpp:3556
#, kde-format
msgid "Tolerance"
msgstr "Tolleranza"

#. i18n: file: data/effects/frei0r/frei0r_keyspillm0pup.xml
#: rc.cpp:3560
#, kde-format
msgid "Hue Gate"
msgstr "Porta di tonalità"

#. i18n: file: data/effects/frei0r/frei0r_keyspillm0pup.xml
#: rc.cpp:3562
#, kde-format
msgid "Saturation Threshold"
