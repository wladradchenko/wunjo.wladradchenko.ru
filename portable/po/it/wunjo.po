#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7050
#, kde-format
msgid "Stereo tools"
msgstr "Strumenti stereo"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7052
#, kde-format
msgid ""
"This filter has some handy utilities to manage stereo signals, for "
"converting M/S stereo recordings to L/R signal while having control over the "
"parameters or spreading the stereo image of master track."
msgstr ""
"Questo filtro ha alcune utilità pratiche per gestire i segnali stereo, per "
"convertire le registrazioni stereo M/S in segnale L/R avendo il controllo "
"dei parametri, oppure diffondendo l'immagine stereo della traccia principale."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7054
#, kde-format
msgid "Level IN"
msgstr "Livello ingresso"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7056 rc.cpp:7060
#, kde-format
msgid ""
"Set input level before filtering for both channels.\n"
"Allowed range is from 0.015625 to 64."
msgstr ""
"Imposta il livello prima del filtraggio per entrambi i canali.\n"
"I valori permessi vanno da 0,015625 a 64."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7058
#, kde-format
msgid "Level OUT"
msgstr "Livello uscita"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7062 rc.cpp:7120
#, kde-format
msgid "Balance IN"
msgstr "Bilanciamento ingresso"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7064 rc.cpp:7068
#, kde-format
msgid ""
"Set input balance between both channels. Default is 0. Allowed range is from "
"-1 to 1."
msgstr ""
"Imposta il bilanciamento tra i canali. Il valore predefinito è 0. "
"L'intervallo permesso va da -1 a 1."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7066 rc.cpp:7126
#, kde-format
msgid "Balance OUT"
msgstr "Bilanciamento uscita"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7070
#, kde-format
msgid "Softclip"
msgstr "Softclip"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7072
#, kde-format
msgid ""
"Enable softclipping. Results in analog distortion instead of harsh digital "
"0dB clipping."
msgstr ""
"Abilita il soft clipping. Si ottiene una distorsione analogica invece del "
"duro clipping digitale a 0 dB."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7074
#, kde-format
msgid "Mute Left"
msgstr "Silenzia sinistra"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7076
#, kde-format
msgid "Mute Right"
msgstr "Silenzia destra"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7078
#, kde-format
msgid "Phase Left"
msgstr "Fase sinistra"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7080
#, kde-format
msgid "Change the phase of the left channel."
msgstr "Modifica la fase del canale sinistro."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7082
#, kde-format
msgid "Phase Right"
msgstr "Fase destra"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7084
#, kde-format
msgid "Change the phase of the right channel."
msgstr "Modifica la fase del canale destro."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:7086 rc.cpp:8426
#, kde-format
msgid "Stereo Mode"
msgstr "Modalità stereo"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7088
#, kde-format
msgid ""
"Left/Right to Left/Right,Left/Right to Mid/Side,Mid/Side to Left/Right,Left/"
"Right to Left/Left,Left/Right to Right/Right,Left/Right to Left + Right,Left/"
"Right to Right/Left,Mid/Side to Left/Left,Mid/Side to Right/Right,Mid/Side "
"to Right/Left,Left/Right to Left - Right"
msgstr ""
"Sinistra/Destra a Sinistra/Destra,Sinistra/Destra a Centro/Lato,Centro/Lato "
"a Sinistra/Destra,Sinistra/Destra a Sinistra/Sinistra,Sinistra/Destra a "
"Destra/Destra,Sinistra/Destra a Sinistra + Destra,Sinistra/Destra a Destra/"
"Sinistra,Centro/Lato a Sinistra/Sinistra,Centro/Lato a Destra/Destra,Centro/"
"Lato a Destra/Sinistra,Sinistra/Destra a Sinistra - Destra"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7090
#, kde-format
msgid "Side Level"
msgstr "Livello laterale"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7092
#, kde-format
msgid ""
"Set level of side signal. Default is 1. Allowed range is from 0.015625 to 64."
msgstr ""
"Imposta il livello del segnale laterale. Il valore predefinito è 1. I valori "
"permessi vanno da 0,015625 a 64."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7094
#, kde-format
msgid "Side Balance"
msgstr "Bilanciamento laterale"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7096
#, kde-format
msgid ""
"Set balance of side signal. Default is 0. Allowed range is from -1 to 1."
msgstr ""
"Imposta il bilanciamento del segnale laterale. Il valore predefinito è 0. I "
"valori permessi vanno da -1 a 1."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7098
#, kde-format
msgid "Mid Level"
msgstr "Livello centrale"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7100
#, kde-format
msgid ""
"Set level of the middle signal. Default is 1. Allowed range is from 0.015625 "
"to 64."
msgstr ""
"Imposta il livello centrale del segnale. L'impostazione predefinita è 1. "
"L'intervallo consentito va da 0,015625 a 64."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7102
#, kde-format
msgid "Mid Pan"
msgstr "Panoramica del centro"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7104
#, kde-format
msgid "Set middle signal pan. Default is 0. Allowed range is from -1 to 1."
msgstr ""
"Imposta la panoramica del segnale centrale. Il valore predefinito è 0. "
"L'intervallo permesso va da -1 a 1."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7106
#, kde-format
msgid "Stereo base"
msgstr "Base stereo"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7108
#, kde-format
msgid ""
"Set stereo base between mono and inverted channels. Default is 0. Allowed "
"range is from -1 to 1."
msgstr ""
"Imposta la base stereo tra i canali mono e invertiti. Il valore predefinito "
"è 0. L'intervallo permesso va da -1 a 1."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7112
#, kde-format
msgid ""
"Set delay in milliseconds how much to delay left from right channel and vice "
"versa. Default is 0. Allowed range is from -20 to 20."
msgstr ""
"Imposta di quanto ritardare, in millisecondi, il canale sinistro da quello "
"destro, e viceversa. Il valore predefinito è 0. L'intervallo consentito va "
"da -20 a 20."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7114
#, kde-format
msgid "S/C level"
msgstr "Livello S/C"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7116
#, kde-format
msgid "Stereo phase"
msgstr "Fase stereo"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7118
#, kde-format
msgid "Set the stereo phase in degrees."
msgstr "Imposta la fase stereo in gradi."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7122 rc.cpp:7128
#, kde-format
msgid ""
"‘balance’\n"
"Classic balance mode. Attenuate one channel at a time. Gain is raised up to "
"1.\n"
"‘amplitude’\n"
"Similar to classic mode above but gain is raised up to 2.\n"
"‘power’\n"
"Equal power distribution, from -6dB to +6dB range."
msgstr ""
"«bilanciamento»\n"
"La modalità di bilanciamento classica. Attenua un canale alla volta. Il "
"guadagno viene aumentato fino a 1.\n"
"«ampiezza»\n"
"Simile alla modalità classica di cui sopra, ma il guadagno viene aumentato "
"fino a 2.\n"
"«potenza»\n"
"Distribuzione equa della potenza, da -6dB a +6dB."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7124 rc.cpp:7130
#, kde-format
msgid "balance,amplitude,power"
msgstr "bilanciamento,ampiezza,potenza"

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7132
#, kde-format
msgid "Stereo widener"
msgstr "Stereo ampliato"

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7134
#, kde-format
msgid ""
"This filter enhance the stereo effect by suppressing signal common to both "
"channels and by delaying the signal of left into right and vice versa, "
"thereby widening the stereo effect."
msgstr ""
"Questo filtro migliora l'effetto stereo sopprimendo il segnale comune a "
"entrambi i canali e ritardando il segnale da sinistra a destra e viceversa. "
"L'effetto stereo viene così ampliato."

