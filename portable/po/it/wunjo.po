#. i18n: file: data/effects/timer.xml
#: rc.cpp:2002
#, kde-format
msgid "Start (HH:MM:SS.SSS)"
msgstr "Inizio (HH:MM:SS.SSS)"

#. i18n: file: data/effects/timer.xml
#: rc.cpp:2004
#, kde-format
msgid ""
"The time that the timer will start counting up or down.<br>\n"
"        The text will be frozen at 00:00:00.000 from the start of the filter "
"until the start time has elapsed."
msgstr ""
"Il tempo da cui il timer inizierà a contare in avanti o all'indietro.<br>\n"
"        Il testo verrà immobilizzato a 00:00:00.000 dall'inizio del filtro "
"finché non è trascorso il tempo di inizio."

#. i18n: file: data/effects/timer.xml
#: rc.cpp:2006 rc.cpp:2012 rc.cpp:2018
#, kde-format
msgid "HH:MM:SS.SSS"
msgstr "HH:MM:SS.SSS"

#. i18n: file: data/effects/timer.xml
#: rc.cpp:2008
#, kde-format
msgid "Duration (HH:MM:SS.SSS)"
msgstr "Durata (HH:MM:SS.SSS)"

#. i18n: file: data/effects/timer.xml
#: rc.cpp:2010
#, kde-format
msgid ""
"The maximum elapsed duration of the timer after the start time has elapsed."
"<br>\n"
"The text will be frozen at the duration time after the duration has elapsed."
msgstr ""
"La durata massima trascorsa del timer dopo che è passato il tempo di avvio."
"<br>\n"
"Il testo verrà immobilizzato al tempo della durata dopo che la durata è "
"trascorsa."

#. i18n: file: data/effects/timer.xml
#: rc.cpp:2014
#, kde-format
msgid "Offset (HH:MM:SS.SSS)"
msgstr "Scostamento (HH:MM:SS.SSS)"

#. i18n: file: data/effects/timer.xml
#: rc.cpp:2016
#, kde-format
msgid ""
"An offset to be added to the timer value.<br>\n"
"        When the direction is <i>Down</i>, the timer will count down to "
"<i>Offset</i> instead of 00:00:00.000.<br>\n"
"        When the direction is <i>Up</i>, the timer will count up starting "
"from <i>Offset</i>."
msgstr ""
"Uno scostamento da aggiungere al valore del timer.<br>\n"
"        Se la direzione è <i>All'indietro</i>, il timer conterà indietro "
"fino allo <i>Scostamento</i> invece che a 00:00:00.000.<br>\n"
"        Se la direzione è <i>In avanti</i>, il timer conterà in avanti a "
"partire dallo <i>Scostamento</i>."

#. i18n: file: data/effects/timer.xml
#: rc.cpp:2022
#, kde-format
msgid ""
"Clock speed multiplier.<br>\n"
"        For example, speed 10.0 makes the timer tick 10 seconds for each "
"second of playback.<br><br>\n"
"        Scales Duration but does not affect <i>Start</i> or <i>Offset</i>. "
"For example: start 5s, duration 30s, offset 7s and speed 10.0 will have the "
"timer start at playback time 00:00:05.000 with value 00:00:07, count 10 "
"seconds per second of playback and stop at playback time 00:00:08.000 with "
"value 00:00:37."
msgstr ""
"Moltiplicatore della velocità dell'orologio.<br>\n"
"        Ad esempio, una velocità di 10.0 fa avanzare il timer di 10 secondi "
"per ogni secondo di riproduzione.<br><br>\n"
"        Scala la durata ma non influisce su <i>Inizio</i> o <i>Scostamento</"
"i>. Ad esempio: inizio 5s, durata 30s, scostamento 7s e velocità 10.0 "
"faranno partire il timer al tempo di riproduzione 00:00:05.000 con valore "
"00:00:07, conterà 10 secondi per secondo di riproduzione e si fermerà al "
"tempo di riproduzione 00:00:08.000 con valore 00:00:37."

#. i18n: file: data/effects/timer.xml
#: rc.cpp:2026
#, kde-format
msgid ""
"Whether the counter should count up from 00:00:00.000 or down from the "
"duration time."
msgstr ""
"Se il contatore deve contare in avanti da 00:00:00.000 o all'indietro dal "
"tempo di durata."

#. i18n: file: data/effects/timer.xml
#: rc.cpp:2028
#, kde-format
msgid "Up,Down"
msgstr "In avanti,All'indietro"

