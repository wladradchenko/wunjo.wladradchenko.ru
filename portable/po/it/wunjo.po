msgstr "Mescolamento rotore/tromba"

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8324
#, kde-format
msgid "TAP Pitch Shifter"
msgstr "Modulatore di tonalità TAP"

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8326
#, kde-format
msgid ""
"TAP Pitch Shifter (LADSPA 2150)<br>\n"
"   Change the pitch in the range of plus/minus one octave."
msgstr ""
"Modulatore di tonalità TAP (LADSPA 2150)<br>\n"
"   Cambia la tonalità nell'intervallo di più o meno un'ottava."

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8328
#, kde-format
msgid "Semitone Shift"
msgstr "Spostamento del semitono"

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8330
#, kde-format
msgid ""
"Does the same thing as <b>Rate Shift</b></br>\n"
"      but allows to set musically sensible pitch shift rates."
msgstr ""
"Fa la stessa cosa di <b>Spostamento di velocità</b></br>\n"
"      ma consente di impostare velocità di trasposizione della tonalità "
"sensate dal punto di vista musicale."

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8332
#, kde-format
msgid "Rate Shift"
msgstr "Spostamento di velocità"

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8334
#, kde-format
msgid ""
"Does the same thing as <b>Semitone Shift</b><br>\n"
"      but in percentage of the original pitch, so that is closer to a "
"\"physical\", non-musical approach"
msgstr ""
"Fa la stessa cosa di <b>Spostamento di semitoni</b><br>\n"
"      ma in percentuale della tonalità originale, quindi è più vicino a un "
"approccio \"fisico\", non musicale"

#. i18n: file: data/effects/ladspa/ladspa_2151.xml
#: rc.cpp:8342
#, kde-format
msgid "TAP Equalizer/BW"
msgstr "Equalizzatore TAP/BW"

#. i18n: file: data/effects/ladspa/ladspa_2151.xml
#: rc.cpp:8344
#, kde-format
msgid ""
"TAP Equalizer (LADSPA (2151)<br>\n"
"    8-band equalizer with adjustable band center frequencies and bandwidth."
msgstr ""
"Equalizzatore TAP (LADSPA (2151)<br>\n"
"    Equalizzatore a 8 bande con frequenze centrali e larghezza di banda "
"regolabili."

#. i18n: file: data/effects/ladspa/ladspa_2151.xml
