#. i18n: file: data/effects/frei0r/frei0r_keyspillm0pup.xml
#: rc.cpp:3570
#, kde-format
msgid "Operation 2"
msgstr "Operazione 2"

#. i18n: file: data/effects/frei0r/frei0r_keyspillm0pup.xml
#: rc.cpp:3574
