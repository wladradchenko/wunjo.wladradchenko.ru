#, kde-format
msgid "First available, All"
msgstr "Primo disponibile,Tutti"

#. i18n: file: data/effects/avfilter/avfilter_weave.xml
#: rc.cpp:7410
#, kde-format
msgid "Weave interlacer"
msgstr "Interlacciatore weave"

#. i18n: file: data/effects/avfilter/avfilter_weave.xml
#: rc.cpp:7412
#, kde-format
msgid ""
"The weave takes a field-based video input and join each two sequential "
"fields into single frame, producing a new double height clip with half the "
"frame rate and half the frame count."
msgstr ""
"Il weave prende in ingresso un video basato su campi e unisce ogni coppia di "
"campi sequenziali in un singolo fotogramma, producendo una nuova clip di "
"altezza doppia con metà della frequenza e metà del numero di fotogrammi."

#. i18n: file: data/effects/avfilter/avfilter_weave.xml
#: rc.cpp:7416
#, kde-format
msgid "Top,Bottom"
msgstr "Alto,Basso"

#. i18n: file: data/effects/avfilter/avfilter_xbr.xml
#: rc.cpp:7418
#, kde-format
msgid "xBR Interpolator"
msgstr "Interpolatore xBR"

#. i18n: file: data/effects/avfilter/avfilter_xbr.xml
#: rc.cpp:7420
#, kde-format
msgid ""
"Apply the xBR high-quality magnification filter which is designed for pixel "
"art. It follows a set of edge-detection rules."
msgstr ""
"Applica il filtro di ingrandimento ad alta qualità xBR, che è progettato per "
"la pixel art. Segue un gruppo di regole di rilevamento dei bordi."

#. i18n: file: data/effects/avfilter/avfilter_xbr.xml
#: rc.cpp:7422
#, kde-format
msgid "Scaling dimension"
msgstr "Dimensione di scalatura"

#. i18n: file: data/effects/avfilter/avfilter_xbr.xml
#: rc.cpp:7424
#, kde-format
msgid "2x BR,3x BR,4x BR"
msgstr "2x BR,3x BR,4x BR"

#. i18n: file: data/effects/avfilter/avfilter_yadif.xml
#: rc.cpp:7426
#, kde-format
msgid "Yadif Deinterlacer"
msgstr "Deinterlacciatore Yadif"

#. i18n: file: data/effects/avfilter/avfilter_yadif.xml
#: rc.cpp:7428
#, kde-format
msgid ""
"Deinterlace the input video (\"yadif\" means \"yet another deinterlacing "
"filter\")"
msgstr ""
"Deinterlaccia il video in ingresso («yadif» significa \"yet another "
"deinterlacing filter\")"

#. i18n: file: data/effects/avfilter/avfilter_yadif.xml
#: rc.cpp:7432
#, kde-format
msgid "Send frame,Send field,Send frame nospatial,Send field nospatial"
msgstr ""
"Invia fotogramma,Invia campo,Invia fotogramma senza spaziale,Invia campo "
"senza spaziale"

#. i18n: file: data/effects/avfilter/avfilter_yadif.xml
#: rc.cpp:7436
#, kde-format
msgid "Top field first,Bottom field first,Auto"
msgstr "Prima il campo superiore,Prima il campo inferiore,Automatico"

#. i18n: file: data/effects/avfilter/avfilter_zoompan.xml
#: rc.cpp:7442
#, kde-format
msgid "Zoom Pan"
msgstr "Ingrandisci e sposta"

#. i18n: file: data/effects/avfilter/avfilter_zoompan.xml
#: rc.cpp:7444
#, kde-format
msgid "Apply Zoom and Pan effect"
msgstr "Applica l'effetto Ingrandisci e sposta"

#. i18n: file: data/effects/avfilter/subtitles.xml
#: rc.cpp:7456
#, kde-format
msgid "Render subtitles onto the video"
msgstr "Genera i sottotitoli sul video"

#. i18n: file: data/effects/avfilter/subtitles.xml
#: rc.cpp:7458
#, kde-format
msgid "Subtitle file to apply"
msgstr "File di sottotitoli da applicare"

#. i18n: file: data/effects/ladspa/ladspa_1185.xml
#: rc.cpp:7460
#, kde-format
msgid "Diode Processor"
msgstr "Processore a diodi"

#. i18n: file: data/effects/ladspa/ladspa_1185.xml
#: rc.cpp:7462
#, kde-format
msgid ""
"Diode Processor (LADSPA 1185)<br>\n"
"   Mangles the signal as if it had been passed through a diode rectifier "
"network. You should probably follow this with a <i>DC Offset Remover</i>, "
"unless you want the offset."
msgstr ""
"Processore a diodi (LADSPA 1185)<br>\n"
"   Altera il segnale come se fosse passato attraverso una rete di "
"raddrizzatori a diodi. Probabilmente dovresti farlo seguire da un "
"<i>Rimozione scostamento DC</i>, a meno che tu non voglia lo scostamento."

#. i18n: file: data/effects/ladspa/ladspa_1185.xml
#: rc.cpp:7466
#, kde-format
msgid ""
"The <i>Mode</i> parameter is<br>\n"
"      continuously variable from thru to half-wave (1) rectification to full-"
"wave (2) to silence (0)"
msgstr ""
"Il parametro <i>Modalità</i> è<br>\n"
"      variabile in modo continuo da passante a raddrizzamento a semionda "
"(1), a onda intera (2), a silenzio (0)"

