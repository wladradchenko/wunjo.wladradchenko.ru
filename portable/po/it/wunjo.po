#. i18n: file: data/effects/lumakey.xml
#: rc.cpp:1342
#, kde-format
msgid "Lumakey"
msgstr "Lumakey"

#. i18n: file: data/effects/lumakey.xml
#: rc.cpp:1344
#, kde-format
msgid ""
"This filter modifies the<br>\n"
"   alpha channel as a function of the image's luma value. This is used "
"together with a compositor to combine two images so that bright or dark "
"areas of source image are overwritten on top of the destination image."
msgstr ""
"Questo filtro modifica il<br>\n"
"   canale alfa dell'immagine come funzione del valore di luma dell'immagine. "
"Viene usato insieme a un compositore per combinare due immagini, in modo che "
"le aree luminose o scure dell'immagine sorgente vengano sovrascritte sopra "
"all'immagine di destinazione."

#. i18n: file: data/effects/lumakey.xml
#: rc.cpp:1348
#, kde-format
msgid ""
"Luma value that defines the<br>\n"
"      center point of transition from prelevel to postlevel opacity value."
msgstr ""
"Valore di luminanza che definisce il<br>\n"
"      punto centrale della transizione dal valore di opacità del livello "
"precedente a quello successivo."

#. i18n: file: data/effects/lumakey.xml
#. i18n: file: data/effects/frei0r/frei0r_keyspillm0pup.xml
#: rc.cpp:1350 rc.cpp:3558
#, kde-format
msgid "Slope"
msgstr "Inclinazione"

#. i18n: file: data/effects/lumakey.xml
#: rc.cpp:1352
#, kde-format
msgid ""
"This defines the width of the<br>\n"
"      transition from prelevel to postlevel luma value. Start point of "
"transition in opacity value is threshold - slope and end point is thresholt "
"+ slope, values are forced in range 0 - 255."
msgstr ""
"Definisce la larghezza della<br>\n"
"      transizione dal valore di luminanza del livello precedente a quello "
"successivo. Il punto iniziale della transizione nel valore di opacità è "
"soglia - pendenza e il punto finale è soglia + pendenza, i valori sono "
"forzati nell'intervallo 0 - 255."

#. i18n: file: data/effects/lumakey.xml
#: rc.cpp:1354
#, kde-format
msgid "Pre-Threshold Luma Level"
msgstr "Livello di luma pre-soglia"

#. i18n: file: data/effects/lumakey.xml
#: rc.cpp:1356
#, kde-format
msgid ""
"Opacity value before the<br>\n"
"      transition in opacity value begins."
msgstr ""
"Valore di opacità all'inizio della<br>\n"
"       transizione del valore di opacità."

#. i18n: file: data/effects/lumakey.xml
#: rc.cpp:1358
#, kde-format
msgid "Post-Threshold Luma Level"
msgstr "Livello di luma post-soglia"

#. i18n: file: data/effects/lumakey.xml
#: rc.cpp:1360
#, kde-format
msgid ""
"Opacity value after the<br>\n"
"      transition in opacity value ends."
msgstr ""
"Valore di opacità al termine della<br>\n"
"      transizione del valore di opacità."

#. i18n: file: data/effects/lumaliftgaingamma.xml
