#: rc.cpp:7700
#, kde-format
msgid "Controls degree of smoothing of the crossover point"
msgstr "Controlla il grado di attenuazione del punto di crossover"

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7704
#, kde-format
msgid "Aliasing"
msgstr "Aliasing"

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7706
#, kde-format
msgid ""
"Aliasing (LADSPA 1407)<br>\n"
"   Simulates aliasing using nyquist frequency modulation. Produces wacky "
"results if the blocks aren't even numbers of samples long."
msgstr ""
"Aliasing (LADSPA 1407)<br>\n"
"   Simula l'aliasing usando la modulazione della frequenza di Nyquist. "
"Produce risultati bizzarri se i blocchi non hanno una lunghezza pari in "
"campioni."

