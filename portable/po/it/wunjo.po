#: rc.cpp:7478 rc.cpp:7500 rc.cpp:7512 rc.cpp:7616 rc.cpp:7634 rc.cpp:7870
#: rc.cpp:8636
#, kde-format
msgid "Feedback"
msgstr "Feedback"

#. i18n: file: data/effects/ladspa/ladspa_1190.xml
#: rc.cpp:7480
#, kde-format
msgid "Feedback level, increases the distinctive wooshy phaser sound."
msgstr ""
"Livello di feedback, aumenta il caratteristico suono sibilante del phaser."

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7486
#, kde-format
msgid ""
"Flanger (LADSPA 1191)<br>\n"
"   A digital flanger implementation. Uses a novel zero excursion, controlled "
"bandwidth modulation function, which should make the modulation less "
"repetitive and noticeable."
msgstr ""
"Flanger (LADSPA 1191)<br>\n"
"   Un'implementazione digitale del flanger. Usa una nuova funzione di "
"modulazione a escursione zero e larghezza di banda controllata, che dovrebbe "
"rendere la modulazione meno ripetitiva e percepibile."

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7488
#, kde-format
msgid "Delay Base"
msgstr "Base del ritardo"

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7490
#, kde-format
msgid ""
"This is the offset from<br>\n"
"      the input time that the detune delay moves around"
msgstr ""
"Questo è lo scostamento rispetto<br>\n"
"      al tempo di ingresso intorno a cui si muove il ritardo di "
"desintonizzazione"

# Effetto audio
#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7492
#, kde-format
msgid "Max Slowdown"
msgstr "Rallentamento massimo"

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7494
#, kde-format
msgid ""
"This is the maximum<br>\n"
"      delay that will be applied to the delayed signal, relative to the dry "
"signal."
msgstr ""
"Questo è il ritardo<br>\n"
"      massimo che verrà applicato al segnale ritardato, rispetto al segnale "
"non elaborato."

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7496
#, kde-format
msgid "LFO Frequency"
msgstr "Frequenza LFO"

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7498
#, kde-format
msgid ""
"This is the core frequency<br>\n"
"      that the 'LFO' will move at. The LFO isn't actually an oscillator, but "
"it does vary periodically."
msgstr ""
"Questa è la frequenza di base<br>\n"
"      a cui si muoverà l'LFO. L'LFO non è in realtà un oscillatore, ma varia "
"periodicamente."

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7502
#, kde-format
msgid ""
"Feedback applied from the<br>\n"
"      output to the input, increases the depth of the effect, but makes it "
"sound less like a real flanger."
msgstr ""
"Feedback applicato dall'<br>\n"
"      uscita all'ingresso, aumenta la profondità dell'effetto, ma lo fa "
"sembrare meno simile a un vero flanger."

#. i18n: file: data/effects/ladspa/ladspa_1192.xml
#: rc.cpp:7506
#, kde-format
msgid "Fractionally Addressed Delay Line"
msgstr "Linea di ritardo a indirizzamento frazionario"

#. i18n: file: data/effects/ladspa/ladspa_1192.xml
#: rc.cpp:7508
#, kde-format
msgid ""
"Fractionally Addressed Delay Line (LADSPA 1192)<br>\n"
"   Automatically adapts to the number of channels and sampling rate of the "
"consumer."
msgstr ""
"Linea di ritardo a indirizzamento frazionario (LADSPA 1192)<br>\n"
"   Si adatta automaticamente al numero di canali e alla frequenza di "
"campionamento del consumatore."

#. i18n: file: data/effects/ladspa/ladspa_1195.xml
#. i18n: file: data/effects/ladspa/ladspa_declipper.xml
#: rc.cpp:7516 rc.cpp:8560
#, kde-format
msgid "Declipper"
msgstr "Declipper"

#. i18n: file: data/effects/ladspa/ladspa_1195.xml
#: rc.cpp:7518
#, kde-format
msgid ""
"Declipper (LADSPA 1195)<br>\n"
"   Removes nasty clicks from input signals, not very kind to them though."
msgstr ""
"Declipper (LADSPA 1195)<br>\n"
"   Rimuove i fastidiosi clic dai segnali in ingresso, anche se non con molta "
"delicatezza."

#. i18n: file: data/effects/ladspa/ladspa_1196.xml
#: rc.cpp:7522
#, kde-format
msgid "Fast Overdrive"
msgstr "Overdrive veloce"

#. i18n: file: data/effects/ladspa/ladspa_1196.xml
#: rc.cpp:7524
#, kde-format
msgid ""
"Fast Overdrive (LADSPA 1196)<br>\n"
"   A simple overdrive. Compresses the extreme peaks to make a sound similar "
"to an overdriven amplifier."
msgstr ""
"Overdrive veloce (LADSPA 1196)<br>\n"
"   Un semplice overdrive. Comprime i picchi estremi per ottenere un suono "
"simile a quello di un amplificatore in overdrive."

#. i18n: file: data/effects/ladspa/ladspa_1196.xml
#: rc.cpp:7526
#, kde-format
msgid "Drive Level"
msgstr "Livello di drive"

#. i18n: file: data/effects/ladspa/ladspa_1196.xml
#: rc.cpp:7528
#, kde-format
msgid ""
"Controls the point at<br>\n"
"      which the signal starts to distort, and the degree of distortion."
msgstr ""
"Controlla il punto in<br>\n"
"      cui il segnale inizia a distorcere e il grado di distorsione."

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7532
#, kde-format
msgid "Decimator"
msgstr "Decimatore"

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7534
#, kde-format
msgid ""
"Decimator (LADSPA 1202)<br>\n"
"   Decimates (reduces the effective sample rate), and reduces the bit depth "
"of the input signal, allows non integer values for smooth transitions "
"between clean and lo-fi signals."
msgstr ""
"Decimatore (LADSPA 1202)<br>\n"
"   Decima (riduce la frequenza di campionamento effettiva) e riduce la "
"profondità di bit del segnale in ingresso, consente valori non interi per "
"transizioni morbide tra segnali puliti e lo-fi."

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7536
#, kde-format
msgid "Bit Depth"
msgstr "Profondità di bit"

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7538
#, kde-format
msgid "The bit depth that the signal will be reduced to"
msgstr "La profondità di bit a cui verrà ridotto il segnale"

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7540
#, kde-format
msgid "Sample Rate"
msgstr "Frequenza di campionamento"

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7542
#, kde-format
msgid "The sample rate that the signal will be resampled at"
msgstr "La frequenza di campionamento a cui verrà ricampionato il segnale"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7546
#, kde-format
msgid "Single Band Parametric"
msgstr "Parametrico a banda singola"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7548
#, kde-format
msgid ""
"Single Band Parametric (LADSPA 1203)<br>\n"
"   A single band of a parametric filter."
msgstr ""
"Parametrico a banda singola (LADSPA 1203)<br>\n"
"   Una singola banda di un filtro parametrico."

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7550
#, kde-format
msgid "Gain (dB)"
msgstr "Guadagno (dB)"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7552
#, kde-format
msgid "The attenuation/gain of the eq"
msgstr "L'attenuazione/guadagno dell'equalizzatore"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7554
#, kde-format
msgid "Frequency (Hz)"
msgstr "Frequenza (Hz)"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7556
#, kde-format
msgid ""
"The centre frequency (i.e. point of<br>\n"
"      most/least attenuation). Beware of high values for <i>Frequency</i> "
"and <i>Bandwidth</i>: if the high pitch (<i>Frequency</i> * 2^<i>Bandwidth</"
"i>) goes over half the sample rate, you will get aliasing."
msgstr ""
"La frequenza centrale (cioè il punto di<br>\n"
"      massima/minima attenuazione). Attenzione ai valori alti per "
"<i>Frequenza</i> e <i>Larghezza di banda</i>: se il tono alto (<i>Frequenza</"
"i> * 2^<i>Larghezza di banda</i>) supera la metà della frequenza di "
"campionamento, si otterrà aliasing."

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7558
#, kde-format
msgid "Bandwidth (octaves)"
msgstr "Larghezza di banda (ottave)"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7560
#, kde-format
msgid ""
"The pitch difference from the<br>\n"
"      centre before the attenuation has reached half the <i>Gain</i>."
msgstr ""
"La differenza di tono dal<br>\n"
"      centro prima che l'attenuazione abbia raggiunto metà del <i>Guadagno</"
"i>."

#. i18n: file: data/effects/ladspa/ladspa_1207.xml
#: rc.cpp:7564
#, kde-format
msgid "DC Offset Remover"
msgstr "Rimozione scostamento DC"

#. i18n: file: data/effects/ladspa/ladspa_1207.xml
#: rc.cpp:7566
#, kde-format
msgid ""
"DC Offset Remover (LADSPA 1207)<br>\n"
"   Simply removes the DC (0 Hz) component from an audio signal, uses a high "
"pass filter, so has some side effects, but they should be minimal."
msgstr ""
"Rimozione scostamento DC (LADSPA 1207)<br>\n"
"   Rimuove semplicemente la componente DC (0 Hz) da un segnale audio, usa un "
"filtro passa-alto, quindi ha alcuni effetti collaterali, che dovrebbero "
"comunque essere minimi."

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#: rc.cpp:7570
#, kde-format
msgid "Foldover Distortion"
msgstr "Distorsione foldover"

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#: rc.cpp:7572
#, kde-format
msgid ""
"Foldover Distortion (LADSPA 1213)<br>\n"
"   Uses a sine wave approximation to simulate valve style foldover "
"distortion. Probably should have a <i>DC Offset Remover</i> on the output, "
"but it's not always necessary."
msgstr ""
"Distorsione foldover (LADSPA 1213)<br>\n"
"   Usa un'approssimazione a onda sinusoidale per simulare una distorsione "
"foldover in stile valvolare. Probabilmente dovrebbe avere un <i>Rimozione "
"scostamento DC</i> in uscita, ma non è sempre necessario."

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:7574 rc.cpp:8516
#, kde-format
msgid "Drive"
msgstr "Unità"

