#. i18n: file: data/effects/ladspa/ladspa_1890.xml
#: rc.cpp:7932
#, kde-format
msgid "GLAME Highpass"
msgstr "Passa-alto GLAME"

#. i18n: file: data/effects/ladspa/ladspa_1890.xml
#: rc.cpp:7934
#, kde-format
msgid ""
"GLAME Highpass Filter (LADSPA 1890)<br>\n"
"   IIR highpass filter based using Chebishev coefficients. The filter allows "
"you to tweak the number of stages used for filtering. Every stage adds two "
"more poles, which leads to a steeper dropoff."
msgstr ""
"Filtro passa-alto GLAME (LADSPA 1890)<br>\n"
"   Filtro passa-alto IIR basato sui coefficienti di Chebyshev. Il filtro "
"consente di regolare il numero di stadi usati per il filtraggio. Ogni stadio "
"aggiunge altri due poli, il che porta a un'attenuazione più ripida."

