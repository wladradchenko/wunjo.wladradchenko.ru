#: rc.cpp:8408 rc.cpp:8432
#, kde-format
msgid "Dynamics Transfer Function"
msgstr "Funzione di trasferimento dinamica"

#. i18n: file: data/effects/ladspa/ladspa_2152.xml
#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8410 rc.cpp:8434
#, kde-format
msgid ""
"2:1 comp at -6dB,2:1 comp at -9dB,2:1 comp at -12dB,2:1 comp at -18dB,2.5 "
"comp at -18dB,3:1 comp at -12dB,3:1 comp at -15dB,Compressor/Gate,Expander,"
"Hard limiter at -6dB;Hard limiter at -12dB;Hard gate at -35dB;Soft limiter;"
"Soft knee comp/gate;Softgate below -36dB"
msgstr ""
"Comp. 2:1 a -6dB,Comp. 2:1 a -9dB,Comp. 2:1 a -12dB,Comp. 2:1 a -18dB,Comp. "
"2.5 a -18dB,Comp. 3:1 a -12dB,Comp. 3:1 a -15dB,Compressore/Gate,Espansore,"
"Limitatore rigido a -6dB;Limitatore rigido a -12dB;Gate rigido a -35dB;"
"Limitatore morbido;Comp./gate a ginocchio morbido;Gate morbido sotto -36dB"

#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8414
#, kde-format
msgid "TAP Dynamics (St)"
msgstr "Dinamica TAP (St)"

#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8416
#, kde-format
msgid ""
"TAP Dynamics Stereo (LADSPA 2153)<br>\n"
"   Allows changing the dynamic content of the audio stream"
msgstr ""
"Stereo dinamica TAP (LADSPA 2153)<br>\n"
"   Permette di modificare il contenuto dinamico del flusso audio"

#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8428
#, kde-format
msgid ""
"Controls how the envelope levels<br>\n"
"      are used to determine the needed gain adjustment"
msgstr ""
"Controlla come vengono usati i livelli<br>\n"
"      dell'inviluppo per determinare la regolazione del guadagno necessaria"

#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8430
#, kde-format
msgid "Independent,Average,Peak"
msgstr "Indipendente,Medio,Picco"

#. i18n: file: data/effects/ladspa/ladspa_2154.xml
#: rc.cpp:8438
#, kde-format
msgid "TAP Reflector"
msgstr "Riflettore TAP"

#. i18n: file: data/effects/ladspa/ladspa_2154.xml
#: rc.cpp:8440
#, kde-format
msgid ""
"TAP Reflector (LADSPA 2154)<br>\n"
"    Creates a psychedelic reverse audio effect."
msgstr ""
"Riflettore TAP (LADSPA 2154)<br>\n"
"    Crea un effetto audio psichedelico al contrario."

#. i18n: file: data/effects/ladspa/ladspa_2154.xml
#: rc.cpp:8442
#, kde-format
msgid "Fragment Length"
msgstr "Lunghezza del frammento"

#. i18n: file: data/effects/ladspa/ladspa_2154.xml
#: rc.cpp:8444
#, kde-format
msgid ""
"It is best to set it to<br>\n"
"      approximately match the tempo of the track, so the Fragment Length is "
"equal to the time of one measure."
msgstr ""
"È meglio impostarlo in modo<br>\n"
"      che corrisponda all'incirca al tempo del brano, così che la lunghezza "
"del frammento sia uguale alla durata di una battuta."

#. i18n: file: data/effects/ladspa/ladspa_2155.xml
#: rc.cpp:8452
#, kde-format
msgid "TAP Pink/Fractal Noise"
msgstr "Rumore rosa/frattale TAP"

#. i18n: file: data/effects/ladspa/ladspa_2155.xml
#: rc.cpp:8454
#, kde-format
msgid ""
"TAP Pink/Fractal Noise (LADSPA 2155)<br>\n"
"    Adds pink noise to the incoming signal using a one-dimensional random "
"fractal line generated by the Midpoint Displacement Method."
msgstr ""
"Rumore rosa/frattale TAP (LADSPA 2155)<br>\n"
"    Aggiunge rumore rosa al segnale in ingresso usando una linea frattale "
"casuale monodimensionale generata con il metodo dello spostamento del punto "
"medio."

#. i18n: file: data/effects/ladspa/ladspa_2155.xml
#: rc.cpp:8456
#, kde-format
msgid "Fractal Dimension"
msgstr "Dimensione frattale"

#. i18n: file: data/effects/ladspa/ladspa_2155.xml
#: rc.cpp:8458
#, kde-format
msgid "Signal Level"
msgstr "Livello del segnale"

#. i18n: file: data/effects/ladspa/ladspa_2155.xml
#: rc.cpp:8460
#, kde-format
msgid "Noise Level"
msgstr "Livello del rumore"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8464
#, kde-format
msgid "TAP Fractal Doubler"
msgstr "Raddoppiatore frattale TAP"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8466
#, kde-format
msgid ""
"TAP Fractal Doubler (LADSPA 2156)<br>\n"
"    Suitable for doubling tracks with vocals, acoustic/electric guitars, "
"bass and just about any other instrument on them."
msgstr ""
"Raddoppiatore frattale TAP (LADSPA 2156)<br>\n"
"    Ideale per registrare in doppia traccia voci, chitarre acustiche o "
"elettriche, basso, e praticamente qualsiasi altro strumento."

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8468
#, kde-format
msgid "Time Tracking"
msgstr "Tracciamento del tempo"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8470 rc.cpp:8474
#, kde-format
msgid ""
"Determines how \"rough\" and how big<br>\n"
"      these changes are. When set to 0, changes are bigger and more chaotic "
"(\"bad backup singer\"). When set to 1, changes are smaller and smoother "
"(\"better tracking of the original\")."
msgstr ""
"Determina quanto \"ruvide\" e quanto grandi<br>\n"
"      sono queste variazioni. Se impostato a 0, le variazioni sono più "
"grandi e caotiche (\"cattivo corista\"). Se impostato a 1, le variazioni "
"sono più piccole e morbide (\"migliore aderenza all'originale\")."

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8472
#, kde-format
msgid "Pitch Tracking"
msgstr "Aderenza della tonalità"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8478
#, kde-format
msgid "Dry Left Position"
msgstr "Posizione sinistra dry"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8480 rc.cpp:8484 rc.cpp:8490 rc.cpp:8494
#, kde-format
msgid ""
"These controls range between 0 and 1,<br>\n"
"      0 meaning hard left and 1 meaning hard right position."
msgstr ""
"Controllano l'intervallo tra 0 e 1:<br>\n"
"      0 significa posizione estrema a sinistra, mentre 1 significa posizione "
"estrema a destra."

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8482
#, kde-format
msgid "Dry Right Position"
msgstr "Posizione destra dry"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8488
#, kde-format
msgid "Wet Left Position"
msgstr "Posizione sinistra wet"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8492
#, kde-format
msgid "Wet Right Position"
msgstr "Posizione destra wet"

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8498
#, kde-format
msgid "TAP Sigmoid Booster"
msgstr "Amplificatore sigmoide TAP"

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8500
#, kde-format
msgid ""
"TAP Sigmoid Booster (LADSPA 2157)<br>\n"
"   Applies a time-invariant nonlinear amplitude transfer function to the "
"signal."
msgstr ""
"Amplificatore sigmoide TAP (LADSPA 2157)<br>\n"
"   Applica al segnale una funzione di trasferimento dell'ampiezza non "
"lineare e invariante nel tempo."

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8502
#, kde-format
msgid "Pre Gain"
msgstr "Guadagno pre"

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8504
#, kde-format
msgid "Scales the input signal before the transfer function is applied to it."
msgstr ""
"Ridimensiona il segnale di ingresso prima che venga applicata la funzione di "
"trasferimento."

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8506
#, kde-format
msgid "Post Gain"
msgstr "Guadagno post"

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8508
#, kde-format
msgid "Can be used to adjust the output gain of the effect."
msgstr "Può essere utilizzato per regolare il guadagno in uscita dell'effetto."

#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:8512
#, kde-format
msgid "TAP TubeWarmth"
msgstr "TubeWarmth TAP"

#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:8514
#, kde-format
msgid ""
"TAP TubeWarmth (LADSPA 2158)<br>\n"
"   Adds the character of vacuum tube amplification by emulating the "
"sonically desirable nonlinear characteristics of triodes. It also supports "
"emulating analog tape saturation."
msgstr ""
"TubeWarmth TAP (LADSPA 2158)<br>\n"
"   Aggiunge il carattere dell'amplificazione a valvole emulando le "
"caratteristiche non lineari, sonoramente desiderabili, dei triodi. Supporta "
"anche l'emulazione della saturazione del nastro analogico."

#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:8518
#, kde-format
msgid "Adjusts the amount of the effect"
msgstr "Regola la quantità dell'effetto"

#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:8520
#, kde-format
msgid "Tape--Tube Blend"
msgstr "Fusione nastro--valvola"

#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:8522
#, kde-format
msgid "Controls the color of the TubeWarmth sound"
msgstr "Controlla il colore del suono TubeWarmth"

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8526
#, kde-format
msgid "TAP Chorus/Flange"
msgstr "Chorus/Flange TAP"

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8528
#, kde-format
msgid ""
"TAP Chorus/Flange (LADSPA 2159)<br>\n"
"    Creates traditional Chorus and Flanger effects, spiced up a bit to make "
"use of stereo processing. It sounds best on guitar and synth tracks."
msgstr ""
"Chorus/Flange TAP (LADSPA 2159)<br>\n"
"    Crea i tradizionali effetti Chorus e Flanger, un po' arricchiti per "
"sfruttare l'elaborazione stereo. Suona meglio su tracce di chitarra e "
"sintetizzatore."

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8532
#, kde-format
msgid ""
"Determines the LFO frequency<br>\n"
"      with which the time-varying delay is modulated. The higher the "
"frequency, the more intense the effect will be."
msgstr ""
"Determina la frequenza dell'LFO<br>\n"
"      con cui viene modulato il ritardo variabile nel tempo. Più alta è la "
"frequenza, più intenso sarà l'effetto."

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8534
#, kde-format
msgid "L/R Phase Shift"
msgstr "Sfasamento D/S"

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8536
#, kde-format
msgid ""
"Controls the phase shift between the two<br>\n"
"      LFOs. The higher this setting, the stronger the \"stereo-ness\" of the "
"effect will be. When set to 0, processing of the two channels will be in-"
"phase; when set to 180 degrees, the two LFO's are is counter-phase to create "
"the widest stereo effect."
msgstr ""
"Controlla lo spostamento di fase tra i due<br>\n"
"      LFO. Più alto è questo valore, più forte sarà l'effetto \"stereo\". Se "
"impostato a 0, l'elaborazione dei due canali sarà in fase; se impostato a "
"180 gradi, i due LFO sono in controfase per creare l'effetto stereo più "
"ampio."

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8540
#, kde-format
msgid ""
"Adjusts the modulation depth of the delay.<br>\n"
"      Increasing it will result in stronger modulation using the same LFO "
"frequency."
msgstr ""
"Regola la profondità di modulazione del ritardo.<br>\n"
"      Aumentandolo si otterrà una modulazione più forte utilizzando la "
"stessa frequenza LFO."

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8544
#, kde-format
msgid ""
"Determines the fixed amount of time with<br>\n"
"      which the signal is delayed after the time-varying delay has been "
"applied. The setting of this control distinguishes between the Chorus and "
"Flanger effects. Delays smaller than 10 ms can be labeled Flanger, delays "
"above 20 ms yield Chorus, and delays in the range of 10-20 ms result in a "
"blend between Chorus and Flanger."
msgstr ""
"Determina la quantità fissa di tempo di<br>\n"
"      cui il segnale viene ritardato dopo l'applicazione del ritardo "
"variabile nel tempo. L'impostazione di questo controllo distingue tra gli "
"effetti Chorus e Flanger. I ritardi inferiori a 10 ms possono essere "
"considerati Flanger, i ritardi superiori a 20 ms producono Chorus e i "
"ritardi nell'intervallo 10-20 ms producono una fusione tra Chorus e Flanger."

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8546
#, kde-format
msgid "Contour"
msgstr "Contorno"

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8548
#, kde-format
msgid ""
"The cutoff frequency of a high-pass<br>\n"
"      filter applied to the now twice-delayed signal."
msgstr ""
"La frequenza di taglio di un filtro<br>\n"
"      passa-alto applicato al segnale ora ritardato due volte."

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8552 rc.cpp:8556
#, kde-format
msgid ""
"Allows for a final tuning of the sound.<br>\n"
"      The strongest effect is achieved if the two settings are about the "
"same. Decreasing one of them (preferably the Wet Level, to mitigate any "
"unwanted side effects) results in a subtler effect."
msgstr ""
"Consente una regolazione finale del suono.<br>\n"
"      L'effetto più forte si ottiene se le due impostazioni sono circa "
"uguali. Diminuendone una (preferibilmente il livello wet, per attenuare "
"eventuali effetti collaterali indesiderati) si ottiene un effetto più "
"sottile."

#. i18n: file: data/effects/ladspa/ladspa_declipper.xml
