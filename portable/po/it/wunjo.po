#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8214
#, kde-format
msgid ""
"TAP Stereo Echo (LADSPA 2143)<br>\n"
"   Supports conventional mono and stereo delays, ping-pong delays and the "
"Haas effect (also known as Cross Delay Stereo)."
msgstr ""
"Eco stereo TAP (LADSPA 2143)<br>\n"
"   Supporta i ritardi convenzionali mono e stereo, i ritardi ping-pong e "
"l'effetto Haas (noto anche come Cross Delay Stereo)."

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8216
