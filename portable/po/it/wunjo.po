#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7692
#, kde-format
msgid ""
"Crossover Distortion (LADSPA 1404)<br>\n"
"   This is a simulation of the distortion that happens in class B and AB "
"power amps when the signal crosses 0."
msgstr ""
"Distorsione di crossover (LADSPA 1404)<br>\n"
"   È una simulazione della distorsione che si verifica negli amplificatori "
"di potenza di classe B e AB quando il segnale attraversa lo 0."

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7694
#, kde-format
msgid "Crossover Amplitude"
msgstr "Ampiezza di crossover"

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7696
#, kde-format
msgid "Controls the point at which the output signal becomes linear"
msgstr "Controlla il punto in cui il segnale in uscita diventa lineare"

