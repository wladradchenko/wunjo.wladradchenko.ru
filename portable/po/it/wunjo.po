msgstr "Livello di aliasing"

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7710
#, kde-format
msgid "Controls the amount of simulated aliasing in the output."
msgstr "Controlla la quantità di aliasing simulato nell'uscita."

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7714
#, kde-format
msgid "Barry's Satan Maximiser"
msgstr "Barry's Satan Maximiser"

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7716
#, kde-format
msgid ""
"Barry's Satan Maximiser (LADSPA 1408)<br>\n"
"   Compresses signals with a stupidly short attack and decay, infinite ratio "
"and hard knee. Not really as a compressor, but good harsh (non-musical) "
"distortion."
msgstr ""
"Barry's Satan Maximiser (LADSPA 1408)<br>\n"
"   Comprime i segnali con attacco e decadimento esageratamente brevi, "
"rapporto infinito e ginocchio rigido. Non è davvero un compressore, ma una "
"buona distorsione aspra (non musicale)."

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7718
#, kde-format
msgid "Decay Time (samples)"
msgstr "Tempo di decadimento (campioni)"

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7720
#, kde-format
msgid "Controls the envelope decay time."
msgstr "Controlla il tempo di decadimento dell'inviluppo."

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7722
#, kde-format
msgid "Knee Point"
msgstr "Punto di ginocchio"

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7724
#, kde-format
msgid ""
"Controls the knee roll-off point,<br>\n"
"      ie. the point above which the compression kicks in. 0 will have no "
"effect, -90 will remove virtually all dynamic range."
msgstr ""
"Controlla il punto di attenuazione del ginocchio,<br>\n"
"      cioè il punto sopra il quale interviene la compressione. 0 non avrà "
"effetto, -90 rimuoverà praticamente tutta la gamma dinamica."

