#. i18n: file: data/effects/ladspa/ladspa_2144.xml
#: rc.cpp:8238
#, kde-format
msgid "TAP Tremolo"
msgstr "Tremolo TAP"

#. i18n: file: data/effects/ladspa/ladspa_2144.xml
#: rc.cpp:8240
#, kde-format
msgid ""
"TAP Tremolo (LADSPA 2144)<br>\n"
"   Sounds good mainly on acoustic or electric guitar tracks."
msgstr ""
"Tremolo TAP (LADSPA 2144)<br>\n"
"   Suona bene soprattutto su tracce di chitarra acustica o elettrica."

#. i18n: file: data/effects/ladspa/ladspa_2145.xml
#: rc.cpp:8250
#, kde-format
msgid "TAP Scaling Limiter"
msgstr "Limitatore a scalatura TAP"

#. i18n: file: data/effects/ladspa/ladspa_2145.xml
#: rc.cpp:8252
#, kde-format
msgid ""
"TAP Scaling Limiter (LADSPA 2145)<br>\n"
"   Achieves signal level limiting without audible artifacts."
msgstr ""
"Limitatore a scalatura TAP (LADSPA 2145)<br>\n"
"   Ottiene la limitazione del livello del segnale senza artefatti udibili."

#. i18n: file: data/effects/ladspa/ladspa_2145.xml
#: rc.cpp:8254
#, kde-format
msgid "Limit Level"
msgstr "Limita livello"

#. i18n: file: data/effects/ladspa/ladspa_2145.xml
#: rc.cpp:8256
#, kde-format
msgid "Output Volume"
msgstr "Volume di uscita"

#. i18n: file: data/effects/ladspa/ladspa_2146.xml
#: rc.cpp:8260
#, kde-format
msgid "TAP AutoPanner"
msgstr "AutoPanner TAP"

#. i18n: file: data/effects/ladspa/ladspa_2146.xml
#: rc.cpp:8262
#, kde-format
msgid ""
"TAP AutoPanner (LADSPA 2146)<br>\n"
"   Main use is to liven up synth tracks in the mix"
msgstr ""
"AutoPanner TAP (LADSPA 2146)<br>\n"
"   L'uso principale è ravvivare le tracce di sintetizzatore nel missaggio"

#. i18n: file: data/effects/ladspa/ladspa_2146.xml
#: rc.cpp:8268
#, kde-format
msgid ""
"Sets the wideness of panning.<br>\n"
"      A setting of 100% means that mono input signal is panned between the "
"extreme left and right positions"
msgstr ""
"Imposta l'ampiezza della panoramica.<br>\n"
"      Un valore del 100% significa che il segnale mono in ingresso viene "
"spostato tra le posizioni estreme sinistra e destra"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8274
#, kde-format
msgid "TAP DeEsser"
msgstr "DeEsser TAP"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8276
#, kde-format
msgid ""
"TAP DeEsser (LADSPA 2147)<br>\n"
"   Used for attenuating higher pitched frequencies in vocals such as those "
"found in 'ess', 'shh' and 'chh' sounds."
msgstr ""
"DeEsser TAP (LADSPA 2147)<br>\n"
"   Usato per attenuare le frequenze più acute nelle voci, come quelle dei "
"suoni 'ess', 'shh' e 'chh'."

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8278
#, kde-format
msgid "Threshold Level"
msgstr "Livello di soglia"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8282
#, kde-format
msgid "Sidechain Filter"
msgstr "Filtro sidechain"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8284
#, kde-format
msgid ""
"The chosen filter's frequency<br>\n"
"      is set by the <b>Frequency</b> parameter"
msgstr ""
"La frequenza scelta del filtro<br>\n"
"      viene impostata dal parametro <b>Frequenza</b>"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8286
#, kde-format
msgid "Highpass,Bandpass"
msgstr "Passa alto,Passa banda"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8288
#, kde-format
msgid "Monitor On"
msgstr "Controllo attivo"

#. i18n: file: data/effects/ladspa/ladspa_2148.xml
#: rc.cpp:8292
#, kde-format
msgid "TAP Vibrato"
msgstr "Vibrato TAP"

#. i18n: file: data/effects/ladspa/ladspa_2148.xml
#: rc.cpp:8294
#, kde-format
msgid ""
"TAP Vibrato (LADSPA 2148)<br>\n"
"   Modulates the pitch of its input signal with a low-frequency sinusoidal "
"signal. It is useful for guitar and synth tracks, and it can also come handy "
"if a strange effect is needed."
msgstr ""
"Vibrato TAP (LADSPA 2148)<br>\n"
"   Modula la tonalità del segnale in ingresso con un segnale sinusoidale a "
"bassa frequenza. È utile per tracce di chitarra e sintetizzatore e può "
"tornare utile anche quando serve un effetto strano."

#. i18n: file: data/effects/ladspa/ladspa_2148.xml
#: rc.cpp:8298
#, kde-format
msgid "Determines how fast the pitch is modulated up-down"
msgstr ""
"Determina la velocità con cui l'intonazione viene modulata verso l'alto e "
"verso il basso."

#. i18n: file: data/effects/ladspa/ladspa_2148.xml
#: rc.cpp:8302
#, kde-format
msgid "Sets the amount of pitch modulation"
msgstr "Imposta la quantità di modulazione dell'intonazione"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8310
#, kde-format
msgid "TAP Rotary Speaker"
msgstr "Altoparlante rotante TAP"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8312
#, kde-format
msgid ""
"TAP Rotary Speaker (LADSPA 2149)<br>\n"
"   Simulates the sound of rotating speakers."
msgstr ""
"Altoparlante rotante TAP (LADSPA 2149)<br>\n"
"   Simula il suono di altoparlanti TAP."

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8314
#, kde-format
msgid "Rotor Frequency"
msgstr "Frequenza del rotore"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8316
#, kde-format
msgid "Horn Frequency"
msgstr "Frequenza di Horn"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8318
#, kde-format
msgid "Mic Distance"
