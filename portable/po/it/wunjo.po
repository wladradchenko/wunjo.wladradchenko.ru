msgid "TAP Reverberator"
msgstr "Riverbero TAP"

#. i18n: file: data/effects/ladspa/ladspa_2142.xml
#: rc.cpp:8188
#, kde-format
msgid ""
"TAP Reverberator (LADSPA 2142)<br>\n"
"   Versatile reverb filter based on the comb/allpass filter model. For "
"recommended decay times for reverb types refer to the effect documentation "
"linked below."
msgstr ""
"Riverberatore TAP (LADSPA 2142)<br>\n"
"   Filtro di riverbero versatile basato sul modello di filtro a pettine/"
"passa tutto. Per i tempi di decadimento consigliati per i diversi tipi di "
"riverbero, consulta la documentazione sull'effetto disponibile al "
"collegamento sottostante."

