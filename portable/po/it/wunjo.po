#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:6944 rc.cpp:7186
#, kde-format
msgid "Luma strength"
msgstr "Forza luma"

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6946
#, kde-format
msgid ""
"Set the luma strength.<br>\n"
"            The value configures the blurring. A positive value will blur "
"the image, whereas a negative value will sharpen the image."
msgstr ""
"Imposta la forza della luma.<br>\n"
"            Il valore configura la sfocatura. Se è positivo l'immagine verrà "
"sfocata, se è invece negativo la nitidezza dell'immagine verrà aumentata."

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6948
#, kde-format
msgid "Luma threshold"
msgstr "Soglia luma"

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6950
#, kde-format
msgid ""
"Set the luma threshold used as a coefficient<br>\n"
"            to determine whether a pixel should be blurred or not. A value "
"of 0 will filter all the image, positive values will filter flat areas, "
"negative values will filter edges."
msgstr ""
"Imposta la soglia di luma usata come coefficiente<br>\n"
"            per determinare se un pixel verrà sfocato o no. Un valore di 0 "
"filtrerà tutta l'immagine, uno positivo solo le aree piatte, mentre uno "
"negativo filtrerà solo i bordi."

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6952
#, kde-format
msgid "Chroma radius"
msgstr "Raggio cromatico"

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6954
#, kde-format
msgid ""
"Set the chroma radius.<br>\n"
"            The value specifies the variance of the gaussian filter used to "
"blur the image (slower if larger). If not specified, it defaults to the "
"value set for <em>Luma radius</em>"
msgstr ""
"Imposta il raggio cromatico.<br>\n"
"            Il valore specifica la varianza del filtro gaussiano utilizzato "
"per sfocare l'immagine (più lento se più grande). Se non specificato, il "
"valore predefinito è quello impostato per <em>Raggio Luma</em>."

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:6956 rc.cpp:7198
#, kde-format
msgid "Chroma strength"
msgstr "Forza cromatica"

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6958
#, kde-format
