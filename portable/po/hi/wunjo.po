#. i18n: file: data/effects/audiospectrum.xml
#: rc.cpp:578
#, kde-format
msgid "Draw the points starting with the highest frequency first."
msgstr "सबसे पहले उच्चतम आवृत्ति से शुरू करते हुए बिंदु बनाएं।"

#. i18n: file: data/effects/audiospectrum.xml
#: rc.cpp:580
#, kde-format
msgid "Line Tension"
msgstr "लाइन तनाव"

#. i18n: file: data/effects/audiospectrum.xml
#: rc.cpp:582
#, kde-format
msgid ""
"Affects the amount of curve in the line interpolating between points. 0.0 = "
"a straight line between points. 100 = very curved lines between points. "
"Values < 0 and > 100 will cause loops in the lines. Only applies to line "
"graph type."
msgstr ""
"बिंदुओं के बीच इंटरपोलेशन करने वाली रेखा में वक्रता की मात्रा को प्रभावित करता है। 0.0 = "
"बिंदुओं के बीच एक सीधी रेखा। 100 = बिंदुओं के बीच बहुत घुमावदार रेखाएँ। मान < 0 और > 100 "
"रेखाओं में लूप का कारण बनेंगे। केवल लाइन ग्राफ़ प्रकार पर लागू होता है।"

#. i18n: file: data/effects/audiospectrum.xml
#: rc.cpp:584
