msgid "2x BR,3x BR,4x BR"
msgstr "2x BR,3x BR,4x BR"

#. i18n: file: data/effects/avfilter/avfilter_yadif.xml
#: rc.cpp:7426
#, kde-format
msgid "Yadif Deinterlacer"
msgstr "Usuwanie przeplotu Yadif"

#. i18n: file: data/effects/avfilter/avfilter_yadif.xml
#: rc.cpp:7428
#, kde-format
msgid ""
"Deinterlace the input video (\"yadif\" means \"yet another deinterlacing "
"filter\")"
msgstr ""
"Usuń przeplot z obrazu wejściowego (\"yadif\" oznacza \"yet another "
"deinterlacing filter\")"

#. i18n: file: data/effects/avfilter/avfilter_yadif.xml
#: rc.cpp:7432
#, kde-format
msgid "Send frame,Send field,Send frame nospatial,Send field nospatial"
msgstr ""
"Wyślij klatkę,Wyślij pole,Wyślij klatkę nieprzestrzennie,Wyślij pole "
"nieprzestrzennie"

#. i18n: file: data/effects/avfilter/avfilter_yadif.xml
#: rc.cpp:7436
#, kde-format
msgid "Top field first,Bottom field first,Auto"
msgstr "Najpierw górne pole,Najpierw dolne pole,Auto"

#. i18n: file: data/effects/avfilter/avfilter_zoompan.xml
#: rc.cpp:7442
#, kde-format
msgid "Zoom Pan"
msgstr "Powiększ przesunięcie"

#. i18n: file: data/effects/avfilter/avfilter_zoompan.xml
#: rc.cpp:7444
#, kde-format
msgid "Apply Zoom and Pan effect"
msgstr "Zastosuj efekt powiększenia i przesunięcia"

#. i18n: file: data/effects/avfilter/subtitles.xml
#: rc.cpp:7456
#, kde-format
msgid "Render subtitles onto the video"
msgstr "Wpleć napisy na obrazie"

#. i18n: file: data/effects/avfilter/subtitles.xml
#: rc.cpp:7458
#, kde-format
msgid "Subtitle file to apply"
msgstr "Plik napisów do zastosowania"

#. i18n: file: data/effects/ladspa/ladspa_1185.xml
#: rc.cpp:7460
#, kde-format
msgid "Diode Processor"
msgstr "Procesor diodowy"

#. i18n: file: data/effects/ladspa/ladspa_1185.xml
#: rc.cpp:7462
#, kde-format
msgid ""
"Diode Processor (LADSPA 1185)<br>\n"
"   Mangles the signal as if it had been passed through a diode rectifier "
"network. You should probably follow this with a <i>DC Offset Remover</i>, "
"unless you want the offset."
msgstr ""
"Procesor diodowy (LADSPA 1185)<br>\n"
"   Przekształca sygnał tak, jakby przeszedł przez sieć prostownika "
"diodowego. Prawdopodobnie warto potem użyć <i>Usuwania składowej stałej</i>, "
"chyba że przesunięcie jest pożądane."

#. i18n: file: data/effects/ladspa/ladspa_1185.xml
#: rc.cpp:7466
#, kde-format
msgid ""
"The <i>Mode</i> parameter is<br>\n"
"      continuously variable from thru to half-wave (1) rectification to full-"
"wave (2) to silence (0)"
msgstr ""
"Parametr <i>Tryb</i> jest<br>\n"
"      zmienny w sposób ciągły, od przepuszczania przez prostowanie "
"półokresowe (1) i pełnookresowe (2) do ciszy (0)"

