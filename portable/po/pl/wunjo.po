#, kde-format
msgid "Comb Filter"
msgstr "Filtr grzebieniowy"

#. i18n: file: data/effects/ladspa/ladspa_1190.xml
#: rc.cpp:7472
#, kde-format
msgid "Comb Filter (LADSPA 1190)"
msgstr "Filtr grzebieniowy (LADSPA 1190)"

#. i18n: file: data/effects/ladspa/ladspa_1190.xml
#. i18n: file: data/effects/ladspa/ladspa_1411.xml
#: rc.cpp:7474 rc.cpp:7772
#, kde-format
msgid "Band Separation"
msgstr "Rozdzielenie pasm"

#. i18n: file: data/effects/ladspa/ladspa_1190.xml
#: rc.cpp:7476
#, kde-format
msgid "Controls the distance between the filters peaks"
msgstr "Steruje odległością pomiędzy szczytami filtra"

#. i18n: file: data/effects/ladspa/ladspa_1190.xml
#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#. i18n: file: data/effects/ladspa/ladspa_1192.xml
#. i18n: file: data/effects/ladspa/ladspa_1219.xml
#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#. i18n: file: data/effects/ladspa/ladspa_1438.xml
#. i18n: file: data/effects/ladspa/ladspa_phaser.xml
#: rc.cpp:7478 rc.cpp:7500 rc.cpp:7512 rc.cpp:7616 rc.cpp:7634 rc.cpp:7870
#: rc.cpp:8636
#, kde-format
msgid "Feedback"
msgstr "Informacja zwrotna"

#. i18n: file: data/effects/ladspa/ladspa_1190.xml
#: rc.cpp:7480
#, kde-format
msgid "Feedback level, increases the distinctive wooshy phaser sound."
msgstr ""
"Poziom sprzężenia zwrotnego, wzmacnia charakterystyczny szumiący dźwięk "
"fazera."

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7486
#, kde-format
msgid ""
"Flanger (LADSPA 1191)<br>\n"
"   A digital flanger implementation. Uses a novel zero excursion, controlled "
"bandwidth modulation function, which should make the modulation less "
"repetitive and noticeable."
msgstr ""
"Flanger (LADSPA 1191)<br>\n"
"   Cyfrowa implementacja flangera. Używa nowatorskiej funkcji modulacji o "
"zerowym wychyleniu i kontrolowanej szerokości pasma, co powinno sprawić, że "
"modulacja będzie mniej powtarzalna i zauważalna."

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7488
#, kde-format
msgid "Delay Base"
msgstr "Podstawa opóźnienia"

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7490
#, kde-format
msgid ""
"This is the offset from<br>\n"
"      the input time that the detune delay moves around"
msgstr ""
"Jest to przesunięcie względem<br>\n"
"      czasu wejściowego, wokół którego porusza się opóźnienie rozstrojenia"

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7492
#, kde-format
msgid "Max Slowdown"
msgstr "Największe spowolnienie"

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7494
#, kde-format
msgid ""
"This is the maximum<br>\n"
"      delay that will be applied to the delayed signal, relative to the dry "
"signal."
msgstr ""
"Jest to największe<br>\n"
"      opóźnienie, które zostanie zastosowane do sygnału opóźnionego, "
"względem sygnału suchego."

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7496
#, kde-format
msgid "LFO Frequency"
msgstr "Częstotliwość LFO"

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7498
#, kde-format
msgid ""
"This is the core frequency<br>\n"
"      that the 'LFO' will move at. The LFO isn't actually an oscillator, but "
"it does vary periodically."
msgstr ""
"Jest to podstawowa częstotliwość<br>\n"
"      z jaką będzie poruszać się 'LFO'. LFO nie jest w rzeczywistości "
"oscylatorem, ale zmienia się okresowo."

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7502
#, kde-format
msgid ""
"Feedback applied from the<br>\n"
"      output to the input, increases the depth of the effect, but makes it "
"sound less like a real flanger."
msgstr ""
"Sprzężenie zwrotne stosowane z<br>\n"
"      wyjścia na wejście, zwiększa głębię efektu, ale sprawia, że brzmi on "
"mniej jak prawdziwy flanger."

#. i18n: file: data/effects/ladspa/ladspa_1192.xml
#: rc.cpp:7506
#, kde-format
msgid "Fractionally Addressed Delay Line"
msgstr "Linia opóźniająca z adresowaniem ułamkowym"

#. i18n: file: data/effects/ladspa/ladspa_1192.xml
#: rc.cpp:7508
#, kde-format
msgid ""
"Fractionally Addressed Delay Line (LADSPA 1192)<br>\n"
"   Automatically adapts to the number of channels and sampling rate of the "
"consumer."
msgstr ""
"Linia opóźniająca z adresowaniem ułamkowym (LADSPA 1192)<br>\n"
"   Samoczynnie dostosowuje się do liczby kanałów i częstotliwości "
"próbkowania odbiorcy."

#. i18n: file: data/effects/ladspa/ladspa_1195.xml
#. i18n: file: data/effects/ladspa/ladspa_declipper.xml
#: rc.cpp:7516 rc.cpp:8560
#, kde-format
msgid "Declipper"
msgstr "Usunięcie przycięcia"

#. i18n: file: data/effects/ladspa/ladspa_1195.xml
#: rc.cpp:7518
#, kde-format
msgid ""
"Declipper (LADSPA 1195)<br>\n"
"   Removes nasty clicks from input signals, not very kind to them though."
msgstr ""
"Declipper (LADSPA 1195)<br>\n"
"   Usuwa nieprzyjemne trzaski z sygnałów wejściowych, choć nie obchodzi się "
"z nimi zbyt delikatnie."

#. i18n: file: data/effects/ladspa/ladspa_1196.xml
#: rc.cpp:7522
#, kde-format
msgid "Fast Overdrive"
msgstr "Szybki przester"

#. i18n: file: data/effects/ladspa/ladspa_1196.xml
#: rc.cpp:7524
#, kde-format
msgid ""
"Fast Overdrive (LADSPA 1196)<br>\n"
"   A simple overdrive. Compresses the extreme peaks to make a sound similar "
"to an overdriven amplifier."
msgstr ""
"Szybki przester (LADSPA 1196)<br>\n"
"   Prosty przester. Ściska skrajne szczyty, aby uzyskać dźwięk podobny do "
"przesterowanego wzmacniacza."

#. i18n: file: data/effects/ladspa/ladspa_1196.xml
#: rc.cpp:7526
#, kde-format
msgid "Drive Level"
msgstr "Poziom przesteru"

#. i18n: file: data/effects/ladspa/ladspa_1196.xml
#: rc.cpp:7528
#, kde-format
msgid ""
"Controls the point at<br>\n"
"      which the signal starts to distort, and the degree of distortion."
msgstr ""
"Określa punkt,<br>\n"
"      w którym sygnał zaczyna się zniekształcać, oraz stopień "
"zniekształcenia."

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7532
#, kde-format
msgid "Decimator"
msgstr "Decymator"

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7534
#, kde-format
msgid ""
"Decimator (LADSPA 1202)<br>\n"
"   Decimates (reduces the effective sample rate), and reduces the bit depth "
"of the input signal, allows non integer values for smooth transitions "
"between clean and lo-fi signals."
msgstr ""
"Decymator (LADSPA 1202)<br>\n"
"   Decymuje (zmniejsza efektywną częstotliwość próbkowania) i zmniejsza "
"głębię bitową sygnału wejściowego, pozwala na wartości niecałkowite dla "
"płynnych przejść między czystym sygnałem a lo-fi."

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7536
#, kde-format
msgid "Bit Depth"
msgstr "Głębia bitowa"

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7538
#, kde-format
msgid "The bit depth that the signal will be reduced to"
msgstr "Głębia bitowa, do której zostanie zmniejszony sygnał"

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7540
#, kde-format
msgid "Sample Rate"
msgstr "Częstotliwość próbkowania"

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7542
#, kde-format
msgid "The sample rate that the signal will be resampled at"
msgstr "Częstotliwość próbkowania, z jaką sygnał zostanie przepróbkowany"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7546
#, kde-format
msgid "Single Band Parametric"
msgstr "Jednopasmowy parametryczny"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7548
#, kde-format
msgid ""
"Single Band Parametric (LADSPA 1203)<br>\n"
"   A single band of a parametric filter."
msgstr ""
"Jednopasmowy parametryczny (LADSPA 1203)<br>\n"
"   Pojedyncze pasmo filtra parametrycznego."

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7550
#, kde-format
msgid "Gain (dB)"
msgstr "Wzmocnienie (dB)"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7552
#, kde-format
msgid "The attenuation/gain of the eq"
msgstr "Tłumienie/wzmocnienie korektora"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7554
#, kde-format
msgid "Frequency (Hz)"
msgstr "Częstotliwość (Hz)"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7556
#, kde-format
msgid ""
"The centre frequency (i.e. point of<br>\n"
"      most/least attenuation). Beware of high values for <i>Frequency</i> "
"and <i>Bandwidth</i>: if the high pitch (<i>Frequency</i> * 2^<i>Bandwidth</"
"i>) goes over half the sample rate, you will get aliasing."
msgstr ""
"Częstotliwość środkowa (tj. punkt<br>\n"
"      największego/najmniejszego tłumienia). Uważaj na duże wartości "
"<i>Częstotliwości</i> i <i>Szerokości pasma</i>: jeśli wysoki ton "
"(<i>Częstotliwość</i> * 2^<i>Szerokość pasma</i>) przekroczy połowę "
"częstotliwości próbkowania, wystąpi aliasing."

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7558
#, kde-format
msgid "Bandwidth (octaves)"
msgstr "Szerokość pasma (oktawy)"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7560
#, kde-format
msgid ""
"The pitch difference from the<br>\n"
"      centre before the attenuation has reached half the <i>Gain</i>."
msgstr ""
"Różnica wysokości od<br>\n"
"      środka, zanim tłumienie osiągnie połowę <i>Wzmocnienia</i>."

#. i18n: file: data/effects/ladspa/ladspa_1207.xml
#: rc.cpp:7564
#, kde-format
msgid "DC Offset Remover"
msgstr "Usuwanie składowej stałej"

#. i18n: file: data/effects/ladspa/ladspa_1207.xml
#: rc.cpp:7566
#, kde-format
msgid ""
"DC Offset Remover (LADSPA 1207)<br>\n"
"   Simply removes the DC (0 Hz) component from an audio signal, uses a high "
"pass filter, so has some side effects, but they should be minimal."
msgstr ""
"Usuwanie składowej stałej (LADSPA 1207)<br>\n"
"   Po prostu usuwa składową stałą (0 Hz) z sygnału dźwiękowego; używa filtra "
"górnoprzepustowego, więc ma pewne skutki uboczne, ale powinny być one "
"minimalne."

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#: rc.cpp:7570
#, kde-format
msgid "Foldover Distortion"
msgstr "Zniekształcenie z zawinięciem"

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#: rc.cpp:7572
#, kde-format
msgid ""
"Foldover Distortion (LADSPA 1213)<br>\n"
"   Uses a sine wave approximation to simulate valve style foldover "
"distortion. Probably should have a <i>DC Offset Remover</i> on the output, "
"but it's not always necessary."
msgstr ""
"Zniekształcenie z zawinięciem (LADSPA 1213)<br>\n"
"   Używa przybliżenia fali sinusoidalnej do symulowania zniekształcenia z "
"zawinięciem w stylu lampowym. Prawdopodobnie na wyjściu powinno być "
"<i>Usuwanie składowej stałej</i>, ale nie zawsze jest to konieczne."

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:7574 rc.cpp:8516
#, kde-format
msgid "Drive"
msgstr "Przester"

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#: rc.cpp:7576
#, kde-format
msgid "Controls the degree of distortion"
msgstr "Określa stopień zniekształcenia"

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#: rc.cpp:7578
#, kde-format
msgid "Skew"
msgstr "Pochylenie"

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#: rc.cpp:7580
#, kde-format
msgid "Controls the asymmetry of the waveform"
msgstr "Steruje asymetrią kształtu fali"

