#, kde-format
msgid "Compression Ratio"
msgstr "Stopień kompresji"

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7690
#, kde-format
msgid "Crossover Distortion"
msgstr "Zniekształcenie skrośne"

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7692
#, kde-format
msgid ""
"Crossover Distortion (LADSPA 1404)<br>\n"
"   This is a simulation of the distortion that happens in class B and AB "
"power amps when the signal crosses 0."
msgstr ""
"Zniekształcenie skrośne (LADSPA 1404)<br>\n"
"   Jest to symulacja zniekształcenia, które występuje we wzmacniaczach mocy "
"klasy B i AB, gdy sygnał przechodzi przez 0."

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7694
#, kde-format
msgid "Crossover Amplitude"
msgstr "Amplituda skrośna"

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7696
#, kde-format
msgid "Controls the point at which the output signal becomes linear"
msgstr "Określa punkt, w którym sygnał wyjściowy staje się liniowy"

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7700
#, kde-format
msgid "Controls degree of smoothing of the crossover point"
msgstr "Określa stopień wygładzenia punktu przejścia"

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7704
#, kde-format
msgid "Aliasing"
msgstr "Aliasing"

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7706
#, kde-format
msgid ""
"Aliasing (LADSPA 1407)<br>\n"
"   Simulates aliasing using nyquist frequency modulation. Produces wacky "
"results if the blocks aren't even numbers of samples long."
msgstr ""
"Aliasowanie (LADSPA 1407)<br>\n"
"   Symuluje aliasowanie przy użyciu modulacji częstotliwości nyquista. Daje "
"dziwne wyniki, jeśli bloków nie zawierają parzystej liczby próbek."

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7708
#, kde-format
msgid "Aliasing Level"
msgstr "Poziom aliasingu"

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7710
#, kde-format
msgid "Controls the amount of simulated aliasing in the output."
msgstr "Określa ilość symulowanego aliasingu na wyjściu."

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7714
#, kde-format
msgid "Barry's Satan Maximiser"
msgstr "Maksymalizator Szatana Barry'ego"

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7716
#, kde-format
msgid ""
"Barry's Satan Maximiser (LADSPA 1408)<br>\n"
"   Compresses signals with a stupidly short attack and decay, infinite ratio "
"and hard knee. Not really as a compressor, but good harsh (non-musical) "
"distortion."
msgstr ""
"Maksymalizator Szatana Barry'ego (LADSPA 1408)<br>\n"
"   Kompresuje sygnały z niedorzecznie krótkim atakiem i rozpadem, "
"nieskończonym stopniem i twardym kolanem. Nie tyle jako kompresor, co dobre "
"ostre (niemuzyczne) zniekształcenie."

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7718
#, kde-format
msgid "Decay Time (samples)"
msgstr "Czas rozpadu (próbki)"

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7720
#, kde-format
msgid "Controls the envelope decay time."
msgstr "Steruje czasem zaniku w kopercie."

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7722
#, kde-format
msgid "Knee Point"
msgstr "Punkt kolana"

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7724
#, kde-format
msgid ""
"Controls the knee roll-off point,<br>\n"
"      ie. the point above which the compression kicks in. 0 will have no "
"effect, -90 will remove virtually all dynamic range."
msgstr ""
"Określa punkt kolana,<br>\n"
"      tj. punkt, powyżej którego zaczyna działać kompresja. 0 nie da żadnego "
"efektu, -90 usunie praktycznie cały zakres dynamiki."

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7728
#, kde-format
msgid "Gate"
msgstr "Bramka"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7730
#, kde-format
msgid "Gate (LADSPA 1410)"
msgstr "Bramka (LADSPA 1410)"

