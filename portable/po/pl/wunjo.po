#. i18n: file: data/effects/sox/sox_flanger.xml
#: rc.cpp:5968 rc.cpp:7308 rc.cpp:8244 rc.cpp:8266 rc.cpp:8300 rc.cpp:8538
#: rc.cpp:8634 rc.cpp:8744
#, kde-format
msgid "Depth"
msgstr "Głębia"

#. i18n: file: data/effects/avfilter/avfilter_flanger.xml
#: rc.cpp:5970
#, kde-format
msgid "Set added sweep delay in milliseconds. Range from 0 to 10."
msgstr ""
"Ustaw dodawane opóźnienie w milisekundach. Możliwe wartości są w zakresie od "
"0 do 10."

#. i18n: file: data/effects/avfilter/avfilter_flanger.xml
#. i18n: file: data/effects/sox/sox_flanger.xml
#: rc.cpp:5972 rc.cpp:8746
#, kde-format
msgid "Regeneration"
msgstr "Regeneracja"

#. i18n: file: data/effects/avfilter/avfilter_flanger.xml
#: rc.cpp:5974
#, kde-format
msgid ""
"Set percentage regeneration (delayed signal feedback). Range from -95 to 95."
msgstr ""
"Ustaw procentową regenerację (opóźniony odzew sygnału). Możliwe wartości są "
"w zakresie od -95 do 95."

#. i18n: file: data/effects/avfilter/avfilter_flanger.xml
#: rc.cpp:5978
#, kde-format
msgid ""
"Set percentage of delayed signal mixed with original. Range from 0 to 100."
msgstr ""
"Ustaw procent opóźnionego sygnału wymieszanego z pierwotnym. Możliwe "
"wartości są w zakresie od 0 do 100."

#. i18n: file: data/effects/avfilter/avfilter_flanger.xml
#: rc.cpp:5982
#, kde-format
msgid "Set sweeps per second (Hz). Range from 0.1 to 10."
msgstr ""
"Ustaw liczbę przetarć na sekundę (Hz). Możliwe wartości są w zakresie od 0,1 "
"do 10."

#. i18n: file: data/effects/avfilter/avfilter_flanger.xml
#: rc.cpp:5986
#, kde-format
msgid "Set swept wave shape, can be triangular or sinusoidal."
msgstr ""
"Ustaw kształt fali przecierającej. Może być trójkątna lub sinusoidalna."

#. i18n: file: data/effects/avfilter/avfilter_flanger.xml
#. i18n: file: data/effects/avfilter/avfilter_phase.xml
#. i18n: file: data/effects/sox/sox_flanger.xml
#: rc.cpp:5990 rc.cpp:6714 rc.cpp:8754
#, kde-format
msgid "Phase"
msgstr "Faza"

#. i18n: file: data/effects/avfilter/avfilter_flanger.xml
#: rc.cpp:5992
#, kde-format
msgid "Set swept wave percentage-shift for multi channel. Range from 0 to 100."
msgstr ""
"Ustaw przesunięcie procentowe fali przetarcia dla wielu kanałów. Możliwe "
"wartości są w zakresie od 0 do 100."

#. i18n: file: data/effects/avfilter/avfilter_flanger.xml
#: rc.cpp:5996
#, kde-format
msgid "Set delay-line interpolation, linear or quadratic."
msgstr "Ustaw interpolację opóźnionej linii na linową lub kwadratową."

#. i18n: file: data/effects/avfilter/avfilter_flanger.xml
#: rc.cpp:5998
#, kde-format
msgid "Linear,Quadratic"
msgstr "Liniowy,Kwadratowy"

#. i18n: file: data/effects/avfilter/avfilter_framestep.xml
#: rc.cpp:6000
#, kde-format
msgid "Framestep"
msgstr "Krok klatkowy"

#. i18n: file: data/effects/avfilter/avfilter_framestep.xml
#: rc.cpp:6002
#, kde-format
msgid "Select one frame every N frames"
msgstr "Zaznacz jedną klatkę, co N klatek"

#. i18n: file: data/effects/avfilter/avfilter_framestep.xml
#: rc.cpp:6004
#, kde-format
msgid "One frame every"
msgstr "Jedna klatka co każde"

#. i18n: file: data/effects/avfilter/avfilter_fspp.xml
#: rc.cpp:6006
#, kde-format
msgid "fspp"
msgstr "fspp"

#. i18n: file: data/effects/avfilter/avfilter_fspp.xml
#: rc.cpp:6008
#, kde-format
msgid "Fast and simple postprocessing"
msgstr "Szybkie i proste przetwarzanie końcowe"

#. i18n: file: data/effects/avfilter/avfilter_fspp.xml
#: rc.cpp:6010
#, kde-format
msgid "Quality"
msgstr "Jakość"

#. i18n: file: data/effects/avfilter/avfilter_fspp.xml
#: rc.cpp:6012
#, kde-format
msgid "4,5"
msgstr "4,5"

#. i18n: file: data/effects/avfilter/avfilter_fspp.xml
#: rc.cpp:6014
#, kde-format
msgid "Constant quantizer"
msgstr "Stały kwantyzator"

#. i18n: file: data/effects/avfilter/avfilter_fspp.xml
#: rc.cpp:6018
#, kde-format
