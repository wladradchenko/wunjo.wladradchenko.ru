msgstr "Pogłos płytowy SWH"

#. i18n: file: data/effects/ladspa/ladspa_1423.xml
#: rc.cpp:7792
#, kde-format
msgid ""
"SWH Plate Reverb (LADSPA 1423)<br>\n"
"   Automatically adapts to the number of channels and sampling rate of the "
"audio stream"
msgstr ""
"Pogłos płytowy SWH (LADSPA 1423)<br>\n"
"   Samoczynnie dostosowuje się do liczby kanałów i częstotliwości "
"próbkowania strumienia dźwięku"

#. i18n: file: data/effects/ladspa/ladspa_1423.xml
#: rc.cpp:7794
