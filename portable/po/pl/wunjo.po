#, kde-format
msgid "Hertz,Q-Factor,Octave,Slope,kHz"
msgstr "Hertz,Współczynnik-Q,Oktawa,Krzywa,kHz"

#. i18n: file: data/effects/avfilter/avfilter_equalizer.xml
#: rc.cpp:5820
#, kde-format
msgid "Band Width"
msgstr "Szerokość pasma"

#. i18n: file: data/effects/avfilter/avfilter_erosion.xml
#: rc.cpp:5836
#, kde-format
msgid "Erosion"
msgstr "Erozja"

#. i18n: file: data/effects/avfilter/avfilter_erosion.xml
#: rc.cpp:5838
#, kde-format
msgid ""
"Apply erosion effect.<br>\n"
"    Simulates image erosion, an effect which will enlarge the darkest pixels "
"in the image by replacing the pixel by the local (3x3) minimum."
msgstr ""
"Zastosuje efekt erozji.<br>\n"
"    Symuluje erozję obrazu, czyli efekt który powiększy najciemniejsze "
"piksele na obrazie zastępując piksel jego lokalnym (3x3) minimum."

#. i18n: file: data/effects/avfilter/avfilter_exposure.xml
#: rc.cpp:5860 rc.cpp:5864
#, kde-format
msgid "Exposure"
msgstr "Naświetlenie"

#. i18n: file: data/effects/avfilter/avfilter_exposure.xml
#: rc.cpp:5862
#, kde-format
msgid "Adjust exposure of the video stream."
msgstr "Dostosuj naświetlenie strumienia obrazu."

#. i18n: file: data/effects/avfilter/avfilter_extrastereo.xml
#: rc.cpp:5868
#, kde-format
msgid "Extrastereo"
msgstr "Extrastereo"

#. i18n: file: data/effects/avfilter/avfilter_extrastereo.xml
#: rc.cpp:5870
#, kde-format
msgid ""
"Linearly increases the difference between left and right channels which adds "
"some sort of \"live\" effect to playback."
msgstr ""
"Liniowo zwiększa różnicę pomiędzy lewymi i prawymi kanałami, co dodaje "
"trochę efektu \"żywości\" w trakcie odtwarzania."

#. i18n: file: data/effects/avfilter/avfilter_extrastereo.xml
#: rc.cpp:5874
#, kde-format
msgid ""
"Sets the difference coefficient (default: 2.5).\n"
"0.0 means mono sound (average of both channels),\n"
"with 1.0 sound will be unchanged, with -1.0 left and right channels will be "
"swapped."
msgstr ""
"Ustawia współczynnik różnicy (domyślnie: 2,5).\n"
"0,0 oznacza dźwięk mono (średnia obu kanałów),\n"
"przy 1,0 dźwięk pozostanie bez zmian, przy -1,0 nastąpi zamiana kanału "
"lewego z prawym."

#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:5878
#, kde-format
msgid "3D FFT Denoiser"
msgstr "Odszumiacz 3D FFT"

#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:5880
#, kde-format
msgid "Denoise frames using 3D FFT (frequency domain filtering)"
msgstr ""
"Odszum klatki przy użyciu 3D FFT (filtrowanie w domenie częstotliwości)"

#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:5884
#, kde-format
msgid ""
"Set the noise sigma constant.<br>\n"
"       \tThis sets denoising strength. Using very high sigma with low "
"overlap may give blocking artifacts."
msgstr ""
"Ustaw stałą sigma szumu.<br>\n"
"       \tUstawia to siłę odszumiania. Ustawienie bardzo dużej sigmy z małym "
"nachodzeniem może dać zakłócenia blokowe."

#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:5888
#, kde-format
msgid ""
"Set the amount of denoising.<br>\n"
"       \tBy default all detected noise is reduced."
msgstr ""
"Ustaw siłę odszumiania.<br>\n"
"       \tDomyślnie usuwany jest cały wykryty szum."

#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:5890
#, kde-format
msgid "Block"
msgstr "Blok"

#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:5892
#, kde-format
msgid "Set size of block in pixels"
msgstr "Ustaw rozmiar bloku w pikselach"

#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:5896
#, kde-format
msgid "Set block overlap"
msgstr "Ustaw nachodzenie bloku"

#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:5900
#, kde-format
msgid "Set denoising method"
msgstr "Ustaw tryb odszumiania"

#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:5902
#, kde-format
msgid "Wiener,Hard"
msgstr "Wiener,Twardy"

#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:5904
#, kde-format
msgid ""
"Add <em>previous</em> frame<br>\n"
"        for temporal denoising"
msgstr ""
"Dodaj <em>poprzednią</em> klatkę<br>\n"
"        do tymczasowego odszumienia"

#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:5906
#, kde-format
msgid ""
"Add <em>next</em> frame<br>\n"
"        for temporal denoising"
msgstr ""
"Dodaj <em>następną</em> klatkę<br>\n"
"        do tymczasowego odszumienia"

