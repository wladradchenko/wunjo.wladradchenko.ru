msgstr "Okres cyklu LFO w sekundach"

#. i18n: file: data/effects/ladspa/ladspa_1438.xml
#: rc.cpp:7868
#, kde-format
msgid "The maximum delay the LFO will use to flange in milliseconds"
msgstr ""
"Największe opóźnienie, jakiego LFO użyje do flangowania, w milisekundach"

#. i18n: file: data/effects/ladspa/ladspa_1438.xml
#: rc.cpp:7872
#, kde-format
msgid "The amount of the delays output that is mixed back into the delay"
msgstr "Ilość wyniku opóźnień, który jest z powrotem wmieszany w opóźnienie"

