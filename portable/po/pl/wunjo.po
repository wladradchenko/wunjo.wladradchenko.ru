msgstr "Użyj parametrów odpowiedzi czujnika"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2746
#, kde-format
msgid "Switch on to use sensor response parameters (EMoR h(x))"
msgstr "Włącz, aby użyć parametrów odpowiedzi czujnika (EMoR h(x))"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2748
#, kde-format
msgid "EMoR h(1)"
msgstr "EMoR h(1)"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2750 rc.cpp:2754 rc.cpp:2758 rc.cpp:2762 rc.cpp:2766
#, kde-format
msgid ""
"Sensor response parameters.<br>\n"
"    \tThe EMoR h(x) parameters are the same as Hugin's Ra - Re in the lens "
"parameters. If you use Hugin-derived values for vignetting correction, you "
"should also use these parameters, as Hugin's vignetting correction assumes "
"that the sensor response has been corrected."
msgstr ""
"Parametry odpowiedzi czujnika.<br>\n"
"    \tParametry EMoR h(x) są tymi samymi co Hugin Ra - Re w parametrach "
"soczewki. Jeśli używasz wartości pochodzących z Hugin do poprawiania "
"winietowania, to powinieneś także używać tych parametrów, bo poprawianie "
"winietowania Hugin'a zakłada, że odpowiedź czujnika została już poprawiona."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2752
