#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_mask.xml
#: rc.cpp:2550
#, kde-format
msgid ""
"The Start is half the height in degrees of the un-matted area. The End is "
"the half the height in degrees where the matte is at 100%."
msgstr ""
"Początek to połowa wysokości w stopniach obszaru un-matted. Koniec to połowa "
"wysokości w stopniach tam, gdzie matte jest na 100%."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_mask.xml
#: rc.cpp:2552
#, kde-format
msgid "Horizontal start"
msgstr "Początek w poziomie"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_mask.xml
#: rc.cpp:2554 rc.cpp:2558
#, kde-format
msgid ""
"The <b>Start</b> is the width in degrees of the un-matted area. The <b>End</"
"b> is the width in degrees where the matte is at 100%."
msgstr ""
"<b>Początek</b> to szerokość w stopniach obszaru un-matted. <b>Koniec</b> to "
"szerokość w stopniach, gdzie matte jest na 100%."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_mask.xml
#: rc.cpp:2556
#, kde-format
msgid "Horizontal end"
msgstr "Koniec w poziomie"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#: rc.cpp:2566
#, kde-format
msgid "VR360 Equirectangular to Rectilinear"
msgstr "VR360 prostokątna na prostoliniową"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#: rc.cpp:2568
#, kde-format
msgid ""
"Converts an equirectangular frame (panoramic) to a rectilinear frame (what "
"you're used to seeing). Can be used to preview what will be shown in a 360 "
"video viewer. Delayed frame blitting mapped on a time bitmap"
msgstr ""
"Przekształca prostokątną klatkę (panoramiczną) na prostoliniową klatkę (do "
"której widoku jesteś przyzwyczajony). Można używać do podglądania, co będzie "
"pokazane w przeglądarce nagrań 360. Opóźnione blittowanie zmapowane na mapę "
"bitową czasu"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_stereo.xml
#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_transform_360.xml
#: rc.cpp:2570 rc.cpp:2598 rc.cpp:2860
#, kde-format
msgid "Yaw"
msgstr "Obrót"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_transform_360.xml
#: rc.cpp:2572 rc.cpp:2862
#, kde-format
msgid ""
"The amount to rotate the image<br>\n"
"    \t(nose moves from side to side)."
msgstr ""
"Wielkość obrotu obrazu<br>\n"
"    \t(nos przesuwa się na boki)."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_stereo.xml
#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_transform_360.xml
#: rc.cpp:2574 rc.cpp:2600 rc.cpp:2864
#, kde-format
msgid "Pitch"
msgstr "Nachylenie"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_transform_360.xml
#: rc.cpp:2576 rc.cpp:2866
#, kde-format
msgid ""
"The amount to rotate the image<br>\n"
"    \t(nose up or down)."
msgstr ""
"Wielkość obrotu obrazu<br>\n"
"    \t(nos w górę lub w dół)."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_stereo.xml
#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_transform_360.xml
#: rc.cpp:2578 rc.cpp:2602 rc.cpp:2868
#, kde-format
msgid "Roll"
msgstr "Przechylenie"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_transform_360.xml
#: rc.cpp:2580 rc.cpp:2870
#, kde-format
msgid ""
"The amount to rotate the image<br>\n"
"    \t(clockwise or anticlockwise rotation along the axis of movement)."
msgstr ""
"Ilość o jaką obrócić obraz<br>\n"
"    \t(zgodnie lub przeciwnie do ruchu wskazówek zegara i wzdłuż osi ruchu)."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_stereo.xml
#: rc.cpp:2582 rc.cpp:2604
#, kde-format
msgid "FOV"
msgstr "Pole widzenia"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#: rc.cpp:2584
#, kde-format
msgid ""
"The horizontal field of view, in degrees, of the resulting frame.<br>\n"
"    \tAny value over 179 results in a fisheye projection."
msgstr ""
"Pole widoku klatki wynikowej, w poziomie, w stopniach.<br>\n"
"    \tWartości powyżej 179 skutkują projekcją rybie oko."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#: rc.cpp:2586
#, kde-format
msgid "Fisheye"
msgstr "Rybie oko"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#: rc.cpp:2588
#, kde-format
msgid ""
"The amount of fisheye to mix in.<br>\n"
"    \t100 means that you get a 100% fisheye lens."
msgstr ""
"Ilość rybiego oka do domieszania.<br>\n"
"    \t100 oznacza obiektyw rybie oko w 100%."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_stereo.xml
#: rc.cpp:2594
#, kde-format
msgid "VR360 Equirectangular to Stereo"
msgstr "VR360 równoprostokątny do Stereo"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_stereo.xml
#: rc.cpp:2596
#, kde-format
msgid ""
"Projects a stereographic image from an equirectangular. Use this to create "
"the little planet effect from a VR360 footage."
msgstr ""
"Rzutuje stereograficzny obraz z prostokątnego. Używaj tego do tworzenia "
"efektu planety z nagrań VR360."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_stereo.xml
#. i18n: file: data/effects/frei0r/frei0r_defish0r.xml
#. i18n: file: data/effects/frei0r/frei0r_iirblur.xml
#. i18n: file: data/effects/frei0r/frei0r_sharpness.xml
#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:2606 rc.cpp:3164 rc.cpp:3470 rc.cpp:4380 rc.cpp:5886
#, kde-format
msgid "Amount"
msgstr "Krok"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_stereo.xml
#: rc.cpp:2610
#, kde-format
msgid "Nearest-neighbor,Bilinear"
msgstr "Najbliższy sąsiad,Dwuliniowo"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_wrap.xml
#: rc.cpp:2612
#, kde-format
msgid "VR360 Wrap"
msgstr "Owinięcie VR360"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_wrap.xml
#: rc.cpp:2614
#, kde-format
msgid ""
"Stretches a section of the equirectangular panorama to cover the entire VR "
"sphere"
msgstr "Rozciąga wycinek panoramy równoprostokątnej, aby pokryć całą sferę VR"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_wrap.xml
#: rc.cpp:2618
#, kde-format
msgid "Determines the sampling method"
msgstr "Określa sposób próbkowania"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_wrap.xml
#: rc.cpp:2624 rc.cpp:2628 rc.cpp:2632 rc.cpp:2636
#, kde-format
msgid "Degrees from the center of the image to keep unchanged"
msgstr "Liczba stopni mierzona od środka obrazu do zachowania niezmienionymi"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_wrap.xml
#: rc.cpp:2638
#, kde-format
msgid "Blur start"
msgstr "Początek rozmycia"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_wrap.xml
#: rc.cpp:2640
#, kde-format
msgid ""
"Horizontal fraction of the unchanged area to blur over in the equator band"
msgstr "Pozioma część niezmienionego obszaru do rozmycia w pasie równika"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_wrap.xml
#: rc.cpp:2642
#, kde-format
msgid "Blur end"
msgstr "Rozmyty koniec"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_wrap.xml
#: rc.cpp:2644
#, kde-format
msgid "Horizontal fraction of the unchanged area to blur over at the poles"
msgstr "Pozioma część niezmienionego obszaru do rozmycia na biegunach"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2646
#, kde-format
msgid "VR360 Hemispherical to Equirectangular"
msgstr "VR360 hemisferyczne na prostokątne"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2648
#, kde-format
msgid ""
"Converts a video frame with two hemispherical images to a single "
"equirectangular frame. The plugin assumes that both hemispheres are in the "
"frame"
msgstr ""
"Przekształca klatkę nagranie o dwóch hemisferycznych obrazach na pojedynczą "
"prostokątną klatkę. Wtyczka zakłada, że obie hemisfery znajdują się na klatce"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2650
#, kde-format
msgid "Alignment yaw"
msgstr "Wyrównanie obrotu"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2652 rc.cpp:2656 rc.cpp:2660
#, kde-format
msgid ""
"The two fisheye cameras of a 360 camera are rarely perfectly 180 degrees "
"apart.<br>\n"
"    \tThese parameters adds a rotation to both lenses to correct for this."
msgstr ""
"Dwie kamery rybie oko w kamerze 360° rzadko są oddalone od siebie dokładnie "
"o 180° stopni.<br>\n"
"    \tTe parametry dodają obrót do obu soczewek, aby temu zaradzić."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2654
#, kde-format
msgid "Alignment pitch"
msgstr "Wyrównanie nachylenia"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2658
#, kde-format
msgid "Alignment roll"
msgstr "Wyrównanie przechyłu"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2662
#, kde-format
msgid "Projection"
msgstr "Rzutowanie"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2664
#, kde-format
msgid ""
"The fisheye projection type. Currently only equidistant fisheyes, like the "
"Ricoh Theta and Garmin Virb360 are supported."
msgstr ""
"Rodzaj rzutowania rybie oko. Obecnie obsługiwane są tylko równoodległe rybie "
"oczy, takie jak Ricoh Theta oraz Garmin Virb360."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2666
#, kde-format
msgid "Equidistant Fisheye"
msgstr "Równoodległe rybie oko"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2668
#, kde-format
msgid "Lens FOV"
msgstr "Pole widzenia soczewki"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2670
#, kde-format
msgid ""
"The field of view of a single hemisphere in degrees, expressed as a fraction "
"of the frame width."
msgstr ""
"Pole widoku pojedynczej półkuli w stopniach, wyrażone jako ułamek szerokości "
"klatki."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2672
#, kde-format
msgid "Lens radius"
msgstr "Promień soczewki"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2674
#, kde-format
msgid ""
"The radius of the image circle, expressed as a fraction of the frame width."
msgstr "Promień okręgu obrazu, wyrażony jako część szerokości klatki."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2676
#, kde-format
msgid "Front X"
msgstr "Przód w X"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2678
#, kde-format
msgid ""
"The image center and image orientation for the front-facing camera.<br>\n"
"    \tThe X parameter is a fraction of the image width."
msgstr ""
"Środek i kierunek obrazu dla kamery patrzącej w przód.<br>\n"
"    \tParametr X jest ułamkiem szerokości obrazu."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2680
#, kde-format
msgid "Front Y"
msgstr "Przód w Y"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2682
#, kde-format
msgid ""
"The image center and image orientation for the front-facing camera.<br>\n"
"    \tThe Y parameter a fraction of the image height."
msgstr ""
"Środek i kierunek obrazu dla kamery patrzącej w przód.<br>\n"
"    \tParametr Y jest ułamkiem wysokości obrazu."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2684
#, kde-format
msgid "Front Up"
msgstr "Przód w górę"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2686
#, kde-format
msgid ""
"The image center and image orientation for the front-facing camera.<br>\n"
"    \tUp is the \"up\" direction in the image, in degrees clockwise from a "
"direction towards the frame top edge."
msgstr ""
"Środek i kierunek obrazu dla kamery patrzącej na wprost.<br>\n"
"    \tW górę oznacza \"górny\" kierunek na obrazie, w stopniach zgodnie z "
"ruchem wskazówek zegara od kierunku w stronę górnej krawędzi ramki."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2688
#, kde-format
msgid "Back X"
msgstr "Tył w X"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2690
#, kde-format
msgid ""
"The image center and image orientation for the back-facing camera.<br>\n"
"    \tThe X parameter is a fraction of the image width.."
msgstr ""
"Środek i kierunek obrazu dla kamery patrzącej w tył.<br>\n"
"    \tParametr X jest ułamkiem szerokości obrazu."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2692
#, kde-format
msgid "Back Y"
msgstr "Tył w Y"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2694
#, kde-format
msgid ""
"The image center and image orientation for the back-facing camera.<br>\n"
"    \tThe Y parameter a fraction of the image height."
msgstr ""
"Środek i kierunek obrazu dla kamery patrzącej w tył.<br>\n"
"    \tParametr Y jest ułamkiem wysokości obrazu."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2696
#, kde-format
msgid "Back Up"
msgstr "Tył w górę"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2698
#, kde-format
msgid ""
"The image center and image orientation for the back-facing camera.<br>\n"
"    \tUp is the \"up\" direction in the image, in degrees clockwise from a "
"direction towards the frame top edge."
msgstr ""
"Środek i kierunek obrazu dla kamery patrzącej od tył.<br>\n"
"    \tW górę oznacza \"górny\" kierunek na obrazie, w stopniach zgodnie z "
"ruchem wskazówek zegara od kierunku w stronę górnej krawędzi ramki."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2700
#, kde-format
msgid "Nadir radius"
msgstr "Promień nadiru"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2702 rc.cpp:2706
#, kde-format
msgid ""
"360 cameras like the Theta have a problem with the nadir direction where, no "
"matter what, you will have a little of the camera in the image.<br>\n"
"    \tThis parameter \"stretches\" the image near nadir to cover up the "
"missing parts."
msgstr ""
"Kamery 360 jak np. Theta mają problem z kierunkiem nadiru, gdzie niezależnie "
"od wszystkiego, będziesz mieć trochę kamery na obrazie.<br>\n"
"    \tTen parametr \"rozciąga\" obraz w pobliżu nadiru, aby pokryć brakujące "
"części."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2704
#, kde-format
msgid "Nadir start"
msgstr "Początek nadiru"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2708
#, kde-format
msgid "Lens distortion A"
msgstr "Zniekształcenie soczewki A"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2710 rc.cpp:2714 rc.cpp:2718
#, kde-format
msgid ""
"Lens distortion correction parameters.<br>\n"
"    \tThe first three parameters are the same as in Hugin."
msgstr ""
"Parametry poprawkowe zniekształcenia soczewki.<br>\n"
"    \tPierwsze trzy parametry są takie same jak w Hugin."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2712
#, kde-format
msgid "Lens distortion B"
msgstr "Zniekształcenie soczewki B"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2716
#, kde-format
msgid "Lens distortion C"
msgstr "Zniekształcenie soczewki C"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2720
#, kde-format
msgid "Lens distortion radius"
msgstr "Promień zniekształcenia soczewki"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2722
#, kde-format
msgid ""
"Lens distortion correction parameters.<br>\n"
"    \tIf you use Hugin parameters, the Radius should be set to the value of "
"(0.5 * min(image width, image height) / image width). For a 2:1 aspect dual "
"hemispherical image, that would be 0.25."
msgstr ""
"Parametry poprawiające zniekształcenie soczewki.<br>\n"
"    \tJeśli używasz parametrów Hugina, to promień powinien być ustawiony na "
"wartość (0.5 * min(szerokość obrazu, wysokość obrazu) / szerokość obrazu). "
"Dla obrazu o podwójnej hemisferze w stosunku 2:1, to jest 0.25."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2724
#, kde-format
msgid "Lens vignetting A"
msgstr "Winietowanie soczewki A"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2726 rc.cpp:2730 rc.cpp:2734 rc.cpp:2738
#, kde-format
msgid ""
"Lens vignetting correction parameters.<br>\n"
"    \tThe first four parameters are the same as in Hugin, corresponding to "
"the Va, Vb, Vc and Vd image parameters."
msgstr ""
"Parametry poprawkowe winietowania soczewki.<br>\n"
"    \tPierwsze cztery parametry są takie same jak w Hugin, co odpowiada "
"parametrom obrazu Va, Vb, Vc oraz Vd."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2728
#, kde-format
msgid "Lens vignetting B"
msgstr "Winietowanie soczewki B"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2732
#, kde-format
msgid "Lens vignetting C"
msgstr "Winietowanie soczewki C"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2736
#, kde-format
msgid "Lens vignetting D"
msgstr "Winietowanie soczewki D"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2740
#, kde-format
msgid "Lens vignetting radius"
msgstr "Promień winietowania soczewki"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2742
#, kde-format
msgid ""
"If you use Hugin parameters, the radius should be set to the value of (0.5 * "
"image diagonal / image width).<br>\n"
"    \tFor a 2:1 aspect dual hemispherical image, that would be 0.5590. Use "
"the A parameter to scale the effect and avoid overexposing highlights"
msgstr ""
"Jeśli używasz parametrów Hugina, to promień powinien być ustawiony na "
"wartość (0.5 * przekątna obrazu / szerokość obrazu).<br>\n"
"    \tDla obrazu podwójnie hemisferycznego o stosunku 2:1, to będzie 0.5590. "
"Użyj parametru A, aby przeskalować efekt i uniknąć nadmiernego "
"prześwietlenia podświetleń"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
