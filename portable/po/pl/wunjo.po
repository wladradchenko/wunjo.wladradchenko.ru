#, kde-format
msgid "Audio Equalizer (avfilter)"
msgstr "Korektor graficzny (avfilter)"

#. i18n: file: data/effects/avfilter/avfilter_equalizer.xml
#: rc.cpp:5812
#, kde-format
msgid ""
"Apply two-pole peaking equalization (EQ) filter. With this filter, the "
"signal-level at and around a selected frequency can be increased or "
"decreased, whilst (unlike bandpass and bandreject filters) that at all other "
"frequencies is unchanged."
msgstr ""
"Zastosuj dwubiegunowy filtr wyrównujący szczyty (EQ). Z tym filtrem, poziom "
"sygnału w i wokół wybranej częstotliwości może być zwiększony lub "
"zmniejszony, podczas gdy (odmiennie od filtrów przepuszczających lub "
"blokujących pasmo) gdy poziom sygnału na innych częstotliwościach pozostaje "
"bez zmian."

#. i18n: file: data/effects/avfilter/avfilter_equalizer.xml
#: rc.cpp:5816
#, kde-format
msgid "Width Type"
msgstr "Rodzaj szerokości"

#. i18n: file: data/effects/avfilter/avfilter_equalizer.xml
