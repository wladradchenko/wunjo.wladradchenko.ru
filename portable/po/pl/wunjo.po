#. i18n: file: data/effects/ladspa/ladspa_1890.xml
#: rc.cpp:7934
#, kde-format
msgid ""
"GLAME Highpass Filter (LADSPA 1890)<br>\n"
"   IIR highpass filter based using Chebishev coefficients. The filter allows "
"you to tweak the number of stages used for filtering. Every stage adds two "
"more poles, which leads to a steeper dropoff."
msgstr ""
"Filtr górnoprzepustowy GLAME (LADSPA 1890)<br>\n"
"   Filtr górnoprzepustowy IIR oparty na współczynnikach Czebyszewa. Filtr "
"pozwala dostosować liczbę stopni używanych do filtrowania. Każdy stopień "
"dodaje dwa kolejne bieguny, co prowadzi do bardziej stromego spadku."

