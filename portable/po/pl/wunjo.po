msgstr "Oscylator FM (LADSPA 1415)"

#. i18n: file: data/effects/ladspa/ladspa_1415.xml
#: rc.cpp:7784
#, kde-format
msgid "The shape of the waveform"
msgstr "Kształt kształtu fali"

#. i18n: file: data/effects/ladspa/ladspa_1415.xml
#: rc.cpp:7786
#, kde-format
