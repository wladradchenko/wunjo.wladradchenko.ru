#. i18n: file: data/effects/frei0r/frei0r_kaleid0sc0pe.xml
#: rc.cpp:3502
#, kde-format
msgid ""
"Kaleidoscope segmentation / 128;<br>\n"
"        segmentations of 1, 2, or multiples of 4 work best. Default is 16"
msgstr ""
"Podział kalejdoskopu / 128;<br>\n"
"        podział na 1, 2 lub wielokrotności 4 sprawdzają się najlepiej. "
"Domyślnie to 16"

#. i18n: file: data/effects/frei0r/frei0r_kaleid0sc0pe.xml
#: rc.cpp:3504
#, kde-format
msgid "Specify Source Segment"
msgstr "Wskaż odcinek źródłowy"

#. i18n: file: data/effects/frei0r/frei0r_kaleid0sc0pe.xml
#: rc.cpp:3506
#, kde-format
msgid ""
"If checked, the source angle<br>\n"
"        is read from the <em>source segment</em>, otherwise it is auto "
"calculated"
msgstr ""
"Po zaznaczeniu, kąt źródła<br>\n"
"        jest odczytywany z <em>odcinka źródła</em>, w przeciwnym przypadku "
"jest obliczany"

#. i18n: file: data/effects/frei0r/frei0r_kaleid0sc0pe.xml
#: rc.cpp:3508
#, kde-format
msgid "Source Segment"
msgstr "Odcinek źródłowy"

#. i18n: file: data/effects/frei0r/frei0r_kaleid0sc0pe.xml
#: rc.cpp:3510
#, kde-format
msgid ""
"Center of the source segment. Only used if <em>Specify Source Segment</em> "
"is checked.<br>\n"
"        0 is in +x and rotates counter clockwise."
msgstr ""
"Środek odcinka źródłowego. Używane tylko po zaznaczeniu <em>Określ Odcinek "
"Źródłowy</em>. <br>\n"
"        0 jest w +x i obraca przeciwnie do ruchu wskazówek zegara."

#. i18n: file: data/effects/frei0r/frei0r_kaleid0sc0pe.xml
#: rc.cpp:3512
#, kde-format
msgid "Segmentation Direction"
msgstr "Kierunek segmentacji"

#. i18n: file: data/effects/frei0r/frei0r_kaleid0sc0pe.xml
#: rc.cpp:3514
#, kde-format
msgid "Direction of the segmentation."
msgstr "Kierunek segmentacji."

#. i18n: file: data/effects/frei0r/frei0r_kaleid0sc0pe.xml
#: rc.cpp:3516
#, kde-format
msgid "None,Counter Clockwise,Clockwise"
msgstr "Brak,W lewo,W prawo"

#. i18n: file: data/effects/frei0r/frei0r_kaleid0sc0pe.xml
#: rc.cpp:3518
#, kde-format
msgid "Reflect Edges"
msgstr "Odbij krawędzie"

#. i18n: file: data/effects/frei0r/frei0r_kaleid0sc0pe.xml
#: rc.cpp:3520
#, kde-format
msgid ""
"If checked, reflections that end up outside the source reflect back into it."
"<br>\n"
"        Otherwise the specified background color is used."
msgstr ""
"Po zaznaczeniu, odbicia które kończą się poza źródłem, odbijają się z "
"powrotem w nim. <br>\n"
"         W przeciwnym przypadku używana jest dana barwa tła."

#. i18n: file: data/effects/frei0r/frei0r_kaleid0sc0pe.xml
#: rc.cpp:3522
#, kde-format
msgid "Edge Threshold"
msgstr "Próg krawędzi"

#. i18n: file: data/effects/frei0r/frei0r_kaleid0sc0pe.xml
#: rc.cpp:3524
#, kde-format
msgid ""
"Edge threshold / 4, reflections <br>\n"
"        outside the image but within this distance clamp to the edge."
msgstr ""
"Próg krawędzi / 4, odbicia <br>\n"
"        poza obrazem, lecz w zasięgu tego obszaru do krawędzi."

#. i18n: file: data/effects/frei0r/frei0r_kaleid0sc0pe.xml
#: rc.cpp:3526
#, kde-format
msgid "Preferred Corner"
msgstr "Domyślny narożnik"

#. i18n: file: data/effects/frei0r/frei0r_kaleid0sc0pe.xml
#: rc.cpp:3528
#, kde-format
msgid ""
"If <em>Reflect Edges</em> is not checked, <br>\n"
"        this parameter defines the preferred corner."
msgstr ""
"Jeśli <em>Odbij krawędzie</em> nie jest zaznaczone, <br>\n"
"        ten parametr określa domyślny narożnik."

#. i18n: file: data/effects/frei0r/frei0r_kaleid0sc0pe.xml
#: rc.cpp:3530
#, kde-format
msgid "Top right,Top left,Bottom left,Bottom right"
msgstr "Górny prawy,Górny lewy,Dolny lewy,Dolny prawy"

#. i18n: file: data/effects/frei0r/frei0r_kaleid0sc0pe.xml
#: rc.cpp:3532
#, kde-format
msgid "Corner Search"
msgstr "Wyszukiwanie narożnika"

#. i18n: file: data/effects/frei0r/frei0r_kaleid0sc0pe.xml
#: rc.cpp:3534
#, kde-format
msgid ""
"If checked, search clockwise for furthest corner.<br>\n"
"        Otherwise search counter clockwise."
msgstr ""
"Po zaznaczeniu, poszuka najdalej położonego narożnika zgodnie z ruchem "
"wskazówek zegara.<br>\n"
"        W przeciwnym przypadku w przeciwnym kierunku."

#. i18n: file: data/effects/frei0r/frei0r_kaleid0sc0pe.xml
#: rc.cpp:3538
#, kde-format
msgid ""
"Color to use if reflection<br>\n"
"        lies outside of the source image and not reflecting back in."
msgstr ""
"Barwa używana w przypadku, gdy odbicie<br>\n"
"        znajduje się poza obrazem źródłowym i nie odbija się z powrotem w "
"nim."

#. i18n: file: data/effects/frei0r/frei0r_kaleid0sc0pe.xml
#: rc.cpp:3540
#, kde-format
msgid "No Alpha Background"
msgstr "Bez tła alfy"

#. i18n: file: data/effects/frei0r/frei0r_kaleid0sc0pe.xml
#: rc.cpp:3542
#, kde-format
msgid ""
"If checked, the selected<br>\n"
"        color will be used, if reflection lies outside of the source image "
"and not reflecting back in."
msgstr ""
"Po zaznaczeniu, użyta zostanie wybrana <br>\n"
"        barwa, gdy odbicie będzie leżeć poza obrazem źródłowym i nie będzie "
"się w nim z powrotem odbijać."

#. i18n: file: data/effects/frei0r/frei0r_keyspillm0pup.xml
