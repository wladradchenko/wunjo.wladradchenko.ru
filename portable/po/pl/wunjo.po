#, kde-format
msgid "DJ Flanger"
msgstr "Flanger DJ"

#. i18n: file: data/effects/ladspa/ladspa_1438.xml
#: rc.cpp:7856
#, kde-format
msgid ""
"DJ Flanger (LADSPA 1438)<br>\n"
"   This is a flanger which is more or less typical of DJ mixing desks"
msgstr ""
"Flanger DJ (LADSPA 1438)<br>\n"
"   Jest to flanger mniej więcej typowy dla konsolet mikserskich DJ-ów"

#. i18n: file: data/effects/ladspa/ladspa_1438.xml
#: rc.cpp:7858
#, kde-format
msgid "LFO sync"
msgstr "Synchronizacja LFO"

#. i18n: file: data/effects/ladspa/ladspa_1438.xml
#: rc.cpp:7860
#, kde-format
msgid ""
"When turned from off to on<br>\n"
"      it resets the phase of the LFO back to the start of the cycle. Used to "
"sync the LFO to the track."
msgstr ""
"Po przełączeniu z wyłączonego na włączony<br>\n"
"      zeruje fazę LFO z powrotem do początku cyklu. Służy do synchronizacji "
"LFO ze ścieżką."

#. i18n: file: data/effects/ladspa/ladspa_1438.xml
