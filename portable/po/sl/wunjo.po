#: rc.cpp:2606
#, kde-format
msgid ""
"The amount of fisheye to mix in.<br>\n"
"    \t100 means that you get a 100% fisheye lens."
msgstr ""
"Količina širokokotnosti, ki jo je treba dodati.<br>\n"
"    \t100 % pomeni, da dobite 100 % skrajno širokokotno lečo (ribje oko)."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_stereo.xml
