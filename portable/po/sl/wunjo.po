msgstr "Oslabitev CV"

#. i18n: file: data/effects/ladspa/ladspa_1432.xml
#: rc.cpp:7852
#, kde-format
msgid "Shift CV"
msgstr "Zamik CV"

#. i18n: file: data/effects/ladspa/ladspa_1433.xml
#: rc.cpp:7858
#, kde-format
msgid "AM Pitch Shifter"
msgstr "Zamik višine tona AM"

#. i18n: file: data/effects/ladspa/ladspa_1433.xml
#: rc.cpp:7860
#, kde-format
msgid ""
"AM Pitch Shifter (LADSPA 1433)<br>\n"
"   This effect works by running a single write pointer (monotonic) and two "
"read pointers (pitchscaled) over a ringbuffer. The output is faded between "
"the two readpointers according to the sine of the distance from the write "
"pointer."
msgstr ""
"Zamik višine tona AM (LADSPA 1433)<br>\n"
"   Ta učinek deluje tako, da nad krožnim medpomnilnikom teče en pisalni "
"kazalec (monotono) in dva bralna kazalca (z višino tona). Izhod se med obema "
"bralnima kazalcema utiša glede na sinus razdalje od kazalca za pisanje."

#. i18n: file: data/effects/ladspa/ladspa_1433.xml
#. i18n: file: data/effects/ladspa/ladspa_pitch.xml
#: rc.cpp:7862 rc.cpp:8658
#, kde-format
msgid "Pitch Shift"
msgstr "Zamik višine tona"

#. i18n: file: data/effects/ladspa/ladspa_1433.xml
#: rc.cpp:7864
#, kde-format
msgid ""
"The multiple of the output pitch.<br>\n"
"      For example, 2.00 will increase the pitch by one octave."
msgstr ""
"Večkratnik izhodne višine tona.<br>\n"
"      Primer: 2,00 poveča višino tona za eno oktavo."

#. i18n: file: data/effects/ladspa/ladspa_1433.xml
#: rc.cpp:7866
#, kde-format
msgid "Buffer Size"
msgstr "Velikost medpomnilnika"

#. i18n: file: data/effects/ladspa/ladspa_1433.xml
#: rc.cpp:7868
#, kde-format
msgid ""
"The order of magnitude of the buffer size.<br>\n"
"      Small buffers will sound fluttery, large buffers will have flangy "
"sounding echos."
msgstr ""
"Red velikosti velikosti medpomnilnika.<br>\n"
"      Majhni medpomnilniki bodo zveneli trepetajoče, veliki medpomnilniki pa "
"bodo imeli prirobljene odmeve."

#. i18n: file: data/effects/ladspa/ladspa_1438.xml
#: rc.cpp:7872
#, kde-format
msgid "DJ Flanger"
msgstr "Prirobnik DJ (flanger DJ)"

#. i18n: file: data/effects/ladspa/ladspa_1438.xml
#: rc.cpp:7874
#, kde-format
msgid ""
"DJ Flanger (LADSPA 1438)<br>\n"
"   This is a flanger which is more or less typical of DJ mixing desks"
msgstr ""
"Prirobnik DJ (LADSPA 1438)<br>\n"
"   To je prirobnik, ki je bolj ali manj značilen za mešalne mize za DJ-je"

#. i18n: file: data/effects/ladspa/ladspa_1438.xml
#: rc.cpp:7876
#, kde-format
msgid "LFO sync"
msgstr "Sinhronizacija LFO"

#. i18n: file: data/effects/ladspa/ladspa_1438.xml
#: rc.cpp:7878
#, kde-format
msgid ""
"When turned from off to on<br>\n"
"      it resets the phase of the LFO back to the start of the cycle. Used to "
"sync the LFO to the track."
msgstr ""
"Ko je preklopljeno iz izklopljenega na vklopljeno,<br>\n"
"      ponastavi fazo LFO nazaj na začetek cikla. Uporabljeno za "
"sinhronizacijo LFO s stezo."

#. i18n: file: data/effects/ladspa/ladspa_1438.xml
#: rc.cpp:7880
#, kde-format
msgid "LFO period"
msgstr "Perioda LFO"

#. i18n: file: data/effects/ladspa/ladspa_1438.xml
#: rc.cpp:7882
#, kde-format
msgid "The cycle period of the LFO in seconds"
msgstr "Perioda cikličnosti LFO v sekundah"

#. i18n: file: data/effects/ladspa/ladspa_1438.xml
#: rc.cpp:7886
#, kde-format
msgid "The maximum delay the LFO will use to flange in milliseconds"
msgstr ""
"Največja zakasnitev, ki jo LFO uporabi za prirobnik, izražena v milisekundah"

#. i18n: file: data/effects/ladspa/ladspa_1438.xml
#: rc.cpp:7890
#, kde-format
msgid "The amount of the delays output that is mixed back into the delay"
msgstr "Količina zakasnitev izhoda, ki se vmešajo nazaj v zamik."

#. i18n: file: data/effects/ladspa/ladspa_1886.xml
