#: rc.cpp:2602
#, kde-format
msgid ""
"The horizontal field of view, in degrees, of the resulting frame.<br>\n"
"    \tAny value over 179 results in a fisheye projection."
msgstr ""
"Vodoravno vidno polje nastalega vidnega polja, v stopinjah.<br>\n"
"    \tVsaka vrednost nad 179 ima za posledico projekcijo ribjega očesa."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#: rc.cpp:2604
#, kde-format
