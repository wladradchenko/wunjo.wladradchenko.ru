#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2708
#, kde-format
msgid ""
"The image center and image orientation for the back-facing camera.<br>\n"
"    \tThe X parameter is a fraction of the image width.."
msgstr ""
"Središče slike in usmerjenost slike za hrbtno kamero.<br>\n"
"    \tParameter X je ulomljeni del širine slike."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2710
#, kde-format
msgid "Back Y"
msgstr "Y zadaj"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2712
#, kde-format
msgid ""
"The image center and image orientation for the back-facing camera.<br>\n"
"    \tThe Y parameter a fraction of the image height."
msgstr ""
"Središče slike in usmerjenost slike za hrbtno kamero.<br>\n"
"    \tParameter Y je ulomljeni del širine slike."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2714
#, kde-format
msgid "Back Up"
msgstr "Navzgor zadaj"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2716
#, kde-format
msgid ""
"The image center and image orientation for the back-facing camera.<br>\n"
"    \tUp is the \"up\" direction in the image, in degrees clockwise from a "
"direction towards the frame top edge."
msgstr ""
"Središče slike in usmeritev slike za kamero, obrnjeno nazaj.<br>\n"
