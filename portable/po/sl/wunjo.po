"The amount to rotate the image<br>\n"
"    \t(nose up or down)."
msgstr ""
"Količina sukanja slike<br>\n"
"    \t(nos navzgor ali navzdol)."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_stereo.xml
#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_transform_360.xml
#: rc.cpp:2596 rc.cpp:2620 rc.cpp:2886
#, kde-format
msgid "Roll"
msgstr "Kotaljenje"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_transform_360.xml
#: rc.cpp:2598 rc.cpp:2888
#, kde-format
msgid ""
"The amount to rotate the image<br>\n"
"    \t(clockwise or anticlockwise rotation along the axis of movement)."
msgstr ""
"Mera sukanja slike<br>\n"
"    \t(vrtenje v smeri urinega kazalca ali nasprotni smeri urinega kazalca "
"vzdolž osi gibanja)."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_rect.xml
#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_to_stereo.xml
