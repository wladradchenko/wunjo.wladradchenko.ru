#: rc.cpp:7496 rc.cpp:7518 rc.cpp:7530 rc.cpp:7634 rc.cpp:7652 rc.cpp:7888
#: rc.cpp:8654
#, kde-format
msgid "Feedback"
msgstr "Odziv"

#. i18n: file: data/effects/ladspa/ladspa_1190.xml
#: rc.cpp:7498
#, kde-format
msgid "Feedback level, increases the distinctive wooshy phaser sound."
msgstr "Raven povratne zveze poveča značilen šumeč zvok faznega učinka."

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7504
#, kde-format
msgid ""
"Flanger (LADSPA 1191)<br>\n"
"   A digital flanger implementation. Uses a novel zero excursion, controlled "
"bandwidth modulation function, which should make the modulation less "
"repetitive and noticeable."
msgstr ""
"Prirobnik (LADSPA 1191)<br>\n"
"   Digitalna izvedba prirobnika (flangerja). Uporablja inovativno funkcijo "
"modulacije z ničelnim odklonom in nadzorovano pasovno širino, kar naj bi "
"zmanjšalo ponavljanje in opaznost modulacije."

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7506
#, kde-format
msgid "Delay Base"
msgstr "Zakasnitev osnove"

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7508
#, kde-format
msgid ""
"This is the offset from<br>\n"
"      the input time that the detune delay moves around"
msgstr ""
"To je odmik od<br>\n"
"      vhodnega časa, za katerega se zamik razglašenosti premika"

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7510
#, kde-format
msgid "Max Slowdown"
msgstr "Najv. Upočasnitev"

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7512
#, kde-format
msgid ""
"This is the maximum<br>\n"
"      delay that will be applied to the delayed signal, relative to the dry "
"signal."
msgstr ""
"To je največja<br>\n"
"      zakasnitev, ki bo uporabljena za zakasnjeni signal, glede na suhi "
"signal."

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7514
#, kde-format
msgid "LFO Frequency"
msgstr "Frekvenca LFO"

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7516
#, kde-format
msgid ""
"This is the core frequency<br>\n"
"      that the 'LFO' will move at. The LFO isn't actually an oscillator, but "
"it does vary periodically."
msgstr ""
"To je osnovna frekvenca,<br>\n"
"      s katero se bo gibal »LFO«. LFO v resnici ni oscilator, vendar se "
"periodično spreminja."

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7520
#, kde-format
msgid ""
"Feedback applied from the<br>\n"
"      output to the input, increases the depth of the effect, but makes it "
"sound less like a real flanger."
msgstr ""
"Povratne informacije, uporabljene iz<br>\n"
"      izhoda na vhod, poveča globino učinka, a naredi, da zveni manj kot "
"pravi prirobnik."

#. i18n: file: data/effects/ladspa/ladspa_1192.xml
#: rc.cpp:7524
#, kde-format
msgid "Fractionally Addressed Delay Line"
msgstr "Ulomljeno naslovljena zakasnitvena linija"

#. i18n: file: data/effects/ladspa/ladspa_1192.xml
#: rc.cpp:7526
#, kde-format
msgid ""
"Fractionally Addressed Delay Line (LADSPA 1192)<br>\n"
"   Automatically adapts to the number of channels and sampling rate of the "
"consumer."
msgstr ""
"Ulomljeno naslovljena zakasnitvena linija (LADSPA 1192)<br>\n"
"   Samodejno prilagodi število kanalov in mero vzorčenja potrošnika."

#. i18n: file: data/effects/ladspa/ladspa_1195.xml
#. i18n: file: data/effects/ladspa/ladspa_declipper.xml
#: rc.cpp:7534 rc.cpp:8578
#, kde-format
msgid "Declipper"
msgstr "Odstranjevalnik porezav"

#. i18n: file: data/effects/ladspa/ladspa_1195.xml
#: rc.cpp:7536
#, kde-format
msgid ""
"Declipper (LADSPA 1195)<br>\n"
"   Removes nasty clicks from input signals, not very kind to them though."
msgstr ""
"Odstranjevalnik porezav (LADSPA 1195)<br>\n"
"   Odstrani grozne klike iz vhodnih signalov, kar do njih ni ravno prijazno."

#. i18n: file: data/effects/ladspa/ladspa_1196.xml
#: rc.cpp:7540
#, kde-format
msgid "Fast Overdrive"
msgstr "Hitro prekoračenje"

#. i18n: file: data/effects/ladspa/ladspa_1196.xml
#: rc.cpp:7542
#, kde-format
msgid ""
"Fast Overdrive (LADSPA 1196)<br>\n"
"   A simple overdrive. Compresses the extreme peaks to make a sound similar "
"to an overdriven amplifier."
msgstr ""
"Hitro prekoračenje (LADSPA 1196)<br>\n"
"   Preprosto pretiravanje. Stisne ekstremne vrhove, da ustvari zvok, podoben "
"preobremenjenemu ojačevalcu."

#. i18n: file: data/effects/ladspa/ladspa_1196.xml
#: rc.cpp:7544
#, kde-format
msgid "Drive Level"
msgstr "Raven pogona"

#. i18n: file: data/effects/ladspa/ladspa_1196.xml
#: rc.cpp:7546
#, kde-format
msgid ""
"Controls the point at<br>\n"
"      which the signal starts to distort, and the degree of distortion."
msgstr ""
"Določa točko, v kateri<br>\n"
"      se signal začne pačiti, ter stopnjo popačenja."

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7550
#, kde-format
msgid "Decimator"
msgstr "Decimator"

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7552
#, kde-format
msgid ""
"Decimator (LADSPA 1202)<br>\n"
"   Decimates (reduces the effective sample rate), and reduces the bit depth "
"of the input signal, allows non integer values for smooth transitions "
"between clean and lo-fi signals."
msgstr ""
"Decimator (LADSPA 1202)<br>\n"
"   Zmanjša (zmanjša efektivno frekvenco vzorčenja) in zmanjša bitno globino "
"vhodnega signala, omogoča neceloštevilčne vrednosti za gladke prehode med "
"čistimi in lo-fi signali."

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7554
#, kde-format
msgid "Bit Depth"
msgstr "Bitna globina"

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7556
#, kde-format
msgid "The bit depth that the signal will be reduced to"
msgstr "Bitna globina, na katero bo reduciran signal."

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7558
#, kde-format
msgid "Sample Rate"
msgstr "Hitrost vzorčenja"

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7560
#, kde-format
msgid "The sample rate that the signal will be resampled at"
msgstr "Hitrost vzorčenja, pri kateri bo signal prevzorčen."

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7564
#, kde-format
msgid "Single Band Parametric"
msgstr "Enopasovni parametrični"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7566
#, kde-format
msgid ""
"Single Band Parametric (LADSPA 1203)<br>\n"
"   A single band of a parametric filter."
msgstr ""
"Enopasovni parametrični (LADSPA 1203)<br>\n"
"   Enojni pas parametričnega filtra."

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7568
#, kde-format
msgid "Gain (dB)"
msgstr "Ojačitev (dB)"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7570
#, kde-format
msgid "The attenuation/gain of the eq"
msgstr "Oslabitev/ojačanje izenačevalnika"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7572
#, kde-format
msgid "Frequency (Hz)"
msgstr "Frekvenca (Hz)"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7574
#, kde-format
msgid ""
"The centre frequency (i.e. point of<br>\n"
"      most/least attenuation). Beware of high values for <i>Frequency</i> "
"and <i>Bandwidth</i>: if the high pitch (<i>Frequency</i> * 2^<i>Bandwidth</"
"i>) goes over half the sample rate, you will get aliasing."
msgstr ""
"Srednja frekvenca (tj. točka<br>\n"
"      največjega/najmanjšega slabljenja). Pazite na visoke vrednosti za "
"<i>frekvenco</i> in <i>pasovno širino</i>: če visoka frekvenca "
"(<i>frekvenca</i> *2^<i>pasovna širina</i>) preseže polovico vzorčne "
"frekvence, bo prišlo do pojava robljenja."

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7576
#, kde-format
msgid "Bandwidth (octaves)"
msgstr "Pasovna širina (oktave)"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7578
#, kde-format
msgid ""
"The pitch difference from the<br>\n"
"      centre before the attenuation has reached half the <i>Gain</i>."
msgstr ""
"Razlika v višini tona glede na<br>\n"
"      središče, preden je slabljenje doseglo polovico <i>ojačitve</i>."

#. i18n: file: data/effects/ladspa/ladspa_1207.xml
#: rc.cpp:7582
#, kde-format
msgid "DC Offset Remover"
msgstr "Odstranjevalnik zamika DC"

#. i18n: file: data/effects/ladspa/ladspa_1207.xml
#: rc.cpp:7584
#, kde-format
msgid ""
"DC Offset Remover (LADSPA 1207)<br>\n"
"   Simply removes the DC (0 Hz) component from an audio signal, uses a high "
"pass filter, so has some side effects, but they should be minimal."
msgstr ""
"Odstranjevalnik enosmernega zamika (LADSPA 1207)<br>\n"
"   Preprosto odstrani komponento DC (0 Hz) iz zvočnega signala, uporabi "
"visokoprepustni filter, zato ima nekaj stranskih učinkov, ki pa naj bi bili "
"minimalni."

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#: rc.cpp:7588
#, kde-format
msgid "Foldover Distortion"
msgstr "Popačenje prepogibanja"

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#: rc.cpp:7590
#, kde-format
msgid ""
"Foldover Distortion (LADSPA 1213)<br>\n"
"   Uses a sine wave approximation to simulate valve style foldover "
"distortion. Probably should have a <i>DC Offset Remover</i> on the output, "
"but it's not always necessary."
msgstr ""
"Popačenje prepogibanja (LADSPA 1213)<br>\n"
"   Uporablja približek sinusnega vala za simulacijo popačenja prepogibanja v "
"slogu ventilov. Verjetno bi moral imeti na izhodu še <i>Odstranjevalnik "
"zamika DC</i>, vendar ni vedno nujen."

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:7592 rc.cpp:8534
#, kde-format
msgid "Drive"
