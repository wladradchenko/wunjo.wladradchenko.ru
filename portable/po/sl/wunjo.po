#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2692
#, kde-format
msgid ""
"The radius of the image circle, expressed as a fraction of the frame width."
msgstr "Polmer kroga slike kot delež širine sličice."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2694
#, kde-format
msgid "Front X"
msgstr "X spredaj"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2696
#, kde-format
msgid ""
"The image center and image orientation for the front-facing camera.<br>\n"
"    \tThe X parameter is a fraction of the image width."
msgstr ""
"Središče slike in usmerjenost slike za prednjo kamero.<br>\n"
"    \tParameter X je ulomljeni del širine slike."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2698
#, kde-format
msgid "Front Y"
msgstr "Y spredaj"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2700
#, kde-format
msgid ""
"The image center and image orientation for the front-facing camera.<br>\n"
"    \tThe Y parameter a fraction of the image height."
msgstr ""
"Središče slike in usmerjenost slike za prednjo kamero.<br>\n"
"    \tParameter Y je ulomljeni del širine slike."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2702
#, kde-format
msgid "Front Up"
msgstr "Navzgor spredaj"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2704
#, kde-format
msgid ""
"The image center and image orientation for the front-facing camera.<br>\n"
"    \tUp is the \"up\" direction in the image, in degrees clockwise from a "
