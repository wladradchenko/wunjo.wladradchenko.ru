#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7708
#, kde-format
msgid "Crossover Distortion"
msgstr "Popačenje ob prečenju"

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7710
#, kde-format
msgid ""
"Crossover Distortion (LADSPA 1404)<br>\n"
"   This is a simulation of the distortion that happens in class B and AB "
"power amps when the signal crosses 0."
msgstr ""
"Popačenje ob prečenju (LADSPA 1404)<br>\n"
"   To je simulacija popačenja, ki se zgodi v ojačevalnikih razredov B in AB, "
"ko signal prečka 0."

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7712
#, kde-format
msgid "Crossover Amplitude"
msgstr "Amplituda prečenja"

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7714
#, kde-format
msgid "Controls the point at which the output signal becomes linear"
msgstr "Nadzoruje točko, pri kateri izhodni signal postane linearen"

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7718
#, kde-format
msgid "Controls degree of smoothing of the crossover point"
msgstr "Nadzoruje stopnjo glajenja točke prehoda"

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7722
#, kde-format
msgid "Aliasing"
msgstr "Robljenje"

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7724
#, kde-format
msgid ""
"Aliasing (LADSPA 1407)<br>\n"
"   Simulates aliasing using nyquist frequency modulation. Produces wacky "
"results if the blocks aren't even numbers of samples long."
msgstr ""
"Robljenje (LADSPA 1407)<br>\n"
"   Simulira robljenje z uporabo Nyquistove frekvenčne modulacije. Rezultati "
"so nenavadni, če bloki niso dolgi po številu vzorcev."

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7726
#, kde-format
msgid "Aliasing Level"
msgstr "Raven robljenja"

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7728
#, kde-format
msgid "Controls the amount of simulated aliasing in the output."
msgstr "Nadzoruje količino simuliranega robljenja v izhodu."

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7732
#, kde-format
msgid "Barry's Satan Maximiser"
msgstr "Satanski maksimizator Barryja"

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7734
#, kde-format
msgid ""
"Barry's Satan Maximiser (LADSPA 1408)<br>\n"
"   Compresses signals with a stupidly short attack and decay, infinite ratio "
"and hard knee. Not really as a compressor, but good harsh (non-musical) "
"distortion."
msgstr ""
"Satanski maksimizator Barryja (LADSPA 1408)<br>\n"
"   Stisne signale z neumno kratkim vnihavanjem in upadom, neskončnim "
"razmerjem in trdim kolenom. Ne ravno kot kompresor, pa vendar gre za dobro "
"grobo (ne-glasbeno) popačenje."

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7736
#, kde-format
msgid "Decay Time (samples)"
msgstr "Čas upada (vzorci)"

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7738
#, kde-format
msgid "Controls the envelope decay time."
msgstr "Nadzira čas upada ovojnice."

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7740
#, kde-format
msgid "Knee Point"
msgstr "Točka kolena"

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7742
#, kde-format
msgid ""
"Controls the knee roll-off point,<br>\n"
"      ie. the point above which the compression kicks in. 0 will have no "
"effect, -90 will remove virtually all dynamic range."
msgstr ""
"Nadzoruje točko odvijanja kolena,<br>\n"
"      t.j. točko, nad katero se začne stiskanje. 0 ne bo imelo učinka, -90 "
"bo praktično odstranilo ves dinamični razpon."

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7746
#, kde-format
msgid "Gate"
msgstr "Vrata"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7748
#, kde-format
msgid "Gate (LADSPA 1410)"
msgstr "Vrata (LADSPA 1410)"

