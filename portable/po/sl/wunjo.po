#. i18n: file: data/effects/ladspa/ladspa_1430.xml
#: rc.cpp:7820
#, kde-format
msgid "Chebyshev Distortion"
msgstr "Popačenje Čebiševa"

#. i18n: file: data/effects/ladspa/ladspa_1430.xml
#: rc.cpp:7822
#, kde-format
msgid ""
"Chebyshev Distortion (LADSPA 1430)<br>\n"
"   This effect is seeded from incoming signal envelope. As the level of the "
"signal rises more and more harmonics will for added to the output signal. "
"The distortion control sets the sensitivity of the input."
msgstr ""
"Distorzija Čebiševa (LADSPA 1430)<br>\n"
"   Ta učinek je seeded iz ovojnice dohodnega signala. Ko se raven signala "
"vse bolj dvigam, se izhodnemu signalu dodaja več harmonije. Kontrolnik "
"distorzije določa občutljivost vhoda."

#. i18n: file: data/effects/ladspa/ladspa_1430.xml
#: rc.cpp:7824
#, kde-format
msgid "Distortion"
msgstr "Popačenje"

#. i18n: file: data/effects/ladspa/ladspa_1430.xml
#: rc.cpp:7826
#, kde-format
msgid "Sets the sensitivity of the input"
msgstr "Določa občutljivost vhoda"

#. i18n: file: data/effects/ladspa/ladspa_1431.xml
#: rc.cpp:7830
#, kde-format
msgid "Bode Frequency Shifter"
msgstr "Bodejev zamikalnik frekvenc"

#. i18n: file: data/effects/ladspa/ladspa_1431.xml
#: rc.cpp:7832
#, kde-format
msgid ""
"<b>Bode Frequency Shifter</b> (LADSPA 1431)<br>\n"
"   A Bode/Moog Frequency Shifter is a popular analogue synth module that "
"works by shifting all the frequencies of an input signal up or down by a "
"specified frequency. This effect shifts in both directions at the same time "
"as it is almost no extra work and is often useful to have both directions. "
"In contrast to the analogue Bode/Moog, which use Dome filters as the core, "
"it uses a Hilbert Transformer, which is much simpler to implement in digital "
"systems."
msgstr ""
"<b>Bodejev zamikalnik frekvenc</b> (LADSPA 1431)<br>\n"
"   Bodejev/Moogov zamikalnik frekvenc je priljubljeni analogni modul "
"sintetizatorja, ki deluje z zamikanjem vseh frekvenc vhodnega signala "
"navzgor ali navzdol za navedeno frekvenco. Ta učinek lahko zamika v obe "
"smeri hkrati, saj to ne predstavlja dodatne obremenitve in je pogosto "
"uporabno imeti podprte obe smeri. Za razliko od analognih zamikalnikov Bode/"
"Moog, ki uporabljajo filtre Dome za osnovo, uporablja Hilbertov "
"Transformator, ki ga je veliko enostavneje implementirati v digitalnih "
"sistemih."

#. i18n: file: data/effects/ladspa/ladspa_1431.xml
