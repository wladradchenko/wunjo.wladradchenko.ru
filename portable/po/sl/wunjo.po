#. i18n: file: data/effects/lumakey.xml
#: rc.cpp:1362
#, kde-format
msgid ""
"This filter modifies the<br>\n"
"   alpha channel as a function of the image's luma value. This is used "
"together with a compositor to combine two images so that bright or dark "
"areas of source image are overwritten on top of the destination image."
msgstr ""
"Ta filter spremeni kanal alfa<br>\n"
"      slike kot funkcijo njene vrednosti lume. Uporablja se skupaj s "
"skladalnikom za združevanje dveh slik, tako da se svetla ali temna območja "
"izvorne slike prepišejo čez ciljno sliko."

#. i18n: file: data/effects/lumakey.xml
#: rc.cpp:1366
#, kde-format
msgid ""
"Luma value that defines the<br>\n"
"      center point of transition from prelevel to postlevel opacity value."
msgstr ""
"Vrednost lume, ki določa<br>\n"
"      središčno točko prehoda iz predstopenjske v postopenjsko vrednost "
"prekrivnosti."

#. i18n: file: data/effects/lumakey.xml
