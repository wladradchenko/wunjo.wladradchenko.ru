msgstr "Filter ključenja HF"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7756
#, kde-format
msgid ""
"Controls the cutoff of<br>\n"
"      the high frequency filter (lowpass)"
msgstr ""
"Nadzoruje porezavo<br>\n"
"      visokofrekvenčnega filtra (nizkoprepustnega)"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7760
#, kde-format
msgid ""
"Controls the level at<br>\n"
"      which the gate will open"
msgstr ""
"Nadzoruje raven, pri<br>\n"
"      kateri se bodo vrata odprla"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7764
#, kde-format
msgid ""
"Controls the time the<br>\n"
"      gate will take to open fully"
msgstr ""
"Nadzoruje čas,<br>\n"
"      v katerem se bodo vrata popolnoma odprla"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7766
#, kde-format
msgid "Hold"
msgstr "Zadrži"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7768
#, kde-format
msgid ""
"Controls the minimum<br>\n"
"      time the gate will stay open for"
msgstr ""
"Nadzoruje najkrajši čas,<br>\n"
"      ko bodo vrata ostala odprta"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7772
#, kde-format
msgid ""
"Controls the time the<br>\n"
"      gate will take to close fully"
msgstr ""
"Nadzoruje čas,<br>\n"
"      da se vrata popolnoma zaprejo"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7776
#, kde-format
msgid ""
"Controls the difference<br>\n"
"      between the gate's open and closed state"
msgstr ""
"Nadzoruje razliko<br>\n"
"      med odprtim in zaprtim stanjem vrat"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7778
#, kde-format
msgid "Output Monitor"
msgstr "Izhodni pregled"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7780
#, kde-format
msgid "Controls output monitor"
msgstr "Nadzira izhodni pregled"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7782
#, kde-format
msgid "Key (listen),Gate (normal output),Bypass"
msgstr "Ključ (poslušaj),Vrata (navadni izhod),Obhod"

#. i18n: file: data/effects/ladspa/ladspa_1411.xml
#: rc.cpp:7786
#, kde-format
msgid "Comb Splitter"
msgstr "Razdelilnik s prečesavanjem"

#. i18n: file: data/effects/ladspa/ladspa_1411.xml
#: rc.cpp:7788
#, kde-format
msgid ""
"Comb Splitter (LADSPA 1411)<br>\n"
"   Divides the input up into two parts with frequency peaks at f Hz "
"intervals, skewed by f/2 Hz between the two outputs. Mixing the two outputs "
"will get you exactly the input signal."
msgstr ""
"Razdelilnik s prečesavanjem (LADSPA 1411)<br>\n"
"   Vhod razdeli na dva dela s frekvenčnimi vrhovi na f Hz intervalih, ki so "
"med dvema izhodoma nagnjeni za f/2 Hz. Mešanje obeh izhodov daje ravno tisti "
"vhodni signal."

#. i18n: file: data/effects/ladspa/ladspa_1411.xml
#: rc.cpp:7792
#, kde-format
msgid "The distance between the frequency peaks"
msgstr "Razdalja med vrhovi frekvenc"

#. i18n: file: data/effects/ladspa/ladspa_1415.xml
#: rc.cpp:7796
#, kde-format
msgid "FM Oscillator"
msgstr "Oscilator FM"

#. i18n: file: data/effects/ladspa/ladspa_1415.xml
#: rc.cpp:7798
#, kde-format
msgid "FM Oscillator (LADSPA 1415)"
msgstr "Oscilator FM (LADSPA 1415)"

#. i18n: file: data/effects/ladspa/ladspa_1415.xml
#: rc.cpp:7802
#, kde-format
msgid "The shape of the waveform"
msgstr "Oblika signalne oblike."

#. i18n: file: data/effects/ladspa/ladspa_1415.xml
#: rc.cpp:7804
#, kde-format
msgid "Sine,Triangle,Square,Saw"
msgstr "sinus,trikotnik,kvadrat,žaga"

#. i18n: file: data/effects/ladspa/ladspa_1423.xml
