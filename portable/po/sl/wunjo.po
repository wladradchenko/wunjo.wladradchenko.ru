#, kde-format
msgid "Input black level"
msgstr "Vhodna raven črnine"

#. i18n: file: data/effects/frei0r/frei0r_levels.xml
#: rc.cpp:3632 rc.cpp:3656 rc.cpp:3688 rc.cpp:3722
#, kde-format
msgid "Input white level"
msgstr "Vhodna raven beline"

