#. i18n: file: data/effects/ladspa/ladspa_1890.xml
#: rc.cpp:7950
#, kde-format
msgid "GLAME Highpass"
msgstr "Visokopasovni filter GLAME"

#. i18n: file: data/effects/ladspa/ladspa_1890.xml
#: rc.cpp:7952
#, kde-format
msgid ""
"GLAME Highpass Filter (LADSPA 1890)<br>\n"
"   IIR highpass filter based using Chebishev coefficients. The filter allows "
"you to tweak the number of stages used for filtering. Every stage adds two "
"more poles, which leads to a steeper dropoff."
msgstr ""
"Visoko prepustni filter GLAME (LADSPA 1890)<br>\n"
"   Visokoprepustni filter IIR temelji na Čebiševih koeficientih. Filter vam "
"omogoča prilagajanje števila stopenj, ki se uporabljajo za filtriranje. "
"Vsaka stopnja doda še dva stebra, kar vodi do strmejšega padca."

