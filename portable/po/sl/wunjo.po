#. i18n: file: data/effects/timer.xml
#: rc.cpp:2020
#, kde-format
msgid "Start (HH:MM:SS.SSS)"
msgstr "Začetek (UU:MM:SS,SSS)"

#. i18n: file: data/effects/timer.xml
#: rc.cpp:2022
#, kde-format
msgid ""
"The time that the timer will start counting up or down.<br>\n"
"        The text will be frozen at 00:00:00.000 from the start of the filter "
"until the start time has elapsed."
msgstr ""
"Čas, s katerim bo časovnik začel beležiti čas ali ga odštevati.<br>\n"
"        Besedilo bo zamrznjeno pri 00:00:00,000 od začetka filtra do "
"pretečenega začetnega časa."

#. i18n: file: data/effects/timer.xml
#: rc.cpp:2024 rc.cpp:2030 rc.cpp:2036
#, kde-format
msgid "HH:MM:SS.SSS"
msgstr "UU:MM:SS,SSS"

#. i18n: file: data/effects/timer.xml
#: rc.cpp:2026
#, kde-format
msgid "Duration (HH:MM:SS.SSS)"
msgstr "Trajanje (UU:MM:SS,SSS)"

#. i18n: file: data/effects/timer.xml
#: rc.cpp:2028
#, kde-format
msgid ""
"The maximum elapsed duration of the timer after the start time has elapsed."
"<br>\n"
"The text will be frozen at the duration time after the duration has elapsed."
msgstr ""
"Najdaljše trajanje časovnika po tem, ko je začetni čas pretekel.<br>\n"
"Besedilo bo zamrznjeno v času trajanja po tem, ko je trajanje preteklo."

#. i18n: file: data/effects/timer.xml
#: rc.cpp:2032
#, kde-format
msgid "Offset (HH:MM:SS.SSS)"
msgstr "Zamik (UU:MM:SS,SSS)"

#. i18n: file: data/effects/timer.xml
#: rc.cpp:2034
#, kde-format
msgid ""
"An offset to be added to the timer value.<br>\n"
"        When the direction is <i>Down</i>, the timer will count down to "
"<i>Offset</i> instead of 00:00:00.000.<br>\n"
"        When the direction is <i>Up</i>, the timer will count up starting "
"from <i>Offset</i>."
msgstr ""
"Zamik, ki bo dodan vrednosti časovnika.<br>\n"
"        Ko je smer <i>Navzdol</i>, bo časovnik odšteval do <i>odmika</i> "
"namesto od 00:00:00,000.\n"
"        Ko je smer <i>Navzgor</i>, bo časovnik štel od <i>odmika</i> naprej."

#. i18n: file: data/effects/timer.xml
#: rc.cpp:2040
#, kde-format
msgid ""
"Clock speed multiplier.<br>\n"
"        For example, speed 10.0 makes the timer tick 10 seconds for each "
"second of playback.<br><br>\n"
"        Scales Duration but does not affect <i>Start</i> or <i>Offset</i>. "
"For example: start 5s, duration 30s, offset 7s and speed 10.0 will have the "
"timer start at playback time 00:00:05.000 with value 00:00:07, count 10 "
"seconds per second of playback and stop at playback time 00:00:08.000 with "
"value 00:00:37."
msgstr ""
"Multiplikator hitrosti ure.<br>\n"
"        Primer: hitrost 10,0 povzroči 10 s tiktakanje za vsako sekundo "
"predvajanja.<br><br>\n"
"        Spremeni dolžino trajanja, vendar ne vpliva na <i>Začetek</i> ali "
"<i>Zamik</i>. Primer: začetek 5 s, trajanje 30 s, zamik 7 s in hitrost 10,0 "
"zaženejo časovnik pri predvajalnem času 00:00:05,000 z vrednostjo 00:00:07, "
"šteje 10 sekund na sekundo predvajanja in se ustavi pri predvajalnem času "
"00:00:08,000 z vrednostjo 00:00:37."

#. i18n: file: data/effects/timer.xml
#: rc.cpp:2044
#, kde-format
msgid ""
"Whether the counter should count up from 00:00:00.000 or down from the "
"duration time."
msgstr ""
"Ali naj števec beleži čas od 00:00:00,000 naprej ali naj odšteva od časa "
"trajanja."

