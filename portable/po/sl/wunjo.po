#: rc.cpp:2672
#, kde-format
msgid "Alignment pitch"
msgstr "Nagib za poravnavo"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2676
#, kde-format
msgid "Alignment roll"
msgstr "Kotaljenje za poravnavo"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2680
#, kde-format
msgid "Projection"
msgstr "Projekcija"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2682
#, kde-format
msgid ""
"The fisheye projection type. Currently only equidistant fisheyes, like the "
"Ricoh Theta and Garmin Virb360 are supported."
msgstr ""
"Vrsta projekcije ribjega očesa. Trenutno so podprte samo enako oddaljeni "
"ribji očesi, kot pri Ricoh Theta in Garmin Virb360."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2684
#, kde-format
msgid "Equidistant Fisheye"
msgstr "Ekvidistančno ribje oko"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2686
#, kde-format
msgid "Lens FOV"
msgstr "Vidno polje objektiva"

