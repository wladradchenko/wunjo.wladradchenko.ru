#: rc.cpp:1368 rc.cpp:3576
#, kde-format
msgid "Slope"
msgstr "Naklon"

#. i18n: file: data/effects/lumakey.xml
#: rc.cpp:1370
#, kde-format
msgid ""
"This defines the width of the<br>\n"
"      transition from prelevel to postlevel luma value. Start point of "
"transition in opacity value is threshold - slope and end point is thresholt "
"+ slope, values are forced in range 0 - 255."
msgstr ""
"Določa širino prehoda iz<br>\n"
"      predstopenjske v postopenjsko vrednost lume. Začetna točka prehoda v "
"vrednosti prekrivnosti je `prag - naklon`, končna točka pa `prag + naklon`, "
"vrednosti so vsiljene v območje 0-255."

#. i18n: file: data/effects/lumakey.xml
