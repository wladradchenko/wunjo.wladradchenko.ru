#: rc.cpp:7478 rc.cpp:7500 rc.cpp:7512 rc.cpp:7616 rc.cpp:7634 rc.cpp:7870
#: rc.cpp:8636
#, kde-format
msgid "Feedback"
msgstr "مؤشر الاستعمال"

#. i18n: file: data/effects/ladspa/ladspa_1190.xml
#: rc.cpp:7480
#, kde-format
msgid "Feedback level, increases the distinctive wooshy phaser sound."
msgstr "مستوى التغذية الراجعة، يزيد من صوت المزاح الطنان المميز."

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7486
#, kde-format
msgid ""
"Flanger (LADSPA 1191)<br>\n"
"   A digital flanger implementation. Uses a novel zero excursion, controlled "
"bandwidth modulation function, which should make the modulation less "
"repetitive and noticeable."
msgstr ""
"فلانجر (LADSPA 1191)<br>\n"
"تطبيق رقمي لتأثير الفلانجر. يستخدم وظيفة تعديل عرض النطاق الترددي المتحكم "
"بها، والتي تتميز بانعدام الحركة، مما يجعل التعديل أقل تكرارًا وأكثر وضوحًا."

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7488
#, kde-format
msgid "Delay Base"
msgstr "قاعدة التأخير"

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7490
#, kde-format
msgid ""
"This is the offset from<br>\n"
"      the input time that the detune delay moves around"
msgstr ""
"هذا هو الإزاحة من<br>\n"
"وقت الإدخال الذي يتحرك حوله تأخير الضبط"

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7492
#, kde-format
msgid "Max Slowdown"
msgstr "أقصى تباطؤ"

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7494
#, kde-format
msgid ""
"This is the maximum<br>\n"
"      delay that will be applied to the delayed signal, relative to the dry "
"signal."
msgstr ""
"هذا هو الحد الأقصى<br>\n"
"      للتأخير الذي سيتم تطبيقه على الإشارة المؤخرة، مقارنةً بالإشارة الأصلية."

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7496
#, kde-format
msgid "LFO Frequency"
msgstr "تردد المذبذب منخفض التردد"

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7498
#, kde-format
msgid ""
"This is the core frequency<br>\n"
"      that the 'LFO' will move at. The LFO isn't actually an oscillator, but "
"it does vary periodically."
msgstr ""
"هذه هي التردد الأساسي<br>\n"
"      الذي سيتحرك عنده «LFO». لا يُعد «LFO» في الواقع مذبذبًا، ولكنه يتغير "
"بشكل دوري."

#. i18n: file: data/effects/ladspa/ladspa_1191.xml
#: rc.cpp:7502
#, kde-format
msgid ""
"Feedback applied from the<br>\n"
"      output to the input, increases the depth of the effect, but makes it "
"sound less like a real flanger."
msgstr ""
"تطبيق التغذية الراجعة من <br>\n"
"      من المخرج إلى المدخل، يزيد من عمق التأثير، لكنه يجعل الصوت يبدو أقل "
"شبهاً بآلة الفلانجر الحقيقية."

#. i18n: file: data/effects/ladspa/ladspa_1192.xml
#: rc.cpp:7506
#, kde-format
msgid "Fractionally Addressed Delay Line"
msgstr "خط تأخير ذو عناوين كسرية"

#. i18n: file: data/effects/ladspa/ladspa_1192.xml
#: rc.cpp:7508
#, kde-format
msgid ""
"Fractionally Addressed Delay Line (LADSPA 1192)<br>\n"
"   Automatically adapts to the number of channels and sampling rate of the "
"consumer."
msgstr ""
"خط تأخير ذو عناوين كسرية (LADSPA 1192)<br>\n"
"   يتكيف آليًا مع عدد القنوات ومعدل أخذ العينات لدىالمستخدم."

#. i18n: file: data/effects/ladspa/ladspa_1195.xml
#. i18n: file: data/effects/ladspa/ladspa_declipper.xml
#: rc.cpp:7516 rc.cpp:8560
#, kde-format
msgid "Declipper"
msgstr "فك التحديد"

#. i18n: file: data/effects/ladspa/ladspa_1195.xml
#: rc.cpp:7518
#, kde-format
msgid ""
"Declipper (LADSPA 1195)<br>\n"
"   Removes nasty clicks from input signals, not very kind to them though."
msgstr ""
"مزيل التقليم (LADSPA 1195)<br>\n"
"   يزيل الطقطقات المزعجة من إشارات الدخل، ولكنه ليس لطيفًا معها تمامًا."

#. i18n: file: data/effects/ladspa/ladspa_1196.xml
#: rc.cpp:7522
#, kde-format
msgid "Fast Overdrive"
msgstr "تجاوز سريع"

#. i18n: file: data/effects/ladspa/ladspa_1196.xml
#: rc.cpp:7524
#, kde-format
msgid ""
"Fast Overdrive (LADSPA 1196)<br>\n"
"   A simple overdrive. Compresses the extreme peaks to make a sound similar "
"to an overdriven amplifier."
msgstr ""
"دفع مفرط سريع (LADSPA 1196)<br>\n"
"   دفع مفرط بسيط. يضغط الذرى القصوى ليجعل الصوت شبيهًا بمضخم صوت مدفوع بشكل "
"مفرط."

#. i18n: file: data/effects/ladspa/ladspa_1196.xml
#: rc.cpp:7526
#, kde-format
msgid "Drive Level"
msgstr "مستوى الدفع"

#. i18n: file: data/effects/ladspa/ladspa_1196.xml
#: rc.cpp:7528
#, kde-format
msgid ""
"Controls the point at<br>\n"
"      which the signal starts to distort, and the degree of distortion."
msgstr ""
"يتعلم في النقطة التي<br>\n"
"      تبدأ عندها الإشارة بالتشوه، ودرجة التشوه."

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7532
#, kde-format
msgid "Decimator"
msgstr "مُعشّر"

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7534
#, kde-format
msgid ""
"Decimator (LADSPA 1202)<br>\n"
"   Decimates (reduces the effective sample rate), and reduces the bit depth "
"of the input signal, allows non integer values for smooth transitions "
"between clean and lo-fi signals."
msgstr ""
"مُهلك (LADSPA 1202)<br>\n"
"   يُهلك (يقلل معدل العينات الفعلي)، ويقلل عمق البت لإشارة الدخل، ويسمح "
"بالقيم غير الصحيحة للانتقال السلس بين الإشارات النظيفة ومنخفضة الدقة (lo-fi)."

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7536
#, kde-format
msgid "Bit Depth"
msgstr "عمق البت"

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7538
#, kde-format
msgid "The bit depth that the signal will be reduced to"
msgstr "عمق البت الذي ستُقلّل إليه الإشارة"

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7540
#, kde-format
msgid "Sample Rate"
msgstr "معدّل الإعتيان"

#. i18n: file: data/effects/ladspa/ladspa_1202.xml
#: rc.cpp:7542
#, kde-format
msgid "The sample rate that the signal will be resampled at"
msgstr "معدل أخذ العينات الذي ستُعاد عينة الإشارة به"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7546
#, kde-format
msgid "Single Band Parametric"
msgstr "معلمي أحادي النطاق"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7548
#, kde-format
msgid ""
"Single Band Parametric (LADSPA 1203)<br>\n"
"   A single band of a parametric filter."
msgstr ""
"محدد معلمات أحادي النطاق (LADSPA 1203)<br>\n"
"   نطاق واحد لمرشح محدد المعلمات."

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7550
#, kde-format
msgid "Gain (dB)"
msgstr "الكسب (ديسيبل)"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7552
#, kde-format
msgid "The attenuation/gain of the eq"
msgstr "توهين/كسب المعادل"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7554
#, kde-format
msgid "Frequency (Hz)"
msgstr "التّردّد (هرتز)"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7556
#, kde-format
msgid ""
"The centre frequency (i.e. point of<br>\n"
"      most/least attenuation). Beware of high values for <i>Frequency</i> "
"and <i>Bandwidth</i>: if the high pitch (<i>Frequency</i> * 2^<i>Bandwidth</"
"i>) goes over half the sample rate, you will get aliasing."
msgstr ""
"التردد المركزي (أي نقطة التوهين<br>\n"
"      الأكبر/الأقل). احذر من القيم العالية لـ <i>التردد</i> و<i>عرض النطاق</"
"i>: إذا تجاوزت حدة الصوت العالية (<i>التردد</i> * 2^<i>عرض النطاق</i>) نصف "
"معدل العينات، فسيحدث تداخل في الترددات (aliasing)."

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7558
#, kde-format
msgid "Bandwidth (octaves)"
msgstr "عرض النطاق (أوكتافات)"

#. i18n: file: data/effects/ladspa/ladspa_1203.xml
#: rc.cpp:7560
#, kde-format
msgid ""
"The pitch difference from the<br>\n"
"      centre before the attenuation has reached half the <i>Gain</i>."
msgstr ""
"فرق حدة الصوت عن<br>\n"
"      المركز قبل أن يصل التوهين إلى نصف <i>الكسب</i>."

#. i18n: file: data/effects/ladspa/ladspa_1207.xml
#: rc.cpp:7564
#, kde-format
msgid "DC Offset Remover"
msgstr "مزيل إزاحة التيار المستمر"

#. i18n: file: data/effects/ladspa/ladspa_1207.xml
#: rc.cpp:7566
#, kde-format
msgid ""
"DC Offset Remover (LADSPA 1207)<br>\n"
"   Simply removes the DC (0 Hz) component from an audio signal, uses a high "
"pass filter, so has some side effects, but they should be minimal."
msgstr ""
"مزيل إزاحة التيار المستمر (LADSPA 1207)<br>\n"
"   يزيل ببساطة مكون التيار المستمر (0 هرتز) من الإشارة الصوتية، ويستخدم مرشح "
"تمرين العالي، لذا له بعض الآثار الجانبية، لكنها ستكون في حدها الأدنى."

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#: rc.cpp:7570
#, kde-format
msgid "Foldover Distortion"
msgstr "تشويه الطي"

#. i18n: file: data/effects/ladspa/ladspa_1213.xml
#: rc.cpp:7572
#, kde-format
msgid ""
"Foldover Distortion (LADSPA 1213)<br>\n"
"   Uses a sine wave approximation to simulate valve style foldover "
"distortion. Probably should have a <i>DC Offset Remover</i> on the output, "
"but it's not always necessary."
msgstr ""
"تشويه الالتفاف (LADSPA 1213)<br>\n"
"   يستخدم تقريب موجة جيبية لمحاكاة تشويه الالتفاف بأسلوب الصمامات. من "
"المحتمل أنه يحتاج إلى <i>مزيل إزاحة التيار المستمر</i> على الخرج، ولكنه ليس "
"ضروريًا دائمًا."

