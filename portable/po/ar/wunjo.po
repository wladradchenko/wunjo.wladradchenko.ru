#: rc.cpp:2688
#, kde-format
msgid "Back X"
msgstr "خلف س"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2690
#, kde-format
msgid ""
"The image center and image orientation for the back-facing camera.<br>\n"
"    \tThe X parameter is a fraction of the image width.."
msgstr ""
"مركز الصورة وتوجيهها للكاميرا الخلفية.<br>\n"
"    \tالمعلمة س هو كسر من عرض الصورة."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2692
#, kde-format
msgid "Back Y"
msgstr "خلف ص"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2694
#, kde-format
msgid ""
"The image center and image orientation for the back-facing camera.<br>\n"
"    \tThe Y parameter a fraction of the image height."
msgstr ""
"مركز الصورة وتوجيهها للكاميرا الخلفية.<br>\n"
"    \tالمعلمة ص هو كسر من ارتفاع الصورة."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2696
#, kde-format
msgid "Back Up"
msgstr "خلف أعلى"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2698
#, kde-format
msgid ""
"The image center and image orientation for the back-facing camera.<br>\n"
"    \tUp is the \"up\" direction in the image, in degrees clockwise from a "
"direction towards the frame top edge."
msgstr ""
"مركز الصورة وتوجيهها للكاميرا الخلفية.<br>\n"
"    \t\"أعلى\" هو الاتجاه في الصورة، بالدرجات مع عقارب الساعة من اتجاه نحو "
"حافة الإطار العليا."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2700
#, kde-format
msgid "Nadir radius"
msgstr "نصف قطر السمت"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2702 rc.cpp:2706
#, kde-format
msgid ""
"360 cameras like the Theta have a problem with the nadir direction where, no "
"matter what, you will have a little of the camera in the image.<br>\n"
"    \tThis parameter \"stretches\" the image near nadir to cover up the "
"missing parts."
msgstr ""
"الكاميرات 360 مثل Theta لديها مشكلة في اتجاه السمت حيث، بغض النظر عن أي شيء، "
"سوف تظهر الكاميرا قليلًا في الصورة.<br>\n"
"    \tيقوم هذا المعلم بـ \"تمديد\" الصورة بالقرب من السمت لتغطية الأجزاء "
"المفقودة."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2704
#, kde-format
msgid "Nadir start"
msgstr "بداية السمت"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2708
#, kde-format
msgid "Lens distortion A"
msgstr "تشوه العدسة A"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2710 rc.cpp:2714 rc.cpp:2718
#, kde-format
msgid ""
"Lens distortion correction parameters.<br>\n"
"    \tThe first three parameters are the same as in Hugin."
msgstr ""
"معلمات تصحيح تشوه العدسة.<br>\n"
"    \tالمعلمات الثلاث الأولى هي ذاتها في Hugin."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2712
#, kde-format
msgid "Lens distortion B"
msgstr "تشوه العدسة B"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2716
#, kde-format
msgid "Lens distortion C"
msgstr "تشوه العدسة C"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2720
#, kde-format
msgid "Lens distortion radius"
msgstr "نصف قطر تشوه العدسة"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2722
#, kde-format
msgid ""
"Lens distortion correction parameters.<br>\n"
"    \tIf you use Hugin parameters, the Radius should be set to the value of "
"(0.5 * min(image width, image height) / image width). For a 2:1 aspect dual "
"hemispherical image, that would be 0.25."
msgstr ""
"معلمات تصحيح تشوه العدسة.<br>\n"
"    \tإذا استخدمت معلمات Hugin، ينبغي ضبط نصف القطر على القيمة (0.5 * "
"min(عرض الصورة، ارتفاع الصورة) / عرض الصورة).لصورة ثنائية نصف كروية بنسبة "
"2:1، تكون القيمة 0.25."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2724
#, kde-format
msgid "Lens vignetting A"
msgstr "تظليل العدسة A"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2726 rc.cpp:2730 rc.cpp:2734 rc.cpp:2738
#, kde-format
msgid ""
"Lens vignetting correction parameters.<br>\n"
"    \tThe first four parameters are the same as in Hugin, corresponding to "
"the Va, Vb, Vc and Vd image parameters."
msgstr ""
"معلمات تصحيح تظليل العدسة.<br>\n"
"    \tالمعلمات الأربع الأولى هي ذاتها في Hugin، وتتوافق مع معلمات الصورة Va، "
"Vb، Vc، و Vd."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2728
#, kde-format
msgid "Lens vignetting B"
msgstr "تظليل العدسة B"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2732
#, kde-format
msgid "Lens vignetting C"
msgstr "تظليل العدسة C"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2736
#, kde-format
msgid "Lens vignetting D"
msgstr "تظليل العدسة D"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2740
#, kde-format
msgid "Lens vignetting radius"
msgstr "نصف قطر تظليل العدسة"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2742
#, kde-format
msgid ""
"If you use Hugin parameters, the radius should be set to the value of (0.5 * "
"image diagonal / image width).<br>\n"
"    \tFor a 2:1 aspect dual hemispherical image, that would be 0.5590. Use "
"the A parameter to scale the effect and avoid overexposing highlights"
msgstr ""
"إذا استخدمت معلمات Hugin، ينبغي ضبط نصف القطر على القيمة (0.5 * قطر الصورة / "
"عرض الصورة).<br>\n"
"    \tلصورة ثنائية نصف كروية بنسبة 2:1، تكون القيمة 0.5590.استخدم المعلم A "
"لتغيير حجم التأثير وتجنب تعريض الإضاءات الزائدة"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2744
#, kde-format
msgid "Use sensor response parameters"
msgstr "استخدم معلمات استجابة المستشعر"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2746
#, kde-format
msgid "Switch on to use sensor response parameters (EMoR h(x))"
msgstr "فعل لاستخدام معلمات استجابة المستشعر (EMoR h(x))"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2748
#, kde-format
msgid "EMoR h(1)"
msgstr "EMoR h(1)"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2750 rc.cpp:2754 rc.cpp:2758 rc.cpp:2762 rc.cpp:2766
#, kde-format
msgid ""
"Sensor response parameters.<br>\n"
"    \tThe EMoR h(x) parameters are the same as Hugin's Ra - Re in the lens "
"parameters. If you use Hugin-derived values for vignetting correction, you "
"should also use these parameters, as Hugin's vignetting correction assumes "
"that the sensor response has been corrected."
msgstr ""
"معلمات استجابة المستشعر.<br>\n"
"    \tتتطابق معلمات EMoR h(x) مع معلمات Hugin's Ra - Re في معلمات العدسة.إذا "
"استخدمت قيمًا مشتقة من Hugin لتصحيح التظليل،عليك أيضًا استخدام هذه المعلمات، "
"لأن تصحيح تظليل Hugin يفترض أن استجابة المستشعر جرى تصحيحها."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2752
#, kde-format
msgid "EMoR h(2)"
msgstr "EMoR h(2)"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2756
#, kde-format
msgid "EMoR h(3)"
msgstr "EMoR h(3)"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2760
#, kde-format
msgid "EMoR h(4)"
msgstr "EMoR h(4)"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2764
#, kde-format
msgid "EMoR h(5)"
msgstr "EMoR h(5)"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_rect_to_eq.xml
#: rc.cpp:2772
#, kde-format
msgid "VR360 Rectilinear to Equirectangular"
msgstr "VR360 من خطي إلى مستطيل متساوي"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_rect_to_eq.xml
#: rc.cpp:2774
#, kde-format
msgid ""
"Converts a rectilinear (a normal-looking) image to an equirectangular image. "
"Use this together with Transform 360 to place \"normal\" footage in a 360 "
"movie."
msgstr ""
"يحول صورة خطية (ذات مظهر طبيعي) إلى صورة مستطيلة متساوية.استخدم هذا مع تحويل "
"360 لوضع لقطات \"طبيعية\" في فيلم 360."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2784
#, kde-format
msgid "VR360 Stabilize"
msgstr "VR360 تثبيت"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2786
#, kde-format
msgid ""
"Stabilizes 360 footage.<br>\n"
"    The plugin works in two phases - analysis and stabilization. When "
"analyzing footage, it detects frame-to-frame rotation, and when stabilizing "
"it tries to correct high-frequency motion (shake)."
msgstr ""
"يثبت لقطات 360.<br>\n"
"    يعمل الملحق في مرحلتين - تحليل وتثبيت.عند تحليل اللقطات، يكتشف الدوران "
"من إطار إلى آخر،وعند التثبيت يحاول تصحيح الحركة عالية التردد (الاهتزاز)."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2788
#, kde-format
msgid "Analyze"
msgstr "حلل"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2790
#, kde-format
msgid "Switch on for analysis phase; switch off for stabilization phase."
msgstr "فعل لمرحلة التحليل؛ ألغِ التفعيل لمرحلة التثبيت."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2792
#, kde-format
msgid "Motion analysis file"
msgstr "ملف تحليل الحركة"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2794
#, kde-format
msgid "Select the file to store stabilization data in"
msgstr "اختر الملف لتخزين بيانات التثبيت فيه"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2796
#, kde-format
msgid "Start offset"
msgstr "بدء الإزاحة"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2798
#, kde-format
msgid ""
"The offset into the stabilization file that corresponds to the start of this "
"clip.<br>\n"
"    \tFor example, if you have a 30 second clip, analyze it all, and then "
"split it into three clips of 10 seconds each, then the start offsets should "
"be 0s, 10s, and 20s."
msgstr ""
"الإزاحة في ملف التثبيت الذي يتوافق مع بداية هذا المقطع.<br>\n"
"    \tعلى سبيل المثال، إذا كان لديك مقطع 30 ثانية، حلله بالكامل،ثم اقسمه إلى "
"ثلاثة مقاطع مدة كل منها 10 ثوانٍ،يجب أن تكون إزاحات البداية 0 ثانية، 10 ثوانٍ، "
"و 20 ثانية."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2800
#, kde-format
msgid "Analysis sample radius"
msgstr "نصف قطر عينة التحليل"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2802
#, kde-format
msgid "The radius of the square that the stabilizer will sample"
msgstr "نصف قطر المربع الذي سيأخذ منه المثبت عينة"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2804
#, kde-format
msgid "Analysis search radius"
msgstr "نصف قطر بحث التحليل"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2806
#, kde-format
msgid "The maximum amount of motion the stabilizer will detect"
msgstr "الحد الأقصى للحركة الذي سيكتشفه المثبت"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2808
#, kde-format
msgid "Analysis offset"
msgstr "إزاحة التحليل"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2810
#, kde-format
msgid "The distance between the track points"
msgstr "المسافة بين نقاط التتبع"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2812
#, kde-format
msgid "Use backwards-facing track points"
msgstr "استخدم نقاط تتبع مواجهة للخلف"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2814
#, kde-format
msgid ""
"If set, six backwards-facing track points will also be used to detect pitch "
"and yaw motion.<br>\n"
"    \tDisable if, for example, you show up holding the camera there"
msgstr ""
"إن ضبطت، ستستخدم أيضًا ست نقاط تتبع مواجهة للخلف لاكتشاف حركة الميل والانحراف."
"<br>\n"
"    \tأوقفها إن، على سبيل المثال، ظهرت حاملًا الكاميرا هناك"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2816
#, kde-format
msgid "Yaw amount"
msgstr "مقدار الانحراف"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2818 rc.cpp:2842
#, kde-format
msgid ""
"The amount of stabilization to apply.<br>\n"
"    \t100% means that the stabilizer will make the camera as steady as it "
"can. Smaller values reduce the amount of stabilization."
msgstr ""
"مقدار التثبيت للتطبيق.<br>\n"
"    \t100% تعني أن المثبت سيجعل الكاميرا ثابتة قدر الإمكان.القيم الأصغر تقلل "
"من مقدار التثبيت."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2820
#, kde-format
msgid "Yaw smoothing"
msgstr "تنعيم الانحراف"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2822
#, kde-format
msgid ""
"The number of frames to use to smooth out the shakes. The higher the value, "
"the slower the camera will follow any intended motion."
msgstr ""
"عدد الإطارات التي تستخدم لتنعيم الاهتزازات.كلما زادت القيمة، كلما أبطأ "
"الكاميرا في تتبع أي حركة مقصودة."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2824
#, kde-format
msgid "Yaw time bias"
msgstr "تحيز وقت الانحراف"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2826 rc.cpp:2838 rc.cpp:2850
#, kde-format
msgid ""
"Shift the frames used to smooth out the shakes relative to the stabilized "
"frame.<br>\n"
"    \tA value less than zero will give more weight to past frames, and the "
"camera will seem to lag behind intended movement. A value greater than zero "
"will give more weight to future frames, and the camera will appear to move "
"ahead of the intended camera movement. A value of zero should make the "
"camera follow the intended path."
msgstr ""
"أزح الإطارات المستخدمة لتنعيم الاهتزازات بالنسبة للإطار المثبت.<br>\n"
"    \tقيمة أقل من الصفر ستعطي وزنًا أكبر للإطارات السابقة،وستبدو الكاميرا "
"وكأنها تتخلف عن الحركة المقصودة.قيمة أكبر من الصفر ستعطي وزنًا أكبر للإطارات "
"المستقبلية،وستبدو الكاميرا وكأنها تتحرك قبل حركة الكاميرا المقصودة.قيمة صفر "
"ستجعل الكاميرا تتبع المسار المقصود."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2828
#, kde-format
msgid "Pitch amount"
msgstr "مقدار الميل"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2830
#, kde-format
msgid ""
"The amount of stabilization to apply. 100% means that the stabilizer will "
"make the camera as steady as it can. Smaller values reduce the amount of "
"stabilization."
msgstr ""
"مقدار التثبيت للتطبيق.100% تعني أن المثبت سيجعل الكاميرا ثابتة قدر الإمكان."
"القيم الأصغر تقلل من مقدار التثبيت."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2832
#, kde-format
msgid "Pitch smoothing"
msgstr "تنعيم الميل"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2834 rc.cpp:2846
#, kde-format
msgid ""
"The number of frames to use to smooth out the shakes.<br>\n"
"    \tThe higher the value, the slower the camera will follow any intended "
"motion."
msgstr ""
"عدد الإطارات التي تستخدم لتنعيم الاهتزازات.<br>\n"
"    \tكلما زادت القيمة، كلما أبطأ الكاميرا في تتبع أي حركة مقصودة."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2836
#, kde-format
msgid "Pitch time bias"
msgstr "تحيز وقت الميل"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2840
#, kde-format
msgid "Roll amount"
msgstr "مقدار الدحرجة"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2844
#, kde-format
msgid "Roll smoothing"
msgstr "تنعيم الدحرجة"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_stabilize_360.xml
#: rc.cpp:2848
#, kde-format
msgid "Roll time bias"
msgstr "تحيز وقت الدحرجة"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_transform_360.xml
#: rc.cpp:2856
#, kde-format
msgid "VR360 Transform"
msgstr "VR360 تحويل"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_transform_360.xml
#: rc.cpp:2858
#, kde-format
msgid "Rotates a panoramic image"
msgstr "يدور صورة بانورامية"

#. i18n: file: data/effects/frei0r/frei0r_bluescreen0r.xml
#: rc.cpp:2878
#, kde-format
msgid "Blue Screen (Color to Alpha)"
msgstr "شاشة زرقاء (لون إلى ألفا)"

#. i18n: file: data/effects/frei0r/frei0r_bluescreen0r.xml
#: rc.cpp:2880
#, kde-format
msgid "Turns the selected color into alpha making it transparent."
msgstr "يحول اللون المختار إلى ألفا لجعله شفافًا."

#. i18n: file: data/effects/frei0r/frei0r_bluescreen0r.xml
#: rc.cpp:2886
#, kde-format
msgid "Distance to Color"
msgstr "مسافة إلى اللون"

#. i18n: file: data/effects/frei0r/frei0r_brightness.xml
#: rc.cpp:2888
#, kde-format
msgctxt "Brightness Effect Name"
msgid "Brightness"
msgstr "السطوع"

#. i18n: file: data/effects/frei0r/frei0r_brightness.xml
#: rc.cpp:2890
#, kde-format
msgid "Adjusts the brightness of a source image"
msgstr "يعدل سطوع صورة مصدر"

#. i18n: file: data/effects/frei0r/frei0r_bw0r.xml
#: rc.cpp:2894
#, kde-format
msgid "BW0r"
msgstr "BW0r"

#. i18n: file: data/effects/frei0r/frei0r_bw0r.xml
#: rc.cpp:2896
#, kde-format
msgid "Turns image black and white"
msgstr "يُحوّل الصورة إلى الأسود والأبيض"

#. i18n: file: data/effects/frei0r/frei0r_c0rners.xml
#: rc.cpp:2898
#, kde-format
msgctxt "Corners Effect Name"
msgid "Corners"
msgstr "الزّوايا"

#. i18n: file: data/effects/frei0r/frei0r_c0rners.xml
#: rc.cpp:2900
