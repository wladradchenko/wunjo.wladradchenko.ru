#: rc.cpp:2652 rc.cpp:2656 rc.cpp:2660
#, kde-format
msgid ""
"The two fisheye cameras of a 360 camera are rarely perfectly 180 degrees "
"apart.<br>\n"
"    \tThese parameters adds a rotation to both lenses to correct for this."
msgstr ""
"كاميرات عين السمكة الاثنتين في كاميرا 360 نادرًا ما تكون متباعدة تمامًا بـ 180 "
"درجة.<br>\n"
"    \tتضيف هذه المعلمات دورانًا لكلتا العدستين لتصحيح ذلك."

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2654
#, kde-format
msgid "Alignment pitch"
msgstr "ميل المحاذاة"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2658
#, kde-format
msgid "Alignment roll"
msgstr "دحرجة المحاذاة"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2662
#, kde-format
msgid "Projection"
msgstr "الإسقاط"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_hemi_to_eq.xml
#: rc.cpp:2664
#, kde-format
