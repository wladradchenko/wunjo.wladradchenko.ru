msgstr "أقصى تأخير"

#. i18n: file: data/effects/ladspa/ladspa_1887.xml
#. i18n: file: data/effects/ladspa/ladspa_1888.xml
#. i18n: file: data/effects/ladspa/ladspa_1889.xml
#: rc.cpp:7890 rc.cpp:7906 rc.cpp:7922
#, kde-format
msgid ""
"Maximum delay.<br>\n"
"      Used to set the delay buffer size upon activation. Cannot be modulated."
msgstr ""
"التأخير الأقصى.<br>\n"
"      يُستخدم لضبط حجم المخزن المؤقت للتأخير عند التنشيط. لا يمكن تضمينه."

#. i18n: file: data/effects/ladspa/ladspa_1887.xml
