#: rc.cpp:5570 rc.cpp:6972
#, kde-format
msgid "Alpha threshold"
msgstr "عتبة ألفا"

#. i18n: file: data/effects/avfilter/avfilter_deblock.xml
#: rc.cpp:5572
#, kde-format
