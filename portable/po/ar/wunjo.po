msgstr "تبديل المخارج"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8222
#, kde-format
msgid "L Delay"
msgstr "تأخير اليسار"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8224
#, kde-format
msgid "L Feedback"
msgstr "تغذية اليسار"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8226
#, kde-format
msgid "R/Haas Delay"
msgstr "تأخير يمين/هاس"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8228
#, kde-format
msgid "R/Haas Feedback"
msgstr "تغذية اليمين/هاس"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8230
#, kde-format
msgid "L Echo Level"
msgstr "مستوى صدى اليسار"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8232
#, kde-format
msgid "R Echo Level"
msgstr "مستوى صدى اليمين"

#. i18n: file: data/effects/ladspa/ladspa_2144.xml
#: rc.cpp:8238
#, kde-format
msgid "TAP Tremolo"
msgstr "TAP Tremolo"

#. i18n: file: data/effects/ladspa/ladspa_2144.xml
#: rc.cpp:8240
#, kde-format
msgid ""
"TAP Tremolo (LADSPA 2144)<br>\n"
"   Sounds good mainly on acoustic or electric guitar tracks."
msgstr ""
"TAP Tremolo (LADSPA 2144)<br>\n"
"   يبدو جيدًا بشكل أساسي على مسارات الغيتار الصوتي أو الكهربائي."

#. i18n: file: data/effects/ladspa/ladspa_2145.xml
#: rc.cpp:8250
#, kde-format
msgid "TAP Scaling Limiter"
msgstr "محدد المقياس TAP"

#. i18n: file: data/effects/ladspa/ladspa_2145.xml
#: rc.cpp:8252
#, kde-format
msgid ""
"TAP Scaling Limiter (LADSPA 2145)<br>\n"
"   Achieves signal level limiting without audible artifacts."
msgstr ""
"محدد المقياس TAP (LADSPA 2145)<br>\n"
"   يحقق تحديد مستوى الإشارة دون مؤثرات صوتية مسموعة."

#. i18n: file: data/effects/ladspa/ladspa_2145.xml
#: rc.cpp:8254
#, kde-format
msgid "Limit Level"
msgstr "مستوى الحد"

#. i18n: file: data/effects/ladspa/ladspa_2145.xml
#: rc.cpp:8256
#, kde-format
msgid "Output Volume"
msgstr "مستوى صوت الإخراج"

#. i18n: file: data/effects/ladspa/ladspa_2146.xml
#: rc.cpp:8260
#, kde-format
msgid "TAP AutoPanner"
msgstr "TAP AutoPanner"

#. i18n: file: data/effects/ladspa/ladspa_2146.xml
#: rc.cpp:8262
#, kde-format
msgid ""
"TAP AutoPanner (LADSPA 2146)<br>\n"
"   Main use is to liven up synth tracks in the mix"
msgstr ""
"TAP AutoPanner (LADSPA 2146)<br>\n"
"   الاستخدام الرئيس هو لإضفاء الحيوية على مسارات المُركِّب الصوتي في المزيج"

#. i18n: file: data/effects/ladspa/ladspa_2146.xml
#: rc.cpp:8268
#, kde-format
msgid ""
"Sets the wideness of panning.<br>\n"
"      A setting of 100% means that mono input signal is panned between the "
"extreme left and right positions"
msgstr ""
"يضبط اتساع التحريك.<br>\n"
"      إعداد 100% يعني تحريك إشارة إدخال المونو بين موضعي أقصى اليسار واليمين"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8274
#, kde-format
msgid "TAP DeEsser"
msgstr "مزيل الصفير TAP"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8276
#, kde-format
msgid ""
"TAP DeEsser (LADSPA 2147)<br>\n"
"   Used for attenuating higher pitched frequencies in vocals such as those "
"found in 'ess', 'shh' and 'chh' sounds."
msgstr ""
"مزيل الصفير TAP (LADSPA 2147)<br>\n"
"   يستعمل لتخفيف الترددات الأعلى نغمة في الأصوات مثل تلك الموجودة في أصوات "
"'ess' و 'shh' و 'chh'."

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8278
#, kde-format
msgid "Threshold Level"
msgstr "مستوى العتبة"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8282
#, kde-format
msgid "Sidechain Filter"
msgstr "مرشح السلسلة الجانبية"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8284
#, kde-format
msgid ""
"The chosen filter's frequency<br>\n"
"      is set by the <b>Frequency</b> parameter"
msgstr ""
"تردّد المرشح المختار<br>\n"
"      يضبطه معلمة <b>التردد</b>"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8286
#, kde-format
msgid "Highpass,Bandpass"
msgstr "يمرّر-عالي, يمرّر-شريطي"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8288
#, kde-format
msgid "Monitor On"
msgstr "تشغيل الشاشة"

#. i18n: file: data/effects/ladspa/ladspa_2148.xml
#: rc.cpp:8292
#, kde-format
msgid "TAP Vibrato"
msgstr "اهتزاز TAP"

#. i18n: file: data/effects/ladspa/ladspa_2148.xml
#: rc.cpp:8294
#, kde-format
msgid ""
"TAP Vibrato (LADSPA 2148)<br>\n"
"   Modulates the pitch of its input signal with a low-frequency sinusoidal "
"signal. It is useful for guitar and synth tracks, and it can also come handy "
"if a strange effect is needed."
msgstr ""
"اهتزاز TAP (LADSPA 2148)<br>\n"
"   يعدّل نغمة إشارة الإدخال بإشارة جيبية منخفضة التردد. يفيد لمسارات الغيتار "
"والمُركِّب الصوتي، ويمكن أن يكون مفيدًا إذا احتاج الأمر لتأثير غريب."

#. i18n: file: data/effects/ladspa/ladspa_2148.xml
#: rc.cpp:8298
#, kde-format
msgid "Determines how fast the pitch is modulated up-down"
msgstr "يحدد سرعة تعديل النغمة للأعلى والأسفل"

#. i18n: file: data/effects/ladspa/ladspa_2148.xml
#: rc.cpp:8302
#, kde-format
msgid "Sets the amount of pitch modulation"
msgstr "يضبط مقدار تعديل النغمة"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8310
#, kde-format
msgid "TAP Rotary Speaker"
msgstr "مكبر صوت دوار TAP"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8312
#, kde-format
msgid ""
"TAP Rotary Speaker (LADSPA 2149)<br>\n"
"   Simulates the sound of rotating speakers."
msgstr ""
"TAP Rotary Speaker (LADSPA 2149)<br>\n"
"   يحاكي صوت مكبرات الصوت الدوّارة."

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8314
#, kde-format
msgid "Rotor Frequency"
msgstr "تردد الدوّار"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8316
#, kde-format
msgid "Horn Frequency"
msgstr "تردد البوق"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8318
#, kde-format
msgid "Mic Distance"
msgstr "مسافة الميكروفون"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8320
#, kde-format
msgid "Rotor/Horn Mix"
msgstr "مزج الدوّار/البوق"

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8324
#, kde-format
msgid "TAP Pitch Shifter"
msgstr "مزيح نغمة TAP"

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8326
#, kde-format
msgid ""
"TAP Pitch Shifter (LADSPA 2150)<br>\n"
"   Change the pitch in the range of plus/minus one octave."
msgstr ""
"مزيح نغمة TAP (LADSPA 2150)<br>\n"
"   يغيّر النغمة في نطاق زائد/ناقص أوكتاف واحد."

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8328
#, kde-format
msgid "Semitone Shift"
msgstr "إزاحة نصف النغمة"

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8330
#, kde-format
msgid ""
"Does the same thing as <b>Rate Shift</b></br>\n"
"      but allows to set musically sensible pitch shift rates."
msgstr ""
"يفعل الشيء نفسه الذي تفعله <b>إزاحة المعدل</b></br> \n"
"      لكنه يسمح بضبط معدلات إزاحة نغمة معقولة موسيقيًا."

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8332
#, kde-format
msgid "Rate Shift"
msgstr "إزاحة المعدل"

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8334
#, kde-format
msgid ""
"Does the same thing as <b>Semitone Shift</b><br>\n"
"      but in percentage of the original pitch, so that is closer to a "
"\"physical\", non-musical approach"
msgstr ""
"يفعل الشيء نفسه الذي تفعله <b>إزاحة نصف النغمة</b><br>\n"
"      لكن كنسبة مئوية من النغمة الأصلية، مما يجعله أقرب إلى نهج \"مادي\" غير "
"موسيقي"

#. i18n: file: data/effects/ladspa/ladspa_2151.xml
#: rc.cpp:8342
#, kde-format
msgid "TAP Equalizer/BW"
msgstr "موازن TAP/BW"

#. i18n: file: data/effects/ladspa/ladspa_2151.xml
#: rc.cpp:8344
#, kde-format
msgid ""
"TAP Equalizer (LADSPA (2151)<br>\n"
"    8-band equalizer with adjustable band center frequencies and bandwidth."
msgstr ""
"موازن TAP (LADSPA (2151)<br>\n"
"    موازن 8 نطاقات بترددات مركز النطاق وعرض النطاق قابلة للتعديل."

#. i18n: file: data/effects/ladspa/ladspa_2151.xml
#: rc.cpp:8350 rc.cpp:8356 rc.cpp:8362 rc.cpp:8368 rc.cpp:8374 rc.cpp:8380
#: rc.cpp:8386 rc.cpp:8392
#, kde-format
msgid "BW"
msgstr "أسود أبيض"

#. i18n: file: data/effects/ladspa/ladspa_2151.xml
#: rc.cpp:8360
#, kde-format
msgid "<Gain"
msgstr "<الكسب"

#. i18n: file: data/effects/ladspa/ladspa_2152.xml
#: rc.cpp:8396
#, kde-format
msgid "TAP Dynamics (M)"
msgstr "ديناميكيات TAP (مونو)"

#. i18n: file: data/effects/ladspa/ladspa_2152.xml
#: rc.cpp:8398
#, kde-format
msgid ""
"TAP Dynamics Mono (LADSPA 2152)<br>\n"
"   Allows changing the dynamic content of the audio stream"
msgstr ""
"ديناميكيات TAP مونو (LADSPA 2152)<br>\n"
"   يسمح بتغيير المحتوى الديناميكي لتيار الصوت"

#. i18n: file: data/effects/ladspa/ladspa_2152.xml
#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8404 rc.cpp:8422
#, kde-format
msgid "Offset Gain"
msgstr "كسب الإزاحة"

#. i18n: file: data/effects/ladspa/ladspa_2152.xml
#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8406 rc.cpp:8424
#, kde-format
msgid "Makeup Gain"
msgstr "كسب التحسين"

#. i18n: file: data/effects/ladspa/ladspa_2152.xml
#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8408 rc.cpp:8432
#, kde-format
msgid "Dynamics Transfer Function"
msgstr "دالة نقل الديناميكيات"

#. i18n: file: data/effects/ladspa/ladspa_2152.xml
#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8410 rc.cpp:8434
#, kde-format
msgid ""
"2:1 comp at -6dB,2:1 comp at -9dB,2:1 comp at -12dB,2:1 comp at -18dB,2.5 "
"comp at -18dB,3:1 comp at -12dB,3:1 comp at -15dB,Compressor/Gate,Expander,"
"Hard limiter at -6dB;Hard limiter at -12dB;Hard gate at -35dB;Soft limiter;"
"Soft knee comp/gate;Softgate below -36dB"
msgstr ""
"2:1 ضاغط عند -6dB,2:1 ضاغط عند -9dB,2:1 ضاغط عند -12dB,2:1 ضاغط عند "
"-18dB,2.5 ضاغط عند -18dB,3:1 ضاغط عند -12dB,3:1 ضاغط عند -15dB,ضاغط/بوابة,"
"موسّع,محدّد قاس عند -6dB;محدّد قاس عند -12dB;بوابة قاسية عند -35dB;محدّد ناعم;"
"ضاغط/بوابة بركبة ناعمة;بوابة ناعمة تحت -36dB"

#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8414
#, kde-format
msgid "TAP Dynamics (St)"
msgstr "ديناميكيات TAP (ستيريو)"

#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8416
#, kde-format
msgid ""
"TAP Dynamics Stereo (LADSPA 2153)<br>\n"
"   Allows changing the dynamic content of the audio stream"
msgstr ""
"ديناميكيات TAP ستيريو (LADSPA 2153)<br>\n"
"   يسمح بتغيير المحتوى الديناميكي لتيار الصوت"

#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8428
#, kde-format
msgid ""
"Controls how the envelope levels<br>\n"
"      are used to determine the needed gain adjustment"
msgstr ""
"يتحكّم بكيفية استخدام مستويات الغلاف<br>\n"
"      لتحديد ضبط الكسب المطلوب"

#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8430
#, kde-format
msgid "Independent,Average,Peak"
msgstr "مستقل,معدّل,ذروة"

#. i18n: file: data/effects/ladspa/ladspa_2154.xml
#: rc.cpp:8438
#, kde-format
msgid "TAP Reflector"
msgstr "عاكس TAP"

#. i18n: file: data/effects/ladspa/ladspa_2154.xml
#: rc.cpp:8440
#, kde-format
msgid ""
"TAP Reflector (LADSPA 2154)<br>\n"
"    Creates a psychedelic reverse audio effect."
msgstr ""
"عاكس TAP (LADSPA 2154)<br>\n"
"    ينشئ تأثير صوت عكسي سيكاديلك."

#. i18n: file: data/effects/ladspa/ladspa_2154.xml
#: rc.cpp:8442
#, kde-format
msgid "Fragment Length"
msgstr "طول الجزء"

#. i18n: file: data/effects/ladspa/ladspa_2154.xml
#: rc.cpp:8444
#, kde-format
msgid ""
"It is best to set it to<br>\n"
"      approximately match the tempo of the track, so the Fragment Length is "
"equal to the time of one measure."
msgstr ""
"من الأفضل ضبطه لـ<br>\n"
"      يتطابق تقريبًا مع إيقاع المسار، لذا طول الجزء يساوي وقت مقياس واحد."

#. i18n: file: data/effects/ladspa/ladspa_2155.xml
#: rc.cpp:8452
#, kde-format
msgid "TAP Pink/Fractal Noise"
msgstr "ضوضاء TAP وردية/كسيرية"

#. i18n: file: data/effects/ladspa/ladspa_2155.xml
#: rc.cpp:8454
#, kde-format
msgid ""
"TAP Pink/Fractal Noise (LADSPA 2155)<br>\n"
"    Adds pink noise to the incoming signal using a one-dimensional random "
"fractal line generated by the Midpoint Displacement Method."
msgstr ""
"ضوضاء TAP وردية/كسيرية (LADSPA 2155)<br>\n"
"    يضيف ضوضاء وردية إلى الإشارة الواردة باستخدام خط كسيري عشوائي أحادي "
"البعد يولّد بطريقة إزاحة نقطة المنتصف."

#. i18n: file: data/effects/ladspa/ladspa_2155.xml
#: rc.cpp:8456
#, kde-format
msgid "Fractal Dimension"
msgstr "بعد كسيري"

#. i18n: file: data/effects/ladspa/ladspa_2155.xml
#: rc.cpp:8458
#, kde-format
msgid "Signal Level"
msgstr "مستوى الإشارة"

#. i18n: file: data/effects/ladspa/ladspa_2155.xml
#: rc.cpp:8460
#, kde-format
msgid "Noise Level"
msgstr "مستوى الضوضاء"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8464
#, kde-format
msgid "TAP Fractal Doubler"
msgstr "مضاعف كسيري TAP"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8466
#, kde-format
msgid ""
"TAP Fractal Doubler (LADSPA 2156)<br>\n"
"    Suitable for doubling tracks with vocals, acoustic/electric guitars, "
"bass and just about any other instrument on them."
msgstr ""
"مضاعف كسيري TAP (LADSPA 2156)<br>\n"
"    مناسب لمضاعفة المسارات التي تحتوي على أصوات وغيتارات صوتية/كهربائية "
"وجهير وأي آلة أخرى تقريبًا."

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8468
#, kde-format
msgid "Time Tracking"
msgstr "تتبع الوقت"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8470 rc.cpp:8474
#, kde-format
msgid ""
"Determines how \"rough\" and how big<br>\n"
"      these changes are. When set to 0, changes are bigger and more chaotic "
"(\"bad backup singer\"). When set to 1, changes are smaller and smoother "
"(\"better tracking of the original\")."
msgstr ""
"يحدد مدى \"خشونة\" وحجم<br>\n"
"      هذه التغييرات. عند الضبط على 0، التغييرات أكبر وأكثر فوضوية (\"مغنّي "
"مساعد سيئ\"). عند الضبط على 1، التغييرات أصغر وأكثر سلاسة (\"تتبّع أفضل "
"للأصل\")."

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8472
#, kde-format
