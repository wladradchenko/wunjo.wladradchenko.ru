msgstr "طبِّق زخرفة تسطير على النص."

#. i18n: file: data/effects/gpstext.xml
#: rc.cpp:1166
#, kde-format
msgid "Apply strikethrough decoration to the text."
msgstr "طبِّق زخرفة شطب على النص."

#. i18n: file: data/effects/gpstext.xml
#: rc.cpp:1172
