#: rc.cpp:7668
#, kde-format
msgid "The level of delayed sound mixed into the output"
msgstr "مستوى الصوت المؤخر المخلوط في الخرج"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#: rc.cpp:7672
#, kde-format
msgid "Dyson Compressor"
msgstr "ضاغط دايسون"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#: rc.cpp:7674
#, kde-format
msgid "Dyson Compressor (LADSPA 1403)"
msgstr "ضاغط دايسون (LADSPA 1403)"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#: rc.cpp:7676
#, kde-format
msgid "Peak Limit"
msgstr "حد الذروة"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#: rc.cpp:7678
#, kde-format
msgid ""
"Controls the desired limit<br>\n"
"      of the output signal"
msgstr ""
"يتحكم في الحد المطلوب<br>\n"
"      لإشارة الخرج"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#. i18n: file: data/effects/ladspa/ladspa_1913.xml
#: rc.cpp:7680 rc.cpp:8138
#, kde-format
msgid "Release Time"
msgstr "وقت الإطلاق"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#: rc.cpp:7682
#, kde-format
msgid ""
"Controls the time taken for<br>\n"
"      the compressor to relax its gain control over the input signal"
msgstr ""
"يتحكم في الوقت الذي يستغرقه<br>\n"
"      الضاغط لإرخاء تحكمه في الكسب على إشارة الدخل"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#: rc.cpp:7684
#, kde-format
msgid "Fast Compression Ratio"
msgstr "نسبة الضغط السريع"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#: rc.cpp:7686
#, kde-format
msgid "Compression Ratio"
msgstr "نسبة الضغط"

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7690
#, kde-format
msgid "Crossover Distortion"
msgstr "تشويه التقاطع"

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7692
#, kde-format
msgid ""
"Crossover Distortion (LADSPA 1404)<br>\n"
"   This is a simulation of the distortion that happens in class B and AB "
"power amps when the signal crosses 0."
msgstr ""
"تشويه العبور (LADSPA 1404)<br>\n"
"   هذا محاكاة للتشويه الذي يحدث في مضخمات الطاقة من الفئة B و AB عندما تعبر "
"الإشارة الصفر."

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7694
#, kde-format
msgid "Crossover Amplitude"
msgstr "سعة التقاطع"

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7696
#, kde-format
msgid "Controls the point at which the output signal becomes linear"
msgstr "يتحكم في النقطة التي يصبح عندها إشارة الخرج خطية"

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7700
#, kde-format
msgid "Controls degree of smoothing of the crossover point"
msgstr "يتحكم في درجة تنعيم نقطة التقاطع"

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7704
#, kde-format
msgid "Aliasing"
msgstr "الصقل"

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7706
#, kde-format
msgid ""
"Aliasing (LADSPA 1407)<br>\n"
"   Simulates aliasing using nyquist frequency modulation. Produces wacky "
"results if the blocks aren't even numbers of samples long."
msgstr ""
"تداخل الترددات (LADSPA 1407)<br>\n"
"   يحاكي تداخل الترددات باستخدام تضمين تردد نايغويست. ينتج نتائج غريبة إذا "
"لم تكن الكتل ذات أعداد زوجية من طول العينات."

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7708
#, kde-format
msgid "Aliasing Level"
msgstr "مستوى التشويش"

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7710
#, kde-format
msgid "Controls the amount of simulated aliasing in the output."
msgstr "يتحكم في مقدار التشويش المُحاكى في الخرج."

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7714
#, kde-format
msgid "Barry's Satan Maximiser"
msgstr "مُعظِم باري الشيطاني"

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7716
#, kde-format
msgid ""
"Barry's Satan Maximiser (LADSPA 1408)<br>\n"
"   Compresses signals with a stupidly short attack and decay, infinite ratio "
"and hard knee. Not really as a compressor, but good harsh (non-musical) "
"distortion."
msgstr ""
"معظم شيطان باري (LADSPA 1408)<br>\n"
"   يضغط الإشارات بزمن هجوم واضمحلال قصير للغاية، ونسبة لانهائية وركبة صلبة. "
"لا يعمل كضاغط حقًا، ولكنه تشويه خشن جيد (غير موسيقي)."

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7718
#, kde-format
msgid "Decay Time (samples)"
msgstr "زمن الانحلال (عينات)"

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7720
#, kde-format
msgid "Controls the envelope decay time."
msgstr "يتحكم في زمن انحلال الغلاف."

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7722
#, kde-format
msgid "Knee Point"
msgstr "نقطة الركبة"

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7724
#, kde-format
msgid ""
"Controls the knee roll-off point,<br>\n"
"      ie. the point above which the compression kicks in. 0 will have no "
"effect, -90 will remove virtually all dynamic range."
msgstr ""
"يتحكم في نقطة هبوط الركبة،<br>\n"
"      أي النطاق الذي يبدأ عنده الضاغط بالعمل. القيمة 0 لن يكون لها تأثير، "
"والقيمة -90 ستزيل كامل النطاق الديناميكي تقريبًا."

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7728
#, kde-format
msgid "Gate"
msgstr "البوابة"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7730
#, kde-format
msgid "Gate (LADSPA 1410)"
msgstr "البوابة (LADSPA 1410)"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7732
#, kde-format
msgid "LF Key Filter"
msgstr "مرشح المفتاح منخفض التردد"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7734
#, kde-format
msgid ""
"Controls the cutoff of<br>\n"
"      the low frequency filter (highpass)"
msgstr ""
"يتحكم في قطع<br>\n"
"      مرشح الترددات المنخفضة (تمرير عالي)"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7736
#, kde-format
msgid "HF Key Filter"
msgstr "مرشح المفتاح عالي التردد"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7738
#, kde-format
msgid ""
"Controls the cutoff of<br>\n"
"      the high frequency filter (lowpass)"
msgstr ""
"يتحكم في قطع<br>\n"
"      مرشح الترددات العالية (تمرير منخفض)"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7742
#, kde-format
msgid ""
"Controls the level at<br>\n"
"      which the gate will open"
msgstr ""
"يتحكم في المستوى الذي<br>\n"
"      تفتح عنده البوابة"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7746
#, kde-format
msgid ""
"Controls the time the<br>\n"
"      gate will take to open fully"
msgstr ""
"يتحكم في الوقت الذي تستغرقه<br>\n"
"      البوابة لتفتح بالكامل"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7748
#, kde-format
msgid "Hold"
msgstr "علِق"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7750
#, kde-format
msgid ""
"Controls the minimum<br>\n"
"      time the gate will stay open for"
msgstr ""
"يتحكم في الحد الأدنى للوقت<br>\n"
"      الذي ستبقى فيه البوابة مفتوحة"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7754
#, kde-format
msgid ""
"Controls the time the<br>\n"
"      gate will take to close fully"
msgstr ""
"يتحكم في الوقت الذي تستغرقه<br>\n"
"      البوابة لتغلق بالكامل"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7758
#, kde-format
msgid ""
"Controls the difference<br>\n"
"      between the gate's open and closed state"
msgstr ""
"يتحكم في الفرق<br>\n"
"      بين حالة البوابة المفتوحة والمغلقة"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7760
#, kde-format
msgid "Output Monitor"
msgstr "مراقب الخرج"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7762
#, kde-format
msgid "Controls output monitor"
msgstr "يتحكم في مراقب الخرج"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7764
#, kde-format
msgid "Key (listen),Gate (normal output),Bypass"
msgstr "مفتاح (استماع)، بوابة (خرج عادي)، تجاوز"

#. i18n: file: data/effects/ladspa/ladspa_1411.xml
#: rc.cpp:7768
#, kde-format
msgid "Comb Splitter"
msgstr "فاصل المشط"

#. i18n: file: data/effects/ladspa/ladspa_1411.xml
#: rc.cpp:7770
#, kde-format
msgid ""
"Comb Splitter (LADSPA 1411)<br>\n"
"   Divides the input up into two parts with frequency peaks at f Hz "
"intervals, skewed by f/2 Hz between the two outputs. Mixing the two outputs "
"will get you exactly the input signal."
msgstr ""
"مقسم مشطي (LADSPA 1411)<br>\n"
"   يقسم الدخل إلى جزءين مع ذرى ترددية عند فواصل f هرتز، مائلة بمقدار f/2 "
"هرتز بين الخرجين. خلط الخرجين سيعطيك إشارة الدخل تمامًا."

#. i18n: file: data/effects/ladspa/ladspa_1411.xml
