msgstr "وزن الخط."

#. i18n: file: data/effects/gpstext.xml
#: rc.cpp:1140
#, kde-format
msgid "The style of the font."
msgstr "نمط الخط."

#. i18n: file: data/effects/gpstext.xml
#: rc.cpp:1150
#, kde-format
msgid "Background color"
msgstr "لون الخلفية"

#. i18n: file: data/effects/gpstext.xml
#: rc.cpp:1152
#, kde-format
msgid "Outline Color"
msgstr "لون المحيط"

#. i18n: file: data/effects/gpstext.xml
#: rc.cpp:1154
#, kde-format
msgid "Outline color"
msgstr "لون المخطط"

#. i18n: file: data/effects/gpstext.xml
#: rc.cpp:1158
#, kde-format
msgid "The width of the outline in pixels"
msgstr "عرض المخطط بالبكسل"

#. i18n: file: data/effects/gpstext.xml
#: rc.cpp:1162
#, kde-format
