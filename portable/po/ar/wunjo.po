#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8500
#, kde-format
msgid ""
"TAP Sigmoid Booster (LADSPA 2157)<br>\n"
"   Applies a time-invariant nonlinear amplitude transfer function to the "
"signal."
msgstr ""
"معزز سيجمويد TAP (LADSPA 2157)<br>\n"
"   يطبّق دالة نقل سعة غير خطية وثابتة زمنيًا على الإشارة."

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8502
#, kde-format
msgid "Pre Gain"
msgstr "الكسب المسبق"

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8504
#, kde-format
msgid "Scales the input signal before the transfer function is applied to it."
msgstr "يقيس إشارة الإدخال قبل تطبيق دالة النقل عليها."

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8506
#, kde-format
msgid "Post Gain"
msgstr "الكسب اللاحق"

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
