#: rc.cpp:1342
#, kde-format
msgid "Lumakey"
msgstr "مفتاح الإضاءة (Lumakey)"

#. i18n: file: data/effects/lumakey.xml
#: rc.cpp:1344
#, kde-format
msgid ""
"This filter modifies the<br>\n"
"   alpha channel as a function of the image's luma value. This is used "
"together with a compositor to combine two images so that bright or dark "
"areas of source image are overwritten on top of the destination image."
msgstr ""
"يعدل هذا المرشح قناة<br>\n"
"   ألفا كدالة لقيمة الإضاءة (luma) للصورة. يُستخدم هذا مع المازج لدمج صورتين "
"بحيث تُكتب المناطق الساطعة أو المظلمة من الصورة المصدر فوق الصورة الهدف."

#. i18n: file: data/effects/lumakey.xml
#: rc.cpp:1348
#, kde-format
msgid ""
"Luma value that defines the<br>\n"
"      center point of transition from prelevel to postlevel opacity value."
msgstr ""
"قيمة الإضاءة (Luma) التي تحدد<br>\n"
"      نقطة المنتصف للانتقال من قيمة عتامة ما قبل المستوى إلى ما بعده."

#. i18n: file: data/effects/lumakey.xml
#. i18n: file: data/effects/frei0r/frei0r_keyspillm0pup.xml
#: rc.cpp:1350 rc.cpp:3558
#, kde-format
msgid "Slope"
msgstr "انحدار"

#. i18n: file: data/effects/lumakey.xml
#: rc.cpp:1352
#, kde-format
msgid ""
"This defines the width of the<br>\n"
"      transition from prelevel to postlevel luma value. Start point of "
"transition in opacity value is threshold - slope and end point is thresholt "
"+ slope, values are forced in range 0 - 255."
msgstr ""
"يحدد هذا عرض<br>\n"
"      الانتقال من قيمة إضاءة ما قبل المستوى إلى ما بعده. نقطة بداية الانتقال "
"في قيمة العتامة هي (العتبة - الميل) ونقطة النهاية هي (العتبة + الميل)، وتُجبر "
"القيم لتكون في النطاق 0 - 255."

#. i18n: file: data/effects/lumakey.xml
#: rc.cpp:1354
#, kde-format
msgid "Pre-Threshold Luma Level"
msgstr "مستوى إضاءة ما قبل العتبة"

#. i18n: file: data/effects/lumakey.xml
#: rc.cpp:1356
