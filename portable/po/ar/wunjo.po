#. i18n: file: data/effects/avfilter/avfilter_waveform.xml
#: rc.cpp:7400
#, kde-format
msgid "Set the fit mode"
msgstr "اضبط وضع الملائمة."

#. i18n: file: data/effects/avfilter/avfilter_waveform.xml
#: rc.cpp:7402
#, kde-format
msgid "None,Size"
msgstr "لا شيء,حجم"

#. i18n: file: data/effects/avfilter/avfilter_waveform.xml
#: rc.cpp:7404
#, kde-format
msgid "Input Format"
msgstr "تنسيق الإدخال"

#. i18n: file: data/effects/avfilter/avfilter_waveform.xml
#: rc.cpp:7406
#, kde-format
msgid "Set input formats for filter to pick from"
msgstr "اضبط تنسيقات الإدخال للمرشح ليختار منها"

#. i18n: file: data/effects/avfilter/avfilter_waveform.xml
#: rc.cpp:7408
#, kde-format
msgid "First available, All"
msgstr "أول متاح,الكل"

#. i18n: file: data/effects/avfilter/avfilter_weave.xml
#: rc.cpp:7410
#, kde-format
msgid "Weave interlacer"
msgstr "متشابك الويف"

#. i18n: file: data/effects/avfilter/avfilter_weave.xml
#: rc.cpp:7412
#, kde-format
msgid ""
"The weave takes a field-based video input and join each two sequential "
"fields into single frame, producing a new double height clip with half the "
"frame rate and half the frame count."
msgstr ""
"الويف يأخذ إدخال فيديو قائم على الحقل ويضم كل حقلين متتاليين في إطار واحد، "
"لينتج مقطعًا جديدًا بارتفاع مضاعف ونصف معدل الإطار ونصف عدد الإطارات."

#. i18n: file: data/effects/avfilter/avfilter_weave.xml
#: rc.cpp:7416
#, kde-format
msgid "Top,Bottom"
msgstr "أعلى,أسفل"

#. i18n: file: data/effects/avfilter/avfilter_xbr.xml
#: rc.cpp:7418
#, kde-format
msgid "xBR Interpolator"
msgstr "مستكمل xBR"

#. i18n: file: data/effects/avfilter/avfilter_xbr.xml
#: rc.cpp:7420
#, kde-format
msgid ""
"Apply the xBR high-quality magnification filter which is designed for pixel "
"art. It follows a set of edge-detection rules."
msgstr ""
"طبق مرشح التكبير عالي الجودة xBR المصمم لفن البكسل. يتبع مجموعة من قواعد كشف "
"الحواف."

#. i18n: file: data/effects/avfilter/avfilter_xbr.xml
#: rc.cpp:7422
#, kde-format
msgid "Scaling dimension"
msgstr "أبعاد المقياس"

#. i18n: file: data/effects/avfilter/avfilter_xbr.xml
#: rc.cpp:7424
#, kde-format
msgid "2x BR,3x BR,4x BR"
msgstr "2x BR,3x BR,4x BR"

#. i18n: file: data/effects/avfilter/avfilter_yadif.xml
#: rc.cpp:7426
#, kde-format
msgid "Yadif Deinterlacer"
msgstr "مزيل تشابك Yadif"

#. i18n: file: data/effects/avfilter/avfilter_yadif.xml
#: rc.cpp:7428
#, kde-format
msgid ""
"Deinterlace the input video (\"yadif\" means \"yet another deinterlacing "
"filter\")"
msgstr "أزل تشابك فيديو الإدخال (\"yadif\" تعني \"مرشح آخر لإزالة التشابك\")"

#. i18n: file: data/effects/avfilter/avfilter_yadif.xml
#: rc.cpp:7432
#, kde-format
msgid "Send frame,Send field,Send frame nospatial,Send field nospatial"
msgstr "أرسل إطار,أرسل حقل,أرسل إطار لا مكاني,أرسل حقل لا مكاني"

#. i18n: file: data/effects/avfilter/avfilter_yadif.xml
#: rc.cpp:7436
#, kde-format
msgid "Top field first,Bottom field first,Auto"
msgstr "الحقل الأعلى أولًا,الحقل الأسفل أولًا,آلي"

#. i18n: file: data/effects/avfilter/avfilter_zoompan.xml
#: rc.cpp:7442
#, kde-format
msgid "Zoom Pan"
msgstr "تكبير وتحريك"

#. i18n: file: data/effects/avfilter/avfilter_zoompan.xml
#: rc.cpp:7444
#, kde-format
msgid "Apply Zoom and Pan effect"
msgstr "طبق تأثير التكبير والتحريك"

#. i18n: file: data/effects/avfilter/subtitles.xml
#: rc.cpp:7456
#, kde-format
msgid "Render subtitles onto the video"
msgstr "اعرض ترجمات على الفيديو"

#. i18n: file: data/effects/avfilter/subtitles.xml
#: rc.cpp:7458
#, kde-format
msgid "Subtitle file to apply"
msgstr "ملف الترجمة للتطبيق"

#. i18n: file: data/effects/ladspa/ladspa_1185.xml
#: rc.cpp:7460
#, kde-format
msgid "Diode Processor"
msgstr "معالج الصمام الثنائي"

#. i18n: file: data/effects/ladspa/ladspa_1185.xml
#: rc.cpp:7462
#, kde-format
msgid ""
"Diode Processor (LADSPA 1185)<br>\n"
"   Mangles the signal as if it had been passed through a diode rectifier "
"network. You should probably follow this with a <i>DC Offset Remover</i>, "
"unless you want the offset."
msgstr ""
"معالج ثنائي (LADSPA 1185)<br>\n"
"يُشوّه الإشارة كما لو كانت قد مُرِّرت عبر مُقوِّم ثنائييُفضَّل استخدام <i>مُزيل إزاحة "
"التيار المستمر</i> بعد ذلك،إلا إذا كنت ترغب في إزالة الإزاحة."

#. i18n: file: data/effects/ladspa/ladspa_1185.xml
#: rc.cpp:7466
#, kde-format
msgid ""
"The <i>Mode</i> parameter is<br>\n"
"      continuously variable from thru to half-wave (1) rectification to full-"
"wave (2) to silence (0)"
msgstr ""
"المعامل <i>Mode</i> هو<br>\n"
"متغير باستمرار من خلال تقويم نصف الموجة (1) إلىالموجة الكاملة (2) إلى الصمت "
"(0)"

