msgstr ""
"قيمة العتامة قبل<br>\n"
"      بدء الانتقال في قيمة العتامة."

#. i18n: file: data/effects/lumakey.xml
#: rc.cpp:1358
#, kde-format
msgid "Post-Threshold Luma Level"
msgstr "مستوى إضاءة ما بعد العتبة"

#. i18n: file: data/effects/lumakey.xml
