#: rc.cpp:7936 rc.cpp:7948 rc.cpp:8054 rc.cpp:8064 rc.cpp:8074
#, kde-format
msgid "Cutoff Frequency"
msgstr "تردد القطع"

#. i18n: file: data/effects/ladspa/ladspa_1890.xml
#. i18n: file: data/effects/ladspa/ladspa_1891.xml
#. i18n: file: data/effects/ladspa/ladspa_1892.xml
#: rc.cpp:7938 rc.cpp:7950 rc.cpp:7964
#, kde-format
msgid "Stages"
msgstr "المراحل"

#. i18n: file: data/effects/ladspa/ladspa_1890.xml
#. i18n: file: data/effects/ladspa/ladspa_1891.xml
#. i18n: file: data/effects/ladspa/ladspa_1892.xml
#: rc.cpp:7940 rc.cpp:7952 rc.cpp:7966
#, kde-format
msgid ""
"Every stage adds two more<br>\n"
"      poles, which leads to a steeper dropoff."
msgstr ""
"تضيف كل مرحلة قطبين<br>\n"
"      إضافيين، مما يؤدي إلى انخفاض حاد."

#. i18n: file: data/effects/ladspa/ladspa_1891.xml
#: rc.cpp:7944
#, kde-format
msgid "GLAME Lowpass"
msgstr "مرشح سفلي GLAME"

#. i18n: file: data/effects/ladspa/ladspa_1891.xml
#: rc.cpp:7946
#, kde-format
msgid ""
"GLAME Lowpass Filter (LADSPA 1891)<br>\n"
"   IIR lowpass filter based using Chebishev coefficients. The filter allows "
"you to tweak the number of stages used for filtering. Every stage adds two "
"more poles, which leads to a steeper dropoff."
msgstr ""
"مرشح تمرير منخفض GLAME ‏(LADSPA 1891)<br>\n"
"   مرشح تمرير منخفض الاستجابة الاندفاعية اللانهائية (IIR) مبني باستخدام "
"معاملات تشيبيشيف. يتيح لك المرشح ضبط عدد المراحل المستخدمة للترشيح. تضيف كل "
"مرحلة قطبين إضافيين، مما يؤدي إلى انخفاض حاد."

#. i18n: file: data/effects/ladspa/ladspa_1892.xml
#: rc.cpp:7956
#, kde-format
msgid "GLAME Bandpass"
msgstr "مرشح حزامي GLAME"

#. i18n: file: data/effects/ladspa/ladspa_1892.xml
#: rc.cpp:7958
#, kde-format
msgid ""
"GLAME Bandpass Filter (LADSPA 1892)<br>\n"
"   IIR bandpass filter based using Chebishev coefficients. The filter allows "
"you to tweak the number of stages used for filtering. Every stage adds two "
"more poles, which leads to a steeper dropoff."
