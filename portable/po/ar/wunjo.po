msgstr "عتبة السطوع الزماني"

#. i18n: file: data/effects/avfilter/avfilter_dedot.xml
#: rc.cpp:5594
#, kde-format
msgid "Temporal Chroma Variation"
msgstr "تغير الكروما الزماني"

#. i18n: file: data/effects/avfilter/avfilter_dedot.xml
#: rc.cpp:5596
#, kde-format
msgid "Temporal Chroma Threshold"
msgstr "عتبة الكروما الزمانية"

#. i18n: file: data/effects/avfilter/avfilter_deesser.xml
#: rc.cpp:5598
#, kde-format
msgid "Deesser"
msgstr "مزيل الصفير"

#. i18n: file: data/effects/avfilter/avfilter_deesser.xml
#: rc.cpp:5600
#, kde-format
msgid "Apply de-essing to the audio samples."
msgstr "طبّق إزالة الصفير على العينات الصوتية."

#. i18n: file: data/effects/avfilter/avfilter_deesser.xml
#: rc.cpp:5604
#, kde-format
msgid "Set intensity for triggering de-essing. Allowed range is from 0 to 1."
msgstr "اضبط الشدة لتشغيل إزالة الصفير. النطاق المسموح به من 0 إلى 1."

#. i18n: file: data/effects/avfilter/avfilter_deesser.xml
#: rc.cpp:5606
#, kde-format
msgid "Max deessing"
msgstr "أقصى إزالة صفير"

#. i18n: file: data/effects/avfilter/avfilter_deesser.xml
#: rc.cpp:5608
#, kde-format
msgid ""
"Set amount of ducking on treble part of sound. Allowed range is from 0 to 1."
msgstr ""
"اضبط مقدار التخفيض في جزء التريبل من الصوت. النطاق المسموح به من 0 إلى 1."

#. i18n: file: data/effects/avfilter/avfilter_deesser.xml
