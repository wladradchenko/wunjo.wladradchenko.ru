msgstr "فترة دورة مذبذب الترددات المنخفضة بالثواني"

#. i18n: file: data/effects/ladspa/ladspa_1438.xml
#: rc.cpp:7868
#, kde-format
msgid "The maximum delay the LFO will use to flange in milliseconds"
msgstr "أقصى تأخير سيستخدمه مذبذب الترددات المنخفضة للفلنجة بالمللي ثانية"

#. i18n: file: data/effects/ladspa/ladspa_1438.xml
#: rc.cpp:7872
#, kde-format
msgid "The amount of the delays output that is mixed back into the delay"
msgstr "مقدار خرج التأخير الذي يُخلط مجدداً في التأخير"

#. i18n: file: data/effects/ladspa/ladspa_1886.xml
#: rc.cpp:7876
#, kde-format
