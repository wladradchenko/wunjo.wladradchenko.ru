#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8214
#, kde-format
msgid ""
"TAP Stereo Echo (LADSPA 2143)<br>\n"
"   Supports conventional mono and stereo delays, ping-pong delays and the "
"Haas effect (also known as Cross Delay Stereo)."
msgstr ""
"صدى ستيريو TAP (LADSPA 2143)<br>\n"
"   يدعم تأخيرات المونو والستيريو التقليدية، وتأخيرات بينغ-بونغ وتأثير هاس "
"(المعروف أيضًا باسم ستيريو التأخير المتقاطع)."

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8216
#, kde-format
msgid "Cross Mode"
msgstr "الوضع المتقاطع"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8218
#, kde-format
msgid "Haas Effect"
msgstr "تأثير هاس"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8220
