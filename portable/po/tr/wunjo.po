#: rc.cpp:8276
#, kde-format
msgid ""
"TAP DeEsser (LADSPA 2147)<br>\n"
"   Used for attenuating higher pitched frequencies in vocals such as those "
"found in 'ess', 'shh' and 'chh' sounds."
msgstr ""
"TAP Sibilans Kaldırıcısı (LADSPA 2147)<br>\n"
"   Vokallerdeki “ess”, “shh” ve “chh” gibi seslerde bulunan daha yüksek "
"frekansları azaltmak için kullanılır."

