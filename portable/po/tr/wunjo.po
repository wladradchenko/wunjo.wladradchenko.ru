msgstr "Geçiş noktasının yumuşatma derecesini denetler"

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7704
#, kde-format
msgid "Aliasing"
msgstr "Örtüşme (Aliasing)"

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7706
#, kde-format
msgid ""
"Aliasing (LADSPA 1407)<br>\n"
"   Simulates aliasing using nyquist frequency modulation. Produces wacky "
"results if the blocks aren't even numbers of samples long."
msgstr ""
"Örtüşme (LADSPA 1407)<br>\n"
"   Nyquist frekans modülasyonu kullanarak örtüşmeyi benzetir. Bloklar çift "
"sayıda örnek uzunluğunda değilse tuhaf sonuçlar üretir."

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7708
#, kde-format
