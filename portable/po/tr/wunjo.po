"TAP Pitch Shifter (LADSPA 2150)<br>\n"
"   Change the pitch in the range of plus/minus one octave."
msgstr ""
"TAP Perde Gamı Kaydırıcısı (LADSPA 2150)<br>\n"
"   Artı/eksi bir oktav aralığında perdeyi değiştirir."

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8328
#, kde-format
msgid "Semitone Shift"
msgstr "Yarım Ton Kaydırma"

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8330
#, kde-format
msgid ""
"Does the same thing as <b>Rate Shift</b></br>\n"
"      but allows to set musically sensible pitch shift rates."
msgstr ""
"<b>Hız Kaydırma</b> ile aynı işi yapar; ancak müzikal</br>\n"
"      açıdan mantıklı perde kaydırma oranlarının ayarlanmasına olanak tanır."

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8332
#, kde-format
msgid "Rate Shift"
msgstr "Hız Kaydırma"

