#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7050
#, kde-format
msgid "Stereo tools"
msgstr "Çift Kanal Araçları"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7052
#, kde-format
msgid ""
"This filter has some handy utilities to manage stereo signals, for "
"converting M/S stereo recordings to L/R signal while having control over the "
"parameters or spreading the stereo image of master track."
msgstr ""
"Bu süzgeç, stereo sinyalleri yönetmek, M/S stereo kayıtlarını L/R sinyaline "
"dönüştürmek, parametreler üzerinde denetim sahibi olmak veya ana parçanın "
"stereo görüntüsünü yaymak için bazı kullanışlı izlencelere sahiptir."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7054
#, kde-format
msgid "Level IN"
msgstr "Düzey girişi"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7056 rc.cpp:7060
#, kde-format
msgid ""
"Set input level before filtering for both channels.\n"
"Allowed range is from 0.015625 to 64."
msgstr ""
"Her iki kanal için süzme öncesi giriş düzeyini ayarlayın.\n"
"İzin verilen erim 0,015625 ile 64 arasındadır."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7058
#, kde-format
msgid "Level OUT"
msgstr "Düzey çıkışı"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7062 rc.cpp:7120
#, kde-format
msgid "Balance IN"
msgstr "Denge girişi"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7064 rc.cpp:7068
#, kde-format
msgid ""
"Set input balance between both channels. Default is 0. Allowed range is from "
"-1 to 1."
msgstr ""
"Her iki kanal arasındaki giriş dengesini ayarlayın. Öntanımlı değer 0’dır. "
"İzin verilen erim −1 ile 1 arasındadır."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7066 rc.cpp:7126
#, kde-format
msgid "Balance OUT"
msgstr "Denge çıkışı"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7070
#, kde-format
msgid "Softclip"
msgstr "Yumuşak klip"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7072
#, kde-format
msgid ""
"Enable softclipping. Results in analog distortion instead of harsh digital "
"0dB clipping."
msgstr ""
"Yumuşak kırpmayı etkinleştirin. Sert dijital 0 dB bozulma yerine analog "
"bozulmaya neden olur."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7074
#, kde-format
msgid "Mute Left"
msgstr "Sol tarafın sesini kapat"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7076
#, kde-format
msgid "Mute Right"
msgstr "Sağ tarafın sesini kapat"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7078
#, kde-format
msgid "Phase Left"
msgstr "Sol evre"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7080
#, kde-format
msgid "Change the phase of the left channel."
msgstr "Sol kanalın evresini değiştirin."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7082
#, kde-format
msgid "Phase Right"
msgstr "Sağ evre"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7084
#, kde-format
msgid "Change the phase of the right channel."
msgstr "Sağ kanalın evresini değiştirin."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:7086 rc.cpp:8426
#, kde-format
msgid "Stereo Mode"
msgstr "Çift kanal kipi"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7088
#, kde-format
msgid ""
"Left/Right to Left/Right,Left/Right to Mid/Side,Mid/Side to Left/Right,Left/"
"Right to Left/Left,Left/Right to Right/Right,Left/Right to Left + Right,Left/"
"Right to Right/Left,Mid/Side to Left/Left,Mid/Side to Right/Right,Mid/Side "
"to Right/Left,Left/Right to Left - Right"
msgstr ""
"Sol/Sağdan Sola/Sağ,Sol/Sağdan Ortaya/Yanlara,Orta/Yanlardan Sola/Sağlara,"
"Sol/Sağdan Sola/Sola,Sol/Sağdan Sağa/Sağlara,Sol/Sağdan Sola + Sağa,Sol/"
"Sağdan Sağa/Sol,Orta/Yanlardan Sola/Sola,Orta/Yanlardan Sağa/Sağlara,Orta/"
"Yanlardan Sağa/Sola,Sol/Sağdan Sola — Sağ"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7090
#, kde-format
msgid "Side Level"
msgstr "Yan düzey"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7092
#, kde-format
msgid ""
"Set level of side signal. Default is 1. Allowed range is from 0.015625 to 64."
msgstr ""
"Yan sinyalin düzeyini ayarlayın. Öntanımlı değer 1’dir. İzin verilen erim "
"0,015625 ile 64 arasındadır."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7094
#, kde-format
msgid "Side Balance"
msgstr "Yan denge"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7096
#, kde-format
msgid ""
"Set balance of side signal. Default is 0. Allowed range is from -1 to 1."
msgstr ""
"Yan sinyalin dengesini ayarlayın. Öntanımlı değer 0’dır. İzin verilen erim "
"−1 ile 1 arasındadır."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7098
#, kde-format
msgid "Mid Level"
msgstr "Orta düzey"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7100
#, kde-format
msgid ""
"Set level of the middle signal. Default is 1. Allowed range is from 0.015625 "
"to 64."
msgstr ""
"Orta sinyalin düzeyini ayarlayın. Öntanımlı değer 1’dir. İzin verilen erim "
"0,015625 ile 64 arasındadır."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7102
#, kde-format
msgid "Mid Pan"
msgstr "Orta kaydırma"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7104
#, kde-format
msgid "Set middle signal pan. Default is 0. Allowed range is from -1 to 1."
msgstr ""
"Orta sinyal kaydırmasını ayarlayın. Öntanımlı değer 0’dır. İzin verilen erim "
"−1 ile 1 arasındadır."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7106
#, kde-format
msgid "Stereo base"
msgstr "Çift kanallı taban"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7108
#, kde-format
msgid ""
"Set stereo base between mono and inverted channels. Default is 0. Allowed "
"range is from -1 to 1."
msgstr ""
"Tek ve ters çevrilmiş kanallar arasındaki çift kanallı tabanı ayarlayın. "
"Öntanımlı değer 0’dır. İzin verilen erim −1 ile 1 arasındadır."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7112
#, kde-format
msgid ""
"Set delay in milliseconds how much to delay left from right channel and vice "
"versa. Default is 0. Allowed range is from -20 to 20."
msgstr ""
"Soldan sağ kanala ve tam tersi yönde ne kadar gecikme olacağını milisaniye "
"türünden ayarlayın. Öntanımlı değer 0’dır. İzin verilen erim −20 ile 20 "
"arasındadır."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7114
#, kde-format
msgid "S/C level"
msgstr "S/C düzeyi"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7116
#, kde-format
msgid "Stereo phase"
msgstr "Çift kanal evresi"

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7118
#, kde-format
msgid "Set the stereo phase in degrees."
msgstr "Çift kanal evresini derece türünden ayarlayın."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7122 rc.cpp:7128
#, kde-format
msgid ""
"‘balance’\n"
"Classic balance mode. Attenuate one channel at a time. Gain is raised up to "
"1.\n"
"‘amplitude’\n"
"Similar to classic mode above but gain is raised up to 2.\n"
"‘power’\n"
"Equal power distribution, from -6dB to +6dB range."
msgstr ""
"“balance”\n"
"Klasik denge kipi. Bir seferde bir kanalı zayıflatın. Kazanç 1’e kadar "
"yükseltilir.\n"
"“amplitude”\n"
"Yukarıdaki klasik kipe benzer; ancak kazanç 2’ye kadar yükseltilir.\n"
"“power”\n"
"Eşit güç dağılımı, −6 dB’den +6 dB erimine."

#. i18n: file: data/effects/avfilter/avfilter_stereotools.xml
#: rc.cpp:7124 rc.cpp:7130
#, kde-format
msgid "balance,amplitude,power"
msgstr "balance,amplitude,power"

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7132
#, kde-format
msgid "Stereo widener"
msgstr "Çift Kanal Genişleticisi"

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7134
#, kde-format
msgid ""
"This filter enhance the stereo effect by suppressing signal common to both "
"channels and by delaying the signal of left into right and vice versa, "
"thereby widening the stereo effect."
msgstr ""
"Bu süzgeç, her iki kanala ortak gelen sinyali bastırarak ve soldan sağa ve "
"sağdan sola gelen sinyali geciktirerek stereo efektini güçlendirir, böylece "
"çift kanal efektini genişletir."

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7138
#, kde-format
msgid ""
"Time in milliseconds of the delay of left signal into right and vice versa."
msgstr ""
"Sol sinyalin sağa ve sağa doğru gecikmesinin milisaniye türünden süresi."

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7140
#, kde-format
msgid "Feedback Gain"
msgstr "Geri besleme kazancı"

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7142
#, kde-format
msgid ""
"Amount of gain in delayed signal into right and vice versa.\n"
"Gives a delay effect of left signal in right output and vice versa which "
"gives widening effect."
msgstr ""
"Sağa gecikmeli sinyaldeki kazanç miktarı ve tersi.\n"
"Sağ çıkışta sol sinyalin gecikme etkisini verir ve tersi de genişleme etkisi "
"verir."

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7144
#, kde-format
msgid "Cross feed"
msgstr "Çapraz besleme"

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7146
#, kde-format
msgid ""
"Cross feed of left into right with inverted phase. This helps in suppressing "
"the mono.\n"
"If the value is 1 it will cancel all the signal common to both channels."
msgstr ""
"Soldan sağa ters evreli çapraz besleme. Bu, monoyu bastırmaya yardımcı "
"olur.\n"
"Değer 1 ise her iki kanala da ortak olan tüm sinyalleri iptal edecektir."

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7148
#, kde-format
msgid "Drymix"
msgstr "Kuru karışım"

#. i18n: file: data/effects/avfilter/avfilter_stereowiden.xml
#: rc.cpp:7150
#, kde-format
msgid "Set level of input signal of original channel."
msgstr "Özgün kanalın giriş sinyalinin düzeyini ayarlayın."

#. i18n: file: data/effects/avfilter/avfilter_swapuv.xml
#: rc.cpp:7152
#, kde-format
msgid "Swap UV"
msgstr "UV’yi Takas Et"

#. i18n: file: data/effects/avfilter/avfilter_swapuv.xml
#: rc.cpp:7154
#, kde-format
msgid "Swap U and V components"
msgstr "U ve V bileşenlerini takas edin."

#. i18n: file: data/effects/avfilter/avfilter_tmix.xml
#: rc.cpp:7156
#, kde-format
msgid "Temporal frames Mixer"
msgstr "Zamansal kareler karıştırıcısı"

#. i18n: file: data/effects/avfilter/avfilter_tmix.xml
#: rc.cpp:7158
#, kde-format
msgid "Mix successive video frames"
msgstr "Ardışık video karelerini karıştırın."

#. i18n: file: data/effects/avfilter/avfilter_tmix.xml
#: rc.cpp:7160
#, kde-format
msgid "Frames to mix"
msgstr "Karıştırılacak kareler"

#. i18n: file: data/effects/avfilter/avfilter_transpose.xml
#: rc.cpp:7162
#, kde-format
msgid "Transpose"
msgstr "Yön Değiştir"

#. i18n: file: data/effects/avfilter/avfilter_transpose.xml
#: rc.cpp:7164
#, kde-format
msgid "Transpose rows with columns in the input video and optionally flip it"
msgstr ""
"Girdi videosundaki satırları sütunlarla yer değiştirin ve isteğe bağlı "
"olarak ters çevirin."

#. i18n: file: data/effects/avfilter/avfilter_transpose.xml
#: rc.cpp:7168
#, kde-format
msgid "Clock,Clock flip,Counter clock,Counter clock flip"
msgstr "Saat,Saat çevirme,Saat yönü tersi,Saat yönü tersi çevirme"

#. i18n: file: data/effects/avfilter/avfilter_transpose.xml
#: rc.cpp:7170
#, kde-format
msgid "Override if"
msgstr "Şuna göre geçersiz kıl:"

#. i18n: file: data/effects/avfilter/avfilter_transpose.xml
#: rc.cpp:7172
#, kde-format
msgid "None,Portrait,Landscape"
msgstr "Yok,Dikey,Yatay"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7174
#, kde-format
msgid "Sharp/Unsharp"
msgstr "Keskinleştir/Yumuşat"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7176
#, kde-format
msgid "Sharpen or unsharpen/blur your video"
msgstr "Videonuzu keskinleştirin veya duruma göre yumuşatın/bulanıklaştırın."

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7178
#, kde-format
msgid "Luma horizontal matrix"
msgstr "Luma yatay matrisi"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7180
#, kde-format
msgid "Set the luma matrix horizontal size"
msgstr "Luma matrisinin yatay boyutunu ayarlayın."

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7182
#, kde-format
msgid "Luma vertical matrix"
msgstr "Luma yatay matrisi"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7184
#, kde-format
msgid "Set the luma matrix vertical size"
msgstr "Luma matrisinin dikey boyutunu ayarlayın."

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7188
#, kde-format
msgid ""
"Set the luma effect strength.<br>\n"
"            Reasonable values are between -1.5 and 1.5. Negative values will "
"blur the input video, while positive values will sharpen it, a value of 0 "
"will disable the effect."
msgstr ""
"Luma efektinin şiddetini ayarlayın.<br>\n"
"            Makul değerler −1,5 ile 1,5 arasındadır. Negatif değerler giriş "
"videosunu bulanıklaştırırken, pozitif değerler keskinleştirir, 0 değeri ise "
"efekti devre dışı bırakır."

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7190
#, kde-format
msgid "Chroma horizontal matrix"
msgstr "Renk yatay matrisi"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7192
#, kde-format
msgid "Set the chroma matrix horizontal size"
msgstr "Renk matrisinin yatay boyutunu ayarlayın."

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7194
#, kde-format
msgid "Chroma vertical matrix"
msgstr "Renk dikey matrisi"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7196
#, kde-format
msgid "Set the chroma matrix vertical size"
msgstr "Renk matrisinin dikey boyutunu ayarlayın."

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7200
#, kde-format
msgid ""
"Set the chroma effect strength.<br>\n"
"            Reasonable values are between -1.5 and 1.5. Negative values will "
"blur the input video, while positive values will sharpen it, a value of zero "
"will disable the effect."
msgstr ""
"Renk efekti gücünü ayarlayın.<br>\n"
"            Makul değerler −1,5 ile 1,5 arasındadır. Negatif değerler girdi "
"videosunu bulanıklaştırırken, pozitif değerler keskinleştirecektir. 0 "
"verilirse efekt devre dışı bırakılır."

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7202
#, kde-format
msgid "Alpha horizontal matrix"
msgstr "Alfa yatay matrisi"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7204
#, kde-format
msgid "Set the alpha matrix horizontal size"
msgstr "Alfa matrisi yatay boyutunu ayarlayın."

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7206
#, kde-format
msgid "Alpha vertical matrix"
msgstr "Alfa dikey matrisi"

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7208
#, kde-format
msgid "Set the alpha matrix vertical size"
msgstr "Alfa matrisi dikey boyutunu ayarlayın."

#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:7212
#, kde-format
msgid ""
"Set the alpha effect strength.<br>\n"
"            Reasonable values are between -1.5 and 1.5. Negative values will "
"blur the input video, while positive values will sharpen it, a value of zero "
"will disable the effect."
msgstr ""
"Alfa efekti gücünü ayarlayın.<br>\n"
"            Makul değerler −1,5 ile 1,5 arasındadır. Negatif değerler girdi "
"videosunu bulanıklaştırırken, pozitif değerler keskinleştirecektir. 0 "
"verilirse efekt devre dışı bırakılır."

#. i18n: file: data/effects/avfilter/avfilter_vaguedenoiser.xml
#: rc.cpp:7214
#, kde-format
msgid "Wavelet Denoiser"
msgstr "Dalgacık Gürültü Kaldırıcısı"

#. i18n: file: data/effects/avfilter/avfilter_vaguedenoiser.xml
#: rc.cpp:7216
#, kde-format
msgid ""
"Wavelet based denoiser.<br>\n"
"    It transforms each frame from the video input into the wavelet domain, "
"using Cohen-Daubechies-Feauveau 9/7."
msgstr ""
"Dalgacık tabanlı gürültü kaldırıcısı.<br>\n"
"    Cohen-Daubechies-Feauveau 9/7’yi kullanarak video girişindeki her bir "
"kareyi dalgacık alanına dönüştürür."

#. i18n: file: data/effects/avfilter/avfilter_vaguedenoiser.xml
#: rc.cpp:7220
#, kde-format
msgid "Hard,Soft,Garrote"
msgstr "Sert,Yumuşak,Garrote"

#. i18n: file: data/effects/avfilter/avfilter_vaguedenoiser.xml
#: rc.cpp:7222
#, kde-format
msgid "Threshold Type"
msgstr "Eşik türü"

#. i18n: file: data/effects/avfilter/avfilter_vaguedenoiser.xml
#: rc.cpp:7224
#, kde-format
msgid "Universal,Bayes"
msgstr "Evrensel,Bayes"

#. i18n: file: data/effects/avfilter/avfilter_vectorscope.xml
#: rc.cpp:7236
#, kde-format
msgid "Vectorscope (advanced)"
msgstr "Vektörskop (Gelişmiş)"

#. i18n: file: data/effects/avfilter/avfilter_vectorscope.xml
#: rc.cpp:7238
#, kde-format
msgid "Display 2 color component values in a two dimensional graph"
msgstr "İki boyutlu grafikte 2 renkli bileşen değerini görüntüleyin."

#. i18n: file: data/effects/avfilter/avfilter_vectorscope.xml
#: rc.cpp:7242
