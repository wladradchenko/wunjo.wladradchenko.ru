msgid "Audio Equalizer (avfilter)"
msgstr "Ses Dengeleyicisi (avfilter)"

#. i18n: file: data/effects/avfilter/avfilter_equalizer.xml
#: rc.cpp:5812
#, kde-format
msgid ""
"Apply two-pole peaking equalization (EQ) filter. With this filter, the "
"signal-level at and around a selected frequency can be increased or "
"decreased, whilst (unlike bandpass and bandreject filters) that at all other "
"frequencies is unchanged."
msgstr ""
"İki kutuplu tepe eşitleme (EQ) süzgeci uygulayın. Bu süzgeç ile, seçilen bir "
"frekanstaki ve çevresindeki sinyal düzeyi artırılabilir veya "
"azaltılabilirken (bant geçiren ve bant reddeden süzgeçlerin aksine) diğer "
"tüm frekanslardaki sinyal düzeyi değişmez."

#. i18n: file: data/effects/avfilter/avfilter_equalizer.xml
#: rc.cpp:5816
#, kde-format
msgid "Width Type"
msgstr "Genişlik türü"

#. i18n: file: data/effects/avfilter/avfilter_equalizer.xml
