#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6942
#, kde-format
msgid ""
"Set the luma radius.<br>\n"
"            The value specifies the variance of the gaussian filter used to "
"blur the image (slower if larger)."
msgstr ""
"Luma yarıçapını ayarlayın.<br>\n"
"            Değer, görseli bulanıklaştırmak için kullanılan Gauss süzgecinin "
"varyansını belirtir (daha büyükse daha yavaş)."

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#. i18n: file: data/effects/avfilter/avfilter_unsharp.xml
#: rc.cpp:6944 rc.cpp:7186
#, kde-format
msgid "Luma strength"
msgstr "Luma gücü"

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6946
#, kde-format
msgid ""
"Set the luma strength.<br>\n"
"            The value configures the blurring. A positive value will blur "
"the image, whereas a negative value will sharpen the image."
msgstr ""
"Set the luma strength.<br>\n"
"            The value configures the blurring. A positive value will blur "
"the image, whereas a negative value will sharpen the image."

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6948
#, kde-format
msgid "Luma threshold"
msgstr "Luma eşiği"

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6950
#, kde-format
msgid ""
"Set the luma threshold used as a coefficient<br>\n"
"            to determine whether a pixel should be blurred or not. A value "
"of 0 will filter all the image, positive values will filter flat areas, "
"negative values will filter edges."
msgstr ""
"Bir pikselin bulanıklaştırılıp bulanıklaştırılmayacağını<br>\n"
"            belirlemek için katsayı olarak kullanılan luma eşiğini "
"ayarlayın. 0 değeri tüm görseli, pozitif değerler düz alanları, negatif "
"değerler kenarları süzecektir."

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6952
#, kde-format
msgid "Chroma radius"
msgstr "Renk yarıçapı"

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
#: rc.cpp:6954
#, kde-format
msgid ""
"Set the chroma radius.<br>\n"
"            The value specifies the variance of the gaussian filter used to "
"blur the image (slower if larger). If not specified, it defaults to the "
"value set for <em>Luma radius</em>"
msgstr ""
"Renk yarıçapını ayarlayın.<br>\n"
"            Değer, görseli bulanıklaştırmak için kullanılan Gauss süzgecinin "
"varyansını belirtir (daha büyükse daha yavaş). Belirtilmezse öntanımlı "
"olarak <em>Luma yarıçapı</em> için ayarlanan değere ayarlanır."

#. i18n: file: data/effects/avfilter/avfilter_smartblur.xml
