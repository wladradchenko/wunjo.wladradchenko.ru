msgstr "Gürültü kaldırma yöntemini ayarlayın."

#. i18n: file: data/effects/avfilter/avfilter_fftdnoiz.xml
#: rc.cpp:5902
#, kde-format
msgid "Wiener,Hard"
msgstr "Wiener,Sert"

