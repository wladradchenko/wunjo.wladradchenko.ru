#: rc.cpp:8334
#, kde-format
msgid ""
"Does the same thing as <b>Semitone Shift</b><br>\n"
"      but in percentage of the original pitch, so that is closer to a "
"\"physical\", non-musical approach"
msgstr ""
"<b>Yarım Ton Kaydırma</b> ile aynı işi yapar; ancak özgün<br>\n"
"       perdenin yüzdesi kadardır, bu nedenle “fiziksel”, müzik dışı bir "
