msgid "TAP Vibrato"
msgstr "TAP Vibrato"

#. i18n: file: data/effects/ladspa/ladspa_2148.xml
#: rc.cpp:8294
#, kde-format
msgid ""
"TAP Vibrato (LADSPA 2148)<br>\n"
"   Modulates the pitch of its input signal with a low-frequency sinusoidal "
"signal. It is useful for guitar and synth tracks, and it can also come handy "
"if a strange effect is needed."
msgstr ""
"TAP Vibrato (LADSPA 2148)<br>\n"
"   Giriş sinyalinin perdesini düşük frekanslı sinüzoidal bir sinyalle modüle "
"eder. Gitar ve synth parçaları için kullanışlıdır ve sıra dışı bir efekte "
"gereksinim duyulduğunda da işe yarayabilir."

#. i18n: file: data/effects/ladspa/ladspa_2148.xml
#: rc.cpp:8298
#, kde-format
msgid "Determines how fast the pitch is modulated up-down"
msgstr "Perdenin yukarı–aşağı ne kadar hızlı modüle edileceğini belirler."

