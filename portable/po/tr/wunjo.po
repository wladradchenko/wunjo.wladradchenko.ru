#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8414
#, kde-format
msgid "TAP Dynamics (St)"
msgstr "TAP Dinamikleri (St)"

#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8416
#, kde-format
msgid ""
"TAP Dynamics Stereo (LADSPA 2153)<br>\n"
"   Allows changing the dynamic content of the audio stream"
msgstr ""
"TAP Dinamikleri Stereo (LADSPA 2153)<br>\n"
"   Ses akışının devingen içeriğinin değiştirilmesine olanak tanır."

#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8428
#, kde-format
msgid ""
"Controls how the envelope levels<br>\n"
"      are used to determine the needed gain adjustment"
msgstr ""
"Zarf düzeylerinin, gerekli kazanç ayarlamasını belirlemek <br>\n"
"      için nasıl kullanılacağını denetler."

#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8430
#, kde-format
msgid "Independent,Average,Peak"
msgstr "Bağımsız,Ortalama,Tavan"

#. i18n: file: data/effects/ladspa/ladspa_2154.xml
#: rc.cpp:8438
#, kde-format
msgid "TAP Reflector"
msgstr "TAP Reflektör"

#. i18n: file: data/effects/ladspa/ladspa_2154.xml
#: rc.cpp:8440
#, kde-format
msgid ""
"TAP Reflector (LADSPA 2154)<br>\n"
"    Creates a psychedelic reverse audio effect."
msgstr ""
"TAP Reflektör (LADSPA 2154)<br>\n"
"    Saykodelik ters ses efekti yaratır."

#. i18n: file: data/effects/ladspa/ladspa_2154.xml
#: rc.cpp:8442
#, kde-format
msgid "Fragment Length"
msgstr "Parçacık Uzunluğu"

#. i18n: file: data/effects/ladspa/ladspa_2154.xml
#: rc.cpp:8444
#, kde-format
msgid ""
"It is best to set it to<br>\n"
"      approximately match the tempo of the track, so the Fragment Length is "
"equal to the time of one measure."
msgstr ""
"Parçanın temposuna yakın bir değere ayarlanması en iyisidir,<br>\n"
"      böylece parçacık uzunluğu bir ölçünün süresine eşit olur."

#. i18n: file: data/effects/ladspa/ladspa_2155.xml
#: rc.cpp:8452
#, kde-format
msgid "TAP Pink/Fractal Noise"
msgstr "TAP Pembe/Fraktal Gürültü"

#. i18n: file: data/effects/ladspa/ladspa_2155.xml
#: rc.cpp:8454
#, kde-format
msgid ""
"TAP Pink/Fractal Noise (LADSPA 2155)<br>\n"
"    Adds pink noise to the incoming signal using a one-dimensional random "
"fractal line generated by the Midpoint Displacement Method."
msgstr ""
"TAP Pembe/Fraktal Gürültü (LADSPA 2155)<br>\n"
"    Orta Nokta Yer Değiştirme Yöntemi ile üretilen tek boyutlu rastgele "
"fraktal çizgiyi kullanarak gelen sinyale pembe gürültü ekler."

#. i18n: file: data/effects/ladspa/ladspa_2155.xml
#: rc.cpp:8456
#, kde-format
msgid "Fractal Dimension"
msgstr "Fraktal Boyut"

#. i18n: file: data/effects/ladspa/ladspa_2155.xml
#: rc.cpp:8458
#, kde-format
msgid "Signal Level"
msgstr "Sinyal Düzeyi"

#. i18n: file: data/effects/ladspa/ladspa_2155.xml
#: rc.cpp:8460
#, kde-format
msgid "Noise Level"
msgstr "Gürültü Düzeyi"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8464
#, kde-format
msgid "TAP Fractal Doubler"
msgstr "TAP Fraktal Çiftleyici"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8466
#, kde-format
msgid ""
"TAP Fractal Doubler (LADSPA 2156)<br>\n"
"    Suitable for doubling tracks with vocals, acoustic/electric guitars, "
"bass and just about any other instrument on them."
msgstr ""
"TAP Fraktal Çiftleyici (LADSPA 2156)<br>\n"
"    Vokal, akustik/elektrik gitar, bas ve hemen hemen her türlü çalgının "
"bulunduğu parçaları iki katına çıkarmak için uygundur."

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8468
#, kde-format
msgid "Time Tracking"
msgstr "Zaman İzleme"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8470 rc.cpp:8474
#, kde-format
msgid ""
"Determines how \"rough\" and how big<br>\n"
"      these changes are. When set to 0, changes are bigger and more chaotic "
"(\"bad backup singer\"). When set to 1, changes are smaller and smoother "
"(\"better tracking of the original\")."
msgstr ""
"Bu değişikliklerin ne kadar “sert” ve büyük olduğunu belirler.<br>\n"
"      0 olarak ayarlandığında, değişiklikler daha büyük ve daha kaotik olur "
"(“kötü geri vokal”). 1 olarak ayarlandığında, değişiklikler daha küçük ve "
"daha akıcı olur (“özgünün daha iyi takibi”)."

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8472
#, kde-format
msgid "Pitch Tracking"
msgstr "Perde İzleme"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8478
#, kde-format
msgid "Dry Left Position"
msgstr "Kuru Sol Konum"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8480 rc.cpp:8484 rc.cpp:8490 rc.cpp:8494
#, kde-format
msgid ""
"These controls range between 0 and 1,<br>\n"
"      0 meaning hard left and 1 meaning hard right position."
msgstr ""
"Bu denetimler 0 ile 1 arasında değişmektedir;<br>\n"
"      0 sert sol, 1 ise sert sağ pozisyonu ifade eder."

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8482
#, kde-format
msgid "Dry Right Position"
msgstr "Kuru Sağ Konum"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8488
#, kde-format
msgid "Wet Left Position"
msgstr "Islak Sol Konum"

#. i18n: file: data/effects/ladspa/ladspa_2156.xml
#: rc.cpp:8492
#, kde-format
msgid "Wet Right Position"
msgstr "Islak Sağ Konum"

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8498
#, kde-format
msgid "TAP Sigmoid Booster"
msgstr "TAP Sigmoid Güçlendirici"

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8500
#, kde-format
msgid ""
"TAP Sigmoid Booster (LADSPA 2157)<br>\n"
"   Applies a time-invariant nonlinear amplitude transfer function to the "
"signal."
msgstr ""
"TAP Sigmoid Güçlendirici (LADSPA 2157)<br>\n"
"   Sinyale zamanla değişmeyen doğrusal olmayan bir genlik aktarım işlevi "
"uygular."

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8502
#, kde-format
msgid "Pre Gain"
msgstr "Kazanç Öncesi"

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8504
#, kde-format
msgid "Scales the input signal before the transfer function is applied to it."
msgstr "Aktarım işlevi uygulanmadan önce giriş sinyalini ölçeklendirir."

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8506
#, kde-format
msgid "Post Gain"
msgstr "Kazanç Sonrası"

#. i18n: file: data/effects/ladspa/ladspa_2157.xml
#: rc.cpp:8508
#, kde-format
msgid "Can be used to adjust the output gain of the effect."
msgstr "Efektin çıkış kazanımını ayarlamak için kullanılabilir."

#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:8512
#, kde-format
msgid "TAP TubeWarmth"
msgstr "TAP TubeWarmth"

#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:8514
#, kde-format
msgid ""
"TAP TubeWarmth (LADSPA 2158)<br>\n"
"   Adds the character of vacuum tube amplification by emulating the "
"sonically desirable nonlinear characteristics of triodes. It also supports "
"emulating analog tape saturation."
msgstr ""
"TAP TubeWarmth (LADSPA 2158)<br>\n"
"   Triyotların ses açısından istenen doğrusal olmayan özelliklerine "
"öykünerek vakum tüplü genlik karakterini kazandırır. Ayrıca analog bant "
"doygunluğuna öykünmeyi de destekler."

#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:8518
#, kde-format
msgid "Adjusts the amount of the effect"
msgstr "Efektin miktarını ayarlar."

#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:8520
#, kde-format
msgid "Tape--Tube Blend"
msgstr "Teyp–Tüp Harmanı"

#. i18n: file: data/effects/ladspa/ladspa_2158.xml
#: rc.cpp:8522
#, kde-format
msgid "Controls the color of the TubeWarmth sound"
msgstr "TubeWarmth sesinin rengini denetler."

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8526
#, kde-format
msgid "TAP Chorus/Flange"
msgstr "TAP Koro/Flanş"

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8528
#, kde-format
msgid ""
"TAP Chorus/Flange (LADSPA 2159)<br>\n"
"    Creates traditional Chorus and Flanger effects, spiced up a bit to make "
"use of stereo processing. It sounds best on guitar and synth tracks."
msgstr ""
"TAP Koro/Flanş (LADSPA 2159)<br>\n"
"    Geleneksel Koro ve Flanş efektleri yaratır, stereo işlemeyi kullanmak "
"için biraz daha zenginleştirilmiştir. Gitar ve synth parçalarında en iyi "
"sesi verir."

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8532
#, kde-format
msgid ""
"Determines the LFO frequency<br>\n"
"      with which the time-varying delay is modulated. The higher the "
"frequency, the more intense the effect will be."
msgstr ""
"Zamanla değişen gecikmenin modüle edildiği LFO frekansını belirler.<br>\n"
"      Frekans ne kadar yüksekse efekt o kadar yoğun olur."

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8534
#, kde-format
msgid "L/R Phase Shift"
msgstr "Sağ/Sol Evre Kayması"

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8536
#, kde-format
msgid ""
"Controls the phase shift between the two<br>\n"
"      LFOs. The higher this setting, the stronger the \"stereo-ness\" of the "
"effect will be. When set to 0, processing of the two channels will be in-"
"phase; when set to 180 degrees, the two LFO's are is counter-phase to create "
"the widest stereo effect."
msgstr ""
"İki LFO arasındaki evre kaymasını denetler.<br>\n"
"      Bu ayar ne kadar yüksekse efektin “stereo” etkisi o kadar güçlü olur. "
"0 olarak ayarlandığında, iki kanalın işlenmesi aynı evrede gerçekleşir; 180 "
"dereceye ayarlandığında ise iki LFO en geniş stereo efektini oluşturmak için "
"karşı evrede çalışır."

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8540
#, kde-format
msgid ""
"Adjusts the modulation depth of the delay.<br>\n"
"      Increasing it will result in stronger modulation using the same LFO "
"frequency."
msgstr ""
"Gecikmenin modülasyon derinliğini ayarlar.<br>\n"
"      Bunu artırmak aynı LFO frekansını kullanarak daha güçlü modülasyona "
"yol açacaktır."

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8544
#, kde-format
msgid ""
"Determines the fixed amount of time with<br>\n"
"      which the signal is delayed after the time-varying delay has been "
"applied. The setting of this control distinguishes between the Chorus and "
"Flanger effects. Delays smaller than 10 ms can be labeled Flanger, delays "
"above 20 ms yield Chorus, and delays in the range of 10-20 ms result in a "
"blend between Chorus and Flanger."
msgstr ""
"Zamanla değişen gecikme uygulandıktan sonra sinyalin<br>\n"
"      ne kadar süre geciktirileceğini belirler. Bu denetimin ayarı, Koro ve "
"Flanş efektleri arasında ayrım yapar. 10 ms’den küçük gecikmeler Flanş "
"olarak etiketlenebilir, 20 ms’nin üzerindeki gecikmeler Koro ve 10–20 ms "
"aralığındaki gecikmeler ise Koro ve Flanş arasında bir karışım oluşturur."

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8546
#, kde-format
msgid "Contour"
msgstr "Kontur"

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8548
#, kde-format
msgid ""
"The cutoff frequency of a high-pass<br>\n"
"      filter applied to the now twice-delayed signal."
msgstr ""
"Şimdi iki kez geciktirilmiş sinyale uygulanan <br>\n"
"      yüksek geçişli süzgecin kesme frekansı."

#. i18n: file: data/effects/ladspa/ladspa_2159.xml
#: rc.cpp:8552 rc.cpp:8556
#, kde-format
msgid ""
"Allows for a final tuning of the sound.<br>\n"
"      The strongest effect is achieved if the two settings are about the "
"same. Decreasing one of them (preferably the Wet Level, to mitigate any "
"unwanted side effects) results in a subtler effect."
msgstr ""
"Sesin son ayarını yapmaya olanak tanır.<br>\n"
"      En güçlü etki, iki ayarın yaklaşık olarak aynı olması durumunda elde "
"edilir. Bunlardan birini (tercihen istenmeyen yan etkileri azaltmak için "
"Islak Düzeyi) azaltmak, daha incelikli bir etkiyle sonuçlanır."

