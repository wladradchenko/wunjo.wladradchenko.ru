msgstr "Çıktıdaki benzetilmiş örtüşme miktarını denetler."

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7714
#, kde-format
msgid "Barry's Satan Maximiser"
msgstr "Barry's Satan Maximiser"

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7716
#, kde-format
msgid ""
"Barry's Satan Maximiser (LADSPA 1408)<br>\n"
"   Compresses signals with a stupidly short attack and decay, infinite ratio "
"and hard knee. Not really as a compressor, but good harsh (non-musical) "
"distortion."
msgstr ""
"Barry's Satan Maximiser (LADSPA 1408)<br>\n"
"   Sinyalleri aşırı kısa saldırı ve sönümlenme, sonsuz oran ve sert dizle "
"sıkıştırır. Aslında bir kompresör olarak değil, iyi bir sert (müzikal "
"olmayan) bozulma olarak işe yarar."

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7718
#, kde-format
msgid "Decay Time (samples)"
msgstr "Sönümlenme Süresi (örnek)"

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7720
#, kde-format
msgid "Controls the envelope decay time."
msgstr "Zarfın sönümlenme süresini denetler."

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
