msgstr "Línia de retard de pinta (sense interpolació)"

#. i18n: file: data/effects/ladspa/ladspa_1889.xml
#: rc.cpp:7936
#, kde-format
msgid ""
"Comb Delay Line (non-interpolating) (LADSPA 1889)<br>\n"
"   Based on work by James McCartney in SuperCollider."
msgstr ""
"Línia de retard de pinta (sense interpolació) (LADSPA 1889)<br>\n"
"   Es basa en la faena de James McCartney al SuperCollider."

#. i18n: file: data/effects/ladspa/ladspa_1890.xml
#: rc.cpp:7950
#, kde-format
msgid "GLAME Highpass"
msgstr "Passaalt GLAME («GLAME Highpass»)"

#. i18n: file: data/effects/ladspa/ladspa_1890.xml
#: rc.cpp:7952
#, kde-format
msgid ""
"GLAME Highpass Filter (LADSPA 1890)<br>\n"
"   IIR highpass filter based using Chebishev coefficients. The filter allows "
"you to tweak the number of stages used for filtering. Every stage adds two "
"more poles, which leads to a steeper dropoff."
msgstr ""
"Filtre passaalt GLAME (LADSPA 1890)<br>\n"
"   Filtre passaalt basat en IIR que utilitza coeficients de Txebishev. El "
"filtre permet ajustar el nombre d'etapes utilitzades per al filtratge. Cada "
"etapa afig dos pols més, el que conduïx a un descens més pronunciat."

#. i18n: file: data/effects/ladspa/ladspa_1890.xml
#. i18n: file: data/effects/ladspa/ladspa_1891.xml
#. i18n: file: data/effects/ladspa/ladspa_1902.xml
#. i18n: file: data/effects/ladspa/ladspa_1903.xml
#. i18n: file: data/effects/ladspa/ladspa_1904.xml
#: rc.cpp:7954 rc.cpp:7966 rc.cpp:8072 rc.cpp:8082 rc.cpp:8092
#, kde-format
msgid "Cutoff Frequency"
msgstr "Freqüència de tall"

#. i18n: file: data/effects/ladspa/ladspa_1890.xml
#. i18n: file: data/effects/ladspa/ladspa_1891.xml
#. i18n: file: data/effects/ladspa/ladspa_1892.xml
#: rc.cpp:7956 rc.cpp:7968 rc.cpp:7982
#, kde-format
msgid "Stages"
msgstr "Etapes"

#. i18n: file: data/effects/ladspa/ladspa_1890.xml
#. i18n: file: data/effects/ladspa/ladspa_1891.xml
#. i18n: file: data/effects/ladspa/ladspa_1892.xml
#: rc.cpp:7958 rc.cpp:7970 rc.cpp:7984
#, kde-format
msgid ""
"Every stage adds two more<br>\n"
"      poles, which leads to a steeper dropoff."
msgstr ""
"Cada etapa afig dos pols<br>\n"
"      més, el que conduïx a un descens més pronunciat."

#. i18n: file: data/effects/ladspa/ladspa_1891.xml
#: rc.cpp:7962
#, kde-format
msgid "GLAME Lowpass"
msgstr "Passabaix GLAME («GLAME Lowpass»)"

#. i18n: file: data/effects/ladspa/ladspa_1891.xml
#: rc.cpp:7964
#, kde-format
msgid ""
"GLAME Lowpass Filter (LADSPA 1891)<br>\n"
"   IIR lowpass filter based using Chebishev coefficients. The filter allows "
"you to tweak the number of stages used for filtering. Every stage adds two "
"more poles, which leads to a steeper dropoff."
msgstr ""
"Filtre passabaix GLAME (LADSPA 1891)<br>\n"
"   Filtre passabaix basat en IIR que utilitza coeficients de Txebishev. El "
"filtre permet ajustar el nombre d'etapes utilitzades per al filtratge. Cada "
"etapa afig dos pols més, el que conduïx a un descens més pronunciat."

#. i18n: file: data/effects/ladspa/ladspa_1892.xml
#: rc.cpp:7974
#, kde-format
msgid "GLAME Bandpass"
msgstr "Passabanda GLAME («GLAME Bandpass»)"

#. i18n: file: data/effects/ladspa/ladspa_1892.xml
#: rc.cpp:7976
#, kde-format
msgid ""
"GLAME Bandpass Filter (LADSPA 1892)<br>\n"
"   IIR bandpass filter based using Chebishev coefficients. The filter allows "
"you to tweak the number of stages used for filtering. Every stage adds two "
"more poles, which leads to a steeper dropoff."
msgstr ""
"Filtre passabanda GLAME (LADSPA 1892)<br>\n"
"   Filtre passabanda basat en IIR que utilitza coeficients de Txebishev. El "
"filtre permet ajustar el nombre d'etapes utilitzades per al filtratge. Cada "
"etapa afig dos pols més, el que conduïx a un descens més pronunciat."

