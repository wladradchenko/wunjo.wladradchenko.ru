#. i18n: file: data/effects/avfilter/avfilter_crossfeed.xml
#: rc.cpp:5436
#, kde-format
msgid "Crossfeed"
msgstr "Mescla creuada"

#. i18n: file: data/effects/avfilter/avfilter_crossfeed.xml
#: rc.cpp:5438
#, kde-format
msgid ""
"Apply headphone crossfeed filter.\n"
"Crossfeed is the process of blending the left and right channels of stereo "
"audio recording. It is mainly used to reduce extreme stereo separation of "
"low frequencies.\n"
"The intent is to produce more speaker like sound to the listener."
msgstr ""
"Aplica el filtre de mescla creuada d'auriculars.\n"
"La mescla creuada és el procés de barrejar els canals esquerre i dret de la "
"gravació d'àudio estèreo. S'utilitza principalment per a reduir la separació "
"estèreo extrema de freqüències baixes.\n"
"La intenció és produir un so més pareixent al locutor per a l'oient."

#. i18n: file: data/effects/avfilter/avfilter_crossfeed.xml
#: rc.cpp:5442
#, kde-format
msgid ""
"Set strength of crossfeed.\n"
"Default is 0.2. Allowed range is from 0 to 1. This sets gain of low shelf "
"filter for side part of stereo image.\n"
"Default is -6dB. Max allowed is -30db when strength is set to 1."
msgstr ""
"Establix la intensitat de la mescla creuada.\n"
"El valor predeterminat és 0,2. L'interval permés és de 0 a 1. Açò establix "
"el guany del filtre de limitació baixa per a la part lateral de la imatge "
"estèreo.\n"
"El valor predeterminat és -6 dB. El màxim permés és -30 dB quan la "
"intensitat està establida a 1."

#. i18n: file: data/effects/avfilter/avfilter_crossfeed.xml
#: rc.cpp:5446
#, fuzzy, kde-format
#| msgid ""
#| "Set soundstage wideness.\n"
#| "Default is 0.5. Allowed range is from 0 to 1. This sets cut off frequency "
#| "of low shelf filter.\n"
#| "Default is cut off near 1550 Hz. With range set to 1 cut off frequency is "
#| "set to 2100 Hz. "
msgid ""
"Set soundstage wideness.\n"
"Default is 0.5. Allowed range is from 0 to 1. This sets cut off frequency of "
"low shelf filter.\n"
"Default is cut off near 1550 Hz. With range set to 1 cut off frequency is "
"set to 2100 Hz."
msgstr ""
"Establix l'amplària de l'etapa de so.\n"
"El valor predeterminat és 0,5. L'interval permés és de 0 a 1. Açò establix "
"la freqüència de retall del filtre de limitació baixa.\n"
"De manera predeterminada es retalla prop de 1550 Hz. Amb l'interval establit "
"a 1, la freqüència de retall s'establix a 2100 Hz."

