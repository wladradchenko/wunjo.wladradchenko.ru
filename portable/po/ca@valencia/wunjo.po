#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8230
#, kde-format
msgid "TAP Stereo Echo"
msgstr "Eco estèreo TAP"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8232
#, kde-format
msgid ""
"TAP Stereo Echo (LADSPA 2143)<br>\n"
"   Supports conventional mono and stereo delays, ping-pong delays and the "
"Haas effect (also known as Cross Delay Stereo)."
msgstr ""
"Eco estèreo TAP (LADSPA 2143)<br>\n"
"   Implementa els retards mono i estèreo convencionals, els retards de ping-"
"pong i l'efecte Haas (també conegut com «Cross Delay Stereo», Estèreo amb "
"retard creuat)."

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8234
#, kde-format
msgid "Cross Mode"
msgstr "Mode de creuat"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8236
#, kde-format
msgid "Haas Effect"
msgstr "Efecte Haas"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8238
#, kde-format
msgid "Swap Outputs"
msgstr "Intercanvia les eixides"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8240
#, kde-format
msgid "L Delay"
msgstr "Retard E"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8242
#, kde-format
msgid "L Feedback"
msgstr "Retroalimentació E"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8244
#, kde-format
msgid "R/Haas Delay"
msgstr "D/Retard Haas"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8246
#, kde-format
msgid "R/Haas Feedback"
msgstr "D/Retroalimentació Hass"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8248
#, kde-format
msgid "L Echo Level"
msgstr "Nivell d'eco E"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8250
#, kde-format
msgid "R Echo Level"
msgstr "Nivell d'eco D"

#. i18n: file: data/effects/ladspa/ladspa_2144.xml
#: rc.cpp:8256
#, kde-format
msgid "TAP Tremolo"
msgstr "Tremolo TAP"

#. i18n: file: data/effects/ladspa/ladspa_2144.xml
#: rc.cpp:8258
#, kde-format
msgid ""
"TAP Tremolo (LADSPA 2144)<br>\n"
"   Sounds good mainly on acoustic or electric guitar tracks."
msgstr ""
"Tremolo TAP (LADSPA 2144)<br>\n"
"   Sona bé principalment en temes de guitarra acústica o elèctrica."

#. i18n: file: data/effects/ladspa/ladspa_2145.xml
#: rc.cpp:8268
#, kde-format
msgid "TAP Scaling Limiter"
msgstr "Limitador d'escalat TAP"

#. i18n: file: data/effects/ladspa/ladspa_2145.xml
#: rc.cpp:8270
#, kde-format
msgid ""
"TAP Scaling Limiter (LADSPA 2145)<br>\n"
"   Achieves signal level limiting without audible artifacts."
msgstr ""
"Limitador d'escalat TAP (LADSPA 2145)<br>\n"
"   Aconseguix limitar el nivell del senyal sense defectes audibles."

#. i18n: file: data/effects/ladspa/ladspa_2145.xml
#: rc.cpp:8272
#, kde-format
msgid "Limit Level"
msgstr "Nivell límit"

#. i18n: file: data/effects/ladspa/ladspa_2145.xml
#: rc.cpp:8274
#, kde-format
msgid "Output Volume"
msgstr "Volum d'eixida"

#. i18n: file: data/effects/ladspa/ladspa_2146.xml
#: rc.cpp:8278
#, kde-format
msgid "TAP AutoPanner"
msgstr "AutoPanner TAP"

#. i18n: file: data/effects/ladspa/ladspa_2146.xml
#: rc.cpp:8280
#, kde-format
msgid ""
"TAP AutoPanner (LADSPA 2146)<br>\n"
"   Main use is to liven up synth tracks in the mix"
msgstr ""
"AutoPanner TAP (LADSPA 2146)<br>\n"
"   L'ús principal és animar les pistes de sintetització a la mescla"

#. i18n: file: data/effects/ladspa/ladspa_2146.xml
#: rc.cpp:8286
#, kde-format
msgid ""
"Sets the wideness of panning.<br>\n"
"      A setting of 100% means that mono input signal is panned between the "
"extreme left and right positions"
msgstr ""
"Establix l'amplitud de la panoràmica.<br>\n"
"      Un valor del 100% significa que el senyal d'entrada mono es desplaça "
"entre les posicions extrema esquerra i dreta"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8292
#, kde-format
msgid "TAP DeEsser"
msgstr "DeEsser TAP"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8294
#, kde-format
msgid ""
"TAP DeEsser (LADSPA 2147)<br>\n"
"   Used for attenuating higher pitched frequencies in vocals such as those "
"found in 'ess', 'shh' and 'chh' sounds."
msgstr ""
"DeEsser TAP (LADSPA 2147)<br>\n"
"   S'utilitza per a atenuar les freqüències de tons més alts en vocals com "
"les que es troben en sons «ess», «shh» i «chh»."

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8296
#, kde-format
msgid "Threshold Level"
msgstr "Nivell del llindar"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8300
#, kde-format
msgid "Sidechain Filter"
msgstr "Filtre de cadena lateral"

# skip-rule: tags-spaces-start
#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8302
#, kde-format
msgid ""
"The chosen filter's frequency<br>\n"
"      is set by the <b>Frequency</b> parameter"
msgstr ""
"La freqüència escollida del filtre<br>\n"
"      es definix al paràmetre <b>Freqüència</b>"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8304
#, kde-format
msgid "Highpass,Bandpass"
msgstr "Passalt,Passabanda"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8306
#, kde-format
msgid "Monitor On"
msgstr "Monitor actiu"

#. i18n: file: data/effects/ladspa/ladspa_2148.xml
#: rc.cpp:8310
#, kde-format
msgid "TAP Vibrato"
msgstr "Vibrato TAP"

#. i18n: file: data/effects/ladspa/ladspa_2148.xml
#: rc.cpp:8312
#, kde-format
msgid ""
"TAP Vibrato (LADSPA 2148)<br>\n"
"   Modulates the pitch of its input signal with a low-frequency sinusoidal "
"signal. It is useful for guitar and synth tracks, and it can also come handy "
"if a strange effect is needed."
msgstr ""
"Vibrato TAP (LADSPA 2148)<br>\n"
"   Modula el to del seu senyal d'entrada amb un senyal sinusoidal de baixa "
"freqüència. És útil per a les pistes de guitarres i sintetitzadors, i també "
"pot ser útil si es necessita un efecte estrany."

#. i18n: file: data/effects/ladspa/ladspa_2148.xml
#: rc.cpp:8316
#, kde-format
msgid "Determines how fast the pitch is modulated up-down"
msgstr "Determina la rapidesa amb què es modula el to cap amunt o avall"

#. i18n: file: data/effects/ladspa/ladspa_2148.xml
#: rc.cpp:8320
#, kde-format
msgid "Sets the amount of pitch modulation"
msgstr "Establix la quantitat de la modulació de to"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8328
#, kde-format
msgid "TAP Rotary Speaker"
msgstr "Altaveu rotatiu TAP"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8330
#, kde-format
msgid ""
"TAP Rotary Speaker (LADSPA 2149)<br>\n"
"   Simulates the sound of rotating speakers."
msgstr ""
"Altaveu rotatiu TAP (LADSPA 2149)<br>\n"
"   Simula el so dels altaveus rotatius."

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8332
#, kde-format
msgid "Rotor Frequency"
msgstr "Freqüència de gir"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8334
#, kde-format
msgid "Horn Frequency"
msgstr "Freqüència del clàxon"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8336
#, kde-format
msgid "Mic Distance"
msgstr "Distància del micròfon"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8338
#, kde-format
msgid "Rotor/Horn Mix"
msgstr "Mescla gir/clàxon"

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8342
#, kde-format
msgid "TAP Pitch Shifter"
msgstr "Desplaçament de to TAP"

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8344
#, kde-format
msgid ""
"TAP Pitch Shifter (LADSPA 2150)<br>\n"
"   Change the pitch in the range of plus/minus one octave."
msgstr ""
"Desplaçament de to TAP (LADSPA 2150)<br>\n"
"   Canvia el to en l'interval de més/menys una octava."

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8346
#, kde-format
msgid "Semitone Shift"
msgstr "Desplaçament de semitò"

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8348
#, kde-format
msgid ""
"Does the same thing as <b>Rate Shift</b></br>\n"
"      but allows to set musically sensible pitch shift rates."
msgstr ""
"Fa el mateix que el <b>Canviador de to (Rate Shift)</b></br>\n"
"      però permet establir canvis de to de so apreciables musicalment."

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8350
#, kde-format
msgid "Rate Shift"
msgstr "Canviador de to"

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8352
#, kde-format
msgid ""
"Does the same thing as <b>Semitone Shift</b><br>\n"
"      but in percentage of the original pitch, so that is closer to a "
"\"physical\", non-musical approach"
msgstr ""
"Fa el mateix que el <b>Desplaçament de semitò (Semitone Shift)</b></br>\n"
"      però segons un percentatge del to original, de manera que és més "
"pareixent a un criteri més «físic», no musical"

#. i18n: file: data/effects/ladspa/ladspa_2151.xml
#: rc.cpp:8360
#, kde-format
msgid "TAP Equalizer/BW"
msgstr "Equalitzador/BW TAP"

#. i18n: file: data/effects/ladspa/ladspa_2151.xml
#: rc.cpp:8362
#, kde-format
msgid ""
"TAP Equalizer (LADSPA (2151)<br>\n"
"    8-band equalizer with adjustable band center frequencies and bandwidth."
msgstr ""
"Equalitzador TAP (LADSPA (2151)<br>\n"
"    equalitzador de 8 bandes amb freqüències de centre de banda ajustables i "
"amplada de banda."

#. i18n: file: data/effects/ladspa/ladspa_2151.xml
#: rc.cpp:8368 rc.cpp:8374 rc.cpp:8380 rc.cpp:8386 rc.cpp:8392 rc.cpp:8398
#: rc.cpp:8404 rc.cpp:8410
#, kde-format
msgid "BW"
msgstr "BW"

