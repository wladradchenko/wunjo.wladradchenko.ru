#: rc.cpp:8378
#, kde-format
msgid "<Gain"
msgstr "<Guany"

#. i18n: file: data/effects/ladspa/ladspa_2152.xml
#: rc.cpp:8414
#, kde-format
msgid "TAP Dynamics (M)"
msgstr "Dinàmiques TAP (M)"

#. i18n: file: data/effects/ladspa/ladspa_2152.xml
#: rc.cpp:8416
#, kde-format
msgid ""
"TAP Dynamics Mono (LADSPA 2152)<br>\n"
"   Allows changing the dynamic content of the audio stream"
msgstr ""
"Dinàmiques TAP mono (LADSPA 2152)<br>\n"
"   Permet canviar el contingut dinàmic del flux d'àudio"

#. i18n: file: data/effects/ladspa/ladspa_2152.xml
#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8422 rc.cpp:8440
#, kde-format
msgid "Offset Gain"
msgstr "Guany de desplaçament"

#. i18n: file: data/effects/ladspa/ladspa_2152.xml
#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8424 rc.cpp:8442
#, kde-format
msgid "Makeup Gain"
msgstr "Guany de composició"

#. i18n: file: data/effects/ladspa/ladspa_2152.xml
#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8426 rc.cpp:8450
#, kde-format
msgid "Dynamics Transfer Function"
msgstr "Funció de transferència de dinàmica"

# skip-rule: t-pc_sp
