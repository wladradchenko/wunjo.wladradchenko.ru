#. i18n: file: data/effects/ladspa/ladspa_1900.xml
#: rc.cpp:7910 rc.cpp:7926 rc.cpp:7942 rc.cpp:8004 rc.cpp:8018 rc.cpp:8032
#: rc.cpp:8046
#, kde-format
msgid "Delay Time"
msgstr "Temps de retard"

#. i18n: file: data/effects/ladspa/ladspa_1887.xml
#. i18n: file: data/effects/ladspa/ladspa_1888.xml
#. i18n: file: data/effects/ladspa/ladspa_1889.xml
#: rc.cpp:7914 rc.cpp:7930 rc.cpp:7946
#, kde-format
msgid ""
"Time for the echoes to decay<br>\n"
"      by 60 decibels. If this time is negative then the feedback coefficient "
"will be negative, thus emphasizing only odd harmonics at an octave lower."
msgstr ""
"Temps que tarden els ecos a decaure<br>\n"
"      60 decibels. Si este temps és negatiu, llavors el coeficient de "
"retroalimentació serà negatiu, posant així èmfasi només en harmònics "
"imparells a una octava inferior."

#. i18n: file: data/effects/ladspa/ladspa_1888.xml
#: rc.cpp:7918
#, kde-format
msgid "Comb Delay Line (cubic spline interpolation)"
msgstr ""
"Línia de retard de pinta (interpolació cúbica spline) («Comb Delay Line»)"

#. i18n: file: data/effects/ladspa/ladspa_1888.xml
#: rc.cpp:7920
#, kde-format
msgid ""
"Comb Delay Line (cubic spline interpolation) (LADSPA 1888)<br>\n"
"   Based on work by James McCartney in SuperCollider."
msgstr ""
"Línia de retard de pinta (interpolació cúbica spline) (LADSPA 1888)<br>\n"
"   Es basa en la faena de James McCartney al SuperCollider."

#. i18n: file: data/effects/ladspa/ladspa_1889.xml
#: rc.cpp:7934
#, kde-format
