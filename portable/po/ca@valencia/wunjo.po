msgstr "Establix l'alineació vertical"

#. i18n: file: data/effects/gpstext.xml
#: rc.cpp:1202
#, kde-format
msgid "Opacity of all elements - text, outline, and background"
msgstr "Opacitat de tots els elements: text, contorn i fons"

#. i18n: file: data/effects/gradientmap.xml
#: rc.cpp:1204
#, kde-format
msgid "Gradient Map"
msgstr "Mapa de degradats"

#. i18n: file: data/effects/gradientmap.xml
#: rc.cpp:1206
#, kde-format
