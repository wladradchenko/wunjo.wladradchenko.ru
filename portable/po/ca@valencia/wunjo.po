msgstr "Tipus de màscara"

#. i18n: file: data/effects/frei0r/frei0r_keyspillm0pup.xml
#: rc.cpp:3572
#, kde-format
msgid "Color distance,Transparency,Edge inwards,Edge outwards"
msgstr "Distància de color,Transparència,Vora cap a dins,Vora cap a fora"

#. i18n: file: data/effects/frei0r/frei0r_keyspillm0pup.xml
#: rc.cpp:3574
