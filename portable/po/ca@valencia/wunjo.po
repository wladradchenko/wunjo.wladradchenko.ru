msgstr "Color del contorn"

#. i18n: file: data/effects/gpstext.xml
#: rc.cpp:1172
#, kde-format
msgid "Outline color"
msgstr "Color del contorn"

#. i18n: file: data/effects/gpstext.xml
#: rc.cpp:1176
#, kde-format
msgid "The width of the outline in pixels"
msgstr "L'amplària del contorn en píxels"

#. i18n: file: data/effects/gpstext.xml
#: rc.cpp:1180
#, kde-format
msgid "Apply underline decoration to the text."
msgstr "Aplica una decoració de subratllat al text."

#. i18n: file: data/effects/gpstext.xml
#: rc.cpp:1184
#, kde-format
msgid "Apply strikethrough decoration to the text."
msgstr "Aplica una decoració de barrat al text."

#. i18n: file: data/effects/gpstext.xml
#: rc.cpp:1190
#, kde-format
msgid "Set the horizontal alignment"
msgstr "Establix l'alineació horitzontal"

#. i18n: file: data/effects/gpstext.xml
#: rc.cpp:1196
#, kde-format
