#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7640
#, kde-format
msgid "Delayorama"
msgstr "Delayorama"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7642
#, kde-format
msgid "Delayorama (LADSPA 1402)"
msgstr "Delayorama (LADSPA 1402)"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7646
#, kde-format
msgid ""
"Controls the random numbers that<br>\n"
"      will be used to stagger the delays and amplitudes if random is turned "
"up on them. Changing this forces the random values to be recalculated."
msgstr ""
"Controla els números aleatoris que<br>\n"
"      s'utilitzaran per a escalonar els retards i amplituds si es mostren "
"aleatoris. Canviar açò força que es recalculen els valors aleatoris."

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7650
#, kde-format
msgid "Controls the gain of the input signal"
msgstr "Controla el guany del senyal d'entrada"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7654
#, kde-format
msgid "Controls the amount of output signal fed back into the input"
msgstr "Controla la quantitat de senyal d'eixida retornada a l'entrada"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7656
#, kde-format
msgid "Number of Taps"
msgstr "Nombre de tocs"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7658
#, kde-format
msgid "Controls the number of taps in the delay"
msgstr "Controla el nombre de tocs en el retard"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7660
#, kde-format
msgid "First Delay"
msgstr "Primer retard"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7662
#, kde-format
msgid "The time of the first delay"
msgstr "El temps del primer retard"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7664
#, kde-format
msgid "Delay Range"
msgstr "Interval de retard"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7666
#, kde-format
msgid "The time difference between the first and last delay"
msgstr "La diferència de temps entre el primer i l'últim retard"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7668
#, kde-format
msgid "Delay Change"
msgstr "Canvi de retard"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7670
#, kde-format
msgid "The scaling factor between one delay and the next"
msgstr "El factor d'escalat entre un retard i el següent"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7672
#, kde-format
msgid "Delay Random"
msgstr "Retard aleatori"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7674
#, kde-format
msgid "The random factor applied to the delay"
msgstr "El factor aleatori aplicat al retard"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7676
#, kde-format
msgid "Amplitude Change"
msgstr "Canvi d'amplitud"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7678
#, kde-format
msgid "The scaling factor between one amplitude and the next"
msgstr "El factor d'escalat entre una amplitud i la següent"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7680
#, kde-format
msgid "Amplitude Random"
msgstr "Amplitud aleatòria"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7682
#, kde-format
msgid "The random factor applied to the amplitude"
msgstr "El factor aleatori aplicat a l'amplitud"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7684
#, kde-format
msgid "Dry/Wet Mix"
msgstr "Mescla assecament/humitat"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7686
#, kde-format
msgid "The level of delayed sound mixed into the output"
msgstr "El nivell de so retardat barrejat en l'eixida"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#: rc.cpp:7690
#, kde-format
msgid "Dyson Compressor"
msgstr "Compressor Dyson"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#: rc.cpp:7692
#, kde-format
msgid "Dyson Compressor (LADSPA 1403)"
msgstr "Compressor Dyson (LADSPA 1403)"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#: rc.cpp:7694
#, kde-format
msgid "Peak Limit"
msgstr "Límit del pic"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#: rc.cpp:7696
#, kde-format
msgid ""
"Controls the desired limit<br>\n"
"      of the output signal"
msgstr ""
"Controla el límit desitjat<br>\n"
"      del senyal d'eixida"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#. i18n: file: data/effects/ladspa/ladspa_1913.xml
#: rc.cpp:7698 rc.cpp:8156
#, kde-format
msgid "Release Time"
msgstr "Temps de llançament"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#: rc.cpp:7700
#, kde-format
msgid ""
"Controls the time taken for<br>\n"
"      the compressor to relax its gain control over the input signal"
msgstr ""
"Controla el temps que tarda<br>\n"
"      el compressor per relaxar el seu control de guany sobre el senyal "
"d'entrada"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#: rc.cpp:7702
#, kde-format
msgid "Fast Compression Ratio"
msgstr "Relació de compressió ràpida"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#: rc.cpp:7704
#, kde-format
msgid "Compression Ratio"
msgstr "Relació de compressió"

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7708
#, kde-format
msgid "Crossover Distortion"
msgstr "Distorsió creuada («Crossover Distortion»)"

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7710
#, kde-format
msgid ""
"Crossover Distortion (LADSPA 1404)<br>\n"
"   This is a simulation of the distortion that happens in class B and AB "
"power amps when the signal crosses 0."
msgstr ""
"Distorsió creuada (LADSPA 1404)<br>\n"
"   Esta és una simulació de la distorsió que succeïx en els amplificadors de "
"potència de classe B i AB quan el senyal creua 0."

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7712
#, kde-format
msgid "Crossover Amplitude"
msgstr "Amplitud de l'encreuament"

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7714
#, kde-format
msgid "Controls the point at which the output signal becomes linear"
msgstr "Controla el punt en què el senyal d'eixida es torna lineal"

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7718
#, kde-format
msgid "Controls degree of smoothing of the crossover point"
msgstr "Controla el grau de suavitzat del punt d'encreuament"

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7722
#, kde-format
msgid "Aliasing"
msgstr "Aliàsing"

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7724
#, kde-format
msgid ""
"Aliasing (LADSPA 1407)<br>\n"
"   Simulates aliasing using nyquist frequency modulation. Produces wacky "
"results if the blocks aren't even numbers of samples long."
msgstr ""
"Aliàsing (LADSPA 1407)<br>\n"
"   Simula l'aliàsing utilitzant la modulació de freqüència «nyquist». "
"Produïx resultats errònies si els blocs no són un nombre parell de ni tan "
"sols un nombre de mostres."

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7726
#, kde-format
msgid "Aliasing Level"
msgstr "Nivell d'aliàsing"

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7728
#, kde-format
msgid "Controls the amount of simulated aliasing in the output."
msgstr "Controla la quantitat d'aliàsing simulat a l'eixida."

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7732
#, kde-format
msgid "Barry's Satan Maximiser"
msgstr "Maximitzador de Satanàs de Barry («Barry's Satan Maximiser»)"

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7734
#, kde-format
msgid ""
"Barry's Satan Maximiser (LADSPA 1408)<br>\n"
"   Compresses signals with a stupidly short attack and decay, infinite ratio "
"and hard knee. Not really as a compressor, but good harsh (non-musical) "
"distortion."
msgstr ""
"Maximitzador de Satanàs de Barry (LADSPA 1408)<br>\n"
"   Comprimix els senyals amb un atac i un decaïment estúpidament curts, una "
"relació infinita i un amortidor dur. En realitat no com un compressor, sinó "
"una distorsió dura bona (no musical)."

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7736
#, kde-format
msgid "Decay Time (samples)"
msgstr "Temps de decaïment (mostres)"

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7738
#, kde-format
msgid "Controls the envelope decay time."
msgstr "Controla el temps de decaïment de l'envolupant."

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7740
#, kde-format
msgid "Knee Point"
msgstr "Punt d'amortiment"

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7742
#, kde-format
msgid ""
"Controls the knee roll-off point,<br>\n"
"      ie. the point above which the compression kicks in. 0 will have no "
"effect, -90 will remove virtually all dynamic range."
msgstr ""
"Controla el punt d'eixida de l'amortiment,<br>\n"
"      és a dir, el punt per damunt el qual es produïx la compressió. 0 no "
"tindrà cap efecte, -90 eliminarà virtualment tot el marge dinàmic."

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7746
#, kde-format
msgid "Gate"
msgstr "Porta"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7748
#, kde-format
msgid "Gate (LADSPA 1410)"
msgstr "Porta (LADSPA 1410)"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7750
#, kde-format
msgid "LF Key Filter"
msgstr "Filtre de clau LF"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7752
#, kde-format
msgid ""
"Controls the cutoff of<br>\n"
"      the low frequency filter (highpass)"
msgstr ""
"Controla el tall del<br>\n"
"      filtre de baixa freqüència (passaalt)"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7754
#, kde-format
msgid "HF Key Filter"
msgstr "Filtre de clau HF"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7756
#, kde-format
msgid ""
"Controls the cutoff of<br>\n"
"      the high frequency filter (lowpass)"
msgstr ""
"Controla el tall del<br>\n"
"      filtre d'alta freqüència (passabaix)"

