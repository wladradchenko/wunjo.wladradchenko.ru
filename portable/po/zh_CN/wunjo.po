#: rc.cpp:2638
#, kde-format
msgid "Blur start"
msgstr "模糊起始"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_wrap.xml
#: rc.cpp:2640
#, kde-format
msgid ""
"Horizontal fraction of the unchanged area to blur over in the equator band"
msgstr "赤道带中需模糊覆盖的未变化区域的水平比例"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_wrap.xml
#: rc.cpp:2642
#, kde-format
msgid "Blur end"
msgstr "模糊终点"

#. i18n: file: data/effects/frei0r/frei0r_bigsh0t_eq_wrap.xml
#: rc.cpp:2644
#, kde-format
