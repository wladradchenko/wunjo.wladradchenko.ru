#. i18n: file: data/effects/ladspa/ladspa_1190.xml
#: rc.cpp:7470
#, kde-format
msgid "Comb Filter"
msgstr "Comb Filter - 梳状滤波器"

#. i18n: file: data/effects/ladspa/ladspa_1190.xml
#: rc.cpp:7472
#, kde-format
msgid "Comb Filter (LADSPA 1190)"
msgstr "Comb Filter (LADSPA 1190)"

#. i18n: file: data/effects/ladspa/ladspa_1190.xml
#. i18n: file: data/effects/ladspa/ladspa_1411.xml
#: rc.cpp:7474 rc.cpp:7772
#, kde-format
msgid "Band Separation"
msgstr "频带间隔"

#. i18n: file: data/effects/ladspa/ladspa_1190.xml
#: rc.cpp:7476
#, kde-format
msgid "Controls the distance between the filters peaks"
msgstr "控制滤波器峰值之间的距离"

#. i18n: file: data/effects/ladspa/ladspa_1190.xml
#. i18n: file: data/effects/ladspa/ladspa_1191.xml
