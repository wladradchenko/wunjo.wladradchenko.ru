msgstr "扩展 (八度)"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7622
#, kde-format
msgid "Delayorama"
msgstr "Delayorama - Delayorama 延迟"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7624
#, kde-format
msgid "Delayorama (LADSPA 1402)"
msgstr "Delayorama (LADSPA 1402)"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7628
#, kde-format
msgid ""
"Controls the random numbers that<br>\n"
"      will be used to stagger the delays and amplitudes if random is turned "
"up on them. Changing this forces the random values to be recalculated."
msgstr ""
"控制随机数，<br>\n"
"      如果启用了延迟和振幅的随机化，这些随机数将用于错开延迟和振幅。更改此值"
"会强制重新计算随机值。"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7632
#, kde-format
msgid "Controls the gain of the input signal"
msgstr "控制输入信号的增益"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7636
#, kde-format
msgid "Controls the amount of output signal fed back into the input"
msgstr "控制反馈到输入的输出信号量"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7638
#, kde-format
msgid "Number of Taps"
msgstr "抽头数"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7640
#, kde-format
msgid "Controls the number of taps in the delay"
msgstr "控制延迟中的抽头数量"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7642
#, kde-format
msgid "First Delay"
msgstr "第一次延迟"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7644
#, kde-format
msgid "The time of the first delay"
msgstr "第一次延迟的时间"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7646
#, kde-format
msgid "Delay Range"
msgstr "延迟范围"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7648
#, kde-format
msgid "The time difference between the first and last delay"
msgstr "第一次与最后一次延迟之间的时间差"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7650
#, kde-format
msgid "Delay Change"
msgstr "延迟变化"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7652
#, kde-format
msgid "The scaling factor between one delay and the next"
msgstr "相邻两次延迟之间的缩放系数"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7654
#, kde-format
msgid "Delay Random"
msgstr "延迟随机"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7656
#, kde-format
msgid "The random factor applied to the delay"
msgstr "应用于延迟的随机系数"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7658
#, kde-format
msgid "Amplitude Change"
msgstr "振幅变化"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7660
#, kde-format
msgid "The scaling factor between one amplitude and the next"
msgstr "相邻两个振幅之间的缩放系数"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7662
#, kde-format
msgid "Amplitude Random"
msgstr "振幅随机"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7664
#, kde-format
msgid "The random factor applied to the amplitude"
msgstr "应用于振幅的随机系数"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7666
#, kde-format
msgid "Dry/Wet Mix"
msgstr "干/湿混合"

#. i18n: file: data/effects/ladspa/ladspa_1402.xml
#: rc.cpp:7668
#, kde-format
msgid "The level of delayed sound mixed into the output"
msgstr "混入输出的延迟声音电平"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#: rc.cpp:7672
#, kde-format
msgid "Dyson Compressor"
msgstr "Dyson Compressor - Dyson 压缩器"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#: rc.cpp:7674
#, kde-format
msgid "Dyson Compressor (LADSPA 1403)"
msgstr "Dyson Compressor (LADSPA 1403)"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#: rc.cpp:7676
#, kde-format
msgid "Peak Limit"
msgstr "峰值限制"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#: rc.cpp:7678
#, kde-format
msgid ""
"Controls the desired limit<br>\n"
"      of the output signal"
msgstr ""
"控制输出信号<br>\n"
"      的期望限值"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#. i18n: file: data/effects/ladspa/ladspa_1913.xml
#: rc.cpp:7680 rc.cpp:8138
#, kde-format
msgid "Release Time"
msgstr "释放时间"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#: rc.cpp:7682
#, kde-format
msgid ""
"Controls the time taken for<br>\n"
"      the compressor to relax its gain control over the input signal"
msgstr ""
"控制压缩器<br>\n"
"      放松对输入信号增益控制所需的时间"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#: rc.cpp:7684
#, kde-format
msgid "Fast Compression Ratio"
msgstr "快速压缩比"

#. i18n: file: data/effects/ladspa/ladspa_1403.xml
#: rc.cpp:7686
#, kde-format
msgid "Compression Ratio"
msgstr "压缩比"

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7690
#, kde-format
msgid "Crossover Distortion"
msgstr "Crossover Distortion - 交越失真"

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7692
#, kde-format
msgid ""
"Crossover Distortion (LADSPA 1404)<br>\n"
"   This is a simulation of the distortion that happens in class B and AB "
"power amps when the signal crosses 0."
msgstr ""
"Crossover Distortion (LADSPA 1404)<br>\n"
"   模拟 B 类和 AB 类功率放大器在信号过零时产生的失真。"

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7694
#, kde-format
msgid "Crossover Amplitude"
msgstr "交越振幅"

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7696
#, kde-format
msgid "Controls the point at which the output signal becomes linear"
msgstr "控制输出信号变为线性的点"

#. i18n: file: data/effects/ladspa/ladspa_1404.xml
#: rc.cpp:7700
#, kde-format
msgid "Controls degree of smoothing of the crossover point"
msgstr "控制交越点的平滑程度"

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7704
#, kde-format
msgid "Aliasing"
msgstr "Aliasing - 混叠"

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7706
#, kde-format
msgid ""
"Aliasing (LADSPA 1407)<br>\n"
"   Simulates aliasing using nyquist frequency modulation. Produces wacky "
"results if the blocks aren't even numbers of samples long."
msgstr ""
"Aliasing (LADSPA 1407)<br>\n"
"   使用奈奎斯特频率调制模拟混叠。如果数据块的样本数不是偶数，会产生古怪的结"
"果。"

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7708
#, kde-format
msgid "Aliasing Level"
msgstr "混叠电平"

#. i18n: file: data/effects/ladspa/ladspa_1407.xml
#: rc.cpp:7710
#, kde-format
msgid "Controls the amount of simulated aliasing in the output."
msgstr "控制输出中模拟混叠的量。"

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7714
#, kde-format
msgid "Barry's Satan Maximiser"
msgstr "Barry's Satan Maximiser - Barry 撒旦最大化器"

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7716
#, kde-format
msgid ""
"Barry's Satan Maximiser (LADSPA 1408)<br>\n"
"   Compresses signals with a stupidly short attack and decay, infinite ratio "
"and hard knee. Not really as a compressor, but good harsh (non-musical) "
"distortion."
msgstr ""
"Barry's Satan Maximiser (LADSPA 1408)<br>\n"
"   以极短的起音和衰减、无限压缩比和硬拐点压缩信号。与其说是压缩器，不如说是一"
"种不错的刺耳 (非音乐性) 失真。"

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7718
#, kde-format
msgid "Decay Time (samples)"
msgstr "衰减时间 (样本)"

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7720
#, kde-format
msgid "Controls the envelope decay time."
msgstr "控制包络衰减时间。"

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7722
#, kde-format
msgid "Knee Point"
msgstr "拐点"

#. i18n: file: data/effects/ladspa/ladspa_1408.xml
#: rc.cpp:7724
#, kde-format
msgid ""
"Controls the knee roll-off point,<br>\n"
"      ie. the point above which the compression kicks in. 0 will have no "
"effect, -90 will remove virtually all dynamic range."
msgstr ""
"控制拐点滚降点，<br>\n"
"      即超过此点后开始压缩。0 表示无效果，-90 将几乎去除全部动态范围。"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7728
#, kde-format
msgid "Gate"
msgstr "Gate - 噪声门"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7730
#, kde-format
msgid "Gate (LADSPA 1410)"
msgstr "Gate (LADSPA 1410)"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7732
#, kde-format
msgid "LF Key Filter"
msgstr "低频键控滤波器"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7734
#, kde-format
msgid ""
"Controls the cutoff of<br>\n"
"      the low frequency filter (highpass)"
msgstr ""
"控制低频滤波器<br>\n"
"      (高通) 的截止频率"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7736
#, kde-format
msgid "HF Key Filter"
msgstr "高频键控滤波器"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7738
#, kde-format
msgid ""
"Controls the cutoff of<br>\n"
"      the high frequency filter (lowpass)"
msgstr ""
"控制高频滤波器<br>\n"
"      (低通) 的截止频率"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7742
#, kde-format
msgid ""
"Controls the level at<br>\n"
"      which the gate will open"
msgstr ""
"控制噪声门<br>\n"
"      打开时的电平"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7746
#, kde-format
msgid ""
"Controls the time the<br>\n"
"      gate will take to open fully"
msgstr ""
"控制噪声门<br>\n"
"      完全打开所需的时间"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7748
#, kde-format
msgid "Hold"
msgstr "保持"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7750
#, kde-format
msgid ""
"Controls the minimum<br>\n"
"      time the gate will stay open for"
msgstr ""
"控制噪声门<br>\n"
"      保持打开的最短时间"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7754
#, kde-format
msgid ""
"Controls the time the<br>\n"
"      gate will take to close fully"
msgstr ""
"控制噪声门<br>\n"
"      完全关闭所需的时间"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7758
#, kde-format
msgid ""
"Controls the difference<br>\n"
"      between the gate's open and closed state"
msgstr ""
"控制噪声门<br>\n"
"      打开与关闭状态之间的差值"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7760
#, kde-format
msgid "Output Monitor"
msgstr "输出监听"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7762
#, kde-format
msgid "Controls output monitor"
msgstr "控制输出监听"

#. i18n: file: data/effects/ladspa/ladspa_1410.xml
#: rc.cpp:7764
#, kde-format
msgid "Key (listen),Gate (normal output),Bypass"
msgstr "键控 (监听),噪声门 (正常输出),旁通"

#. i18n: file: data/effects/ladspa/ladspa_1411.xml
#: rc.cpp:7768
#, kde-format
msgid "Comb Splitter"
msgstr "Comb Splitter - 梳状分离器"

#. i18n: file: data/effects/ladspa/ladspa_1411.xml
#: rc.cpp:7770
#, kde-format
msgid ""
"Comb Splitter (LADSPA 1411)<br>\n"
"   Divides the input up into two parts with frequency peaks at f Hz "
"intervals, skewed by f/2 Hz between the two outputs. Mixing the two outputs "
"will get you exactly the input signal."
msgstr ""
"Comb Splitter (LADSPA 1411)<br>\n"
"   将输入分成两部分，其频率峰值间隔为 f Hz，两路输出之间相差 f/2 Hz。将两路输"
"出混合即可精确得到输入信号。"

#. i18n: file: data/effects/ladspa/ladspa_1411.xml
#: rc.cpp:7774
#, kde-format
msgid "The distance between the frequency peaks"
msgstr "频率峰值之间的距离"

#. i18n: file: data/effects/ladspa/ladspa_1415.xml
#: rc.cpp:7778
#, kde-format
msgid "FM Oscillator"
msgstr "FM Oscillator - FM 振荡器"

#. i18n: file: data/effects/ladspa/ladspa_1415.xml
#: rc.cpp:7780
#, kde-format
msgid "FM Oscillator (LADSPA 1415)"
msgstr "FM Oscillator (LADSPA 1415)"

#. i18n: file: data/effects/ladspa/ladspa_1415.xml
#: rc.cpp:7784
#, kde-format
msgid "The shape of the waveform"
msgstr "波形的形状"

#. i18n: file: data/effects/ladspa/ladspa_1415.xml
#: rc.cpp:7786
#, kde-format
msgid "Sine,Triangle,Square,Saw"
msgstr "正弦波,三角波,方波,锯齿波"

#. i18n: file: data/effects/ladspa/ladspa_1423.xml
#: rc.cpp:7790
#, kde-format
msgid "SWH Plate Reverb"
msgstr "SWH Plate Reverb - SWH 板式混响"

#. i18n: file: data/effects/ladspa/ladspa_1423.xml
#: rc.cpp:7792
#, kde-format
msgid ""
"SWH Plate Reverb (LADSPA 1423)<br>\n"
"   Automatically adapts to the number of channels and sampling rate of the "
"audio stream"
msgstr ""
"SWH Plate Reverb (LADSPA 1423)<br>\n"
"   自动适应音频流的声道数和采样率"

#. i18n: file: data/effects/ladspa/ladspa_1423.xml
#: rc.cpp:7794
#, kde-format
msgid "Reverb Time"
msgstr "混响时间"

#. i18n: file: data/effects/ladspa/ladspa_1423.xml
#. i18n: file: data/effects/ladspa/ladspa_reverb.xml
#. i18n: file: data/effects/ladspa/ladspa_room_reverb.xml
#: rc.cpp:7796 rc.cpp:8664 rc.cpp:8674
#, kde-format
msgid "Damping"
msgstr "衰减"

#. i18n: file: data/effects/ladspa/ladspa_1423.xml
#: rc.cpp:7798
#, kde-format
msgid "Dry/wet mix"
msgstr "干/湿混合"

#. i18n: file: data/effects/ladspa/ladspa_1430.xml
#: rc.cpp:7802
#, kde-format
msgid "Chebyshev Distortion"
msgstr "Chebyshev Distortion - 切比雪夫失真"

#. i18n: file: data/effects/ladspa/ladspa_1430.xml
#: rc.cpp:7804
#, kde-format
msgid ""
"Chebyshev Distortion (LADSPA 1430)<br>\n"
"   This effect is seeded from incoming signal envelope. As the level of the "
"signal rises more and more harmonics will for added to the output signal. "
"The distortion control sets the sensitivity of the input."
msgstr ""
"Chebyshev Distortion (LADSPA 1430)<br>\n"
"   此效果由输入信号的包络驱动。随着信号电平升高，会有越来越多的谐波被添加到输"
"出信号中。失真控制用于设置输入的灵敏度。"

#. i18n: file: data/effects/ladspa/ladspa_1430.xml
#: rc.cpp:7806
#, kde-format
msgid "Distortion"
msgstr "失真"

#. i18n: file: data/effects/ladspa/ladspa_1430.xml
#: rc.cpp:7808
#, kde-format
msgid "Sets the sensitivity of the input"
msgstr "设置输入的灵敏度"

#. i18n: file: data/effects/ladspa/ladspa_1431.xml
#: rc.cpp:7812
#, kde-format
msgid "Bode Frequency Shifter"
msgstr "Bode Frequency Shifter - Bode 移频器"

#. i18n: file: data/effects/ladspa/ladspa_1431.xml
#: rc.cpp:7814
#, kde-format
msgid ""
"<b>Bode Frequency Shifter</b> (LADSPA 1431)<br>\n"
"   A Bode/Moog Frequency Shifter is a popular analogue synth module that "
"works by shifting all the frequencies of an input signal up or down by a "
"specified frequency. This effect shifts in both directions at the same time "
"as it is almost no extra work and is often useful to have both directions. "
"In contrast to the analogue Bode/Moog, which use Dome filters as the core, "
"it uses a Hilbert Transformer, which is much simpler to implement in digital "
"systems."
msgstr ""
"<b>Bode Frequency Shifter</b> (LADSPA 1431)<br>\n"
"   Bode/Moog 移频器是一种流行的模拟合成器模块，它通过将输入信号的所有频率向上"
"或向下移动指定频率来工作。此效果同时向两个方向移频，因为这几乎不需要额外的计"
"算量，而且同时拥有两个方向通常很有用。与以 Dome 滤波器为核心的模拟 Bode/Moog "
"不同，它使用希尔伯特变换器，在数字系统中实现起来要简单得多。"

#. i18n: file: data/effects/ladspa/ladspa_1431.xml
#: rc.cpp:7816
#, kde-format
msgid "Frequency Shift"
msgstr "频移"

#. i18n: file: data/effects/ladspa/ladspa_1431.xml
#. i18n: file: data/effects/ladspa/ladspa_1432.xml
#: rc.cpp:7818 rc.cpp:7836
#, kde-format
msgid "Controls the frequency shift applied to the input signal"
msgstr "控制应用于输入信号的频移"

#. i18n: file: data/effects/ladspa/ladspa_1432.xml
#: rc.cpp:7822
#, kde-format
msgid "Bode Frequency Shifter (CV)"
msgstr "Bode Frequency Shifter (CV) - Bode 移频器 (CV)"

#. i18n: file: data/effects/ladspa/ladspa_1432.xml
#: rc.cpp:7824
#, kde-format
msgid ""
"<b>Bode Frequency Shifter (CV)</b> (LADSPA 1432)<br>\n"
"   A Bode/Moog Frequency Shifter is a popular analogue synth module that "
"works by shifting all the frequencies of an input signal up or down by a "
"specified frequency. This effect shifts in both directions at the same time "
"as it is almost no extra work and is often useful to have both directions. "
"In contrast to the analogue Bode/Moog, which use Dome filters as the core, "
"it uses a Hilbert Transformer, which is much simpler to implement in digital "
"systems."
msgstr ""
"<b>Bode Frequency Shifter (CV)</b> (LADSPA 1432)<br>\n"
"   Bode/Moog 移频器是一种流行的模拟合成器模块，它通过将输入信号的所有频率向上"
"或向下移动指定频率来工作。此效果同时向两个方向移频，因为这几乎不需要额外的计"
"算量，而且同时拥有两个方向通常很有用。与以 Dome 滤波器为核心的模拟 Bode/Moog "
"不同，它使用希尔伯特变换器，在数字系统中实现起来要简单得多。"

#. i18n: file: data/effects/ladspa/ladspa_1432.xml
#: rc.cpp:7826
#, kde-format
msgid "Base Shift"
msgstr "基础移频"

#. i18n: file: data/effects/ladspa/ladspa_1432.xml
#: rc.cpp:7830
#, kde-format
msgid "Down,Both,Up"
msgstr "向下,双向,向上"

#. i18n: file: data/effects/ladspa/ladspa_1432.xml
#: rc.cpp:7832
#, kde-format
msgid "CV Attenuation"
msgstr "CV 衰减"

#. i18n: file: data/effects/ladspa/ladspa_1432.xml
#: rc.cpp:7834
#, kde-format
msgid "Shift CV"
msgstr "移频 CV"

#. i18n: file: data/effects/ladspa/ladspa_1433.xml
#: rc.cpp:7840
#, kde-format
msgid "AM Pitch Shifter"
msgstr "AM Pitch Shifter - AM 变调器"

#. i18n: file: data/effects/ladspa/ladspa_1433.xml
#: rc.cpp:7842
#, kde-format
msgid ""
"AM Pitch Shifter (LADSPA 1433)<br>\n"
"   This effect works by running a single write pointer (monotonic) and two "
"read pointers (pitchscaled) over a ringbuffer. The output is faded between "
"the two readpointers according to the sine of the distance from the write "
"pointer."
msgstr ""
"AM Pitch Shifter (LADSPA 1433)<br>\n"
"   此效果在环形缓冲区上运行一个写指针 (单调) 和两个读指针 (音高缩放)。输出根"
"据与写指针距离的正弦值在两个读指针之间淡入淡出。"

#. i18n: file: data/effects/ladspa/ladspa_1433.xml
#. i18n: file: data/effects/ladspa/ladspa_pitch.xml
#: rc.cpp:7844 rc.cpp:8640
#, kde-format
msgid "Pitch Shift"
msgstr "Pitch Shift - 音高偏移"

#. i18n: file: data/effects/ladspa/ladspa_1433.xml
#: rc.cpp:7846
#, kde-format
msgid ""
"The multiple of the output pitch.<br>\n"
"      For example, 2.00 will increase the pitch by one octave."
msgstr ""
"输出音高的倍数。<br>\n"
"      例如，2.00 将使音高提高一个八度。"

#. i18n: file: data/effects/ladspa/ladspa_1433.xml
#: rc.cpp:7848
#, kde-format
msgid "Buffer Size"
msgstr "缓冲区大小"

#. i18n: file: data/effects/ladspa/ladspa_1433.xml
#: rc.cpp:7850
#, kde-format
msgid ""
"The order of magnitude of the buffer size.<br>\n"
"      Small buffers will sound fluttery, large buffers will have flangy "
"sounding echos."
msgstr ""
"缓冲区大小的数量级。<br>\n"
"      小缓冲区听起来会有颤动感，大缓冲区会产生类似镶边的回声。"

#. i18n: file: data/effects/ladspa/ladspa_1438.xml
#: rc.cpp:7854
#, kde-format
msgid "DJ Flanger"
msgstr "DJ Flanger - DJ 镶边器"

#. i18n: file: data/effects/ladspa/ladspa_1438.xml
#: rc.cpp:7856
#, kde-format
msgid ""
"DJ Flanger (LADSPA 1438)<br>\n"
"   This is a flanger which is more or less typical of DJ mixing desks"
msgstr ""
"DJ Flanger (LADSPA 1438)<br>\n"
"   这是一种或多或少具有 DJ 调音台典型特征的镶边器"

#. i18n: file: data/effects/ladspa/ladspa_1438.xml
#: rc.cpp:7858
#, kde-format
msgid "LFO sync"
msgstr "LFO 同步"

#. i18n: file: data/effects/ladspa/ladspa_1438.xml
#: rc.cpp:7860
#, kde-format
msgid ""
"When turned from off to on<br>\n"
"      it resets the phase of the LFO back to the start of the cycle. Used to "
"sync the LFO to the track."
msgstr ""
"从关闭切换到开启时，<br>\n"
"      会将 LFO 的相位重置到周期的起点。用于将 LFO 与音轨同步。"

#. i18n: file: data/effects/ladspa/ladspa_1438.xml
#: rc.cpp:7862
#, kde-format
msgid "LFO period"
msgstr "LFO 周期"

#. i18n: file: data/effects/ladspa/ladspa_1438.xml
#: rc.cpp:7864
#, kde-format
msgid "The cycle period of the LFO in seconds"
msgstr "LFO 的周期 (秒)"

#. i18n: file: data/effects/ladspa/ladspa_1438.xml
#: rc.cpp:7868
#, kde-format
msgid "The maximum delay the LFO will use to flange in milliseconds"
msgstr "LFO 用于镶边的最大延迟 (毫秒)"

#. i18n: file: data/effects/ladspa/ladspa_1438.xml
#: rc.cpp:7872
#, kde-format
msgid "The amount of the delays output that is mixed back into the delay"
msgstr "延迟输出中混回延迟的量"

#. i18n: file: data/effects/ladspa/ladspa_1886.xml
#: rc.cpp:7876
#, kde-format
msgid "Exponential Signal Decay"
msgstr "Exponential Signal Decay - 指数信号衰减"

#. i18n: file: data/effects/ladspa/ladspa_1886.xml
#: rc.cpp:7878
#, kde-format
msgid "Exponential Signal Decay (LADSPA 1886)"
msgstr "Exponential Signal Decay (LADSPA 1886)"

#. i18n: file: data/effects/ladspa/ladspa_1887.xml
#: rc.cpp:7884
#, kde-format
msgid "Comb Delay Line (linear interpolation)"
msgstr "Comb Delay Line (linear interpolation) - 梳状延迟线 (线性插值)"

#. i18n: file: data/effects/ladspa/ladspa_1887.xml
#: rc.cpp:7886
#, kde-format
msgid ""
"Comb Delay Line (linear interpolation) (LADSPA 1887)<br>\n"
"   Based on work by James McCartney in SuperCollider."
msgstr ""
"Comb Delay Line (linear interpolation) (LADSPA 1887)<br>\n"
"   基于 James McCartney 在 SuperCollider 中的工作。"

#. i18n: file: data/effects/ladspa/ladspa_1887.xml
#. i18n: file: data/effects/ladspa/ladspa_1888.xml
#. i18n: file: data/effects/ladspa/ladspa_1889.xml
#. i18n: file: data/effects/ladspa/ladspa_1895.xml
#. i18n: file: data/effects/ladspa/ladspa_1896.xml
#. i18n: file: data/effects/ladspa/ladspa_1897.xml
#. i18n: file: data/effects/ladspa/ladspa_1900.xml
#: rc.cpp:7888 rc.cpp:7904 rc.cpp:7920 rc.cpp:7984 rc.cpp:7998 rc.cpp:8012
#: rc.cpp:8026
#, kde-format
msgid "Max Delay"
msgstr "最大延迟"

#. i18n: file: data/effects/ladspa/ladspa_1887.xml
#. i18n: file: data/effects/ladspa/ladspa_1888.xml
#. i18n: file: data/effects/ladspa/ladspa_1889.xml
#: rc.cpp:7890 rc.cpp:7906 rc.cpp:7922
#, kde-format
msgid ""
