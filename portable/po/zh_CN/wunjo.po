msgstr "<增益"

#. i18n: file: data/effects/ladspa/ladspa_2152.xml
#: rc.cpp:8396
#, kde-format
msgid "TAP Dynamics (M)"
msgstr "TAP 动态处理器 (M)"

#. i18n: file: data/effects/ladspa/ladspa_2152.xml
#: rc.cpp:8398
#, kde-format
msgid ""
"TAP Dynamics Mono (LADSPA 2152)<br>\n"
"   Allows changing the dynamic content of the audio stream"
msgstr ""
"TAP 动态处理器（单声道）(LADSPA 2152)<br>\n"
"   可用于调整音频流的动态范围。"

#. i18n: file: data/effects/ladspa/ladspa_2152.xml
#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8404 rc.cpp:8422
#, kde-format
msgid "Offset Gain"
msgstr "偏移增益"

#. i18n: file: data/effects/ladspa/ladspa_2152.xml
#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8406 rc.cpp:8424
#, kde-format
msgid "Makeup Gain"
msgstr " Makeup 增益"

#. i18n: file: data/effects/ladspa/ladspa_2152.xml
#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8408 rc.cpp:8432
#, kde-format
msgid "Dynamics Transfer Function"
msgstr "动态传递函数"

#. i18n: file: data/effects/ladspa/ladspa_2152.xml
#. i18n: file: data/effects/ladspa/ladspa_2153.xml
#: rc.cpp:8410 rc.cpp:8434
#, kde-format
msgid ""
"2:1 comp at -6dB,2:1 comp at -9dB,2:1 comp at -12dB,2:1 comp at -18dB,2.5 "
"comp at -18dB,3:1 comp at -12dB,3:1 comp at -15dB,Compressor/Gate,Expander,"
"Hard limiter at -6dB;Hard limiter at -12dB;Hard gate at -35dB;Soft limiter;"
