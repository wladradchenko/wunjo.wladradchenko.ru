msgstr "十六进制,十进制"

#. i18n: file: data/effects/avfilter/avfilter_dblur.xml
#: rc.cpp:5484
#, kde-format
msgid "Directional Blur"
msgstr "定向模糊"

#. i18n: file: data/effects/avfilter/avfilter_dblur.xml
#: rc.cpp:5486
#, kde-format
msgid "Apply directional blur filter"
msgstr "应用定向模糊滤镜"

#. i18n: file: data/effects/avfilter/avfilter_dblur.xml
#: rc.cpp:5490
#, kde-format
msgid "Sets the angle for the direction"
msgstr "设置方向角"

#. i18n: file: data/effects/avfilter/avfilter_dblur.xml
#: rc.cpp:5494
