#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8212
#, kde-format
msgid "TAP Stereo Echo"
msgstr "TAP 立体声回声"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8214
#, kde-format
msgid ""
"TAP Stereo Echo (LADSPA 2143)<br>\n"
"   Supports conventional mono and stereo delays, ping-pong delays and the "
"Haas effect (also known as Cross Delay Stereo)."
msgstr ""
"TAP 立体声回声 (LADSPA 2143)<br>\n"
"   支持传统的单声道和立体声延迟、乒乓延迟以及哈斯效应 (也称为交叉延迟立体"
"声) 。"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8216
#, kde-format
msgid "Cross Mode"
msgstr "交叉模式"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8218
#, kde-format
msgid "Haas Effect"
msgstr "哈斯效果"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8220
#, kde-format
msgid "Swap Outputs"
msgstr "交换输出"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8222
#, kde-format
msgid "L Delay"
msgstr "左延迟"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8224
#, kde-format
msgid "L Feedback"
msgstr "左反馈"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8226
#, kde-format
msgid "R/Haas Delay"
msgstr "右/哈斯延迟"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8228
#, kde-format
msgid "R/Haas Feedback"
msgstr "右/哈斯反馈"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8230
#, kde-format
msgid "L Echo Level"
msgstr "左回声电平"

#. i18n: file: data/effects/ladspa/ladspa_2143.xml
#: rc.cpp:8232
#, kde-format
msgid "R Echo Level"
msgstr "右回声电平"

#. i18n: file: data/effects/ladspa/ladspa_2144.xml
#: rc.cpp:8238
#, kde-format
msgid "TAP Tremolo"
msgstr "TAP 颤音"

#. i18n: file: data/effects/ladspa/ladspa_2144.xml
#: rc.cpp:8240
#, kde-format
msgid ""
"TAP Tremolo (LADSPA 2144)<br>\n"
"   Sounds good mainly on acoustic or electric guitar tracks."
msgstr ""
"TAP 颤音 (LADSPA 2144)<br>\n"
"   主要适用于原声或电吉他音轨。"

#. i18n: file: data/effects/ladspa/ladspa_2145.xml
#: rc.cpp:8250
#, kde-format
msgid "TAP Scaling Limiter"
msgstr "TAP 动态范围限制器"

#. i18n: file: data/effects/ladspa/ladspa_2145.xml
#: rc.cpp:8252
#, kde-format
msgid ""
"TAP Scaling Limiter (LADSPA 2145)<br>\n"
"   Achieves signal level limiting without audible artifacts."
msgstr ""
"TAP 动态范围限制器 (LADSPA 2145)<br>\n"
"   在不产生可闻失真的情况下实现信号电平限制。"

#. i18n: file: data/effects/ladspa/ladspa_2145.xml
#: rc.cpp:8254
#, kde-format
msgid "Limit Level"
msgstr "限制电平"

#. i18n: file: data/effects/ladspa/ladspa_2145.xml
#: rc.cpp:8256
#, kde-format
msgid "Output Volume"
msgstr "输出音量"

#. i18n: file: data/effects/ladspa/ladspa_2146.xml
#: rc.cpp:8260
#, kde-format
msgid "TAP AutoPanner"
msgstr "TAP 自动声像器"

#. i18n: file: data/effects/ladspa/ladspa_2146.xml
#: rc.cpp:8262
#, kde-format
msgid ""
"TAP AutoPanner (LADSPA 2146)<br>\n"
"   Main use is to liven up synth tracks in the mix"
msgstr ""
"TAP 自动声像器 (LADSPA 2146)<br>\n"
"   主要用于在混音中为合成器音轨增添动感。"

#. i18n: file: data/effects/ladspa/ladspa_2146.xml
#: rc.cpp:8268
#, kde-format
msgid ""
"Sets the wideness of panning.<br>\n"
"      A setting of 100% means that mono input signal is panned between the "
"extreme left and right positions"
msgstr ""
"设置声像摆动的宽度。<br>\n"
"      100% 的设置表示单声道输入信号将在最左和最右位置之间来回摆动。"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8274
#, kde-format
msgid "TAP DeEsser"
msgstr "TAP 去齿音器"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8276
#, kde-format
msgid ""
"TAP DeEsser (LADSPA 2147)<br>\n"
"   Used for attenuating higher pitched frequencies in vocals such as those "
"found in 'ess', 'shh' and 'chh' sounds."
msgstr ""
"TAP 去齿音器 (LADSPA 2147)<br>\n"
"   用于衰减人声中较高频率的成分，例如“s”、“sh”和“ch”等发音中的刺耳高频。"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8278
#, kde-format
msgid "Threshold Level"
msgstr "阈值电平"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8282
#, kde-format
msgid "Sidechain Filter"
msgstr "侧链滤波器"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8284
#, kde-format
msgid ""
"The chosen filter's frequency<br>\n"
"      is set by the <b>Frequency</b> parameter"
msgstr ""
"所选滤波器的频率<br>\n"
"      由<b>频率</b>参数设定"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8286
#, kde-format
msgid "Highpass,Bandpass"
msgstr "高通,带通"

#. i18n: file: data/effects/ladspa/ladspa_2147.xml
#: rc.cpp:8288
#, kde-format
msgid "Monitor On"
msgstr "开启监听"

#. i18n: file: data/effects/ladspa/ladspa_2148.xml
#: rc.cpp:8292
#, kde-format
msgid "TAP Vibrato"
msgstr "TAP 震音"

#. i18n: file: data/effects/ladspa/ladspa_2148.xml
#: rc.cpp:8294
#, kde-format
msgid ""
"TAP Vibrato (LADSPA 2148)<br>\n"
"   Modulates the pitch of its input signal with a low-frequency sinusoidal "
"signal. It is useful for guitar and synth tracks, and it can also come handy "
"if a strange effect is needed."
msgstr ""
"TAP 震音 (LADSPA 2148)<br>\n"
"   使用低频正弦波信号调制输入信号的音高。适用于吉他和合成器音轨，也可在需要制"
"造奇特效果时使用。"

#. i18n: file: data/effects/ladspa/ladspa_2148.xml
#: rc.cpp:8298
#, kde-format
msgid "Determines how fast the pitch is modulated up-down"
msgstr "决定音高上下调制的速度"

#. i18n: file: data/effects/ladspa/ladspa_2148.xml
#: rc.cpp:8302
#, kde-format
msgid "Sets the amount of pitch modulation"
msgstr "设置音高调制的强度"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8310
#, kde-format
msgid "TAP Rotary Speaker"
msgstr "TAP 旋转扬声器"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8312
#, kde-format
msgid ""
"TAP Rotary Speaker (LADSPA 2149)<br>\n"
"   Simulates the sound of rotating speakers."
msgstr ""
"TAP 旋转扬声器 (LADSPA 2149)<br>\n"
"   模拟旋转扬声器的声音效果。"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8314
#, kde-format
msgid "Rotor Frequency"
msgstr "转子频率"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8316
#, kde-format
msgid "Horn Frequency"
msgstr "号角频率"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8318
#, kde-format
msgid "Mic Distance"
msgstr "麦克风距离"

#. i18n: file: data/effects/ladspa/ladspa_2149.xml
#: rc.cpp:8320
#, kde-format
msgid "Rotor/Horn Mix"
msgstr "转子/号角混合"

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8324
#, kde-format
msgid "TAP Pitch Shifter"
msgstr "TAP 音高移调器"

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8326
#, kde-format
msgid ""
"TAP Pitch Shifter (LADSPA 2150)<br>\n"
"   Change the pitch in the range of plus/minus one octave."
msgstr ""
"TAP 音高移调器 (LADSPA 2150)<br>\n"
"   可在正负一个八度范围内改变音高。"

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8328
#, kde-format
msgid "Semitone Shift"
msgstr "半音移调"

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8330
#, kde-format
msgid ""
"Does the same thing as <b>Rate Shift</b></br>\n"
"      but allows to set musically sensible pitch shift rates."
msgstr ""
"功能与<b>速率偏移</b>相同</br>\n"
"      但允许设置符合音乐操作逻辑的音高移调速率。"

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8332
#, kde-format
msgid "Rate Shift"
msgstr "速率移调"

#. i18n: file: data/effects/ladspa/ladspa_2150.xml
#: rc.cpp:8334
#, kde-format
msgid ""
"Does the same thing as <b>Semitone Shift</b><br>\n"
"      but in percentage of the original pitch, so that is closer to a "
"\"physical\", non-musical approach"
msgstr ""
"功能与<b>半音移调</b>相同<br>\n"
"      但以原始音高的百分比表示，因此更接近“物理”而非音乐的处理方式。"

#. i18n: file: data/effects/ladspa/ladspa_2151.xml
#: rc.cpp:8342
#, kde-format
msgid "TAP Equalizer/BW"
msgstr "TAP 均衡器/带宽"

#. i18n: file: data/effects/ladspa/ladspa_2151.xml
#: rc.cpp:8344
#, kde-format
msgid ""
"TAP Equalizer (LADSPA (2151)<br>\n"
"    8-band equalizer with adjustable band center frequencies and bandwidth."
msgstr ""
"TAP 均衡器 (LADSPA 2151)<br>\n"
"    可调节各频段中心频率和带宽的 8 段均衡器。"

#. i18n: file: data/effects/ladspa/ladspa_2151.xml
#: rc.cpp:8350 rc.cpp:8356 rc.cpp:8362 rc.cpp:8368 rc.cpp:8374 rc.cpp:8380
#: rc.cpp:8386 rc.cpp:8392
#, kde-format
msgid "BW"
msgstr "BW"

