{
    "manifest_version": 1,
    "id": "voice-toolkit",
    "name": "Voice Toolkit",
    "version": "1.0.0",
    "author": "Wlad Radchenko",
    "author_email": "i@wladradchenko.ru",
    "description": "Two ways to work on the voice in a clip, sharing one environment: replace it with a registered voice, or take it out of what is behind it. Each is its own effect, and each puts what it makes in the project bin and on an audio track of its own, leaving the clip on the timeline alone.",
    "license": "MIT",
    "homepage": "https://github.com/wladradchenko/wunjo.wladradchenko.ru",
    "icon": "icon.svg",
    "kind": "local",
    "venv": "private",
    "target": "audio",
    "entry": "main.py",
    "python": "python3.11",
    "requirements": "requirements.txt",
    "requirements_cuda": [
        {
            "min_driver_cuda": 12.4,
            "file": "requirements-cu124.txt"
        },
        {
            "min_driver_cuda": 11.8,
            "file": "requirements-cu118.txt"
        }
    ],
    "models": [
        {
            "name": "converter.pth",
            "url": "https://huggingface.co/wladradchenko/wunjo.wladradchenko.ru/resolve/main/clone/converter.pth?download=true",
            "size_mb": 125,
            "auto_download": false,
            "group": ""
        },
        {
            "name": "config.json",
            "url": "https://huggingface.co/wladradchenko/wunjo.wladradchenko.ru/resolve/main/clone/config.json?download=true",
            "size_mb": 0,
            "auto_download": false,
            "group": ""
        },
        {
            "name": "MDX_Inst_HQ_3.onnx",
            "url": "https://huggingface.co/wladradchenko/wunjo.wladradchenko.ru/resolve/main/separator/mdx/MDX_Inst_HQ_3.onnx?download=true",
            "size_mb": 63,
            "auto_download": false,
            "group": ""
        }
    ],
    "params": [
        {
            "key": "use_gpu",
            "type": "bool",
            "label": "Use the graphics card when it is free",
            "default": true,
            "group": ""
        },
        {
            "key": "chunk_seconds",
            "type": "number",
            "label": "Seconds converted at once (0 = choose by free memory)",
            "min": 0,
            "max": 60,
            "step": 5,
            "default": 0,
            "group": "Clone Voice"
        }
    ],
    "hardware": {
        "min_vram_gb": 2,
        "cpu_ok": true
    },
    "os": [
        "linux",
        "windows",
        "macos"
    ],
    "effects": [
        "effects/voice-toolkit-clone.xml",
        "effects/voice-toolkit-separator.xml"
    ],
    "sets": {
        "label": "registered voices. Add a recording of somebody speaking — at least 6 seconds — then choose that voice in the Clone Voice effect.",
        "action": "Register voice",
        "filter": "Audio (*.wav *.mp3 *.m4a *.aac *.ogg *.flac);;All files (*)",
        "detail": "Length"
    },
    "input": {
        "clip": "audio",
        "multiple": false,
        "zone": false
    },
    "result": {
        "type": "audio",
        "place": "bin"
    }
}
