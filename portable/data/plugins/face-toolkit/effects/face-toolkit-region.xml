<?xml version="1.0"?>
<!DOCTYPE kpartgui>
<!--
  Face Region — which face is worked on, and where it is over time.

  One region serves all three effects of this plugin: animating, swapping and
  speaking all need the same answer to "which face". Built on `brightness`
  pinned to level = 1, so it carries data and never touches the image.
-->
<effect xmlns="https://www.wunjo.online" tag="brightness" id="face-toolkit.region" type="customVideo">
    <name>Face Region</name>
    <description>Follows the face that Face Toolkit works on</description>
    <author>Wunjo</author>
    <parameter type="animatedrect" name="fm_face" default="50% 50% 25% 25%" opacity="false" wunjo_fill="face">
        <name>Face</name>
        <comment>Keyframe this rectangle to correct where the face is at any point of the clip.</comment>
    </parameter>
    <parameter type="hidden" name="fm_region" default="" wunjo_fill="region"/>
    <parameter type="fixed" name="level" default="1"/>
</effect>
