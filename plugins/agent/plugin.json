    "params": [
        {
            "key": "tool_set",
            "type": "enum",
            "label": "How much of the editor the assistant is offered",
            "options": [
                "focused",
                "full"
            ],
            "default": "focused",
            "group": ""
        },
        {
            "key": "context_tokens",
            "type": "number",
            "label": "Context window (tokens; the tools alone need ~12000)",
            "min": 16384,
            "max": 65536,
            "step": 4096,
            "default": 65536,
            "group": ""
        },
        {
            "key": "idle_minutes",
            "type": "number",
            "label": "Minutes of silence before the model is unloaded from memory",
            "min": 1,
            "max": 120,
            "step": 1,
            "default": 10,
            "group": ""
        }
    ],
    "hardware": {
        "min_vram_gb": 0,
        "cpu_ok": true
    },
    "os": [
        "linux",
        "windows",
        "macos"
    ],
    "input": {
        "clip": "none",
        "multiple": false,
        "zone": false
    },
    "result": {
        "type": "none",
        "place": "none"
    }
